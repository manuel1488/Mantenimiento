{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Development",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-debug",
            "program": "${workspaceFolder}/src/App.Web/bin/Debug/net9.0/App.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/App.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/src/App.Web/"
            }
        },
        {
            "name": "Debug Production",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-release",
            "program": "${workspaceFolder}/src/App.Web/bin/Release/net9.0/App.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/App.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/src/App.Web/"
            }
        }
    ]
}