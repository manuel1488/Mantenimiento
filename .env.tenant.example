# =============================================================================
# White-Label Tenant — Environment Variables Template
# Copy this file to .env.{tienda} and fill the values.
#
# Used with the generic `webapp-tenant` service in docker-compose.yml, which is
# reused for EVERY additional store (not duplicated per tenant). Bring one up with:
#
#   docker compose -p {tienda} --profile tenant --env-file .env.{tienda} up -d
#
# IMPORTANT: the shared MySQL container (`db`) must already be running and healthy
# before running the command above — this service intentionally has no depends_on: db
# (adding one would make Compose spin up a second, isolated MySQL container under this
# tenant's project instead of reusing the shared one). See
# docs/02-Development/white-label-deployment-guide.md.
#
# `db` itself only needs to be brought up ONCE per server, by whichever tenant's .env
# bootstraps it first (that .env needs MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD/
# DB_CPU_LIMIT/DB_MEMORY_LIMIT/etc, plus MYSQL_ROOT_PASSWORD in a companion
# .env.{tienda}.secrets file — see .env.tr / .env.tr.secrets for a real example).
# Every tenant added AFTER that one just needs its own database created manually on the
# already-running `db` and its own DATABASE_CONNECTION_STRING below — no DB_* vars needed.
# =============================================================================

# Container Configuration — must be unique per tenant
CONTAINER_PREFIX=tienda-x-prod
BUILD_CONFIGURATION=Release

# Brand identity — must match a file in src/App.Web/Branding/{profile}.json
BRANDING_PROFILE=tienda-x

# Application Configuration
Application__Version=1.0.0
Application__DefaultLanguage=es-MX
Application__SupportedLanguages__0=es-MX
Application__SupportedLanguages__1=en-US
Application__BaseUrl=https://your-tenant-domain.com

# Server Configuration — PORT must be unique per tenant (not shared with Cleeny or other tenants)
PORT=8081
TZ=America/Mexico_City

# Resource Limits
CPU_LIMIT=1.0
MEMORY_LIMIT=1G
CPU_RESERVATION=0.5
MEMORY_RESERVATION=512M

# Database Configuration — 'db' resolves via the shared app-shared-network.
# Create this database on the shared MySQL container first:
#   docker exec -it <cleeny-mysql-container> mysql -uroot -p -e "CREATE DATABASE tienda_x;"
DATABASE_CONNECTION_STRING=Server=db;Database=tienda_x;User=tienda_x;Password=YOUR_SECURE_PASSWORD_HERE;
