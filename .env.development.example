# =============================================================================
# App - Environment Variables Template
# Copy this file to .env.development or .env.production and fill the values.
# Also copy .env.development.secrets.example (or .env.production.secrets.example) to
# .env.{environment}.secrets for MYSQL_ROOT_PASSWORD — pass both files:
#   --env-file .env.development --env-file .env.development.secrets
# =============================================================================

# Container Configuration
CONTAINER_PREFIX=app-dev
BUILD_CONFIGURATION=Debug

# Application Configuration
Application__Version=1.0.0-dev
Application__DefaultLanguage=es-MX
Application__SupportedLanguages__0=es-MX
Application__SupportedLanguages__1=en-US
Application__BaseUrl=http://localhost:8080

# Brand identity — must match a file in src/App.Web/Branding/{profile}.json
BRANDING_PROFILE=cleeny

# Server Configuration
ASPNETCORE_ENVIRONMENT=Development
PORT=8080
TZ=UTC

# Resource Limits
CPU_LIMIT=0.5
MEMORY_LIMIT=512M
CPU_RESERVATION=0.25
MEMORY_RESERVATION=256M

# MySQL Configuration
# MYSQL_ROOT_PASSWORD lives in .env.{environment}.secrets
MYSQL_DATABASE=YOUR_DATABASE_NAME_HERE
MYSQL_USER=YOUR_DB_USER_HERE
MYSQL_PASSWORD=YOUR_SECURE_PASSWORD_HERE
MYSQL_PORT=3306

# MySQL Resource Limits
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1G
DB_CPU_RESERVATION=0.5
DB_MEMORY_RESERVATION=512M

# Database Configuration
DATABASE_CONNECTION_STRING=Server=db;Database=YOUR_DATABASE_NAME_HERE;User=YOUR_DB_USER_HERE;Password=YOUR_SECURE_PASSWORD_HERE;
