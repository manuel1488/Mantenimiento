# =============================================================================
# App - Production Environment Variables
# Production assumes an externally-provisioned MySQL server managed by the DBA —
# there is no local `db` container and no MYSQL_ROOT_PASSWORD/.secrets file needed
# for this profile. Just fill in DATABASE_CONNECTION_STRING with what the DBA gives you.
#
# (If you're instead bootstrapping a self-hosted, white-label multi-tenant MySQL —
# see docs/02-Development/white-label-deployment-guide.md — that uses the separate
# "shared-db"/"tenant" profiles and .env.{tenant}.secrets, not this file.)
# =============================================================================

# Container Configuration
CONTAINER_PREFIX=app-prod
BUILD_CONFIGURATION=Release

# Application Configuration
Application__Version=1.0.0
Application__DefaultLanguage=es-MX
Application__SupportedLanguages__0=es-MX
Application__SupportedLanguages__1=en-US
Application__BaseUrl=https://your-domain.com

# Brand identity — must match a file in src/App.Web/Branding/{profile}.json
# (app name, logo path, theme colors). Add a new Branding/{tenant}.json to onboard a tenant.
BRANDING_PROFILE=default

# Server Configuration
PORT=8080
TZ=America/Mexico_City

# Resource Limits
CPU_LIMIT=1.0
MEMORY_LIMIT=1G
CPU_RESERVATION=0.5
MEMORY_RESERVATION=512M

# Database Configuration (Production) — external MySQL provisioned by the DBA.
DATABASE_CONNECTION_STRING=Server=YOUR_DB_HOST_HERE;Port=3306;Database=YOUR_DATABASE_NAME_HERE;User=YOUR_DB_USER_HERE;Password=YOUR_SECURE_PASSWORD_HERE;
