# =============================================================================
# App - Production Environment Variables
# =============================================================================

# Container Configuration
CONTAINER_PREFIX=app-prod
BUILD_CONFIGURATION=Release

# Application Configuration
APPLICATION_NAME=App
Application__Name=App
Application__Version=1.0.0
Application__DefaultLanguage=es-MX
Application__SupportedLanguages__0=es-MX
Application__SupportedLanguages__1=en-US
Application__BaseUrl=https://your-domain.com

# Server Configuration
PORT=8080
TZ=America/Mexico_City

# Resource Limits
CPU_LIMIT=1.0
MEMORY_LIMIT=1G
CPU_RESERVATION=0.5
MEMORY_RESERVATION=512M

# MySQL Configuration (if using containerized DB)
MYSQL_ROOT_PASSWORD=YOUR_SECURE_PASSWORD_HERE
MYSQL_DATABASE=YOUR_DATABASE_NAME_HERE
MYSQL_USER=YOUR_DB_USER_HERE
MYSQL_PASSWORD=YOUR_SECURE_PASSWORD_HERE
MYSQL_PORT=3306

# Database Configuration (Production)
DATABASE_CONNECTION_STRING=Server=db;Database=YOUR_DATABASE_NAME_HERE;User=YOUR_DB_USER_HERE;Password=YOUR_SECURE_PASSWORD_HERE;
