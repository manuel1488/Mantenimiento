@page "/seguimiento/{Token}"
@layout PublicMinimalLayout

@using App.Web.Components.Layout
@using App.Core.Common
@using App.Core.DTOs.Obras
@using App.Core.Enums.Obras
@using App.Core.Interfaces
@using App.Web.Components.Admin.Obras
@using MudBlazor

@inject IStringLocalizer<ObraSeguimientoPage> L
@inject IObraClienteAccesoService ObraClienteAccesoService
@inject IObraService ObraService
@inject IActividadService ActividadService
@inject IObraFolioSettingsService ObraFolioSettingsService

<PageTitle>@L["Project Tracking"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mb-8">
    @if (_loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_obra is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">@L["This link is invalid or has expired"]</MudAlert>
    }
    else
    {
        <MudPaper Class="da-card pa-4 pa-sm-6 mb-4" Elevation="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Folio()</MudText>
            <MudText Typo="Typo.h5" Style="font-weight: 600;">@_obra.Direccion</MudText>
            <MudChip T="string" Size="Size.Small" Color="@ObrasPage.EstadoColor(_obra.Estado)" Variant="Variant.Filled" Class="mt-2">
                @EstadoLabel(_obra.Estado)
            </MudChip>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: nowrap;">@L["Overall Progress"]</MudText>
                <MudProgressLinear Color="Color.Primary" Value="@_obra.PorcentajeAvance" Rounded="true" Class="flex-grow-1" />
                <MudText Typo="Typo.body2" Style="white-space: nowrap;">@_obra.PorcentajeAvance%</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="da-card pa-3 pa-sm-4 mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="pa-2">@L["Actividades"]</MudText>
            @if (_actividades.Count == 0)
            {
                <MudText Class="pa-2">@L["No actividades yet"]</MudText>
            }
            else
            {
                @foreach (var actividad in _actividades)
                {
                    <MudPaper Class="pa-3 mb-2" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.subtitle2">@actividad.ServicioNombre</MudText>
                            <MudText Typo="Typo.body2">@actividad.PorcentajeAvance%</MudText>
                        </MudStack>
                        <MudProgressLinear Color="@EstadoColor(actividad.Estado)" Value="@actividad.PorcentajeAvance"
                                            Rounded="true" Size="Size.Small" />
                        @if (!string.IsNullOrWhiteSpace(actividad.Descripcion))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@actividad.Descripcion</MudText>
                        }
                    </MudPaper>
                }
            }
        </MudPaper>

        <MudPaper Class="da-card pa-3 pa-sm-4 mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Updates"]</MudText>
            <ObraMensajesSection ObraId="_obra.Id" ReadOnly="true" />
        </MudPaper>

        <MudPaper Class="da-card pa-3 pa-sm-4 mb-4" Elevation="2">
            <ObraFotosGeneralesSection ObraId="_obra.Id" ReadOnly="true" />
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private ObraDto? _obra;
    private List<ActividadDto> _actividades = new();
    private string? _folioPrefijo;
    private int? _folioDigitos;

    protected override async Task OnInitializedAsync()
    {
        var folioSettings = await ObraFolioSettingsService.GetSettingsAsync();
        _folioPrefijo = folioSettings.FolioPrefijo;
        _folioDigitos = folioSettings.FolioDigitos;

        var resolveResult = await ObraClienteAccesoService.ResolveTokenAsync(Token);
        if (!resolveResult.IsSuccess)
        {
            _loading = false;
            return;
        }

        var obraResult = await ObraService.GetByIdAsync(resolveResult.Value);
        if (obraResult.IsSuccess)
        {
            _obra = obraResult.Value;

            var actividadesResult = await ActividadService.GetByObraIdAsync(_obra!.Id);
            if (actividadesResult.IsSuccess)
                _actividades = actividadesResult.Value!;
        }

        _loading = false;
    }

    private string Folio() => _obra is null
        ? string.Empty
        : CotizacionFolioFormatter.Format(_obra.Id, _obra.FolioAnio, _obra.FolioNumero, _folioPrefijo, _folioDigitos);

    private string EstadoLabel(ObraEstado estado) => estado switch
    {
        ObraEstado.Solicitada => L["Requested"],
        ObraEstado.Cotizada => L["Quoted"],
        ObraEstado.Rechazada => L["Rejected"],
        ObraEstado.Aprobada => L["Approved"],
        ObraEstado.EnProceso => L["In Progress"],
        ObraEstado.Finalizada => L["Finished"],
        ObraEstado.Facturada => L["Invoiced"],
        _ => estado.ToString()
    };

    private static Color EstadoColor(ActividadEstado estado) => estado switch
    {
        ActividadEstado.Pendiente => Color.Warning,
        ActividadEstado.EnProceso => Color.Info,
        ActividadEstado.Finalizada => Color.Success,
        _ => Color.Default
    };
}
