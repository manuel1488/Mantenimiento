@using App.Core.DTOs.Billing.Mexico
@using App.Core.DTOs.Product
@using App.Core.DTOs.Shop
@using App.Core.DTOs.UnitMeasure
@using App.Core.Interfaces
@using App.Core.Interfaces.Shop
@using App.Core.Options
@using Microsoft.Extensions.Options

@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ProductDialog> L
@inject IUnitMeasureService UnitMeasureService
@inject ILogger<ProductDialog> Logger
@inject IOptions<ImageOptions> ImageOptions
@inject ICompanySettingsService SettingsService
@inject IMexicoFiscalCatalogService MexicoFiscalCatalogService
@inject IProductCodeGeneratorService CodeGeneratorService
@inject IPartialSaleFractionService PartialSaleFractionService
@inject IProductPartialSurchargeService ProductPartialSurchargeService
@inject IWholesaleTierService WholesaleTierService
@inject IProductWholesalePriceService ProductWholesalePriceService

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageProducts">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 800px;" Class="pa-4">
                    <MudForm Model="@_model" @ref="@_form">
                        <MudGrid>
                            <!-- Product Image -->
                            <MudItem xs="12" Class="d-flex justify-center">
                                <MudPaper Class="pa-4" Style="@($"width: {ImageOptions.Value.Thumbnail.MaxWidth}px;")">
                                    @if (!string.IsNullOrEmpty(_currentImage))
                                    {
                                        <MudImage Src="@_currentImage" 
                                            Alt="@L["Product Image"]"
                                            Width="@ImageOptions.Value.Thumbnail.MaxWidth"
                                            Height="@ImageOptions.Value.Thumbnail.MaxHeight"
                                            ObjectFit="ObjectFit.Cover"
                                            ObjectPosition="ObjectPosition.Center"
                                            Class="rounded-lg" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Image" 
                                            Size="Size.Large"
                                            Style="width: 100%; height: 100%;"
                                            Class="mud-text-disabled" />
                                    }
                                </MudPaper>
                            </MudItem>
                            
                            <MudItem xs="12" Class="d-flex justify-center">
                                <InputFile id="fileInput" 
                                    OnChange="OnFileSelected" 
                                    Accept="@string.Join(",", ImageOptions.Value.AllowedTypes)"
                                    hidden />
                                <MudButton HtmlTag="label"
                                    Variant="Variant.Outlined"
                                    Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.PhotoCamera"
                                    for="fileInput"
                                    Size="Size.Small">
                                    @L["Change Image"]
                                </MudButton>
                            </MudItem>

                            <!-- Code - Solo mostrar en modo edición o con toggle para autogenerado -->
                            @if (!IsNew)
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_model.Code" 
                                        Label="@L["Code"]"
                                        Required="true"
                                        RequiredError="@L["Code is required"]"
                                        OnBlur="@(() => ValidateCode(_model.Code))"
                                        Error="@_codeError"
                                        ErrorText="@(_codeError ? L["Product code already exists"]?.ToString() : null)" />
                                </MudItem>
                            }
                            else
                            {
                                <!-- Toggle para generar código automáticamente o manual -->
                                <MudItem xs="12">
                                    <MudGrid>
                                        <MudItem xs="12" sm="8">
                                            <MudSwitch @bind-Value="_useAutoGeneratedCode" 
                                                Label="@L["Auto-generate product code"]"
                                                Color="Color.Primary" />
                                        </MudItem>
                                        @if (_useAutoGeneratedCode)
                                        {
                                            <MudItem xs="12" sm="4">
                                                <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                                                    Variant="Variant.Text"
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    OnClick="@GenerateNewCode"
                                                    Disabled="@_generatingCode">
                                                    @if (_generatingCode)
                                                    {
                                                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                                        @L["Generating..."]
                                                    }
                                                    else
                                                    {
                                                        @L["Generate New"]
                                                    }
                                                </MudButton>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudItem>

                                @if (!_useAutoGeneratedCode)
                                {
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_model.Code" 
                                            Label="@L["Code"]"
                                            Required="true"
                                            RequiredError="@L["Code is required"]"
                                            OnBlur="@(() => ValidateCode(_model.Code))"
                                            Error="@_codeError"
                                            ErrorText="@(_codeError ? L["Product code already exists"]?.ToString() : null)" />
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12" md="6">
                                        <MudTextField Value="@_model.Code" 
                                            Label="@L["Generated Code"]"
                                            ReadOnly="true"
                                            Variant="Variant.Filled"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.AutoAwesome" />
                                    </MudItem>
                                }
                            }

                            <!-- Name -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Name" 
                                    Label="@L["Name"]" 
                                    Required="true"
                                    RequiredError="@L["Name is required"]" />
                            </MudItem>

                            <!-- Brand -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Brand" 
                                    Label="@L["Brand"]"
                                    Required="true" 
                                    RequiredError="@L["Brand is required"]" />
                            </MudItem>

                            <!-- Description -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.Description" 
                                    Label="@L["Description"]" 
                                    Lines="3" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_model.Content" 
                                    Label="@L["Content/Quantity"]" 
                                    Required="true"
                                    RequiredError="@L["Content is required"]" 
                                    Min="0.001M" 
                                    Format="N3" 
                                    Adornment="Adornment.End"
                                    AdornmentText="@GetSelectedUnitMeasureName()" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudCheckBox T="bool"
                                        Value="_model.IsPartialSaleAllowed"
                                        ValueChanged="OnPartialSaleAllowedChanged"
                                        Label="@L["Allow Partial Sales"]"
                                        Color="Color.Primary" />
                            </MudItem>

                            @if (_model.IsPartialSaleAllowed)
                            {
                                <MudItem xs="12">
                                    <MudPaper Class="pa-3" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Partial Sale Surcharges"]</MudText>
                                        <MudText Typo="Typo.caption" Class="mb-3" Color="Color.Secondary">
                                            @L["Configure surcharge percentage for each fraction. Leave at 0% for proportional pricing."]
                                        </MudText>

                                        @if (_loadingSurcharges)
                                        {
                                            <MudProgressLinear Indeterminate="true" />
                                        }
                                        else
                                        {
                                            <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                                <thead>
                                                    <tr>
                                                        <th>@L["Fraction"]</th>
                                                        <th style="width: 150px;">@L["Surcharge %"]</th>
                                                        <th style="width: 100px;">@L["Active"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var config in _surchargeConfigs)
                                                    {
                                                        <tr>
                                                            <td>@config.FractionName (@config.FractionCode)</td>
                                                            <td>
                                                                <MudNumericField T="decimal"
                                                                    @bind-Value="config.SurchargePercentage"
                                                                    Min="0" Max="100" Step="0.5M"
                                                                    Variant="Variant.Outlined"
                                                                    Margin="Margin.Dense"
                                                                    HideSpinButtons="true"
                                                                    Adornment="Adornment.End"
                                                                    AdornmentText="%" />
                                                            </td>
                                                            <td>
                                                                <MudCheckBox T="bool"
                                                                    @bind-Value="config.IsActive"
                                                                    Color="Color.Primary"
                                                                    Dense="true" />
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                        }
                                    </MudPaper>
                                </MudItem>
                            }

                            <MudItem xs="12">
                                <MudCheckBox T="bool"
                                        @bind-Value="_model.AllowCustomPricing"
                                        Label="@L["Allow Custom Pricing"]"
                                        Color="Color.Primary" />
                            </MudItem>

                            <!-- Wholesale Pricing Section -->
                            <MudItem xs="12">
                                <MudPaper Class="pa-3" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Wholesale Pricing"]</MudText>
                                    <MudText Typo="Typo.caption" Class="mb-3" Color="Color.Secondary">
                                        @L["Configure discount percentage for each wholesale tier. Min quantity is in the product's unit of measure."]
                                    </MudText>

                                    @if (_loadingWholesalePrices)
                                    {
                                        <MudProgressLinear Indeterminate="true" />
                                    }
                                    else if (_wholesalePriceConfigs.Count > 0)
                                    {
                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                                            <thead>
                                                <tr>
                                                    <th>@L["Tier"]</th>
                                                    <th style="width: 150px;">@L["Min Quantity"]</th>
                                                    <th style="width: 150px;">@L["Discount %"]</th>
                                                    <th style="width: 100px;">@L["Active"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var config in _wholesalePriceConfigs)
                                                {
                                                    <tr>
                                                        <td>@config.TierName</td>
                                                        <td>
                                                            <MudNumericField T="decimal"
                                                                @bind-Value="config.MinQuantity"
                                                                Min="0" Step="1M"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense"
                                                                HideSpinButtons="true"
                                                                Adornment="Adornment.End"
                                                                AdornmentText="@GetSelectedUnitMeasureName()" />
                                                        </td>
                                                        <td>
                                                            <MudNumericField T="decimal"
                                                                @bind-Value="config.DiscountPercentage"
                                                                Min="0" Max="100" Step="0.5M"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense"
                                                                HideSpinButtons="true"
                                                                Adornment="Adornment.End"
                                                                AdornmentText="%" />
                                                        </td>
                                                        <td>
                                                            <MudCheckBox T="bool"
                                                                @bind-Value="config.IsActive"
                                                                Color="Color.Primary"
                                                                Dense="true" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            @L["No wholesale tiers configured. Add tiers in Settings."]
                                        </MudText>
                                    }
                                </MudPaper>
                            </MudItem>

                            <!-- Unit of Measure -->
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="_model.UnitMeasureId" 
                                    Label="@L["Unit Measure"]" 
                                    Required="true"
                                    RequiredError="@L["Unit measure is required"]"
                                    Validation="@(new Func<int, string>(ValidateUnitMeasure))">
                                    <MudSelectItem T="int" Value="0">@L["Select a unit"]</MudSelectItem>
                                    @foreach (var unit in _unitMeasures)
                                    {
                                        <MudSelectItem Value="@unit.Id">
                                            @unit.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Cost -->
                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_model.Cost"
                                            Label="@L["Cost"]"
                                            Min="0M"
                                            Format="N2"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                            </MudItem>

                            <!-- Price -->
                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_model.Price"
                                            Label="@L["Price"]"
                                            Required="true"
                                            RequiredError="@L["Price is required"]"
                                            Min="0.01M"
                                            Format="N2"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                            </MudItem>

                            <!-- Barcode -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Barcode"
                                    Label="@L["Barcode"]"
                                    OnBlur="@(() => ValidateBarcode(_model.Barcode ?? string.Empty))"
                                    Error="@_barcodeError"
                                    ErrorText="@(_barcodeError ? L["Product barcode already exists"].ToString() : null)" />
                            </MudItem>

                            <!-- SAT Product code (Mexico only) -->
                            @if (_isMexico)
                            {
                                <MudItem xs="12">
                                    <MudAutocomplete T="MexicoProductServiceDto"
                                        Label="@L["SAT Product/Service Code"]"
                                        SearchFunc="@SearchProductServices"
                                        ToStringFunc="@(x => x == null ? string.Empty : $"{x.Description} ({x.Code})")"
                                        Value="_selectedProductService"
                                        ValueChanged="OnProductServiceSelected"
                                        MaxItems="null"
                                        CoerceText="false"
                                        CoerceValue="false"
                                        MinCharacters="0"
                                        ResetValueOnEmptyText="true"
                                        Clearable="true"
                                        Immediate="true"
                                        Dense="true"
                                        AdornmentIcon="@Icons.Material.Filled.Search"
                                        Adornment="Adornment.Start"/>
                                </MudItem>
                            }

                            <!-- Options -->
                            <MudItem xs="12">
                                <MudCheckBox T="bool" 
                                        @bind-Value="_model.IsTaxable" 
                                        Label="@L["Apply Tax"]"
                                        Color="Color.Primary" />
                            </MudItem>

                            @if (!IsNew)
                            {
                                <MudItem xs="12">
                                    <MudCheckBox T="bool" 
                                            @bind-Value="_model.IsActive" 
                                            Label="@L["Active"]"
                                            Color="Color.Primary" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudForm>

                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel" 
                        Class="da-button-rounded" 
                        title="@L["Cancel editing"]">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Error"
                    OnClick="Submit"
                    Variant="Variant.Filled"
                    Disabled="@(_processing || !_isValid || (_useAutoGeneratedCode && string.IsNullOrEmpty(_model.Code)))"
                    title="@L["Save product data"]"
                    Class="da-button-rounded">
                    @if (_processing)
                    {
                        <MudProgressCircular Class = "ms-n1"
                            Size = "Size.Small"
                            Indeterminate = "true"/>               
                        <MudText Class = "ms-2">
                            @L["Saving"]
                        </MudText>
                    }
                    else            
                    {
                        @L["Save"]            
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Parameters and Cascading Values
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] 
    public long? ProductId { get; set; }
    
    // Constants
    private const int PageSize = 50;
    private const int InitialLoadSize = 50;

    // Form and UI Control
    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool IsNew => !ProductId.HasValue;
    
    // Validation States
    private bool _codeError;
    private bool _barcodeError;
    
    // Auto-generation Control
    private bool _useAutoGeneratedCode = true;
    private bool _generatingCode = false;
    
    // Product Data
    private ProductDto? _product;
    private CreateProductDto _model = new()
    {
        Price = 0.01M,
        IsTaxable = true,
        IsActive = true,
        UnitMeasureId = 0
    };
    private List<UnitMeasureDto> _unitMeasures = new();

    // Image Handling
    private string? _currentImage;
    private IBrowserFile? _selectedFile;
    private Stream? _imageStream;

    // Mexico-specific Properties
    private bool _isMexico;
    private MexicoProductServiceDto? _selectedProductService;
    private IList<MexicoProductServiceDto> _productServices = new List<MexicoProductServiceDto>();
    private IEnumerable<MexicoProductServiceDto> _initialProductServices = Array.Empty<MexicoProductServiceDto>();

    // Partial Sale Surcharges
    private bool _loadingSurcharges;
    private List<PartialSaleFractionDto> _availableFractions = new();
    private List<SurchargeConfigModel> _surchargeConfigs = new();

    // Helper class for surcharge configuration
    private class SurchargeConfigModel
    {
        public int PartialSaleFractionId { get; set; }
        public string FractionCode { get; set; } = null!;
        public string FractionName { get; set; } = null!;
        public decimal SurchargePercentage { get; set; }
        public bool IsActive { get; set; } = true;
    }

    // Wholesale Pricing
    private bool _loadingWholesalePrices;
    private List<WholesaleTierDto> _availableTiers = new();
    private List<WholesalePriceConfigModel> _wholesalePriceConfigs = new();

    // Helper class for wholesale price configuration
    private class WholesalePriceConfigModel
    {
        public int WholesaleTierId { get; set; }
        public string TierName { get; set; } = null!;
        public decimal MinQuantity { get; set; }
        public decimal DiscountPercentage { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUnitMeasures();
        
        // Check if the system is configured for Mexico
        var settings = await SettingsService.GetSettingsAsync();
        _isMexico = settings?.CountryCode == CountryCodes.Mexico;
        
        // If Mexico, load initial SAT product/service and unit lists
        if (_isMexico)
        {
            try
            {
                var (_, items) = await MexicoFiscalCatalogService.SearchProductServicesAsync(
                    searchText: null,
                    page: 1,
                    pageSize: InitialLoadSize);
                _initialProductServices = items;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading initial SAT product services");
                Snackbar.Add(L["Error loading SAT catalog"], Severity.Error);
            }
        }
        
        // Load wholesale tier configs (always shown)
        await LoadWholesalePriceConfigs();

        if (ProductId.HasValue)
        {
            await LoadProduct();
        }
        else
        {
            // Auto-generate code for new products
            await GenerateNewCode();
        }
    }

    private async Task GenerateNewCode()
    {
        if (!IsNew || !_useAutoGeneratedCode) return;
        
        try
        {
            _generatingCode = true;
            StateHasChanged();
            
            var generatedCode = await CodeGeneratorService.GenerateProductCodeAsync();
            _model.Code = generatedCode;
            
            // Clear any previous validation errors
            _codeError = false;
            _isValid = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating product code");
            Snackbar.Add(L["Error generating product code"], Severity.Error);
        }
        finally
        {
            _generatingCode = false;
            StateHasChanged();
        }
    }

    private async Task LoadUnitMeasures()
    {
        try
        {
            _unitMeasures = new List<UnitMeasureDto>();
            _unitMeasures = (await UnitMeasureService.GetActiveUnitMeasuresAsync("MX")).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading unit measures");
            Snackbar.Add(L["Error loading unit measures"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private async Task LoadProduct()
    {
        try
        {
            _product = await ProductService.GetProductByIdAsync(ProductId!.Value);
            if (_product != null)
            {
                _model = new CreateProductDto
                {
                    Code = _product.Code,
                    Name = _product.Name,
                    Description = _product.Description,
                    Brand = _product.Brand,
                    UnitMeasureId = _product.UnitMeasureId,
                    Cost = _product.Cost,
                    Price = _product.Price,
                    IsTaxable = _product.IsTaxable,
                    IsActive = _product.IsActive,
                    MexicoProductServiceId = _product.MexicoProductServiceId,
                    Content = _product.Content,
                    IsPartialSaleAllowed = _product.IsPartialSaleAllowed,
                    AllowCustomPricing = _product.AllowCustomPricing,
                    Barcode = _product.Barcode
                };

                // Set the selected SAT product if it exists
                if (_product.MexicoProductServiceId.HasValue)
                {
                    _selectedProductService = new MexicoProductServiceDto
                    {
                        Id = _product.MexicoProductServiceId.Value,
                        Code = _product.MexicoProductServiceCode!,
                        Description = _product.MexicoProductServiceDescription!
                    };
                }


                // Load image if exists
                var images = await ProductService.GetProductImagesAsync(ProductId.Value);
                var primaryImage = images.FirstOrDefault(x => x.IsPrimary);
                if (primaryImage != null)
                {
                    _currentImage = $"/api/ProductImage/{_product.Id}/primary";
                }

                // Load surcharge configs if partial sale is allowed
                if (_product.IsPartialSaleAllowed)
                {
                    await LoadSurchargeConfigs();
                }

                // Reload wholesale price configs with existing product data
                await LoadWholesalePriceConfigs();

            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading product {ProductId}", ProductId);
            Snackbar.Add(L["Error loading product"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > ImageOptions.Value.MaxFileSize)
            {
                Snackbar.Add(L["File exceeds maximum size"], Severity.Warning);
                return;
            }

            if (!ImageOptions.Value.AllowedTypes.Contains(file.ContentType))
            {
                Snackbar.Add(L["File type not allowed"], Severity.Warning);
                return;
            }

            // Create a copy of the stream
            _imageStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: ImageOptions.Value.MaxFileSize)
                .CopyToAsync(_imageStream);
            _imageStream.Position = 0;

            // Show preview
            var imageStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: ImageOptions.Value.MaxFileSize)
                .CopyToAsync(imageStream);
            imageStream.Position = 0;

            _selectedFile = file;
            _currentImage = $"data:{file.ContentType};base64,{Convert.ToBase64String(imageStream.ToArray())}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error selecting file");
            Snackbar.Add(L["Error selecting file"], Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private string ValidateUnitMeasure(int id)
    {
        if (id == 0)
            return L["Unit measure is required"];
        return string.Empty;
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                // Final validation before saving
                var isCodeUnique = await ProductService.ValidateUniqueCodeAsync(_model.Code, ProductId);
                var isBarcodeUnique = true;
                
                if (!string.IsNullOrEmpty(_model.Barcode))
                {
                    isBarcodeUnique = await ProductService.ValidateUniqueBarcodeAsync(_model.Barcode, ProductId);
                }

                if (!isCodeUnique)
                {
                    Snackbar.Add(L["Product code already exists"], Severity.Warning);
                    return;
                }

                if (!isBarcodeUnique)
                {
                    Snackbar.Add(L["Product barcode already exists"], Severity.Warning);
                    return;
                }

                if (ProductId.HasValue)
                {
                    var updateDto = new UpdateProductDto
                    {
                        Code = _model.Code,
                        Barcode = _model.Barcode,
                        Name = _model.Name,
                        Description = _model.Description,
                        Brand = _model.Brand,
                        UnitMeasureId = _model.UnitMeasureId,
                        Cost = _model.Cost,
                        Price = _model.Price,
                        IsTaxable = _model.IsTaxable,
                        IsActive = _model.IsActive,
                        MexicoProductServiceId = _model.MexicoProductServiceId,
                        Content = _model.Content,
                        IsPartialSaleAllowed = _model.IsPartialSaleAllowed,
                        AllowCustomPricing = _model.AllowCustomPricing
                    };

                    var updatedProduct = await ProductService.UpdateProductAsync(ProductId.Value, updateDto);

                    // Update image if a new one was selected
                    if (_imageStream != null && _selectedFile != null)
                    {
                        _imageStream.Position = 0;
                        await ProductService.AddProductImageAsync(
                            updatedProduct.Id,
                            _imageStream,
                            _selectedFile.Name,
                            _selectedFile.ContentType,
                            true);
                    }

                    // Save partial sale surcharges
                    await SaveSurcharges(updatedProduct.Id);

                    // Save wholesale prices
                    await SaveWholesalePrices(updatedProduct.Id);

                    Snackbar.Add(L["Product updated successfully"], Severity.Success);
                }
                else
                {
                    var newProduct = await ProductService.CreateProductAsync(_model);

                    // Add image if one was selected
                    if (_imageStream != null && _selectedFile != null)
                    {
                        _imageStream.Position = 0;
                        await ProductService.AddProductImageAsync(
                            newProduct.Id,
                            _imageStream,
                            _selectedFile.Name,
                            _selectedFile.ContentType,
                            true);
                    }

                    // Save partial sale surcharges
                    await SaveSurcharges(newProduct.Id);

                    // Save wholesale prices
                    await SaveWholesalePrices(newProduct.Id);

                    Snackbar.Add(L["Product created successfully"], Severity.Success);
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving product");
                Snackbar.Add(L["Error saving product"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }

    private async Task ValidateCode(string code)
    {
        if (string.IsNullOrEmpty(code))
            return;

        try
        {
            var isUnique = await ProductService.ValidateUniqueCodeAsync(code, ProductId);
            _codeError = !isUnique;
            _isValid = isUnique && !_barcodeError;
            
            if (_codeError)
            {
                Snackbar.Add(L["Product code already exists"], Severity.Warning);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating product code");
            Snackbar.Add(L["Error validating product code"], Severity.Error);
        }
    }

    private async Task ValidateBarcode(string barcode)
    {
        if (string.IsNullOrEmpty(barcode))
        {
            _barcodeError = false;
            _isValid = !_codeError;
            StateHasChanged();
            return;
        }

        try
        {
            var isUnique = await ProductService.ValidateUniqueBarcodeAsync(barcode, ProductId);
            _barcodeError = !isUnique;
            _isValid = isUnique && !_codeError;
            
            if (_barcodeError)
            {
                Snackbar.Add(L["Product barcode already exists"], Severity.Warning);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating product barcode");
            Snackbar.Add(L["Error validating product barcode"], Severity.Error);
        }
    }

    private async Task<IEnumerable<MexicoProductServiceDto>> SearchProductServices(string value, CancellationToken cancellationToken)
    {
        // If no search text, return initial list
        if (string.IsNullOrWhiteSpace(value))
            return _initialProductServices;

        // If text is less than 1 character and not empty, return empty list
        if (value.Length < 1)
            return Array.Empty<MexicoProductServiceDto>();

        StateHasChanged();

        try
        {
            var (_, items) = await MexicoFiscalCatalogService
                .SearchProductServicesAsync(value, 1, PageSize);

            return items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching SAT product services");
            Snackbar.Add(L["Error searching SAT product services"], Severity.Error);
            return Array.Empty<MexicoProductServiceDto>();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void OnProductServiceSelected(MexicoProductServiceDto? value)
    {
        _selectedProductService = value;
        _model.MexicoProductServiceId = value?.Id;
    }

    private string GetSelectedUnitMeasureName()
    {
        if (_model.UnitMeasureId > 0)
        {
            var unitMeasure = _unitMeasures.FirstOrDefault(u => u.Id == _model.UnitMeasureId);
            return unitMeasure?.Name ?? "";
        }
        return "";
    }

    private async Task OnPartialSaleAllowedChanged(bool value)
    {
        _model.IsPartialSaleAllowed = value;

        if (value && _surchargeConfigs.Count == 0)
        {
            await LoadSurchargeConfigs();
        }
    }

    private async Task LoadSurchargeConfigs()
    {
        _loadingSurcharges = true;
        StateHasChanged();

        try
        {
            // Load available fractions
            var fractionsResult = await PartialSaleFractionService.GetActiveFractionsAsync();
            if (!fractionsResult.IsSuccess)
            {
                Snackbar.Add(L["Error loading fractions"], Severity.Error);
                return;
            }

            _availableFractions = fractionsResult.Value?.ToList() ?? new List<PartialSaleFractionDto>();

            // Load existing surcharges for this product (if editing)
            IList<ProductPartialSurchargeDto> existingSurcharges = new List<ProductPartialSurchargeDto>();
            if (ProductId.HasValue)
            {
                var surchargesResult = await ProductPartialSurchargeService.GetSurchargesForProductAsync(ProductId.Value);
                if (surchargesResult.IsSuccess)
                {
                    existingSurcharges = surchargesResult.Value ?? new List<ProductPartialSurchargeDto>();
                }
            }

            // Build config list combining fractions with existing surcharges
            _surchargeConfigs = _availableFractions.Select(f =>
            {
                var existing = existingSurcharges.FirstOrDefault(s => s.PartialSaleFractionId == f.Id);
                return new SurchargeConfigModel
                {
                    PartialSaleFractionId = f.Id,
                    FractionCode = f.Code,
                    FractionName = f.Name,
                    SurchargePercentage = existing?.SurchargePercentage ?? 0,
                    IsActive = existing?.IsActive ?? true
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading surcharge configurations");
            Snackbar.Add(L["Error loading surcharge configurations"], Severity.Error);
        }
        finally
        {
            _loadingSurcharges = false;
            StateHasChanged();
        }
    }

    private async Task SaveSurcharges(long productId)
    {
        if (!_model.IsPartialSaleAllowed || _surchargeConfigs.Count == 0)
            return;

        try
        {
            var dto = new UpdateProductPartialSurchargesDto
            {
                ProductId = productId,
                Surcharges = _surchargeConfigs.Select(c => new CreateProductPartialSurchargeDto
                {
                    PartialSaleFractionId = c.PartialSaleFractionId,
                    SurchargePercentage = c.SurchargePercentage,
                    IsActive = c.IsActive
                }).ToList()
            };

            var result = await ProductPartialSurchargeService.UpdateProductSurchargesAsync(dto);
            if (!result.IsSuccess)
            {
                Logger.LogWarning("Failed to save surcharges: {Error}", result.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving surcharges for product {ProductId}", productId);
        }
    }

    private async Task LoadWholesalePriceConfigs()
    {
        _loadingWholesalePrices = true;
        StateHasChanged();

        try
        {
            // Load available tiers
            var tiersResult = await WholesaleTierService.GetActiveTiersAsync();
            if (!tiersResult.IsSuccess)
            {
                Snackbar.Add(L["Error loading wholesale tiers"], Severity.Error);
                return;
            }

            _availableTiers = tiersResult.Value?.ToList() ?? new List<WholesaleTierDto>();

            // Load existing wholesale prices for this product (if editing)
            IList<ProductWholesalePriceDto> existingPrices = new List<ProductWholesalePriceDto>();
            if (ProductId.HasValue)
            {
                var pricesResult = await ProductWholesalePriceService.GetWholesalePricesForProductAsync(ProductId.Value);
                if (pricesResult.IsSuccess)
                {
                    existingPrices = pricesResult.Value ?? new List<ProductWholesalePriceDto>();
                }
            }

            // Build config list combining tiers with existing prices
            _wholesalePriceConfigs = _availableTiers.Select(t =>
            {
                var existing = existingPrices.FirstOrDefault(p => p.WholesaleTierId == t.Id);
                return new WholesalePriceConfigModel
                {
                    WholesaleTierId = t.Id,
                    TierName = t.Name,
                    MinQuantity = existing?.MinQuantity ?? 0,
                    DiscountPercentage = existing?.DiscountPercentage ?? 0,
                    IsActive = existing?.IsActive ?? true
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading wholesale price configurations");
        }
        finally
        {
            _loadingWholesalePrices = false;
            StateHasChanged();
        }
    }

    private async Task SaveWholesalePrices(long productId)
    {
        if (_wholesalePriceConfigs.Count == 0)
            return;

        // Only save configs that have meaningful data (discount > 0 and minQuantity > 0)
        var validConfigs = _wholesalePriceConfigs
            .Where(c => c.DiscountPercentage > 0 && c.MinQuantity > 0)
            .ToList();

        if (validConfigs.Count == 0)
            return;

        try
        {
            var dto = new UpdateProductWholesalePricesDto
            {
                ProductId = productId,
                WholesalePrices = validConfigs.Select(c => new CreateProductWholesalePriceDto
                {
                    WholesaleTierId = c.WholesaleTierId,
                    MinQuantity = c.MinQuantity,
                    DiscountPercentage = c.DiscountPercentage,
                    IsActive = c.IsActive
                }).ToList()
            };

            var result = await ProductWholesalePriceService.UpdateProductWholesalePricesAsync(dto);
            if (!result.IsSuccess)
            {
                Logger.LogWarning("Failed to save wholesale prices: {Error}", result.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving wholesale prices for product {ProductId}", productId);
        }
    }

    public void Dispose()
    {
        _imageStream?.Dispose();
    }
