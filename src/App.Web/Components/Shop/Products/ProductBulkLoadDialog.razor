@using CsvHelper
@using CsvHelper.TypeConversion
@using App.Core.Common
@using App.Core.DTOs.Product
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Core.Interfaces.Shop
@using App.Services.Mappings
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using OfficeOpenXml
@using System.Text

@inject IStringLocalizer<ProductBulkLoadDialog> L
@inject IProductService ProductService
@inject IExcelProcessingService ExcelProcessingService
@inject ITemplateService TemplateService
@inject ISnackbar Snackbar
@inject ILogger<ProductBulkLoadDialog> Logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageProducts">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 900px;" Class="pa-4">
                    <MudGrid>
                        <!-- Instructions -->
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Class="mb-4">
                                <MudText>@L["Follow these steps to import products:"]</MudText>
                                <MudList T="string" Dense="true" Class="mt-2">
                                    <MudListItem>@L["1. Download the Excel template file"]</MudListItem>
                                    <MudListItem>@L["2. Fill in your product data following the format"]</MudListItem>
                                    <MudListItem>@L["3. Upload the completed Excel file"]</MudListItem>
                                    <MudListItem>@L["4. Review results and fix any errors"]</MudListItem>
                                </MudList>
                            </MudAlert>
                        </MudItem>

                        <!-- Template Download -->
                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudGrid>
                                    <MudItem xs="12" sm="8">
                                        <MudText Typo="Typo.h6">@L["Step 1: Download Template"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            @L["Download the Excel template with the correct format and example data"]
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4" Class="d-flex justify-end">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Download"
                                                   Href="/api/templates/product"
                                                   Target="_blank"
                                                   Class="da-button-rounded">
                                            @L["Download Template"]
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <!-- File Upload -->
                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudGrid>
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.h6">@L["Step 2: Upload XLSX File"]</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                            @L["Select your completed Excel file to import products"]
                                        </MudText>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <InputFile id="fileInput" OnChange="OnFileSelected" 
                                                   accept="@AllowedFileTypes" MaxFileSize="@MaxFileSize" hidden />
                                        <div class="d-flex flex-column gap-4">
                                            <MudButton HtmlTag="label" 
                                                       Variant="Variant.Filled" 
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.CloudUpload" 
                                                       for="fileInput" 
                                                       Size="Size.Large"
                                                       Class="da-button-rounded"
                                                       FullWidth="true">
                                                @L["Select XLSX File"]
                                            </MudButton>

                                            <MudText Typo="Typo.caption" Align="Align.Center">
                                                @L["Supported formats: {0}. Max file size: {1}MB", AllowedFileTypes, MaxFileSize / (1024 * 1024)]                                
                                            </MudText>

                                            @if (_selectedFile != null)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Medium" Class="align-self-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-2" />
                                                    @_selectedFile.Name
                                                </MudChip>
                                            }
                                        </div>
                                    </MudItem>

                                    <MudItem xs="12" Class="d-flex justify-end">
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Error" 
                                                   OnClick="ImportProductsAsync"
                                                   Disabled="@(!CanImport())" 
                                                   Class="da-button-rounded">
                                            @if (_processing)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">@L["Processing"]</MudText>
                                            }
                                            else
                                            {
                                                @L["Import Products"]
                                            }
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <!-- Excel Processing Errors -->
                        @if (_excelErrors.Any())
                        {
                            <MudItem xs="12">
                                <MudPaper Class="pa-4" Elevation="1">
                                    <MudExpansionPanels MultiExpansion="false" Elevation="0">
                                        <MudExpansionPanel>
                                            <TitleContent>
                                                <div class="d-flex align-items-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-3" />
                                                    <MudText Typo="Typo.h6">@L["Excel Format Errors"] (@_excelErrors.Count)</MudText>
                                                </div>
                                            </TitleContent>
                                            <ChildContent>
                                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                                    @L["The following rows have format errors and were not processed:"]
                                                </MudAlert>
                                                
                                                <MudTable Items="@_excelErrors" Dense="true" Hover="true" Class="mb-3">
                                                    <HeaderContent>
                                                        <MudTh>@L["Row"]</MudTh>
                                                        <MudTh>@L["Column"]</MudTh>
                                                        <MudTh>@L["Cell"]</MudTh>
                                                        <MudTh>@L["Error"]</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate Context="contextExcelErrors">
                                                        <MudTd DataLabel="Row">@contextExcelErrors.RowNumber</MudTd>
                                                        <MudTd DataLabel="Column">@contextExcelErrors.ColumnName</MudTd>
                                                        <MudTd DataLabel="Cell">@contextExcelErrors.CellReference</MudTd>
                                                        <MudTd DataLabel="Error">
                                                            <MudText Typo="Typo.body2" Color="Color.Error">@contextExcelErrors.ErrorMessage</MudText>
                                                        </MudTd>
                                                    </RowTemplate>
                                                </MudTable>
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                </MudPaper>
                            </MudItem>
                        }

                        <!-- Import Results -->
                        @if (_results.Any())
                        {
                            <MudItem xs="12">
                                <MudPaper Class="pa-4" Elevation="1">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.h6">@L["Import Results"]</MudText>
                                        </MudItem>

                                        <!-- Summary Cards -->
                                        <MudItem xs="12" Class="d-flex gap-4 mb-4">
                                            <MudPaper Elevation="0" Class="pa-3 flex-grow-1" Style="border-left: 4px solid var(--mud-palette-info);">
                                                <MudStack Row AlignItems="AlignItems.Center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Info" />
                                                    <div>
                                                        <MudText Typo="Typo.h6">@_results.Count</MudText>
                                                        <MudText Typo="Typo.body2">@L["Total Processed"]</MudText>
                                                    </div>
                                                </MudStack>
                                            </MudPaper>
                                            
                                            @if (_results.Count(x => x.Success) > 0)
                                            {
                                                <MudPaper Elevation="0" Class="pa-3 flex-grow-1" Style="border-left: 4px solid var(--mud-palette-success);">
                                                    <MudStack Row AlignItems="AlignItems.Center">
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                                        <div>
                                                            <MudText Typo="Typo.h6">@_results.Count(x => x.Success)</MudText>
                                                            <MudText Typo="Typo.body2">@L["Successful"]</MudText>
                                                        </div>
                                                    </MudStack>
                                                </MudPaper>
                                            }
                                            
                                            @if (_results.Count(x => !x.Success) > 0)
                                            {
                                                <MudPaper Elevation="0" Class="pa-3 flex-grow-1" Style="border-left: 4px solid var(--mud-palette-error);">
                                                    <MudStack Row AlignItems="AlignItems.Center">
                                                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" />
                                                        <div>
                                                            <MudText Typo="Typo.h6">@_results.Count(x => !x.Success)</MudText>
                                                            <MudText Typo="Typo.body2">@L["Failed"]</MudText>
                                                        </div>
                                                    </MudStack>
                                                </MudPaper>
                                            }
                                        </MudItem>

                                        <!-- Detailed Results Tables -->
                                        @if (_results.Any(r => !r.Success))
                                        {
                                            <MudItem xs="12">
                                                <MudExpansionPanels MultiExpansion="false" Elevation="0">
                                                    <MudExpansionPanel>
                                                        <TitleContent>
                                                            <div class="d-flex align-items-center">
                                                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Class="mr-3" />
                                                                <MudText Typo="Typo.h6">@L["Failed Products"] (@_results.Count(r => !r.Success))</MudText>
                                                            </div>
                                                        </TitleContent>
                                                        <ChildContent>
                                                            <MudAlert Severity="Severity.Error" Class="mb-3">
                                                                @L["The following products could not be imported. Please review and correct the errors:"]
                                                            </MudAlert>
                                                            
                                                            <MudTable Items="@_results.Where(r => !r.Success)" Dense="true" Hover="true" Class="mb-3">
                                                                <HeaderContent>
                                                                    <MudTh>@L["Product Code"]</MudTh>
                                                                    <MudTh>@L["Product Name"]</MudTh>
                                                                    <MudTh>@L["Brand"]</MudTh>
                                                                    <MudTh>@L["Price"]</MudTh>
                                                                    <MudTh>@L["Error"]</MudTh>
                                                                </HeaderContent>
                                                                <RowTemplate Context="contextProductError">
                                                                    <MudTd DataLabel="Code">
                                                                        <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(contextProductError.ProductCode) ? L["Auto-generated"] : contextProductError.ProductCode)</MudText>
                                                                    </MudTd>
                                                                    <MudTd DataLabel="Name">@contextProductError.ProductName</MudTd>
                                                                    <MudTd DataLabel="Brand">@contextProductError.Brand</MudTd>
                                                                    <MudTd DataLabel="Price">@contextProductError.Price.ToString("C")</MudTd>
                                                                    <MudTd DataLabel="Error">
                                                                        <MudTooltip Text="@contextProductError.Error">
                                                                            <MudText Typo="Typo.body2" Color="Color.Error" Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                                                @contextProductError.Error
                                                                            </MudText>
                                                                        </MudTooltip>
                                                                    </MudTd>
                                                                </RowTemplate>
                                                            </MudTable>
                                                        </ChildContent>
                                                    </MudExpansionPanel>
                                                </MudExpansionPanels>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel" 
                           Class="da-button-rounded">
                    @L["Close"]
                </MudButton>
                @if (_results.Any(r => r.Success))
                {
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled" 
                               OnClick="Complete"
                               Class="da-button-rounded">
                        @L["Complete"]
                    </MudButton>
                }
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to manage products"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;

    // File handling constants
    private const long MaxFileSize = 10 * 1024 * 1024; // 10MB
    private const string AllowedFileTypes = ".xlsx";

    // Component state
    private bool _processing;
    private IBrowserFile? _selectedFile;
    private List<ProductBulkLoadResultDto> _results = new();
    private List<ExcelError> _excelErrors = new();

    private bool CanImport()
    {
        return !_processing && _selectedFile != null;
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var allowedExtensions = AllowedFileTypes.Split(',').Select(x => x.Trim().ToLowerInvariant());
        var fileExtension = Path.GetExtension(file.Name).ToLowerInvariant();

        // Validate file extension
        if (!allowedExtensions.Contains(fileExtension))
        {
            Snackbar.Add(L["Only {0} files are allowed", AllowedFileTypes], Severity.Warning);
            return Task.CompletedTask;
        }

        // Validate file size
        if (file.Size > MaxFileSize)
        {
            Snackbar.Add(L["File size exceeds maximum allowed ({0}MB)", MaxFileSize / (1024 * 1024)], Severity.Warning);
            return Task.CompletedTask;
        }

        _selectedFile = file;
        _results.Clear(); // Clear previous results
        _excelErrors.Clear(); // Clear previous Excel errors
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ImportProductsAsync()
    {
        if (!CanImport()) return;
        
        const int bufferSize = 81920;
        using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
        
        try
        {
            _processing = true;
            _results.Clear();
            _excelErrors.Clear();
            StateHasChanged();
            
            // Read file into memory stream
            using var stream = new MemoryStream();
            await _selectedFile!.OpenReadStream(MaxFileSize).CopyToAsync(stream, bufferSize, cts.Token);
            stream.Position = 0;
            
            // Process Excel file using the dedicated service
            var excelProcessingResult = await ExcelProcessingService.ProcessProductExcelFileAsync(stream, cts.Token);
            
            if (!excelProcessingResult.IsSuccess)
            {
                Snackbar.Add(excelProcessingResult.Error!, Severity.Error);
                return;
            }
            
            var processingResult = excelProcessingResult.Value!;
            
            // Store Excel errors for display
            _excelErrors = processingResult.Errors;
            
            // Handle Excel processing errors
            if (processingResult.HasErrors)
            {
                DisplayExcelErrorsSummary(processingResult.Errors);
                
                // If no valid records to process, stop here
                if (processingResult.Request?.Items == null || !processingResult.Request.Items.Any())
                {
                    Snackbar.Add(L["No valid records found to import"], Severity.Warning);
                    StateHasChanged();
                    return;
                }
                
                Snackbar.Add(L["Processing {0} valid records despite errors", processingResult.Request.Items.Count], Severity.Info);
            }
            
            // Process valid records through ProductService
            if (processingResult.Request == null)
            {
                Snackbar.Add(L["No valid request data found"], Severity.Warning);
                return;
            }
            
            var serviceResult = await ProductService.CreateBulkProductsAsync(processingResult.Request, cts.Token);
            
            if (serviceResult.IsSuccess && serviceResult.Value != null)
            {
                _results = serviceResult.Value;
                DisplayImportResults();
            }
            else
            {
                Snackbar.Add(serviceResult.Error ?? L["Unknown error occurred"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importing products");
            Snackbar.Add(L["Error importing products: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Displays a summary of Excel processing errors in snackbar notifications
    /// </summary>
    private void DisplayExcelErrorsSummary(List<ExcelError> errors)
    {
        if (errors.Count <= 3)
        {
            // Show all errors if there are only a few
            foreach (var error in errors)
            {
                Snackbar.Add($"Row {error.RowNumber}: {error.ErrorMessage}", Severity.Warning);
            }
        }
        else
        {
            // Show summary for many errors
            Snackbar.Add(L["{0} Excel format errors found. Check the Excel Errors section for details.", errors.Count], Severity.Warning);
        }
    }

    /// <summary>
    /// Displays import results with appropriate messaging
    /// </summary>
    private void DisplayImportResults()
    {
        var successCount = _results.Count(r => r.Success);
        var failedCount = _results.Count(r => !r.Success);
        
        if (successCount > 0)
        {
            Snackbar.Add(L["{0} products imported successfully", successCount], Severity.Success);
        }
        
        if (failedCount > 0)
        {
            Snackbar.Add(L["{0} products failed to import. Check details below.", failedCount], Severity.Error);
        }
        
        if (_excelErrors.Count > 0)
        {
            Snackbar.Add(L["{0} records had Excel format errors", _excelErrors.Count], Severity.Warning);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Complete()
    {
        MudDialog.Close(DialogResult.Ok(_results.Count(r => r.Success)));
    }
}