@page "/shop/products/{Id:long}"
@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Product
@using App.Core.DTOs.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Shop
@using App.Core.Constants
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IProductService ProductService
@inject IInventoryQueryService InventoryQueryService
@inject IProductWholesalePriceService WholesalePriceService
@inject IProductPartialSurchargeService SurchargeService
@inject IStringLocalizer<ProductDetail> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<ProductDetail> Logger
@inject ICompanySettingsService SettingsService
@inject App.Core.Interfaces.Settings.IWholesaleSettingsService WholesaleSettingsService

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageProducts">
    <Authorized>
        <PageTitle>@L["Product Details"]</PageTitle>

        <MudContainer MaxWidth="MaxWidth.Large">
            @if (_loading)
            {
                <MudProgressCircular Color="Color.Default" Indeterminate="true" />
            }
            else if (_product == null)
            {
                <MudAlert Severity="Severity.Error">@L["Product not found"]</MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" Class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.h4">@_product.Name</MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined"
                                StartIcon="@Icons.Material.Filled.ArrowBack"
                                Class="da-button-rounded"
                                OnClick="@(() => Navigation.NavigateTo("/shop/products"))">
                            @L["Back to List"]
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4">
                            <MudGrid>
                                <!-- Imagen Principal -->
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="pa-2" Style="max-width: 400px;">
                                        <MudImage Src="@($"/api/ProductImage/{_product.Id}/primary")"
                                                Alt="@_product.Name"
                                                Elevation="0"
                                                Class="rounded-lg"
                                                ObjectFit="ObjectFit.Cover"
                                                Width="150"
                                                />
                                    </MudPaper>
                                </MudItem>

                                <!-- Información del Producto -->
                                <MudItem xs="12" md="8">
                                    <MudCard Elevation="0">
                                        <MudCardContent>
                                            <MudGrid>
                                                <!-- Código -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Code"]</MudText>
                                                    <MudText>@_product.Code</MudText>
                                                </MudItem>

                                                <!-- Código de Barras -->
                                                @if (!string.IsNullOrEmpty(_product.Barcode))
                                                {
                                                    <MudItem xs="12" sm="6">
                                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Barcode"]</MudText>
                                                        <MudText>@_product.Barcode</MudText>
                                                    </MudItem>
                                                }

                                                <!-- Marca -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Brand"]</MudText>
                                                    <MudText>@_product.Brand</MudText>
                                                </MudItem>

                                                <!-- Descripción -->
                                                <MudItem xs="12">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Description"]</MudText>
                                                    <MudText>@(_product.Description ?? "-")</MudText>
                                                </MudItem>

                                                <!-- Información SAT -->
                                                @if (_isMexico && _product.MexicoProductServiceId.HasValue)
                                                {
                                                    <MudItem xs="12">
                                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["SAT Product/Service Description"]</MudText>
                                                        <MudText>@_product.MexicoProductServiceCode / @_product.MexicoProductServiceDescription</MudText>
                                                    </MudItem>
                                                }

                                                <!-- Contenido / Unidad -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Content/Quantity"]</MudText>
                                                    <MudText>@_product.Content.ToString("N3") @_product.UnitMeasureName</MudText>
                                                </MudItem>

                                                <!-- Unidad de Medida -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Unit Measure"]</MudText>
                                                    <MudText>@_product.UnitMeasureName</MudText>
                                                </MudItem>

                                                <!-- Costo -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Cost"]</MudText>
                                                    <MudText>@_product.Cost.ToString("C")</MudText>
                                                </MudItem>

                                                <!-- Precio -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Price"]</MudText>
                                                    <MudText>@_product.Price.ToString("C")</MudText>
                                                </MudItem>

                                                <!-- Impuestos -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Tax"]</MudText>
                                                    <MudChip T="Color" Color="@(_product.IsTaxable ? Color.Success : Color.Default)" Size="Size.Small">
                                                        @(_product.IsTaxable ? L["Taxable"] : L["Non-Taxable"])
                                                    </MudChip>
                                                </MudItem>

                                                <!-- Ventas Parciales -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Partial Sales"]</MudText>
                                                    <MudChip T="bool" Size="Size.Small" Color="@(_product.IsPartialSaleAllowed ? Color.Success : Color.Default)">
                                                        @(_product.IsPartialSaleAllowed ? L["Allowed"] : L["Not Allowed"])
                                                    </MudChip>
                                                </MudItem>

                                                <!-- Incremento de Cantidad -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Quantity Step"]</MudText>
                                                    <MudText>@_product.QuantityStep</MudText>
                                                </MudItem>

                                                <!-- Etiquetado -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Labeling"]</MudText>
                                                    <MudChip T="bool" Size="Size.Small" Color="@(_product.IsLabelingAllowed ? Color.Success : Color.Default)">
                                                        @(_product.IsLabelingAllowed ? L["Allowed"] : L["Not Allowed"])
                                                    </MudChip>
                                                </MudItem>

                                                <!-- Precio Personalizado -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Custom Pricing"]</MudText>
                                                    <MudChip T="bool" Size="Size.Small" Color="@(_product.AllowCustomPricing ? Color.Success : Color.Default)">
                                                        @(_product.AllowCustomPricing ? L["Allowed"] : L["Not Allowed"])
                                                    </MudChip>
                                                </MudItem>

                                                <!-- Estado -->
                                                <MudItem xs="12" sm="6">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Status"]</MudText>
                                                    <MudChip T="Color" Color="@(_product.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                                                        @(_product.IsActive ? L["Active"] : L["Inactive"])
                                                    </MudChip>
                                                </MudItem>
                                            </MudGrid>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>

                                <!-- Precios de Mayoreo -->
                                <MudItem xs="12">
                                    <MudDivider Class="my-4" />
                                    <MudText Typo="Typo.h6" Class="mb-4">@L["Wholesale Prices"]</MudText>
                                    @if (_wholesalePrices.Count == 0)
                                    {
                                        <MudText Color="Color.Secondary">@L["No wholesale prices configured"]</MudText>
                                    }
                                    else
                                    {
                                        <MudTable Items="@_wholesalePrices" Dense="true" Hover="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>@L["Tier"]</MudTh>
                                                <MudTh>@L["Min. Quantity"]</MudTh>
                                                <MudTh>@L["Discount / Price"]</MudTh>
                                                <MudTh>@L["Status"]</MudTh>
                                            </HeaderContent>
                                            <RowTemplate Context="wp">
                                                <MudTd>@wp.TierName</MudTd>
                                                <MudTd>@wp.MinQuantity.ToString("N2")</MudTd>
                                                <MudTd>
                                                    @if (wp.FixedPrice is > 0)
                                                    {
                                                        @wp.FixedPrice.Value.ToString("C6")
                                                    }
                                                    else
                                                    {
                                                        @(wp.DiscountPercentage.ToString("0.######") + "%")
                                                    }
                                                </MudTd>
                                                <MudTd>
                                                    <MudChip T="bool" Size="Size.Small" Color="@(wp.IsActive ? Color.Success : Color.Default)">
                                                        @(wp.IsActive ? L["Active"] : L["Inactive"])
                                                    </MudChip>
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>

                                <!-- Recargos por Ventas Parciales -->
                                @if (_product.IsPartialSaleAllowed)
                                {
                                    <MudItem xs="12">
                                        <MudDivider Class="my-4" />
                                        <MudText Typo="Typo.h6" Class="mb-4">@L["Partial Sale Surcharges"]</MudText>
                                        @if (_surcharges.Count == 0)
                                        {
                                            <MudText Color="Color.Secondary">@L["No surcharges configured"]</MudText>
                                        }
                                        else
                                        {
                                            <MudTable Items="@_surcharges" Dense="true" Hover="true" Elevation="0">
                                                <HeaderContent>
                                                    <MudTh>@L["Fraction"]</MudTh>
                                                    <MudTh>@L["Surcharge"]</MudTh>
                                                    <MudTh>@L["Status"]</MudTh>
                                                </HeaderContent>
                                                <RowTemplate Context="ps">
                                                    <MudTd>@ps.FractionName (@ps.FractionCode)</MudTd>
                                                    <MudTd>@ps.SurchargePercentage.ToString("N2")%</MudTd>
                                                    <MudTd>
                                                        <MudChip T="bool" Size="Size.Small" Color="@(ps.IsActive ? Color.Success : Color.Default)">
                                                            @(ps.IsActive ? L["Active"] : L["Inactive"])
                                                        </MudChip>
                                                    </MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        }
                                    </MudItem>
                                }

                                <!-- Niveles de Stock -->
                                <MudItem xs="12">
                                    <MudDivider Class="my-4" />
                                    <MudText Typo="Typo.h6" Class="mb-4">@L["Stock Levels"]</MudText>
                                    @if (_stockLevels.Count == 0)
                                    {
                                        <MudText Color="Color.Secondary">@L["No inventory records found"]</MudText>
                                    }
                                    else
                                    {
                                        <MudTable Items="@_stockLevels" Dense="true" Hover="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>@L["Location"]</MudTh>
                                                <MudTh>@L["Stock"]</MudTh>
                                                <MudTh>@L["Min"]</MudTh>
                                                <MudTh>@L["Max"]</MudTh>
                                            </HeaderContent>
                                            <RowTemplate Context="sl">
                                                <MudTd>@sl.LocationName</MudTd>
                                                <MudTd>@sl.Quantity.ToString("0.##")</MudTd>
                                                <MudTd>@(sl.MinStock.HasValue ? sl.MinStock.Value.ToString("0.##") : "-")</MudTd>
                                                <MudTd>@(sl.MaxStock.HasValue ? sl.MaxStock.Value.ToString("0.##") : "-")</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>

                                <!-- Información de Auditoría -->
                                <MudItem xs="12">
                                    <MudDivider Class="my-4"/>
                                    <MudText Typo="Typo.h6" Class="mb-4">@L["Audit Information"]</MudText>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Created By"]</MudText>
                                            <MudText>@_product.CreatedBy</MudText>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Created At"]</MudText>
                                            <MudText>@FormatToCompanyTimezone(_product.CreatedAt)</MudText>
                                        </MudItem>

                                        @if (_product.ModifiedBy != null)
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Modified By"]</MudText>
                                                <MudText>@_product.ModifiedBy</MudText>
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">@L["Modified At"]</MudText>
                                                <MudText>@(_product.ModifiedAt.HasValue ? FormatToCompanyTimezone(_product.ModifiedAt.Value) : "-")</MudText>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>



@code {
    [Parameter] public long Id { get; set; }
    private ProductDto? _product;
    private IList<ProductWholesalePriceDto> _wholesalePrices = [];
    private IList<ProductPartialSurchargeDto> _surcharges = [];
    private List<ProductWarehouseStockDto> _stockLevels = [];
    private TimeZoneInfo? _companyTimeZone;
    private bool _loading = true;
    private bool _isMexico;
    private App.Core.Enums.Shop.WholesalePriceMode _wholesaleMode = App.Core.Enums.Shop.WholesalePriceMode.Percentage;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _isMexico = settings?.CountryCode == CountryCodes.Mexico;
        _companyTimeZone = await SettingsService.GetCurrentTimeZoneAsync();

        var wholesaleSettingsResult = await WholesaleSettingsService.GetSettingsAsync();
        if (wholesaleSettingsResult.IsSuccess && wholesaleSettingsResult.Value != null)
            _wholesaleMode = wholesaleSettingsResult.Value.PriceMode;

        await LoadProduct();
    }

    private async Task LoadProduct()
    {
        try
        {
            _product = await ProductService.GetProductByIdAsync(Id);

            if (_product != null)
            {
                var wholesaleResult = await WholesalePriceService.GetWholesalePricesForProductAsync(Id);
                if (wholesaleResult.IsSuccess)
                    _wholesalePrices = wholesaleResult.Value;

                var surchargeResult = await SurchargeService.GetSurchargesForProductAsync(Id);
                if (surchargeResult.IsSuccess)
                    _surcharges = surchargeResult.Value;

                var stock = await InventoryQueryService.GetProductStockAsync(Id);
                _stockLevels = stock?.LocationStock ?? [];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading product");
            Snackbar.Add(L["Error loading product"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            var convertedTime = TimeZoneInfo.ConvertTimeFromUtc(utcDate, _companyTimeZone);
            return convertedTime.ToString("g");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }
}
