@page "/shop/invoices/{Id:long}"
@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IMexicoInvoiceService InvoiceService
@inject ICompanySettingsService CompanySettingsService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<InvoiceDetailPage> L

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewInvoice)]

<PageTitle>@L["Invoice Detail"]</PageTitle>

@if (_loading)
{
    <div style="display:flex; justify-content:center; padding:60px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_invoice is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@L["Invoice not found"]</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">@L["Back"]</MudButton>
}
else
{
    @* Title row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="GoBack"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h5" Style="flex:1;">@_invoice.FolioDisplay</MudText>
        <MudChip T="string" Color="@GetStatusColor(_invoice.Status)" Size="Size.Small">
            @GetStatusText(_invoice.Status)
        </MudChip>
        @if (_invoice.HasXml)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Code"
                           Color="Color.Info"
                           title="@L["Download XML"]"
                           OnClick="DownloadXmlAsync" />
        }
        @if (_invoice.HasPdf)
        {
            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                           Color="Color.Default"
                           title="@L["View PDF"]"
                           OnClick="ViewPdfAsync" />
        }
    </MudStack>

    <MudGrid Spacing="3">

        @* Left column — Invoice + Cancellation info *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>@L["Invoice Information"]</strong></MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Folio"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.FolioDisplay</MudText>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_invoice.Uuid))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Style="color:#888;">UUID</MudText>
                            <MudText Typo="Typo.body2" Style="font-family:monospace; font-size:12px; word-break:break-all;">@_invoice.Uuid</MudText>
                        </MudItem>
                    }
                    @if (_invoice.StampDate.HasValue)
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color:#888;">@L["Stamp Date"]</MudText>
                            <MudText Typo="Typo.body2">@FormatDate(_invoice.StampDate.Value)</MudText>
                        </MudItem>
                    }
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Payment Form"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.PaymentForm</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["CFDI Use"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.CfdiUse</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Related Sale"]</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{_invoice.SaleId}"))">
                            #@_invoice.SaleId
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @* Cancellation section *@
                @if (_invoice.CancellationDate.HasValue || !string.IsNullOrEmpty(_invoice.CancellationReason))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">@L["Cancellation"]</MudText>
                    <MudGrid Spacing="2">
                        @if (_invoice.CancellationDate.HasValue)
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Cancellation Date"]</MudText>
                                <MudText Typo="Typo.body2">@FormatDate(_invoice.CancellationDate.Value)</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.CancellationReason))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["SAT Reason"]</MudText>
                                <MudText Typo="Typo.body2">@_invoice.CancellationReason — @GetSatReasonText(_invoice.CancellationReason)</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.CancellationNotes))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Observations"]</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_invoice.CancellationNotes</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>

        @* Right column — Customer + Issuer *@
        <MudItem xs="12" md="6">
            <MudStack Spacing="3">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>@L["Customer"]</strong></MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Style="color:#888;">@L["Legal Name"]</MudText>
                            <MudText Typo="Typo.body2"><strong>@_invoice.CustomerLegalName</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color:#888;">RFC</MudText>
                            <MudText Typo="Typo.body2" Style="font-family:monospace;">@_invoice.CustomerRfc</MudText>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(_invoice.CustomerFiscalRegime))
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Fiscal Regime"]</MudText>
                                <MudText Typo="Typo.body2">@_invoice.CustomerFiscalRegime</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.CustomerPostalCode))
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Postal Code"]</MudText>
                                <MudText Typo="Typo.body2">@_invoice.CustomerPostalCode</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>@L["Issuer"]</strong></MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Style="color:#888;">@L["Legal Name"]</MudText>
                            <MudText Typo="Typo.body2"><strong>@_invoice.IssuerLegalName</strong></MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color:#888;">RFC</MudText>
                            <MudText Typo="Typo.body2" Style="font-family:monospace;">@_invoice.IssuerRfc</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color:#888;">@L["Fiscal Regime"]</MudText>
                            <MudText Typo="Typo.body2">@_invoice.IssuerFiscalRegime</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudStack>
        </MudItem>

        @* Totals *@
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudStack Spacing="1" Style="min-width:260px;">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                            <MudText Typo="Typo.body2">@_invoice.Subtotal.ToString("C2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                            <MudText Typo="Typo.body2">@_invoice.TaxAmount.ToString("C2")</MudText>
                        </MudStack>
                        <MudDivider />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1"><strong>@L["Total"]:</strong></MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@_invoice.Total.ToString("C2")</strong></MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>
}

@code {
    [Parameter] public long Id { get; set; }

    private MexicoInvoiceDto? _invoice;
    private bool _loading = true;
    private TimeZoneInfo? _companyTimeZone;

    protected override async Task OnInitializedAsync()
    {
        _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
        _invoice = await InvoiceService.GetByIdAsync(Id);
        _loading = false;
    }

    private string FormatDate(DateTime utcDate)
    {
        if (_companyTimeZone is null) return utcDate.ToLocalTime().ToString("g");
        return TimeZoneInfo.ConvertTimeFromUtc(utcDate, _companyTimeZone).ToString("g");
    }

    private void GoBack() => Navigation.NavigateTo("/shop/invoices");

    private async Task DownloadXmlAsync()
    {
        var result = await InvoiceService.GetXmlAsync(Id);
        if (result.IsSuccess)
            await JS.InvokeVoidAsync("downloadFile", $"CFDI_{_invoice?.FolioDisplay}.xml", "application/xml", Convert.ToBase64String(result.Value!));
        else
            Snackbar.Add(result.Error, Severity.Error);
    }

    private async Task ViewPdfAsync()
    {
        var result = await InvoiceService.GetPdfAsync(Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error, Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync("openFileInNewTab", "application/pdf",
            Convert.ToBase64String(result.Value!));
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Stamped"             => Color.Success,
        "Draft"               => Color.Default,
        "StampError"          => Color.Error,
        "CancellationPending" => Color.Warning,
        "Cancelled"           => Color.Dark,
        _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "Stamped"             => L["Stamped"],
        "Draft"               => L["Draft"],
        "StampError"          => L["Stamp Error"],
        "CancellationPending" => L["Cancellation Pending"],
        "Cancelled"           => L["Cancelled"],
        _ => status
    };

    private string GetSatReasonText(string? code) => code switch
    {
        "01" => L["Con errores con relación"],
        "02" => L["Con errores sin relación"],
        "03" => L["No se llevó a cabo la operación"],
        "04" => L["Operación nominativa en factura global"],
        _ => code ?? ""
    };
}
