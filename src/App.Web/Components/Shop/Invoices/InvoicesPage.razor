@page "/shop/invoices"
@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using App.Shared.Services
@using App.Web.Services.Background
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IMexicoInvoiceService InvoiceService
@inject CancellationMonitorService CancellationMonitor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<InvoicesPage> L
@inject ILogger<InvoicesPage> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ICompanySettingsService CompanySettingsService
@inject IDateTime DateTimeService

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewInvoice)]

<PageTitle>@L["Invoices"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <MudItem xs="12" Class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4">@L["Invoices"]</MudText>
            <AuthorizeView Policy="@ApplicationClaims.Shop.CreateInvoice">
                <Authorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ReceiptLong"
                               OnClick="OpenPostSaleInvoiceDialog">
                        @L["Invoice Past Sale"]
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </MudItem>

        <!-- Cancellation monitor banner -->
        @if (_hasPendingCancellations)
        {
            <MudItem xs="12" Class="mb-2">
                <MudAlert Severity="Severity.Warning"
                          Icon="@Icons.Material.Filled.HourglassTop"
                          NoIcon="false"
                          Dense="true"
                          Class="d-flex align-center">
                    <div class="d-flex align-center justify-space-between" style="width:100%">
                        <div>
                            <MudText Typo="Typo.body2" Class="mb-0">
                                <b>@_pendingCancellationCount</b>
                                @(L["invoice(s) awaiting receiver acceptance from SAT"])
                            </MudText>
                            @if (CancellationMonitor.LastRunAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @L["Last check"]: @FormatRelativeTime(CancellationMonitor.LastRunAt.Value)
                                    @if (CancellationMonitor.LastRunUpdated > 0)
                                    {
                                        <span> · @CancellationMonitor.LastRunUpdated @L["updated"]</span>
                                    }
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @L["Not yet checked this session — background service checks every 2 hours"]
                                </MudText>
                            }
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="RefreshCancellationStatus"
                                   Disabled="@(_refreshingCancellations || CancellationMonitor.IsRunning)"
                                   Class="ml-4">
                            @if (_refreshingCancellations || CancellationMonitor.IsRunning)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @L["Verify with SAT"]
                        </MudButton>
                    </div>
                </MudAlert>
            </MudItem>
        }

        <!-- Filters -->
        <MudItem xs="12" Class="mb-3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string"
                                      Value="@_searchString"
                                      ValueChanged="@(s => OnSearch(s))"
                                      Placeholder="@L["Search by folio, RFC, or UUID"]"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      FullWidth />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker @bind-DateRange="_dateRange"
                                            Label="@L["Date Range"]"
                                            AutoClose="true"
                                            PickerClosed="OnDateRangeChanged" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string"
                                   Label="@L["Status"]"
                                   ValueChanged="@(s => OnStatusChanged(s))"
                                   AnchorOrigin="Origin.BottomCenter"
                                   FullWidth>
                            <MudSelectItem T="string" Value="@null">@L["All"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Stamped")">@L["Stamped"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Draft")">@L["Draft"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("StampError")">@L["Stamp Error"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Cancelled")">@L["Cancelled"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Table -->
        <MudItem xs="12">
            <MudTable T="MexicoInvoiceSummaryDto"
                      ServerData="@LoadServerData"
                      Dense="true"
                      Hover="true"
                      Loading="@_loading"
                      Striped="true"
                      @ref="_table">
                <HeaderContent>
                    <MudTh>@L["Folio"]</MudTh>
                    <MudTh>@L["Sale #"]</MudTh>
                    <MudTh>@L["Date"]</MudTh>
                    <MudTh>@L["Customer RFC"]</MudTh>
                    <MudTh>@L["Customer"]</MudTh>
                    <MudTh>@L["UUID"]</MudTh>
                    <MudTh Style="text-align: right;">@L["Total"]</MudTh>
                    <MudTh Style="max-width: 150px;">@L["Status"]</MudTh>
                    <MudTh Style="text-align: center; width: 200px;">@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Folio"]"><b>@context.FolioDisplay</b></MudTd>
                    <MudTd DataLabel="@L["Sale #"]">@context.SaleId</MudTd>
                    <MudTd DataLabel="@L["Date"]">
                        @FormatDate(context.RequestedInvoiceDate ?? context.StampDate ?? context.CreatedAt)
                        @if (context.RequestedInvoiceDate.HasValue && context.StampDate.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                @L["Stamped at"]: @FormatDate(context.StampDate.Value)
                            </MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Customer RFC"]">@context.CustomerRfc</MudTd>
                    <MudTd DataLabel="@L["Customer"]">@context.CustomerLegalName</MudTd>
                    <MudTd DataLabel="@L["UUID"]">
                        @if (!string.IsNullOrEmpty(context.Uuid))
                        {
                            <MudTooltip Text="@context.Uuid">
                                <MudText Typo="Typo.caption">@context.Uuid[..8]...</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Total"]" Style="text-align: right;">@context.Total.ToString("C")</MudTd>
                    <MudTd DataLabel="@L["Status"]">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @GetStatusText(context.Status)
                        </MudChip>
                        @if (context.Status == "StampError" && !string.IsNullOrEmpty(context.StampError))
                        {
                            <MudTooltip Text="@context.StampError">
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block" Style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:help;">
                                    @context.StampError
                                </MudText>
                            </MudTooltip>
                        }
                        @if (context.CancellationDate.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                @FormatDate(context.CancellationDate.Value)
                            </MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <div class="d-flex justify-center align-center gap-2">
                            <!-- View detail -->
                            <MudTooltip Text="@L["View Detail"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => Navigation.NavigateTo($"/shop/invoices/{context.Id}"))" />
                            </MudTooltip>

                            <!-- View sale -->
                            <MudTooltip Text="@L["View Sale"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{context.SaleId}"))" />
                            </MudTooltip>

                            <!-- Download XML (available for stamped and error invoices) -->
                            @if (context.HasXml)
                            {
                                <XmlIconButton Title="@L["Download XML"]"
                                               Color="@(context.IsStamped ? Color.Info : Color.Warning)"
                                               OnClick="@(() => DownloadXml(context))" />
                            }

                            <!-- View PDF in new tab -->
                            @if (context.HasPdf)
                            {
                                <MudTooltip Text="@L["View PDF"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="@(() => ViewPdf(context.Id))" />
                                </MudTooltip>
                            }

                            <!-- Download PDF -->
                            @if (context.HasPdf)
                            {
                                <MudTooltip Text="@L["Download PDF"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                   Size="Size.Small"
                                                   Color="Color.Secondary"
                                                   OnClick="@(() => DownloadPdf(context.Id))" />
                                </MudTooltip>
                            }
                            else if (context.IsStamped)
                            {
                                <MudTooltip Text="@L["Generate PDF"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                                   Size="Size.Small"
                                                   Color="Color.Warning"
                                                   Disabled="_regeneratingPdf"
                                                   OnClick="@(() => RegeneratePdf(context))" />
                                </MudTooltip>
                            }

                            <!-- Send by email (only for stamped invoices with PDF) -->
                            @if (context.IsStamped && context.HasPdf)
                            {
                                <MudTooltip Text="@L["Send by Email"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Email"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   OnClick="@(() => OpenSendEmailDialog(context))" />
                                </MudTooltip>
                            }

                            <!-- Download Acuse (available when cancellation has been processed) -->
                            @if (context.HasCancellationAcuse)
                            {
                                <MudTooltip Text="@L["Download Cancellation Acuse"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                                                   Size="Size.Small"
                                                   Color="Color.Warning"
                                                   OnClick="@(() => DownloadAcuse(context))" />
                                </MudTooltip>
                            }

                            <!-- Retry stamp (only for error invoices) -->
                            @if (context.Status == "StampError")
                            {
                                <AuthorizeView Policy="@ApplicationClaims.Shop.CreateInvoice" Context="retryAuth">
                                    <Authorized Context="retryCtx">
                                        <MudTooltip Text="@L["Retry Stamp"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                           Size="Size.Small"
                                                           Color="Color.Warning"
                                                           Disabled="_retryingStamp"
                                                           OnClick="@(() => RetryStamp(context))" />
                                        </MudTooltip>
                                    </Authorized>
                                </AuthorizeView>
                            }

                            <!-- Cancel (only fully stamped) -->
                            @if (context.Status == "Stamped" && string.IsNullOrEmpty(context.CancellationStatus))
                            {
                                <AuthorizeView Policy="@ApplicationClaims.Shop.CancelInvoice" Context="cancelAuth">
                                    <Authorized Context="cancelCtx">
                                        <MudTooltip Text="@L["Cancel Invoice"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => OpenCancelDialog(context))" />
                                        </MudTooltip>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
                <NoRecordsContent>
                    <MudText>@L["No invoices found"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- Cancel Invoice Dialog -->
<MudDialog @bind-Visible="_cancelDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Cancel Invoice"] @_invoiceToCancel?.FolioDisplay</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @L["This action will send a cancellation request to SAT. The invoice will be cancelled or pending acceptance depending on the reason."]
        </MudAlert>

        <MudSelect T="string" @bind-Value="_cancelReason" Label="@L["Cancellation Reason"]" Variant="Variant.Outlined" Class="mb-3" FullWidth>
            <MudSelectItem T="string" Value="@("01")">01 - @L["Comprobante emitido con errores con relación"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("02")">02 - @L["Comprobante emitido con errores sin relación"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("03")">03 - @L["No se llevó a cabo la operación"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("04")">04 - @L["Operación nominativa relacionada en una factura global"]</MudSelectItem>
        </MudSelect>

        @if (_cancelReason == "01")
        {
            @if (_siblingStampedInvoices.Count > 0)
            {
                <MudSelect T="string" @bind-Value="_cancelReplacementUuid"
                           Label="@L["Replacement Invoice UUID"]"
                           Variant="Variant.Outlined"
                           FullWidth
                           Class="mb-2">
                    @foreach (var sibling in _siblingStampedInvoices)
                    {
                        <MudSelectItem T="string" Value="@sibling.Uuid">@sibling.FolioDisplay - @sibling.Uuid</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_cancelReplacementUuid"
                              Label="@L["Replacement Invoice UUID"]"
                              Variant="Variant.Outlined"
                              Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                              FullWidth />
            }
        }

        <MudTextField @bind-Value="_cancelNotes"
                      Label="@L["Observations"]"
                      Variant="Variant.Outlined"
                      Lines="2"
                      FullWidth
                      Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _cancelDialogOpen = false)" Disabled="_cancelProcessing">@L["Keep"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ExecuteCancel"
                   Disabled="@(_cancelProcessing || (_cancelReason == "01" && string.IsNullOrWhiteSpace(_cancelReplacementUuid)))">
            @if (_cancelProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["Cancel Invoice"]
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gap-2 > * + * { margin-left: 8px; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "saleId")]
    public long? SaleIdFilter { get; set; }

    private MudTable<MexicoInvoiceSummaryDto> _table = null!;
    private bool _loading;
    private string _searchString = "";
    private DateRange _dateRange = new();
    private string? _selectedStatus;
    private bool _hasPendingCancellations;
    private int _pendingCancellationCount;
    private bool _refreshingCancellations;
    private TimeZoneInfo? _companyTimeZone;

    protected override async Task OnInitializedAsync()
    {
        _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();

        if (SaleIdFilter.HasValue)
        {
            _searchString = SaleIdFilter.Value.ToString();
            _dateRange = new DateRange(null, null);
        }
        else
        {
            var today = DateTime.Today;
            _dateRange = new DateRange(new DateTime(today.Year, today.Month, 1), today);
        }
    }

    private async Task<TableData<MexicoInvoiceSummaryDto>> LoadServerData(TableState state, CancellationToken _)
    {
        try
        {
            _loading = true;
            var (total, items) = await InvoiceService.GetHistoryAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                startDate: ToUtc(_dateRange.Start),
                endDate: ToUtc(_dateRange.End),
                status: _selectedStatus);

            _pendingCancellationCount = items.Count(i => i.Status == "CancellationPending");
            _hasPendingCancellations = _pendingCancellationCount > 0;
            return new TableData<MexicoInvoiceSummaryDto> { TotalItems = total, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoices");
            Snackbar.Add(L["Error loading invoices"], Severity.Error);
            return new TableData<MexicoInvoiceSummaryDto> { TotalItems = 0, Items = [] };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshCancellationStatus()
    {
        _refreshingCancellations = true;
        try
        {
            await CancellationMonitor.TriggerAsync();
            Snackbar.Add(L["Cancellation status refreshed"], Severity.Success);
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing cancellation status");
            Snackbar.Add(L["Error refreshing cancellation status"], Severity.Error);
        }
        finally
        {
            _refreshingCancellations = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OnDateRangeChanged()
    {
        await _table.ReloadServerData();
    }

    private async Task OnStatusChanged(string? value)
    {
        _selectedStatus = value;
        await _table.ReloadServerData();
    }

    private async Task DownloadXml(MexicoInvoiceSummaryDto invoice)
    {
        var result = await InvoiceService.GetXmlAsync(invoice.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            return;
        }
        var fileName = $"{invoice.FolioDisplay}{(invoice.IsStamped ? $"_{invoice.Uuid?[..8]}" : "_error")}.xml";
        await JS.InvokeVoidAsync("downloadFile", fileName, "application/xml",
            Convert.ToBase64String(result.Value!));
    }

    private async Task ViewPdf(long invoiceId)
    {
        var result = await InvoiceService.GetPdfAsync(invoiceId);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync("openFileInNewTab", "application/pdf",
            Convert.ToBase64String(result.Value!));
    }

    private async Task DownloadPdf(long invoiceId)
    {
        var result = await InvoiceService.GetPdfAsync(invoiceId);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync("downloadFile", $"factura_{invoiceId}.pdf", "application/pdf",
            Convert.ToBase64String(result.Value!));
    }

    private bool _regeneratingPdf;

    private async Task RegeneratePdf(MexicoInvoiceSummaryDto invoice)
    {
        _regeneratingPdf = true;
        try
        {
            var result = await InvoiceService.RegeneratePdfAsync(invoice.Id);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["PDF generated successfully"], Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error regenerating PDF for invoice {InvoiceId}", invoice.Id);
            Snackbar.Add(L["Error generating PDF"], Severity.Error);
        }
        finally
        {
            _regeneratingPdf = false;
        }
    }

    private bool _retryingStamp;

    private async Task RetryStamp(MexicoInvoiceSummaryDto invoice)
    {
        _retryingStamp = true;
        try
        {
            var result = await InvoiceService.RetryStampAsync(invoice.Id);
            if (result.IsSuccess && result.Value?.Status == "Stamped")
            {
                Snackbar.Add(L["Invoice stamped successfully"], Severity.Success);
            }
            else if (result.IsSuccess && result.Value?.Status == "StampError")
            {
                Snackbar.Add($"{L["Stamp error"]}: {result.Value.StampError}", Severity.Error);
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            }
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error retrying stamp for invoice {InvoiceId}", invoice.Id);
            Snackbar.Add(L["Error retrying stamp"], Severity.Error);
        }
        finally
        {
            _retryingStamp = false;
        }
    }

    private string _cancelReason = "02";
    private string? _cancelReplacementUuid;
    private string? _cancelNotes;
    private MexicoInvoiceSummaryDto? _invoiceToCancel;
    private IList<MexicoInvoiceSummaryDto> _siblingStampedInvoices = [];
    private bool _cancelDialogOpen;
    private bool _cancelProcessing;

    private async Task OpenCancelDialog(MexicoInvoiceSummaryDto invoice)
    {
        _invoiceToCancel = invoice;
        _cancelReason = "02";
        _cancelReplacementUuid = null;
        _cancelNotes = null;
        _siblingStampedInvoices = [];

        // Load sibling stamped invoices for the same sale (for reason 01 auto-fill)
        try
        {
            var allForSale = await InvoiceService.GetAllBySaleIdAsync(invoice.SaleId);
            _siblingStampedInvoices = allForSale
                .Where(i => i.Id != invoice.Id && i.Status == "Stamped" && !string.IsNullOrEmpty(i.Uuid))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sibling invoices for sale {SaleId}", invoice.SaleId);
        }

        _cancelDialogOpen = true;
    }


    private async Task ExecuteCancel()
    {
        if (_invoiceToCancel == null) return;
        _cancelProcessing = true;
        var result = await InvoiceService.CancelAsync(_invoiceToCancel.Id, _cancelReason, _cancelReplacementUuid, _cancelNotes);
        _cancelProcessing = false;
        _cancelDialogOpen = false;
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cancellation sent to SAT"], Severity.Success);
            await _table.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
        }
    }

    private async Task OpenPostSaleInvoiceDialog()
    {
        var dialog = await DialogService.ShowAsync<PostSaleInvoiceDialog>(
            L["Invoice Past Sale"],
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _table.ReloadServerData();
    }

    private async Task DownloadAcuse(MexicoInvoiceSummaryDto invoice)
    {
        var result = await InvoiceService.GetCancellationAcuseAsync(invoice.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error ?? L["Error"], Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync("downloadFile",
            $"Acuse_Cancelacion_{invoice.FolioDisplay}.xml", "application/xml",
            Convert.ToBase64String(result.Value!));
    }

    private async Task OpenSendEmailDialog(MexicoInvoiceSummaryDto invoice)
    {
        var parameters = new DialogParameters<SendInvoiceDialog>
        {
            { x => x.InvoiceId, invoice.Id },
            { x => x.CustomerEmail, invoice.CustomerEmail }
        };

        await DialogService.ShowAsync<SendInvoiceDialog>(
            L["Send Invoice by Email"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Stamped" => Color.Success,
        "Draft" => Color.Default,
        "StampError" => Color.Error,
        "CancellationPending" => Color.Warning,
        "Cancelled" => Color.Dark,
        _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "Stamped" => L["Stamped"],
        "Draft" => L["Draft"],
        "StampError" => L["Error"],
        "CancellationPending" => L["Cancelling"],
        "Cancelled" => L["Cancelled"],
        _ => status
    };

    private string GetSatCancellationReasonText(string? code) => code switch
    {
        "01" => L["Con errores con relación"],
        "02" => L["Con errores sin relación"],
        "03" => L["No se llevó a cabo la operación"],
        "04" => L["Operación nominativa en factura global"],
        _ => code ?? ""
    };

    private DateTime? ToUtc(DateTime? localDate)
    {
        if (localDate is null || _companyTimeZone is null)
            return localDate;
        return DateTimeService.ToUtc(
            DateTime.SpecifyKind(localDate.Value, DateTimeKind.Unspecified),
            _companyTimeZone);
    }

    private string FormatDate(DateTime utcDate)
    {
        if (_companyTimeZone is null)
            return utcDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
        return DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
    }

    private string FormatRelativeTime(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;
        if (elapsed.TotalMinutes < 1)
            return L["just now"];
        if (elapsed.TotalMinutes < 60)
            return $"{(int)elapsed.TotalMinutes} {L["min ago"]}";
        if (elapsed.TotalHours < 24)
            return $"{(int)elapsed.TotalHours} {L["h ago"]}";
        return utcTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }
}
