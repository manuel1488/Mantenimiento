@page "/shop/invoices"
@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces.Billing
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IMexicoInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<InvoicesPage> L
@inject ILogger<InvoicesPage> Logger
@inject NavigationManager Navigation
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewInvoice)]

<PageTitle>@L["Invoices"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <MudItem xs="12" Class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h4">@L["Invoices"]</MudText>
        </MudItem>

        <!-- Filters -->
        <MudItem xs="12" Class="mb-3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string"
                                      ValueChanged="@(s => OnSearch(s))"
                                      Placeholder="@L["Search by folio, RFC, or UUID"]"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      FullWidth />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker @bind-DateRange="_dateRange"
                                            Label="@L["Date Range"]"
                                            AutoClose="true"
                                            PickerClosed="OnDateRangeChanged" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string"
                                   Label="@L["Status"]"
                                   ValueChanged="@(s => OnStatusChanged(s))"
                                   AnchorOrigin="Origin.BottomCenter"
                                   FullWidth>
                            <MudSelectItem T="string" Value="@null">@L["All"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Stamped")">@L["Stamped"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Draft")">@L["Draft"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("StampError")">@L["Stamp Error"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Cancelled")">@L["Cancelled"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Table -->
        <MudItem xs="12">
            <MudTable T="MexicoInvoiceSummaryDto"
                      ServerData="@LoadServerData"
                      Dense="true"
                      Hover="true"
                      Loading="@_loading"
                      Striped="true"
                      @ref="_table">
                <HeaderContent>
                    <MudTh>@L["Folio"]</MudTh>
                    <MudTh>@L["Sale #"]</MudTh>
                    <MudTh>@L["Date"]</MudTh>
                    <MudTh>@L["Customer RFC"]</MudTh>
                    <MudTh>@L["Customer"]</MudTh>
                    <MudTh>@L["UUID"]</MudTh>
                    <MudTh Style="text-align: right;">@L["Total"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh Style="text-align: center; width: 160px;">@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Folio"]"><b>@context.FolioDisplay</b></MudTd>
                    <MudTd DataLabel="@L["Sale #"]">@context.SaleId</MudTd>
                    <MudTd DataLabel="@L["Date"]">@FormatDate(context.StampDate ?? context.CreatedAt)</MudTd>
                    <MudTd DataLabel="@L["Customer RFC"]">@context.CustomerRfc</MudTd>
                    <MudTd DataLabel="@L["Customer"]">@context.CustomerLegalName</MudTd>
                    <MudTd DataLabel="@L["UUID"]">
                        @if (!string.IsNullOrEmpty(context.Uuid))
                        {
                            <MudTooltip Text="@context.Uuid">
                                <MudText Typo="Typo.caption">@context.Uuid[..8]...</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Total"]" Style="text-align: right;">@context.Total.ToString("C")</MudTd>
                    <MudTd DataLabel="@L["Status"]">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @GetStatusText(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        <div class="d-flex justify-center align-center gap-2">
                            <!-- View sale -->
                            <MudTooltip Text="@L["View Sale"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{context.SaleId}"))" />
                            </MudTooltip>

                            <!-- Download XML (available for stamped and error invoices) -->
                            @if (context.HasXml)
                            {
                                <MudTooltip Text="@L["Download XML"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Code"
                                                   Size="Size.Small"
                                                   Color="@(context.IsStamped ? Color.Info : Color.Warning)"
                                                   OnClick="@(() => DownloadXml(context))" />
                                </MudTooltip>
                            }

                            <!-- Download PDF -->
                            @if (context.HasPdf)
                            {
                                <MudTooltip Text="@L["Download PDF"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DownloadPdf(context.Id))" />
                                </MudTooltip>
                            }

                            <!-- Cancel (only fully stamped) -->
                            @if (context.Status == "Stamped" && string.IsNullOrEmpty(context.CancellationStatus))
                            {
                                <AuthorizeView Policy="@ApplicationClaims.Shop.CancelInvoice" Context="cancelAuth">
                                    <Authorized Context="cancelCtx">
                                        <MudTooltip Text="@L["Cancel Invoice"]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => ConfirmCancel(context))" />
                                        </MudTooltip>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
                <NoRecordsContent>
                    <MudText>@L["No invoices found"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .gap-2 > * + * { margin-left: 8px; }
</style>

@code {
    private MudTable<MexicoInvoiceSummaryDto> _table = null!;
    private bool _loading;
    private string _searchString = "";
    private DateRange _dateRange = new();
    private string? _selectedStatus;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        _dateRange = new DateRange(new DateTime(today.Year, today.Month, 1), today);
    }

    private async Task<TableData<MexicoInvoiceSummaryDto>> LoadServerData(TableState state, CancellationToken _)
    {
        try
        {
            _loading = true;
            var (total, items) = await InvoiceService.GetHistoryAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                startDate: _dateRange.Start,
                endDate: _dateRange.End,
                status: _selectedStatus);

            return new TableData<MexicoInvoiceSummaryDto> { TotalItems = total, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invoices");
            Snackbar.Add(L["Error loading invoices"], Severity.Error);
            return new TableData<MexicoInvoiceSummaryDto> { TotalItems = 0, Items = [] };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OnDateRangeChanged()
    {
        await _table.ReloadServerData();
    }

    private async Task OnStatusChanged(string? value)
    {
        _selectedStatus = value;
        await _table.ReloadServerData();
    }

    private async Task DownloadXml(MexicoInvoiceSummaryDto invoice)
    {
        var result = await InvoiceService.GetXmlAsync(invoice.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error, Severity.Error);
            return;
        }
        var fileName = $"{invoice.FolioDisplay}{(invoice.IsStamped ? $"_{invoice.Uuid?[..8]}" : "_error")}.xml";
        await JS.InvokeVoidAsync("downloadFile", fileName, "application/xml",
            Convert.ToBase64String(result.Value!));
    }

    private async Task DownloadPdf(long invoiceId)
    {
        var result = await InvoiceService.GetPdfAsync(invoiceId);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error, Severity.Error);
            return;
        }
        await JS.InvokeVoidAsync("downloadFile", $"factura_{invoiceId}.pdf", "application/pdf",
            Convert.ToBase64String(result.Value!));
    }

    private async Task ConfirmCancel(MexicoInvoiceSummaryDto invoice)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message, L["Cancel invoice"].ToString() + $" {invoice.FolioDisplay}? " + L["This action cannot be undone"].ToString() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowMessageBox(
            L["Confirm Cancellation"],
            L["Are you sure you want to cancel this invoice?"],
            yesText: L["Cancel Invoice"],
            cancelText: L["Keep"]);

        if (dialog == true)
        {
            var result = await InvoiceService.CancelAsync(invoice.Id, "Cancelación solicitada");
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Invoice cancellation requested"], Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Stamped" => Color.Success,
        "Draft" => Color.Default,
        "StampError" => Color.Error,
        "CancellationPending" => Color.Warning,
        "Cancelled" => Color.Dark,
        _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "Stamped" => L["Stamped"],
        "Draft" => L["Draft"],
        "StampError" => L["Error"],
        "CancellationPending" => L["Cancelling"],
        "Cancelled" => L["Cancelled"],
        _ => status
    };

    private string FormatDate(DateTime dt) => dt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}
