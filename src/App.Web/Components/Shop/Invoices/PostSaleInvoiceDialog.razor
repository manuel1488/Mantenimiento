@using App.Core.DTOs.Billing
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using MudBlazor

@inject IMexicoInvoiceService InvoiceService
@inject IMexicoFiscalCatalogService FiscalCatalogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<PostSaleInvoiceDialog> L
@inject ILogger<PostSaleInvoiceDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" />
            @L["Invoice Past Sale"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_step == 1)
        {
            <!-- Step 1: Sale lookup -->
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-3">@L["Enter the sale number to invoice"]</MudText>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudNumericField T="long"
                                     @bind-Value="_saleId"
                                     Label="@L["Sale #"]"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="LookupSale"
                               Disabled="@(_searching || _saleId <= 0)"
                               FullWidth="true">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @L["Search"]
                    </MudButton>
                </MudItem>

                @if (_lookupError != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true">@_lookupError</MudAlert>
                    </MudItem>
                }

                @if (_saleInfo != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Success" Dense="true">
                            <MudText Typo="Typo.body2"><b>@L["Sale found"]</b></MudText>
                            <MudText Typo="Typo.caption">
                                @L["Sale date"]: @_saleInfo.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                &nbsp;·&nbsp;
                                @L["Total"]: <b>@_saleInfo.Total.ToString("C")</b>
                                @if (!string.IsNullOrEmpty(_saleInfo.CustomerName))
                                {
                                    <text>&nbsp;·&nbsp;@L["Customer"]: <b>@_saleInfo.CustomerName</b></text>
                                }
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <!-- Step 2: Fiscal form -->
            @if (_loadingCatalogs)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }

            <!-- Sale summary -->
            @if (_saleInfo != null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @L["Sale #"]@_saleInfo.SaleId
                    &nbsp;·&nbsp;
                    @_saleInfo.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    &nbsp;·&nbsp;
                    <b>@_saleInfo.Total.ToString("C")</b>
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Receptor Fiscal Data"]</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_dto.CustomerRfc"
                                      Label="@L["RFC"]"
                                      Required="true"
                                      RequiredError="@L["RFC is required"]"
                                      MaxLength="13"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_dto.CustomerPostalCode"
                                      Label="@L["Postal Code"]"
                                      Required="true"
                                      RequiredError="@L["Postal code is required"]"
                                      MaxLength="5"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_dto.CustomerLegalName"
                                      Label="@L["Legal Name"]"
                                      Required="true"
                                      RequiredError="@L["Legal name is required"]"
                                      MaxLength="150"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   Value="@_dto.CustomerFiscalRegime"
                                   ValueChanged="@OnFiscalRegimeChanged"
                                   Label="@L["Fiscal Regime"]"
                                   Required="true"
                                   RequiredError="@L["Fiscal regime is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var regime in _fiscalRegimes)
                            {
                                <MudSelectItem Value="@regime.Code">@regime.Description (@regime.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.CfdiUse"
                                   Label="@L["CFDI Use"]"
                                   Required="true"
                                   RequiredError="@L["CFDI use is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Disabled="@(string.IsNullOrEmpty(_dto.CustomerFiscalRegime))">
                            @foreach (var use in _filteredCfdiUses)
                            {
                                <MudSelectItem Value="@use.Code">@use.Description (@use.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.PaymentForm"
                                   Label="@L["Payment Form"]"
                                   Required="true"
                                   RequiredError="@L["Payment form is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var form in _paymentForms)
                            {
                                <MudSelectItem Value="@form.Code">@form.Description (@form.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.PaymentMethod"
                                   Label="@L["Payment Method"]"
                                   Required="true"
                                   RequiredError="@L["Payment method is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("PUE")">@L["PUE - Single payment"]</MudSelectItem>
                            <MudSelectItem Value="@("PPD")">@L["PPD - Installments"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_dto.SendToEmail"
                                      Label="@L["Send to Email (optional)"]"
                                      MaxLength="100"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_processing">@L["Cancel"]</MudButton>

        @if (_step == 1)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="GoToFiscalForm"
                       Disabled="@(_saleInfo == null)">
                @L["Continue"]
            </MudButton>
        }
        else
        {
            <MudButton OnClick="GoBack" Disabled="@_processing">@L["Back"]</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="GenerateInvoice"
                       Disabled="@(_processing || !_isValid || _loadingCatalogs)">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@L["Generating..."]</MudText>
                }
                else
                {
                    @L["Generate Invoice"]
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long? PrefilledSaleId { get; set; }

    #region Fields
    private int _step = 1;
    private long _saleId;
    private bool _searching;
    private bool _loadingCatalogs;
    private bool _processing;
    private string? _lookupError;
    private SaleForInvoicingDto? _saleInfo;

    private MudForm _form = null!;
    private bool _isValid;
    private CreateMexicoInvoiceDto _dto = new();

    private List<MexicoFiscalRegimeDto> _fiscalRegimes = [];
    private List<MexicoCfdiUseDto> _allCfdiUses = [];
    private List<MexicoCfdiUseDto> _filteredCfdiUses = [];
    private List<MexicoPaymentFormDto> _paymentForms = [];
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        if (PrefilledSaleId.HasValue && PrefilledSaleId.Value > 0)
        {
            _saleId = PrefilledSaleId.Value;
            await LookupSale();
        }
    }
    #endregion

    #region Methods
    private void Cancel() => MudDialog.Cancel();

    private void GoBack()
    {
        _step = 1;
        _saleInfo = null;
        _lookupError = null;
    }

    private async Task LookupSale()
    {
        _searching = true;
        _lookupError = null;
        _saleInfo = null;
        try
        {
            var result = await InvoiceService.GetSaleInfoForInvoicingAsync(_saleId);
            if (result.IsSuccess)
                _saleInfo = result.Value;
            else
                _lookupError = result.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error looking up sale {SaleId}", _saleId);
            _lookupError = L["Error searching for sale"];
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task GoToFiscalForm()
    {
        if (_saleInfo == null) return;

        _loadingCatalogs = true;
        _step = 2;
        _dto = new CreateMexicoInvoiceDto
        {
            SaleId = _saleInfo.SaleId,
            PaymentMethod = "PUE",
            PaymentForm = _saleInfo.ResolvedPaymentForm,
            CfdiUse = "G03",
            CustomerRfc = _saleInfo.CustomerRfc ?? string.Empty,
            CustomerLegalName = _saleInfo.CustomerLegalName ?? string.Empty,
            CustomerPostalCode = _saleInfo.CustomerPostalCode ?? string.Empty,
            CustomerFiscalRegime = _saleInfo.CustomerFiscalRegime ?? string.Empty,
            SendToEmail = _saleInfo.CustomerSendInvoiceEmail ? _saleInfo.CustomerEmail : null
        };

        try
        {
            _fiscalRegimes = (await FiscalCatalogService.GetFiscalRegimesAsync()).ToList();
            _allCfdiUses = (await FiscalCatalogService.GetCfdiUsesAsync()).ToList();
            _paymentForms = (await FiscalCatalogService.GetPaymentFormsAsync()).ToList();

            // Filter CFDI uses by pre-filled fiscal regime
            if (!string.IsNullOrEmpty(_dto.CustomerFiscalRegime))
            {
                _filteredCfdiUses = (await FiscalCatalogService.GetCfdiUsesByFiscalRegimeAsync(_dto.CustomerFiscalRegime)).ToList();
                if (!_filteredCfdiUses.Any(u => u.Code == _dto.CfdiUse))
                    _dto.CfdiUse = _filteredCfdiUses.Any(u => u.Code == "G03") ? "G03" : string.Empty;
            }
            else
            {
                _filteredCfdiUses = [];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fiscal catalogs");
            Snackbar.Add(L["Error loading catalogs"], Severity.Error);
        }
        finally
        {
            _loadingCatalogs = false;
        }
    }

    private async Task OnFiscalRegimeChanged(string regime)
    {
        _dto.CustomerFiscalRegime = regime;
        _filteredCfdiUses = string.IsNullOrEmpty(regime)
            ? _allCfdiUses
            : (await FiscalCatalogService.GetCfdiUsesByFiscalRegimeAsync(regime)).ToList();

        if (!string.IsNullOrEmpty(_dto.CfdiUse) && !_filteredCfdiUses.Any(u => u.Code == _dto.CfdiUse))
            _dto.CfdiUse = string.Empty;
    }

    private async Task GenerateInvoice()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _processing = true;
        try
        {
            var result = await InvoiceService.CreateAndStampAsync(_dto);
            if (result.IsSuccess)
            {
                if (result.Value!.Status == "StampError")
                {
                    Snackbar.Add(L["Invoice saved with stamp error. Review it in the invoices list."] + $" {result.Value.StampError}", Severity.Warning);
                }
                else
                {
                    Snackbar.Add(L["Invoice generated successfully"] + $" UUID: {result.Value.Uuid}", Severity.Success);
                }
                MudDialog.Close(DialogResult.Ok(result.Value));
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating invoice for sale {SaleId}", _dto.SaleId);
            Snackbar.Add(L["Error generating invoice"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
    #endregion
}
