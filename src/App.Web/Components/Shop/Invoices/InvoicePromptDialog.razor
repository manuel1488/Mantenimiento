@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using MudBlazor

@inject IMexicoInvoiceService InvoiceService
@inject IMexicoFiscalCatalogService FiscalCatalogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<InvoicePromptDialog> L
@inject ILogger<InvoicePromptDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
            @L["Generate Invoice?"] — @L["Sale #"]@SaleId
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Typo="Typo.body2">@L["Customer"]: <b>@CustomerName</b></MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body2">@L["Total"]: <b>@SaleTotal.ToString("C")</b></MudText>
                </MudItem>

                @if (AllowEditFiscalData)
                {
                    <!-- Full CFDI form -->
                    <MudItem xs="12"><MudDivider Class="my-1" /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_dto.CustomerRfc"
                                      Label="@L["RFC"]"
                                      Required="true"
                                      RequiredError="@L["RFC is required"]"
                                      MaxLength="13"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_dto.CustomerPostalCode"
                                      Label="@L["Postal Code"]"
                                      Required="true"
                                      RequiredError="@L["Postal code is required"]"
                                      MaxLength="5"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_dto.CustomerLegalName"
                                      Label="@L["Legal Name"]"
                                      Required="true"
                                      RequiredError="@L["Legal name is required"]"
                                      MaxLength="150"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.CustomerFiscalRegime"
                                   @bind-Value:after="OnFiscalRegimeChanged"
                                   Label="@L["Fiscal Regime"]"
                                   Required="true"
                                   RequiredError="@L["Fiscal regime is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var regime in _fiscalRegimes)
                            {
                                <MudSelectItem Value="@regime.Code">@regime.Description (@regime.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.CfdiUse"
                                   Label="@L["CFDI Use"]"
                                   Required="true"
                                   RequiredError="@L["CFDI use is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var use in FilteredCfdiUses)
                            {
                                <MudSelectItem Value="@use.Code">@use.Description (@use.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.PaymentForm"
                                   Label="@L["Payment Form"]"
                                   Required="true"
                                   RequiredError="@L["Payment form is required"]"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var form in _paymentForms)
                            {
                                <MudSelectItem Value="@form.Code">@form.Description (@form.Code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.PaymentMethod"
                                   Label="@L["Payment Method"]"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("PUE")">@L["PUE - Single payment"]</MudSelectItem>
                            <MudSelectItem Value="@("PPD")">@L["PPD - Installments"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_dto.SendToEmail"
                                      Label="@L["Send to Email (optional)"]"
                                      MaxLength="100"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email" />
                    </MudItem>
                }
                else
                {
                    <!-- Simple mode: only RFC (read-only) + email -->
                    <MudItem xs="12"><MudDivider Class="my-1" /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_dto.CustomerRfc"
                                      Label="@L["RFC"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_dto.SendToEmail"
                                      Label="@L["Send to Email"]"
                                      MaxLength="100"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email" />
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Skip" Disabled="@_processing">@L["Skip"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="GenerateInvoice"
                   Disabled="@(_processing || _loading)"
                   Class="da-button-rounded">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Generating..."]</MudText>
            }
            else
            {
                @L["Generate Invoice"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long SaleId { get; set; }
    [Parameter] public decimal SaleTotal { get; set; }
    [Parameter] public string CustomerName { get; set; } = string.Empty;
    [Parameter] public string? CustomerRfc { get; set; }
    [Parameter] public string? CustomerLegalName { get; set; }
    [Parameter] public string? CustomerPostalCode { get; set; }
    [Parameter] public string? CustomerFiscalRegime { get; set; }
    [Parameter] public string? CustomerEmail { get; set; }
    [Parameter] public string? CustomerDefaultCfdiUse { get; set; }
    [Parameter] public bool CustomerSendEmail { get; set; }
    [Parameter] public bool AllowEditFiscalData { get; set; } = true;

    private bool _loading;
    private bool _processing;
    private CreateMexicoInvoiceDto _dto = new();
    private List<MexicoFiscalRegimeDto> _fiscalRegimes = [];
    private List<MexicoCfdiUseDto> _cfdiUses = [];
    private List<MexicoPaymentFormDto> _paymentForms = [];

    private IEnumerable<MexicoCfdiUseDto> FilteredCfdiUses =>
        string.IsNullOrEmpty(_dto.CustomerFiscalRegime)
            ? _cfdiUses
            : _cfdiUses.Where(u =>
                string.IsNullOrEmpty(u.FiscalRegimeCodes) ||
                u.FiscalRegimeCodes.Split(',').Any(c => c.Trim() == _dto.CustomerFiscalRegime));

    protected override async Task OnInitializedAsync()
    {
        _dto.SaleId = SaleId;
        _dto.CustomerRfc = CustomerRfc ?? string.Empty;
        _dto.CustomerLegalName = CustomerLegalName ?? string.Empty;
        _dto.CustomerPostalCode = CustomerPostalCode ?? string.Empty;
        _dto.CustomerFiscalRegime = CustomerFiscalRegime ?? string.Empty;
        _dto.SendToEmail = CustomerSendEmail ? CustomerEmail : null;
        _dto.PaymentMethod = "PUE";
        _dto.CfdiUse = CustomerDefaultCfdiUse ?? "G03";

        if (AllowEditFiscalData)
        {
            _loading = true;
            try
            {
                _fiscalRegimes = (await FiscalCatalogService.GetFiscalRegimesAsync()).ToList();
                _cfdiUses = (await FiscalCatalogService.GetCfdiUsesAsync()).ToList();
                _paymentForms = (await FiscalCatalogService.GetPaymentFormsAsync()).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading fiscal catalogs for invoice prompt");
                Snackbar.Add(L["Error loading data"], Severity.Error);
            }
            finally
            {
                _loading = false;
            }
        }
    }

    private void OnFiscalRegimeChanged()
    {
        // Reset CFDI use if it's not valid for the new regime
        if (!string.IsNullOrEmpty(_dto.CfdiUse) &&
            !FilteredCfdiUses.Any(u => u.Code == _dto.CfdiUse))
        {
            _dto.CfdiUse = FilteredCfdiUses.Any(u => u.Code == "G03") ? "G03" : FilteredCfdiUses.FirstOrDefault()?.Code ?? string.Empty;
        }
    }

    private void Skip() => MudDialog.Cancel();

    private async Task GenerateInvoice()
    {
        // In simple mode, fill defaults if needed
        if (!AllowEditFiscalData)
        {
            if (string.IsNullOrEmpty(_dto.PaymentForm)) _dto.PaymentForm = "01";
            if (string.IsNullOrEmpty(_dto.CfdiUse)) _dto.CfdiUse = "G03";
        }

        if (string.IsNullOrWhiteSpace(_dto.CustomerRfc) ||
            string.IsNullOrWhiteSpace(_dto.CustomerLegalName) ||
            string.IsNullOrWhiteSpace(_dto.CustomerPostalCode) ||
            string.IsNullOrWhiteSpace(_dto.CustomerFiscalRegime) ||
            string.IsNullOrWhiteSpace(_dto.CfdiUse) ||
            string.IsNullOrWhiteSpace(_dto.PaymentForm))
        {
            Snackbar.Add(L["Please complete all required fields"], Severity.Warning);
            return;
        }

        _processing = true;
        try
        {
            var result = await InvoiceService.CreateAndStampAsync(_dto);
            if (result.IsSuccess)
            {
                if (result.Value!.Status == "StampError")
                {
                    Snackbar.Add(L["Invoice saved with stamp error. Review it in the invoices list."] + $" {result.Value.StampError}", Severity.Warning);
                }
                else
                {
                    Snackbar.Add(L["Invoice generated successfully"] + $" UUID: {result.Value.Uuid}", Severity.Success);
                }
                MudDialog.Close(DialogResult.Ok(result.Value));
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating invoice for sale {SaleId}", SaleId);
            Snackbar.Add(L["Error generating invoice"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}
