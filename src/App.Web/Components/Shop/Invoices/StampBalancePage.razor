@page "/shop/stamp-balance"
@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces.Billing
@using MudBlazor

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ApplicationClaims.Shop.ViewStampBalance)]

@inject IMexicoStampAlertService StampAlertService
@inject ISnackbar Snackbar
@inject IStringLocalizer<StampBalancePage> L

<PageTitle>@L["Stamp Balance"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Stamp Balance"]</MudText>

<MudGrid Spacing="3">

    <!-- Balance card -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6">@L["Current Balance (SW Sapien)"]</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshBalance"
                           Disabled="@_loadingBalance">
                    @if (_loadingBalance)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Refresh"]
                </MudButton>
            </div>

            @if (_loadingBalance && _balance == null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_balance == null)
            {
                <MudAlert Severity="Severity.Warning">@L["Could not load balance. Check your PAC configuration."]</MudAlert>
            }
            else if (!_balance.IsConfigured)
            {
                <MudAlert Severity="Severity.Warning">@L["PAC not configured or unreachable. Showing local data only."]</MudAlert>
            }
            else
            {
                <!-- Stamp counters -->
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background:#f5f5f5; text-align:center;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Available"]</MudText>
                            <MudText Typo="Typo.h3"
                                     Color="@(_balance.Available <= (_alertSettings?.LowStampThreshold ?? 50) ? Color.Error : Color.Success)">
                                @_balance.Available.ToString("N0")
                            </MudText>
                            @if (_balance.Available <= (_alertSettings?.LowStampThreshold ?? 50))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["Low balance"]</MudChip>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background:#f5f5f5; text-align:center;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Used (provider)"]</MudText>
                            <MudText Typo="Typo.h3">@_balance.UsedAtProvider.ToString("N0")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background:#f5f5f5; text-align:center;">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Total assigned"]</MudText>
                            @if (_balance.IsUnlimited)
                            {
                                <MudText Typo="Typo.h3">∞</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["Unlimited"]</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.h3">@_balance.TotalAssigned.ToString("N0")</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- Progress bar -->
                @if (!_balance.IsUnlimited && _balance.TotalAssigned > 0)
                {
                    <div class="mb-1">
                        <MudText Typo="Typo.body2">
                            @L["Usage"]: @_balance.AvailablePercent?.ToString("N1")% @L["remaining"]
                        </MudText>
                    </div>
                    <MudProgressLinear Value="@(_balance.AvailablePercent ?? 0)"
                                       Color="@GetProgressColor()"
                                       Rounded="true"
                                       Size="Size.Large"
                                       Class="mb-2" />
                }

                <!-- Expiration -->
                @if (_balance.ExpirationDate.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Expires"]: @_balance.ExpirationDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                    </MudText>
                }

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                    @L["Last updated"]: @_balance.FetchedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                </MudText>
            }

            <!-- Local invoice count -->
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.body2">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                @L["Invoices stamped in this system"]: <strong>@(_balance?.LocalInvoicesStamped.ToString("N0") ?? "–")</strong>
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Alert settings -->
    <MudItem xs="12">
        <AuthorizeView Policy="@ApplicationClaims.Admin.ManageFiscalSettings">
            <Authorized Context="manageAuth">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["Alert Settings"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudSwitch @bind-Value="_alertModel.AlertEnabled"
                                       Label="@L["Enable low-balance alerts"]"
                                       Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField @bind-Value="_alertModel.LowStampThreshold"
                                             Label="@L["Alert threshold (stamps)"]"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             HelperText="@L["Send alert when available stamps fall at or below this value"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField @bind-Value="_alertModel.AlertCooldownHours"
                                             Label="@L["Cooldown between alerts (hours)"]"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             HelperText="@L["Minimum hours between consecutive alert emails"]" />
                        </MudItem>
                        @if (_alertSettings?.LastAlertSentAt != null)
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["Last alert sent"]: @_alertSettings.LastAlertSentAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </MudText>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["Users with the '{0}' permission will receive email alerts.", L["Receive stamp alerts"]]
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveAlertSettings"
                                       Disabled="@_savingAlerts"
                                       Class="da-button-rounded">
                                @if (_savingAlerts)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">@L["Saving"]</MudText>
                                }
                                else
                                {
                                    @L["Save Settings"]
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </Authorized>
        </AuthorizeView>
    </MudItem>

</MudGrid>

@code {
    private MexicoStampBalanceDto? _balance;
    private StampAlertSettingsDto? _alertSettings;
    private UpdateStampAlertSettingsDto _alertModel = new();

    private bool _loadingBalance;
    private bool _savingAlerts;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RefreshBalance(), LoadAlertSettings());
    }

    private async Task RefreshBalance()
    {
        _loadingBalance = true;
        StateHasChanged();
        try
        {
            var result = await StampAlertService.GetBalanceAsync();
            if (result.IsSuccess)
                _balance = result.Value;
            else
                Snackbar.Add(result.Error, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading balance"], Severity.Error);
            _ = ex;
        }
        finally
        {
            _loadingBalance = false;
            StateHasChanged();
        }
    }

    private async Task LoadAlertSettings()
    {
        try
        {
            _alertSettings = await StampAlertService.GetAlertSettingsAsync();
            _alertModel = new UpdateStampAlertSettingsDto
            {
                AlertEnabled = _alertSettings.AlertEnabled,
                LowStampThreshold = _alertSettings.LowStampThreshold,
                AlertCooldownHours = _alertSettings.AlertCooldownHours
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading alert settings"], Severity.Error);
            _ = ex;
        }
    }

    private async Task SaveAlertSettings()
    {
        _savingAlerts = true;
        StateHasChanged();
        try
        {
            var result = await StampAlertService.SaveAlertSettingsAsync(_alertModel);
            if (result.IsSuccess)
            {
                _alertSettings = result.Value;
                Snackbar.Add(L["Alert settings saved"], Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error saving alert settings"], Severity.Error);
            _ = ex;
        }
        finally
        {
            _savingAlerts = false;
            StateHasChanged();
        }
    }

    private Color GetProgressColor()
    {
        var threshold = _alertSettings?.LowStampThreshold ?? 50;
        if (_balance == null) return Color.Default;
        if (_balance.Available <= threshold) return Color.Error;
        if (_balance.AvailablePercent < 25) return Color.Warning;
        return Color.Success;
    }
}
