@using App.Core.Constants
@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Location
@using App.Core.DTOs.Product
@using App.Core.DTOs.Shop
@using App.Core.Interfaces
@using MudBlazor

@inject IStringLocalizer<CreateStockEntryDialog> L
@inject IStockEntryService StockEntryService
@inject IInventoryService InventoryService
@inject IProductService ProductService
@inject ISupplierService SupplierService
@inject IInventoryQueryService InventoryQueryService
@inject ISnackbar Snackbar
@inject ILogger<CreateStockEntryDialog> Logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageInventoryInputs">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudForm @ref="_form">

                    <!-- ─── Cabecera ─── -->
                    <div class="d-flex align-center gap-2 mb-1">
                        <span class="flex-grow-1 d-flex align-center gap-2"
                              style="cursor:pointer"
                              @onclick="ToggleHeader">
                            <MudText Typo="Typo.subtitle1">@L["Entry Header"]</MudText>
                            @if (!_headerExpanded)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ma-0">
                                    @GetMovementTypeLabel()
                                </MudChip>
                                @if (_locationId != 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ma-0">
                                        @(Locations.FirstOrDefault(l => l.Id == _locationId)?.Name ?? string.Empty)
                                    </MudChip>
                                }
                                @if (_selectedSupplier != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ma-0">
                                        @_selectedSupplier.Name
                                    </MudChip>
                                }
                                @if (!string.IsNullOrEmpty(_documentNumber))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ma-0">
                                        @_documentNumber
                                    </MudChip>
                                }
                            }
                        </span>
                        <MudIconButton Icon="@(_headerExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Size="Size.Small"
                                       OnClick="ToggleHeader"
                                       title="@(_headerExpanded ? L["Collapse header"] : L["Expand header"])" />
                    </div>
                    <MudCollapse Expanded="_headerExpanded">
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string"
                                       Label="@L["Input Type"]"
                                       @bind-Value="_movementType"
                                       Required="true"
                                       RequiredError="@L["Input type is required"]"
                                       Class="mb-2">
                                <MudSelectItem Value="@InventoryMovementType.StockIn">@L["Stock Input"]</MudSelectItem>
                                <MudSelectItem Value="@InventoryMovementType.Purchase">@L["Purchase"]</MudSelectItem>
                                <MudSelectItem Value="@InventoryMovementType.Return">@L["Return"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string"
                                       Label="@L["Input Subtype"]"
                                       @bind-Value="_movementSubType"
                                       Required="true"
                                       RequiredError="@L["Input subtype is required"]"
                                       Class="mb-2">
                                @if (_movementType == InventoryMovementType.StockIn)
                                {
                                    <MudSelectItem Value="@InventoryMovementSubType.NewProduct">@L["New Product"]</MudSelectItem>
                                    <MudSelectItem Value="@InventoryMovementSubType.InitialCount">@L["Initial Count"]</MudSelectItem>
                                }
                                else
                                {
                                    <MudSelectItem Value="@InventoryMovementSubType.NewProduct">@L["New Product"]</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="int"
                                       Label="@L["Location"]"
                                       @bind-Value="_locationId"
                                       Required="true"
                                       RequiredError="@L["Location is required"]"
                                       Class="mb-2">
                                @foreach (var loc in Locations)
                                {
                                    <MudSelectItem Value="@loc.Id">@loc.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudAutocomplete T="SupplierDto"
                                             Label="@L["Supplier"]"
                                             Value="_selectedSupplier"
                                             ValueChanged="OnSupplierChanged"
                                             SearchFunc="SearchSuppliers"
                                             ToStringFunc="@(s => s == null ? string.Empty : s.Name)"
                                             Placeholder="@L["Search supplier..."]"
                                             ResetValueOnEmptyText="true"
                                             ShowProgressIndicator="true"
                                             Class="mb-2" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField T="string"
                                          @bind-Value="_documentNumber"
                                          Label="@L["Document Number"]"
                                          MaxLength="100"
                                          Class="mb-2" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField T="string"
                                          @bind-Value="_reference"
                                          Label="@L["Reference"]"
                                          MaxLength="50"
                                          Class="mb-2" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker @bind-Date="_entryDate"
                                           Label="@L["Entry Date"]"
                                           Class="mb-2"
                                           DateFormat="dd/MM/yyyy" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="8">
                            <MudTextField T="string"
                                          @bind-Value="_reason"
                                          Label="@L["Reason"]"
                                          Required="true"
                                          RequiredError="@L["Reason is required"]"
                                          MaxLength="500"
                                          Lines="2"
                                          Class="mb-2" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudFileUpload T="IBrowserFile"
                                           FilesChanged="OnFileChanged"
                                           Accept=".pdf,.jpg,.jpeg,.png,.webp"
                                           Class="mb-2">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.AttachFile"
                                               Size="Size.Small">
                                        @L["Attachment"]
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (!string.IsNullOrEmpty(_attachmentFileName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                    @_attachmentFileName
                                </MudText>
                            }
                        </MudItem>
                    </MudGrid>
                    </MudCollapse>

                    <MudDivider Class="my-2" />

                    <!-- ─── Productos ─── -->
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Products"]</MudText>

                    <!-- Scanner field -->
                    <MudTextField T="string"
                                  @bind-Value="_scanInput"
                                  @onkeyup="OnScanKeyUp"
                                  Placeholder="@L["Scan barcode..."]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                                  Class="mb-3"
                                  Style="max-width:360px;"
                                  Immediate="true" />

                    <!-- Product grid (scrollable) -->
                    <div style="overflow-y:auto; max-height:calc(100vh - 480px); min-height:120px;">
                        <MudTable Items="_rows"
                                  Dense="true"
                                  Hover="true"
                                  Class="mb-3">
                            <HeaderContent>
                                <MudTh Style="width:40px">#</MudTh>
                                <MudTh>@L["Product"]</MudTh>
                                <MudTh Style="width:120px; text-align:right">@L["Current Stock"]</MudTh>
                                <MudTh Style="width:140px">@L["Quantity"]</MudTh>
                                @if (_movementType == InventoryMovementType.Purchase)
                                {
                                    <MudTh Style="width:140px">@L["Unit Cost"]</MudTh>
                                }
                                <MudTh Style="width:48px"></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="row">
                                <MudTd>@(_rows.IndexOf(row) + 1)</MudTd>
                                <MudTd>
                                    <MudAutocomplete T="ProductDto"
                                                     Value="row.Product"
                                                     ValueChanged="@(p => OnRowProductChanged(row, p))"
                                                     SearchFunc="@((v, t) => SearchProducts(v, t))"
                                                     ToStringFunc="@(p => p == null ? string.Empty : $"{p.Code} - {p.Name}")"
                                                     ResetValueOnEmptyText="true"
                                                     ShowProgressIndicator="true"
                                                     Dense="true"
                                                     Style="min-width:220px" />
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @(row.CurrentStock.HasValue ? row.CurrentStock.Value.ToString("N2") : "-")
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal"
                                                     @bind-Value="row.Quantity"
                                                     Min="0.01M"
                                                     Format="N2"
                                                     HideSpinButtons="true"
                                                     Margin="Margin.Dense" />
                                </MudTd>
                                @if (_movementType == InventoryMovementType.Purchase)
                                {
                                    <MudTd>
                                        <MudNumericField T="decimal?"
                                                         @bind-Value="row.UnitCost"
                                                         Min="0M"
                                                         Format="N2"
                                                         HideSpinButtons="true"
                                                         Margin="Margin.Dense" />
                                    </MudTd>
                                }
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveRow(row))"
                                                   title="@L["Remove row"]" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.caption" Class="pa-2">—</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </div>

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               OnClick="AddEmptyRow"
                               Class="mt-2">
                        @L["Add Row"]
                    </MudButton>

                </MudForm>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Submit"
                           Disabled="@_processing">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@L["Processing"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    // ── Parameters ──────────────────────────────────────────────────────────

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<LocationDto> Locations { get; set; } = new();

    // ── State ────────────────────────────────────────────────────────────────

    private MudForm _form = null!;
    private bool _processing;
    private bool _headerExpanded = true;

    // Header fields
    private string _movementType = InventoryMovementType.StockIn;
    private string _movementSubType = InventoryMovementSubType.NewProduct;
    private int _locationId;
    private SupplierDto? _selectedSupplier;
    private string? _documentNumber;
    private string? _reference;
    private DateTime? _entryDate = DateTime.Today;
    private string _reason = string.Empty;

    // Attachment
    private string? _attachmentFileName;
    private string? _attachmentMimeType;
    private byte[]? _attachmentData;

    // Scan
    private string _scanInput = string.Empty;

    // Grid rows
    private List<StockEntryLineItem> _rows = [];

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        if (Locations.Count > 0)
            _locationId = Locations[0].Id;

        _rows.Add(new StockEntryLineItem());
    }

    // ── Supplier ─────────────────────────────────────────────────────────────

    private async Task<IEnumerable<SupplierDto>> SearchSuppliers(string value, CancellationToken token)
    {
        try
        {
            var (_, items) = await SupplierService.GetSuppliersAsync(
                page: 1, pageSize: 30, searchString: value, isActive: true);
            return items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching suppliers");
            Snackbar.Add(L["Error loading suppliers"], Severity.Error);
            return [];
        }
    }

    private void OnSupplierChanged(SupplierDto? supplier)
    {
        _selectedSupplier = supplier;
    }

    // ── File ─────────────────────────────────────────────────────────────────

    private async Task OnFileChanged(IBrowserFile? file)
    {
        if (file == null)
        {
            _attachmentFileName = null;
            _attachmentMimeType = null;
            _attachmentData = null;
            return;
        }

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        if (file.Size > maxSize)
        {
            Snackbar.Add(L["File too large. Maximum size is 10 MB"], Severity.Warning);
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await using var stream = file.OpenReadStream(maxSize);
            await stream.CopyToAsync(ms);
            _attachmentData = ms.ToArray();
            _attachmentFileName = file.Name;
            _attachmentMimeType = file.ContentType;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading file");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ── Scanner ───────────────────────────────────────────────────────────────

    private async Task OnScanKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_scanInput))
            return;

        var code = _scanInput.Trim();
        _scanInput = string.Empty;

        try
        {
            // Try barcode first, then product code
            var product = await ProductService.GetProductByBarcodeAsync(code)
                       ?? await ProductService.GetProductByCodeAsync(code);

            if (product == null)
            {
                Snackbar.Add(L["Product not found for barcode"], Severity.Warning);
                return;
            }

            // Check if product already in grid
            var existing = _rows.FirstOrDefault(r => r.Product?.Id == product.Id);
            if (existing != null)
            {
                existing.Quantity += 1;
                StateHasChanged();
                return;
            }

            // Add new row
            var row = new StockEntryLineItem { Product = product, Quantity = 1 };
            await LoadRowStock(row);
            _rows.Add(row);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error scanning barcode {Code}", code);
            Snackbar.Add(L["Error searching products"], Severity.Error);
        }
    }

    // ── Grid ─────────────────────────────────────────────────────────────────

    private void AddEmptyRow()
    {
        _rows.Add(new StockEntryLineItem());
    }

    private void RemoveRow(StockEntryLineItem row)
    {
        _rows.Remove(row);
    }

    private async Task<IEnumerable<ProductDto>> SearchProducts(string value, CancellationToken token)
    {
        try
        {
            var (_, items) = await ProductService.GetProductsAsync(
                searchString: string.IsNullOrEmpty(value) ? null : value,
                pageSize: 30,
                isActive: true);
            return items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching products");
            return [];
        }
    }

    private async Task OnRowProductChanged(StockEntryLineItem row, ProductDto? product)
    {
        row.Product = product;
        row.CurrentStock = null;
        row.UnitCost = product?.Cost > 0 ? product.Cost : null;

        if (product != null)
            await LoadRowStock(row);

        StateHasChanged();
    }

    private async Task LoadRowStock(StockEntryLineItem row)
    {
        if (row.Product == null || _locationId == 0) return;

        try
        {
            var stock = await InventoryQueryService.GetProductStockAsync(row.Product.Id, _locationId);
            row.CurrentStock = stock?.LocationStock.FirstOrDefault()?.Quantity;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading stock for product {Id}", row.Product.Id);
        }
    }

    // ── Submit ────────────────────────────────────────────────────────────────

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        var validRows = _rows.Where(r => r.Product != null && r.Quantity > 0).ToList();
        if (validRows.Count == 0)
        {
            Snackbar.Add(L["At least one product with quantity greater than zero is required"], Severity.Warning);
            return;
        }

        _processing = true;

        try
        {
            var dto = new CreateStockEntryDto
            {
                MovementType = _movementType,
                MovementSubType = _movementSubType,
                LocationId = _locationId,
                SupplierId = _selectedSupplier?.Id,
                SupplierName = _selectedSupplier?.Name,
                DocumentNumber = _documentNumber,
                Reference = _reference,
                Reason = _reason,
                EntryDate = _entryDate.HasValue ? _entryDate.Value.ToUniversalTime() : DateTime.UtcNow,
                AttachmentFileName = _attachmentFileName,
                AttachmentMimeType = _attachmentMimeType,
                AttachmentData = _attachmentData,
                Items = validRows.Select(r => new CreateStockEntryItemDto
                {
                    ProductId = r.Product!.Id,
                    Quantity = r.Quantity,
                    UnitCost = _movementType == InventoryMovementType.Purchase ? r.UnitCost : null
                }).ToList()
            };

            var result = await StockEntryService.CreateStockEntryAsync(dto);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Stock entry created successfully"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(result.Value));
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating stock entry");
            Snackbar.Add(L["Error creating stock entry"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    // ── Header collapse ──────────────────────────────────────────────────────

    private void ToggleHeader() => _headerExpanded = !_headerExpanded;

    private string GetMovementTypeLabel() => _movementType switch
    {
        InventoryMovementType.Purchase => L["Purchase"],
        InventoryMovementType.Return   => L["Return"],
        _                              => L["Stock Input"]
    };

    // ── Inner types ──────────────────────────────────────────────────────────

    private sealed class StockEntryLineItem
    {
        public ProductDto? Product { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal? UnitCost { get; set; }
        public decimal? CurrentStock { get; set; }
    }
}
