@page "/shop/inventory"
@using App.Core.DTOs.Inventory
@using App.Core.DTOs.UnitMeasure
@using App.Core.Interfaces
@using App.Web.Components.Shop.Inventory.Tabs
@using App.Web.Components.Shared.Dialogs
@using App.Web.Services
@using Microsoft.AspNetCore.Authorization

@inject IStringLocalizer<InventoryPage> L
@inject IInventoryQueryService InventoryQueryService
@inject IInventoryHistoryService InventoryHistoryService
@inject IUnitMeasureService UnitMeasureService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<InventoryPage> Logger
@inject InventoryEventsService InventoryEvents

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewInventory)]

@implements IDisposable

<PageTitle>@L["Inventory"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <MudItem xs="12">
            <MudCard Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5">@L["Inventory Management"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent Class="pa-0">
                    <MudTabs Elevation="0" Color="Color.Primary"
                            ApplyEffectsToContainer="true" 
                            PanelClass="pa-6">
                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventory">
                            <MudTabPanel Text="@L["Stock"]" Icon="@Icons.Material.Filled.Inventory">
                                <InventoryStatusTab />
                            </MudTabPanel>
                        </AuthorizeView>                        

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryHistory">
                            <MudTabPanel Text="@L["History"]" Icon="@Icons.Material.Filled.History">
                                <InventoryHistoryTab />
                            </MudTabPanel>
                        </AuthorizeView>

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryTransfers">
                            <MudTabPanel Text="@L["Transfers"]" Icon="@Icons.Material.Filled.SwapHoriz">
                                <InventoryTransfersTab />
                            </MudTabPanel>
                        </AuthorizeView>                        

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryInputs">
                            <MudTabPanel Text="@L["Stock Input"]" Icon="@Icons.Material.Filled.Input">
                                <InventoryInputTab />
                            </MudTabPanel>
                        </AuthorizeView>                        

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryAdjustments">
                            <MudTabPanel Text="@L["Adjustments"]" Icon="@Icons.Material.Filled.SettingsBackupRestore">
                                <InventoryAdjustmentsTab />
                            </MudTabPanel>
                        </AuthorizeView>

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewPhysicalCounts">
                            <MudTabPanel Text="@L["Physical Counts"]" Icon="@Icons.Material.Filled.FactCheck">
                                <PhysicalCountsTab />
                            </MudTabPanel>
                        </AuthorizeView>

                        <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryAlerts">
                            <MudTabPanel Text="@L["Alerts"]" Icon="@Icons.Material.Filled.Warning" BadgeData="@_alertCount" BadgeColor="Color.Error">
                                <InventoryAlertsTab AlertsCountChanged="UpdateAlertCount" />
                            </MudTabPanel>
                        </AuthorizeView>                        
                    </MudTabs>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _alertCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertCount();
        InventoryEvents.AlertsChanged += OnAlertsChanged;
    }

    private async Task LoadAlertCount()
    {
        try
        {
            _alertCount = await InventoryHistoryService.GetCurrentAlertsCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading alert count");
            Snackbar.Add(L["Error loading alerts"], Severity.Error);
        }
    }

    private async void OnAlertsChanged(object? sender, EventArgs e)
    {
        await LoadAlertCount();
        StateHasChanged();
    }

    private void UpdateAlertCount(int count)
    {
        _alertCount = count;
        StateHasChanged();
    }

    public void Dispose()
    {
        InventoryEvents.AlertsChanged -= OnAlertsChanged;
    }
}