@page "/shop/inventory/physical-count"
@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Location
@using App.Core.Interfaces
@using App.Core.Interfaces.Settings
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web

@inject IStringLocalizer<PhysicalInventoryCountPage> L
@inject IPhysicalInventoryCountService PhysicalInventoryCountService
@inject IInventorySettingsService InventorySettingsService
@inject ILocationService LocationService
@inject IProductService ProductService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<PhysicalInventoryCountPage> Logger
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Shop.ManagePhysicalCounts)]

<PageTitle>@L["Physical Inventory Count"]</PageTitle>

<div style="display:flex;flex-direction:column;gap:12px;">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/shop/inventory"))"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h4">@L["Physical Inventory Count"]</MudText>
    </MudStack>

    @if (_result == null)
    {
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int"
                                   Label="@L["Location"]"
                                   Value="_locationId"
                                   ValueChanged="OnLocationChanged"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="@L["Location is required"]">
                            @foreach (var location in _locations)
                            {
                                <MudSelectItem T="int" Value="@location.Id">@location.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      @bind-Value="_reference"
                                      Label="@L["Reference"]"
                                      MaxLength="50"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      @bind-Value="_reason"
                                      Label="@L["Reason"]"
                                      Required="true"
                                      RequiredError="@L["Reason is required"]"
                                      MaxLength="500"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudForm>

            @if (_loadingSheet)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (_rows.Count > 0)
            {
                <div id="physical-count-search-scan">
                    <MudTextField T="string"
                                   @bind-Value="_searchText"
                                   Label="@L["Search or scan product"]"
                                   HelperText="@L["Type a name or code to filter, or scan a barcode and press Enter to jump to its quantity"]"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Search"
                                   Variant="Variant.Outlined"
                                   Immediate="true"
                                   @onkeydown="HandleSearchKeyDown" />
                </div>

                var pendingRows = FilteredRows.Where(r => !r.CountedQuantity.HasValue).ToList();
                var countedRowsList = FilteredRows.Where(r => r.CountedQuantity.HasValue).ToList();

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Default" />
                    <MudText Typo="Typo.subtitle1">@L["Pending"] (@pendingRows.Count)</MudText>
                </MudStack>

                @if (pendingRows.Count == 0)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">@L["All products have been counted"]</MudAlert>
                }
                else
                {
                    <div style="overflow-x:auto;max-height:360px;overflow-y:auto;">
                        <MudSimpleTable Dense="true" Hover="true" Style="min-width:600px;">
                            <thead>
                                <tr>
                                    <th>@L["Product"]</th>
                                    @if (_showSystemStock)
                                    {
                                        <th style="width:140px;text-align:right">@L["System Qty"]</th>
                                    }
                                    <th style="width:140px">@L["Counted Qty"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in pendingRows)
                                {
                                    var currentRow = row;
                                    <tr>
                                        <td>@currentRow.ProductName (@currentRow.ProductCode)</td>
                                        @if (_showSystemStock)
                                        {
                                            <td style="text-align:right">@currentRow.SystemQuantity.ToString("N2")</td>
                                        }
                                        <td id="count-row-@currentRow.ProductId">
                                            <MudNumericField T="decimal?"
                                                             @bind-Value="currentRow.CountedQuantity"
                                                             Min="0"
                                                             Format="N2"
                                                             Variant="Variant.Text"
                                                             Dense="true"
                                                             @onkeydown="@(e => HandleQuantityKeyDown(e))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }

                <MudDivider Class="my-2" />

                <div style="display:flex;align-items:center;gap:8px;">
                    <MudIconButton Icon="@(_countedExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   Size="Size.Small"
                                   OnClick="ToggleCounted" />
                    <div style="display:flex;align-items:center;gap:8px;cursor:pointer;" @onclick="ToggleCounted">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle1">@L["Counted"] (@countedRowsList.Count)</MudText>
                    </div>
                </div>

                @if (countedRowsList.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-9">@L["No products counted yet"]</MudText>
                }
                else
                {
                    <MudCollapse Expanded="_countedExpanded">
                        <div style="overflow-x:auto;max-height:360px;overflow-y:auto;">
                            <MudSimpleTable Dense="true" Hover="true" Style="min-width:600px;">
                                <thead>
                                    <tr>
                                        <th>@L["Product"]</th>
                                        @if (_showSystemStock)
                                        {
                                            <th style="width:140px;text-align:right">@L["System Qty"]</th>
                                        }
                                        <th style="width:140px">@L["Counted Qty"]</th>
                                        @if (_showSystemStock)
                                        {
                                            <th style="width:120px;text-align:right">@L["Difference"]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in countedRowsList)
                                    {
                                        var currentRow = row;
                                        <tr>
                                            <td>@currentRow.ProductName (@currentRow.ProductCode)</td>
                                            @if (_showSystemStock)
                                            {
                                                <td style="text-align:right">@currentRow.SystemQuantity.ToString("N2")</td>
                                            }
                                            <td id="count-row-@currentRow.ProductId">
                                                <MudNumericField T="decimal?"
                                                                 @bind-Value="currentRow.CountedQuantity"
                                                                 Min="0"
                                                                 Format="N2"
                                                                 Variant="Variant.Text"
                                                                 Dense="true"
                                                                 @onkeydown="@(e => HandleQuantityKeyDown(e))" />
                                            </td>
                                            @if (_showSystemStock)
                                            {
                                                <td style="text-align:right">
                                                    @{
                                                        var diff = currentRow.CountedQuantity!.Value - currentRow.SystemQuantity;
                                                    }
                                                    <MudText Color="@(diff == 0 ? Color.Default : diff > 0 ? Color.Success : Color.Error)">
                                                        @diff.ToString("+0.##;-0.##;0")
                                                    </MudText>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </MudCollapse>
                }
            }
            else if (_locationId != 0)
            {
                <MudAlert Severity="Severity.Info">@L["This location has no tracked products"]</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton OnClick="@(() => Navigation.NavigateTo("/shop/inventory"))">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="OpenReview"
                           Disabled="@(!_rows.Any(x => x.CountedQuantity.HasValue))">
                    @L["Review Count"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true">
                @L["Physical count applied successfully"]
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Batch"]</MudText>
                    <MudText Typo="Typo.body2">@_result.BatchNumber</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Location"]</MudText>
                    <MudText Typo="Typo.body2">@_result.LocationName</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Date"]</MudText>
                    <MudText Typo="Typo.body2">@_result.CountDate.ToLocalTime().ToString("g")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Created By"]</MudText>
                    <MudText Typo="Typo.body2">@_result.CreatedBy</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Reason"]</MudText>
                    <MudText Typo="Typo.body2">@_result.Reason</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Reference"]</MudText>
                    <MudText Typo="Typo.body2">@(_result.Reference ?? "-")</MudText>
                </MudItem>
            </MudGrid>

            <div style="overflow-x:auto;">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@L["Product"]</th>
                            <th style="text-align:right">@L["System Qty"]</th>
                            <th style="text-align:right">@L["Counted Qty"]</th>
                            <th style="text-align:right">@L["Difference"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _result.Lines)
                        {
                            <tr>
                                <td>@line.ProductName (@line.ProductCode)</td>
                                <td style="text-align:right">@line.SystemQuantity.ToString("N2")</td>
                                <td style="text-align:right">@line.CountedQuantity.ToString("N2")</td>
                                <td style="text-align:right">
                                    <MudText Color="@(line.Difference == 0 ? Color.Default : line.Difference > 0 ? Color.Success : Color.Error)">
                                        @line.Difference.ToString("+0.##;-0.##;0")
                                    </MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintResult">
                    @L["Print"]
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="StartNewCount">
                    @L["New Physical Count"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</div>

@code {
    private class CountRow
    {
        public long ProductId { get; set; }
        public string ProductCode { get; set; } = null!;
        public string ProductName { get; set; } = null!;
        public decimal SystemQuantity { get; set; }
        public decimal? CountedQuantity { get; set; }
    }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _loadingSheet;

    private List<LocationDto> _locations = new();
    private int _locationId;
    private string? _reference;
    private string _reason = string.Empty;
    private string _searchText = string.Empty;
    private bool _showSystemStock = true;
    private bool _countedExpanded;

    private List<CountRow> _rows = new();
    private PhysicalInventoryCountResultDto? _result;

    private IEnumerable<CountRow> FilteredRows => string.IsNullOrWhiteSpace(_searchText)
        ? _rows
        : _rows.Where(r =>
            r.ProductName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            r.ProductCode.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _locations = (await LocationService.GetAccessibleLocationsAsync()).ToList();

            var settingsResult = await InventorySettingsService.GetSettingsAsync();
            _showSystemStock = !settingsResult.IsSuccess || settingsResult.Value!.ShowStockDuringPhysicalCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading physical count setup");
            Snackbar.Add(L["Error loading locations"], Severity.Error);
        }
    }

    private async Task OnLocationChanged(int locationId)
    {
        _locationId = locationId;
        _rows.Clear();
        _searchText = string.Empty;

        if (locationId == 0)
        {
            return;
        }

        _loadingSheet = true;
        try
        {
            var sheet = await PhysicalInventoryCountService.GetCountSheetAsync(locationId);
            _rows = sheet.ProductStock.Select(p => new CountRow
            {
                ProductId = p.ProductId,
                ProductCode = p.ProductCode,
                ProductName = p.ProductName,
                SystemQuantity = p.Quantity
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading count sheet for location {LocationId}", locationId);
            Snackbar.Add(L["Error loading products for this location"], Severity.Error);
        }
        finally
        {
            _loadingSheet = false;
        }
    }

    private void ToggleCounted()
    {
        _countedExpanded = !_countedExpanded;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        await ProcessScanAsync();
    }

    private async Task ProcessScanAsync()
    {
        var code = _searchText.Trim();

        if (string.IsNullOrEmpty(code))
        {
            return;
        }

        var row = _rows.FirstOrDefault(r => string.Equals(r.ProductCode, code, StringComparison.OrdinalIgnoreCase));

        if (row == null)
        {
            try
            {
                var product = await ProductService.GetProductByBarcodeAsync(code)
                    ?? await ProductService.GetProductByCodeAsync(code);

                if (product != null)
                {
                    row = _rows.FirstOrDefault(r => r.ProductId == product.Id);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error resolving scanned code {Code}", code);
            }
        }

        if (row == null)
        {
            // Fallback: if the current filter narrowed the list down to a single product, use it.
            var filtered = FilteredRows.ToList();
            if (filtered.Count == 1)
            {
                row = filtered[0];
            }
        }

        if (row == null)
        {
            Snackbar.Add(L["Product not found in this location's count sheet"], Severity.Warning);
            return;
        }

        _searchText = string.Empty;

        if (row.CountedQuantity.HasValue)
        {
            _countedExpanded = true;
        }

        StateHasChanged();

        await Task.Delay(50);
        await FocusRowQuantityAsync(row.ProductId);
    }

    private async Task HandleQuantityKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        _searchText = string.Empty;
        StateHasChanged();

        await Task.Delay(50);
        await FocusSearchFieldAsync();
    }

    private Task FocusRowQuantityAsync(long productId) => JS.InvokeVoidAsync(
        "eval",
        $"var w=document.getElementById('count-row-{productId}');if(w){{var i=w.querySelector('input');if(i){{i.focus();i.select();}}}}").AsTask();

    private Task FocusSearchFieldAsync() => JS.InvokeVoidAsync(
        "eval",
        "var w=document.getElementById('physical-count-search-scan');if(w){var i=w.querySelector('input');if(i)i.focus();}").AsTask();

    private async Task OpenReview()
    {
        await _form.Validate();
        if (!_isValid)
        {
            return;
        }

        var countedRows = _rows.Where(x => x.CountedQuantity.HasValue).ToList();
        if (countedRows.Count == 0)
        {
            Snackbar.Add(L["Count at least one product"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { "Lines", countedRows.Select(r => new ReviewPhysicalCountDialog.ReviewLine
                {
                    ProductCode = r.ProductCode,
                    ProductName = r.ProductName,
                    SystemQuantity = r.SystemQuantity,
                    CountedQuantity = r.CountedQuantity!.Value
                }).ToList() }
        };

        var dialog = await DialogService.ShowAsync<ReviewPhysicalCountDialog>(
            L["Review Physical Count"],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            });

        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
        {
            await Submit(countedRows);
        }
    }

    private async Task Submit(List<CountRow> countedRows)
    {
        try
        {
            var dto = new CreatePhysicalInventoryCountDto
            {
                LocationId = _locationId,
                Reason = _reason,
                Reference = _reference,
                Lines = countedRows.Select(r => new PhysicalCountLineDto
                {
                    ProductId = r.ProductId,
                    CountedQuantity = r.CountedQuantity!.Value
                }).ToList()
            };

            var result = await PhysicalInventoryCountService.CreateAndApplyAsync(dto);

            if (result.Success && result.Data != null)
            {
                _result = result.Data;
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["Error applying physical count"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying physical count");
            Snackbar.Add(L["Error applying physical count"], Severity.Error);
        }
    }

    private async Task PrintResult()
    {
        if (_result == null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("openInNewTab", $"/api/physical-inventory-counts/batch/{_result.BatchId}/pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening physical count PDF");
            Snackbar.Add(L["Error applying physical count"], Severity.Error);
        }
    }

    private void StartNewCount()
    {
        _result = null;
        _rows.Clear();
        _locationId = 0;
        _reference = null;
        _reason = string.Empty;
        _searchText = string.Empty;
    }
}
