@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Product
@using App.Core.DTOs.Location
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Web.Services

@inject IStringLocalizer<CreateAdjustmentDialog> L
@inject IInventoryService InventoryService
@inject IProductService ProductService
@inject IInventoryQueryService InventoryQueryService
@inject InventoryMovementService MovementService
@inject InventoryEventsService InventoryEvents
@inject ISnackbar Snackbar
@inject ILogger<CreateAdjustmentDialog> _logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageInventoryTransfers">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudForm @ref="_form" Model="@_model">
                    <!-- Tipo de Ajuste -->
                    <MudSelect T="string"
                            Label="@L["Adjustment Type"]"
                            @bind-Value="_model.AdjustmentType"
                            Required="true"
                            RequiredError="@L["Adjustment type is required"]"
                            Class="mb-4">
                        <MudSelectItem Value="@InventoryMovementSubType.PhysicalCount">@MovementService.GetMovementSubTypeDisplay(InventoryMovementSubType.PhysicalCount)</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementSubType.Shrinkage">@MovementService.GetMovementSubTypeDisplay(InventoryMovementSubType.Shrinkage)</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementSubType.Damaged">@MovementService.GetMovementSubTypeDisplay(InventoryMovementSubType.Damaged)</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementSubType.Expired">@MovementService.GetMovementSubTypeDisplay(InventoryMovementSubType.Expired)</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementSubType.SystemAdjustment">@MovementService.GetMovementSubTypeDisplay(InventoryMovementSubType.SystemAdjustment)</MudSelectItem>
                    </MudSelect>

                    <!-- Location -->
                    <MudSelect T="int"
                            Label="@L["Location"]"
                            Value="_model.LocationId"
                            Required="true"
                            RequiredError="@L["Location is required"]"
                            ValueChanged="OnLocationChanged"
                            Class="mb-4">
                        @foreach (var location in Locations)
                        {
                            <MudSelectItem Value="@location.Id">
                                @location.Name
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <!-- Selección de Producto -->
                    <MudAutocomplete T="ProductDto"
                            Label="@L["Product"]"
                            Value="_selectedProduct"
                            ValueChanged="OnProductChanged"
                            SearchFunc="@SearchProducts"
                            ToStringFunc="@(p => p == null ? string.Empty : $"{p.Code} - {p.Name} - {p.Brand}")"
                            ResetValueOnEmptyText="true"
                            Required="true"
                            OnlyValidateIfDirty="true"
                            RequiredError="@L["Product is required"]"
                            Class="mb-4" />

                    @if (_selectedProduct != null)
                    {
                        <MudPaper Class="pa-4 mb-4">
                            <MudText>@L["Selected Product"]</MudText>
                            <MudText Typo="Typo.subtitle1">@_selectedProduct.Name</MudText>
                            <MudText Typo="Typo.caption">@L[name: "Product Code"]: @_selectedProduct.Code</MudText> <br/>
                            <MudText Typo="Typo.caption">@L[name: "Product Brand"]: @_selectedProduct.Brand</MudText> <br/>
                            <MudText Typo="Typo.caption">@L[name: "Product Description"]: @_selectedProduct.Description</MudText> <br/>
                            <MudText Typo="Typo.caption">
                                @L["Current Stock"]: @string.Concat(@_currentStock?.ToString("N2"), " ", L["Units"])
                            </MudText>
                            <br/>
                            <MudText Typo="Typo.caption">
                                @L["Unit Measure"]: @_selectedProduct.UnitMeasureName
                            </MudText>
                        </MudPaper>
                    }

                    <!-- Nueva Cantidad -->
                    <MudNumericField T="decimal"
                                @bind-Value="_model.NewQuantity"
                                Label="@L["New Quantity"]"
                                Required="true"
                                RequiredError="@L["New quantity is required"]"
                                Min="0M"
                                Format="N2"
                                Class="mb-4" />

                    <!-- Referencia -->
                    <MudTextField T="string"
                                @bind-Value="_model.Reference"
                                Label="@L["Reference"]"
                                MaxLength="50"
                                Class="mb-4" />

                    <!-- Razón/Motivo -->
                    <MudTextField T="string"
                                @bind-Value="_model.Reason"
                                Label="@L["Reason"]"
                                Required="true"
                                RequiredError="@L["Reason is required"]"
                                MaxLength="500"
                                Lines="3" />
                </MudForm>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Color="Color.Primary"
                        Variant="Variant.Filled"
                        OnClick="Submit"
                        Disabled="@_processing">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@L["Processing"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<LocationDto> Locations { get; set; } = new();

    private MudForm _form = null!;
    private CreateInventoryAdjustmentDto _model = new() 
    {
        AdjustmentType = InventoryMovementSubType.PhysicalCount
    };
    private ProductDto? _selectedProduct;
    private decimal? _currentStock;
    private bool _processing;

    private async Task<IEnumerable<ProductDto>> SearchProducts(string value, CancellationToken token)
    {
        try
        {
            // If no location is selected, return an empty list
            if (_model.LocationId == 0)
            {
                return Array.Empty<ProductDto>();
            }

            // Search for products
            var products = string.IsNullOrEmpty(value)
                ? (await ProductService.GetProductsAsync(page: 1, pageSize: 50, isActive: true)).Items
                : (await ProductService.GetProductsAsync(searchString: value, pageSize: 50, isActive: true)).Items;

            // Check if products are initialized in inventory for the selected location
            var validProducts = new List<ProductDto>();
            foreach (var product in products)
            {
                var stock = await InventoryQueryService.GetProductStockAsync(product.Id, _model.LocationId);
                if (stock != null && stock.LocationStock.Any(w => w.LocationId == _model.LocationId))
                {
                    validProducts.Add(product);
                }
            }
            return validProducts;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error searching products");
            Snackbar.Add(L["Error searching products"], Severity.Error);
            return Array.Empty<ProductDto>();
        }
    }

    private void OnLocationChanged(int locationId)
    {
        _model.LocationId = locationId;
        // Reset product selection when location changes
        _selectedProduct = null;
        _currentStock = null;
        _model.ProductId = 0;
    }

    private async Task OnProductChanged(ProductDto? product)
    {
        _selectedProduct = product;
        
        if (product != null && _model.LocationId != 0)
        {
            try
            {
                var stock = await InventoryQueryService.GetProductStockAsync(
                    product.Id, 
                    _model.LocationId);

                if (stock == null || !stock.LocationStock.Any(w => w.LocationId == _model.LocationId))
                {
                    // The product is not initialized in the inventory
                    Snackbar.Add(L["Product not found in this location"], Severity.Warning);
                    _selectedProduct = null;
                    _currentStock = null;
                    _model.ProductId = 0;
                    return;
                }

                _currentStock = stock.LocationStock
                    .FirstOrDefault(w => w.LocationId == _model.LocationId)?.Quantity ?? 0;
                _model.ProductId = product.Id;
                
                // Set initial new quantity to current stock
                _model.NewQuantity = _currentStock.Value;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading product stock");
                Snackbar.Add(L["Error loading product stock"], Severity.Error);
            }
        }
        else
        {
            _currentStock = null;
            _model.ProductId = 0;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        try
        {
            await _form.Validate();
            if (!_form.IsValid || _selectedProduct == null) return;

            _processing = true;

            // Set AdjustmentDate to current UTC time
            _model.AdjustmentDate = DateTime.UtcNow;

            // Create the adjustment
            var result = await InventoryService.CreateInventoryAdjustmentAsync(_model);
            
            if (result.Success)
            {
                if (result.Alert != null)
                {
                    // Notificar al usuario que se creó el ajuste pero generó una alerta
                    if (result.Alert.AlertType == InventoryAlertType.LowStock)
                    {
                        Snackbar.Add(
                            L["Adjustment successful but stock is below minimum. Current: {0}, Minimum: {1}", 
                            result.Alert.CurrentStock.ToString("N2"), 
                            result.Alert.Threshold?.ToString("N2") ?? "N/A"],
                            Severity.Warning);
                    }
                    else if (result.Alert.AlertType == InventoryAlertType.OverStock)
                    {
                        Snackbar.Add(
                            L["Adjustment successful but stock is above maximum. Current: {0}, Maximum: {1}",
                            result.Alert.CurrentStock.ToString("N2"),
                            result.Alert.Threshold?.ToString("N2") ?? "N/A"],
                            Severity.Info);
                    }

                    InventoryEvents.NotifyAlertsChanged();
                }
                else
                {
                    Snackbar.Add(L["Adjustment created successfully"], Severity.Success);
                }
                
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? L["Error creating inventory adjustment"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creating inventory adjustment");
            Snackbar.Add(L["Error creating inventory adjustment"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}