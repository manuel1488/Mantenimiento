@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Product
@using App.Core.DTOs.Location
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Web.Services

@inject IStringLocalizer<CreateInputDialog> L
@inject IInventoryService InventoryService
@inject IProductService ProductService
@inject IInventoryQueryService InventoryQueryService
@inject ISnackbar Snackbar
@inject InventoryEventsService InventoryEvents
@inject ILogger<CreateInputDialog> _logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ManageInventoryInputs">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudForm @ref="_form" Model="@_model">
                    <!-- Tipo de Movimiento -->
                    <MudSelect T="string"
                            Label="@L["Input Type"]"
                            @bind-Value="_model.MovementType"
                            Required="true"
                            RequiredError="@L["Input type is required"]"
                            Class="mb-4">
                        <MudSelectItem Value="@InventoryMovementType.StockIn">@L["Stock Input"]</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementType.Purchase">@L["Purchase"]</MudSelectItem>
                        <MudSelectItem Value="@InventoryMovementType.Return">@L["Return"]</MudSelectItem>
                    </MudSelect>

                    <!-- Subtipo de Movimiento -->
                    <MudSelect T="string"
                            Label="@L["Input Subtype"]"
                            @bind-Value="_model.MovementSubType"
                            Required="true"
                            RequiredError="@L["Input subtype is required"]"
                            Class="mb-4">
                        @if (_model.MovementType == InventoryMovementType.StockIn)
                        {
                            <MudSelectItem Value="@InventoryMovementSubType.NewProduct">@L["New Product"]</MudSelectItem>                                        
                        }
                    </MudSelect>

                    <!-- Almacén -->
                    <MudSelect T="int"
                            Label="@L["Location"]"
                            @bind-Value="_model.LocationId"
                            Required="true"
                            RequiredError="@L["Location is required"]"
                            Class="mb-4">
                        @foreach (var location in Locations)
                        {
                            <MudSelectItem Value="@location.Id">
                                @location.Name
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <!-- Selección de Producto -->
                    <MudAutocomplete T="ProductDto"
                            Label="@L["Product"]"
                            Value="_selectedProduct"
                            ValueChanged="OnProductChanged"
                            SearchFunc="@SearchProducts"
                            ToStringFunc="@(p => p == null ? string.Empty : $"{p.Code} - {p.Name} - {p.Brand}")"
                            ResetValueOnEmptyText="true"
                            Required="true"
                            OnlyValidateIfDirty="true"
                            RequiredError="@L["Product is required"]"
                            HelperText="@L["Product must be initialized in inventory first"]"
                            Class="mb-4" />

                    @if (_selectedProduct != null)
                    {
                        <MudPaper Class="pa-4 mb-4">
                            <MudText>@L["Selected Product"]</MudText>
                            <MudText Typo="Typo.subtitle1">@_selectedProduct.Name</MudText>
                            <MudText Typo="Typo.caption">@L[name: "Product Code"]: @_selectedProduct.Code</MudText> <br/>
                            <MudText Typo="Typo.caption">@L[name: "Product Brand"]: @_selectedProduct.Brand</MudText> <br/>
                            <MudText Typo="Typo.caption">@L[name: "Description"]: @_selectedProduct.Description</MudText><br/>
                            <MudText Typo="Typo.caption">
                                @L["Current Stock"]: @string.Concat(@_currentStock?.ToString("N2"), " ", L["Units"])
                            </MudText>
                            <br/>
                            <MudText Typo="Typo.caption">
                                @L["Unit Measure"]: @_selectedProduct.UnitMeasureName
                            </MudText>
                        </MudPaper>
                    }

                    <!-- Cantidad -->
                    <MudNumericField T="decimal"
                                @bind-Value="_model.Quantity"
                                Label="@L["Quantity"]"
                                Required="true"
                                RequiredError="@L["Quantity is required"]"
                                Min="0.01M"
                                Format="N2"
                                Class="mb-4" />

                    <!-- Costo Unitario -->
                    @if (_model.MovementType == InventoryMovementType.Purchase)
                    {
                        <MudNumericField T="decimal?"
                                    @bind-Value="_model.UnitCost"
                                    Label="@L["Unit Cost"]"
                                    Format="N2"
                                    Class="mb-4" />
                    }

                    <!-- Parte Relacionada (proveedor, cliente, etc) -->
                    <MudTextField T="string"
                                @bind-Value="_model.RelatedParty"
                                Label="@L["Related Party"]"
                                MaxLength="100"
                                Class="mb-4" />

                    <!-- Referencia -->
                    <MudTextField T="string"
                                @bind-Value="_model.Reference"
                                Label="@L["Reference"]"
                                MaxLength="50"
                                Class="mb-4" />

                    <!-- Documento -->
                    <MudTextField T="string"
                                @bind-Value="_model.Document"
                                Label="@L["Document"]"
                                MaxLength="50"
                                Class="mb-4" />

                    <!-- Razón/Motivo -->
                    <MudTextField T="string"
                                @bind-Value="_model.Reason"
                                Label="@L["Reason"]"
                                Required="true"
                                RequiredError="@L["Reason is required"]"
                                MaxLength="500"
                                Lines="3" />
                </MudForm>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
                <MudButton Color="Color.Primary"
                        Variant="Variant.Filled"
                        OnClick="Submit"
                        Disabled="@_processing">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@L["Processing"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] 
    public List<LocationDto> Locations { get; set; } = new();

    private MudForm _form = null!;
    private CreateInventoryMovementDto _model = new() 
    { 
        MovementType = InventoryMovementType.StockIn,
        MovementSubType = InventoryMovementSubType.NewProduct
    };
    private ProductDto? _selectedProduct;
    private decimal? _currentStock;
    private bool _processing;

    private async Task<IEnumerable<ProductDto>> SearchProducts(string value, CancellationToken token)
    {
        try
        {
            // Primero obtenemos los productos
            var products = string.IsNullOrEmpty(value) 
                ? (await ProductService.GetProductsAsync(page: 1, pageSize: 50, isActive: true)).Items
                : (await ProductService.GetProductsAsync(searchString: value, pageSize: 50, isActive: true)).Items;

            // Luego filtramos solo los que están en el almacén seleccionado
            if (_model.LocationId != 0)
            {
                var validProducts = new List<ProductDto>();
                foreach (var product in products)
                {
                    var stock = await InventoryQueryService.GetProductStockAsync(product.Id, _model.LocationId);
                    if (stock != null && stock.LocationStock.Any())
                    {
                        validProducts.Add(product);
                    }
                }
                return validProducts;
            }

            return products;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error searching products");
            Snackbar.Add(L["Error searching products"], Severity.Error);
            return Array.Empty<ProductDto>();
        }
    }

    private async Task OnProductChanged(ProductDto? product)
    {
        _selectedProduct = product;
        
        if (product != null && _model.LocationId != 0)
        {
            try
            {
                var stock = await InventoryQueryService.GetProductStockAsync(
                    product.Id,
                    _model.LocationId);

                if (stock == null || !stock.LocationStock.Any())
                {
                    // El producto no está inicializado en el inventario
                    Snackbar.Add(L["Product not initialized in inventory. Please initialize it first."], Severity.Warning);
                    _selectedProduct = null;
                    _currentStock = null;
                    _model.ProductId = 0;
                    return;
                }

                _currentStock = stock.LocationStock.FirstOrDefault()?.Quantity ?? 0;
                _model.ProductId = product.Id;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading product stock");
                Snackbar.Add(L["Error loading product stock"], Severity.Error);
            }
        }
        else
        {
            _currentStock = null;
            _model.ProductId = 0;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        try
        {
            await _form.Validate();
            if (!_form.IsValid || _selectedProduct == null) return;

            _processing = true;

            // Set MovementDate to current UTC time
            _model.MovementDate = DateTime.UtcNow;

            // Create the movement
            var result = await InventoryService.CreateMovementAsync(_model);
            
            if (result.Success)
            {
                if (result.Alert != null)
                {
                    // Notificar al usuario que se creó el movimiento pero generó una alerta
                    if (result.Alert.AlertType == InventoryAlertType.LowStock)
                    {
                        Snackbar.Add(
                            L["Input successful but stock is still below minimum. Current: {0}, Minimum: {1}", 
                            result.Alert.CurrentStock.ToString("N2"), 
                            result.Alert.Threshold?.ToString("N2") ?? "N/A"],
                            Severity.Warning);
                    }
                    else if (result.Alert.AlertType == InventoryAlertType.OverStock)
                    {
                        Snackbar.Add(
                            L["Input successful but stock is now above maximum. Current: {0}, Maximum: {1}",
                            result.Alert.CurrentStock.ToString("N2"),
                            result.Alert.Threshold?.ToString("N2") ?? "N/A"],
                            Severity.Info);
                    }
                    
                    InventoryEvents.NotifyAlertsChanged();
                }
                else
                {
                    Snackbar.Add(L["Input created successfully"], Severity.Success);
                }
                
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? L["Error creating inventory input"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creating inventory input");
            Snackbar.Add(L["Error creating inventory input"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}