@page "/shop/inventory/bulk-transfer"
@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Product
@using App.Core.DTOs.Location
@using App.Core.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IStringLocalizer<BulkTransferPage> L
@inject IInventoryService InventoryService
@inject IProductService ProductService
@inject IInventoryQueryService InventoryQueryService
@inject ILocationService LocationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<BulkTransferPage> Logger
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Shop.ManageInventoryTransfers)]

<PageTitle>@L["Bulk Transfer"]</PageTitle>

<div style="display:flex;flex-direction:column;gap:12px;">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/shop/inventory"))"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h4">@L["Bulk Transfer"]</MudText>
    </MudStack>

    @if (_result == null)
    {
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">

            @if (_lineErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">
                    @L["One or more lines failed validation; no transfer was applied"]
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int"
                                   Label="@L["Source Location"]"
                                   Value="_sourceLocationId"
                                   ValueChanged="OnSourceLocationChanged"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="@L["Source location is required"]">
                            @foreach (var location in _locations.Where(w => w.Id != _destinationLocationId))
                            {
                                <MudSelectItem T="int" Value="@location.Id">@location.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int"
                                   Label="@L["Destination Location"]"
                                   @bind-Value="_destinationLocationId"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="@L["Destination location is required"]">
                            @foreach (var location in _locations.Where(w => w.Id != _sourceLocationId))
                            {
                                <MudSelectItem T="int" Value="@location.Id">@location.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string"
                                   Label="@L["Transfer Type"]"
                                   @bind-Value="_transferType"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="@L["Transfer type is required"]">
                            <MudSelectItem Value="@InventoryMovementSubType.StandardTransfer">@L["Standard Transfer"]</MudSelectItem>
                            <MudSelectItem Value="@InventoryMovementSubType.RushTransfer">@L["Rush Transfer"]</MudSelectItem>
                            <MudSelectItem Value="@InventoryMovementSubType.Rebalancing">@L["Stock Rebalancing"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="_reference"
                                      Label="@L["Reference"]"
                                      MaxLength="50"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="_reason"
                                      Label="@L["Reason"]"
                                      Required="true"
                                      RequiredError="@L["Reason is required"]"
                                      MaxLength="500"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudForm>

            <div style="display:flex;flex-direction:column;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">@L["Products"]</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(_sourceLocationId == 0 || _destinationLocationId == 0)"
                               OnClick="AddLine">
                        @L["Add product"]
                    </MudButton>
                </MudStack>

                @if (_lines.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["Add at least one product"]</MudAlert>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>@L["Product"]</th>
                                    <th style="width:140px;text-align:right">@L["Available Stock"]</th>
                                    <th style="width:120px">@L["Quantity"]</th>
                                    <th style="width:48px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _lines)
                                {
                                    var currentLine = line;
                                    <tr>
                                        <td>
                                            <MudAutocomplete T="ProductDto"
                                                             Value="currentLine.SelectedProduct"
                                                             ValueChanged="@(p => OnProductSelected(currentLine, p))"
                                                             SearchFunc="@SearchProductsAsync"
                                                             ToStringFunc="@(p => p is null ? string.Empty : $"{p.Code} - {p.Name} - {p.Brand}")"
                                                             ResetValueOnEmptyText="true"
                                                             Variant="Variant.Text"
                                                             Dense="true" />
                                        </td>
                                        <td style="text-align:right">
                                            @if (currentLine.SelectedProduct != null)
                                            {
                                                @currentLine.AvailableStock.ToString("N2")
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                            }
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal"
                                                             @bind-Value="currentLine.Quantity"
                                                             Min="0.01M"
                                                             Format="N2"
                                                             Variant="Variant.Text"
                                                             Dense="true" />
                                        </td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => RemoveLine(currentLine))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </div>

            @if (_lineErrors.Count > 0)
            {
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <th>@L["Product"]</th>
                            <th style="text-align:right">@L["Quantity"]</th>
                            <th>@L["Error"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in _lineErrors)
                        {
                            <tr>
                                <td>@error.ProductName (@error.ProductCode)</td>
                                <td style="text-align:right">@error.Quantity.ToString("N2")</td>
                                <td>
                                    <MudText Color="Color.Error">@error.Error</MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton OnClick="@(() => Navigation.NavigateTo("/shop/inventory"))">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Submit"
                           Disabled="@_processing">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@L["Processing"]</MudText>
                    }
                    else
                    {
                        @L["Process Transfer"]
                    }
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true">
                @L["Transfer created successfully"]
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Batch"]</MudText>
                    <MudText Typo="Typo.body2">@_result.BatchNumber</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Source Location"]</MudText>
                    <MudText Typo="Typo.body2">@_result.LocationName</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Destination Location"]</MudText>
                    <MudText Typo="Typo.body2">@_result.DestinationLocationName</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Date"]</MudText>
                    <MudText Typo="Typo.body2">@_result.MovementDate.ToLocalTime().ToString("g")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Reason"]</MudText>
                    <MudText Typo="Typo.body2">@_result.Reason</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Reference"]</MudText>
                    <MudText Typo="Typo.body2">@(_result.Reference ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Created By"]</MudText>
                    <MudText Typo="Typo.body2">@_result.CreatedBy</MudText>
                </MudItem>
            </MudGrid>

            <div style="overflow-x:auto;">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@L["Product"]</th>
                            <th style="text-align:right">@L["Quantity"]</th>
                            <th style="text-align:right">@L["Previous Balance"]</th>
                            <th style="text-align:right">@L["New Balance"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _result.Lines)
                        {
                            <tr>
                                <td>@line.ProductName (@line.ProductCode)</td>
                                <td style="text-align:right">@line.Quantity.ToString("N2")</td>
                                <td style="text-align:right">@line.PreviousBalance.ToString("N2")</td>
                                <td style="text-align:right">@line.NewBalance.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintResult">
                    @L["Print"]
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="StartNewTransfer">
                    @L["New Bulk Transfer"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</div>

@code {
    private class TransferLine
    {
        public Guid LineId { get; } = Guid.NewGuid();
        public ProductDto? SelectedProduct { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal AvailableStock { get; set; }
    }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;

    private List<LocationDto> _locations = new();
    private int _sourceLocationId;
    private int _destinationLocationId;
    private string _transferType = InventoryMovementSubType.StandardTransfer;
    private string? _reference;
    private string _reason = string.Empty;

    private List<TransferLine> _lines = new();
    private List<BulkTransferLineResultDto> _lineErrors = new();
    private BulkTransferResultDto? _result;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _locations = (await LocationService.GetActiveLocationsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading locations");
            Snackbar.Add(L["Error loading locations"], Severity.Error);
        }
    }

    private void AddLine()
    {
        _lines.Add(new TransferLine());
    }

    private void RemoveLine(TransferLine line)
    {
        _lines.Remove(line);
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string value, CancellationToken token)
    {
        try
        {
            if (string.IsNullOrEmpty(value))
            {
                var (_, productItems) = await ProductService.GetProductsAsync(page: 1, pageSize: 50, isActive: true);
                return productItems;
            }

            var (_, searchItems) = await ProductService.GetProductsAsync(searchString: value, pageSize: 50, isActive: true);
            return searchItems;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching products");
            Snackbar.Add(L["Error searching products"], Severity.Error);
            return Array.Empty<ProductDto>();
        }
    }

    private async Task OnProductSelected(TransferLine line, ProductDto? product)
    {
        if (product != null && _lines.Any(x => x != line && x.SelectedProduct?.Id == product.Id))
        {
            Snackbar.Add(L["This product was already added to this transfer"], Severity.Warning);
            return;
        }

        line.SelectedProduct = product;
        await LoadLineStock(line);
    }

    private async Task LoadLineStock(TransferLine line)
    {
        if (line.SelectedProduct == null || _sourceLocationId == 0)
        {
            line.AvailableStock = 0;
            return;
        }

        try
        {
            var stock = await InventoryQueryService.GetProductStockAsync(line.SelectedProduct.Id, _sourceLocationId);
            line.AvailableStock = stock?.LocationStock.FirstOrDefault()?.Quantity ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading product stock");
            Snackbar.Add(L["Error loading product stock"], Severity.Error);
        }
    }

    private async Task OnSourceLocationChanged(int locationId)
    {
        _sourceLocationId = locationId;

        foreach (var line in _lines)
        {
            await LoadLineStock(line);
        }
    }

    private async Task Submit()
    {
        try
        {
            await _form.Validate();

            if (!_isValid)
            {
                return;
            }

            if (_sourceLocationId == _destinationLocationId)
            {
                Snackbar.Add(L["Source and destination locations must be different"], Severity.Warning);
                return;
            }

            var linesWithoutProduct = _lines.Any(x => x.SelectedProduct == null);
            if (_lines.Count == 0 || linesWithoutProduct)
            {
                Snackbar.Add(L["Add at least one product"], Severity.Warning);
                return;
            }

            _processing = true;
            _lineErrors.Clear();

            var dto = new CreateBulkInventoryTransferDto
            {
                LocationId = _sourceLocationId,
                DestinationLocationId = _destinationLocationId,
                TransferType = _transferType,
                Reason = _reason,
                Reference = _reference,
                Lines = _lines.Select(x => new BulkTransferLineDto
                {
                    ProductId = x.SelectedProduct!.Id,
                    Quantity = x.Quantity
                }).ToList()
            };

            var result = await InventoryService.CreateBulkTransferAsync(dto);

            if (result.Success && result.Data != null)
            {
                _result = result.Data;
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? L["Error creating transfer"], Severity.Error);
                _lineErrors = result.Data?.Lines.Where(x => !x.Success).ToList() ?? new List<BulkTransferLineResultDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating bulk transfer");
            Snackbar.Add(L["Error creating transfer"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task PrintResult()
    {
        if (_result == null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("openInNewTab", $"/api/inventory-transfers/batch/{_result.BatchId}/pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening bulk transfer PDF");
            Snackbar.Add(L["Error creating transfer"], Severity.Error);
        }
    }

    private void StartNewTransfer()
    {
        _result = null;
        _lineErrors.Clear();
        _lines.Clear();
        _reference = null;
        _reason = string.Empty;
    }
}
