@using MudBlazor

@inject IStringLocalizer<ReviewPhysicalCountDialog> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @L["Review the system quantity against the counted quantity before applying this count. Lines with no difference will not generate an inventory movement."]
        </MudText>

        <div style="overflow-x:auto;max-height:400px;overflow-y:auto;">
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>@L["Product"]</th>
                        <th style="text-align:right">@L["System Qty"]</th>
                        <th style="text-align:right">@L["Counted Qty"]</th>
                        <th style="text-align:right">@L["Difference"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Lines)
                    {
                        var diff = line.CountedQuantity - line.SystemQuantity;
                        <tr>
                            <td>@line.ProductName (@line.ProductCode)</td>
                            <td style="text-align:right">@line.SystemQuantity.ToString("N2")</td>
                            <td style="text-align:right">@line.CountedQuantity.ToString("N2")</td>
                            <td style="text-align:right">
                                <MudText Color="@(diff == 0 ? Color.Default : diff > 0 ? Color.Success : Color.Error)">
                                    @diff.ToString("+0.##;-0.##;0")
                                </MudText>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm" Class="da-button-rounded">
            @L["Apply Count"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public class ReviewLine
    {
        public string ProductCode { get; set; } = null!;
        public string ProductName { get; set; } = null!;
        public decimal SystemQuantity { get; set; }
        public decimal CountedQuantity { get; set; }
    }

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<ReviewLine> Lines { get; set; } = new();

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
