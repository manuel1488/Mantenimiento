@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Location
@using App.Core.Interfaces
@using App.Core.Options
@using Microsoft.Extensions.Options
@inject IStringLocalizer<InventoryStatusTab> L
@inject IInventoryQueryService InventoryQueryService
@inject NavigationManager NavigationManager
@inject ILocationService LocationService
@inject IOptions<ExportOptions> ExportOptions
@inject IInventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<InventoryStatusTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventory">
    <Authorized>
        <MudGrid>
            <MudItem xs="12" Class="d-flex gap-4 flex-grow-1">
                <!-- Búsqueda -->
                <MudTextField T="string" 
                            ValueChanged="@(s => OnSearch(s))"
                            Placeholder="@L["Search products"]"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Class="flex-1"/>

                <!-- Filtro de Ubicación -->
                <MudSelect T="int?"
                        Label="@L["Location"]"
                        ValueChanged="@(l => OnLocationFilterChange(l))"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="int?" Value="@null">@L["All"]</MudSelectItem>
                    @foreach(var location in _locations)
                    {
                        <MudSelectItem T="int?" Value="@location.Id">
                            @location.Name (@L[location.TypeName])
                        </MudSelectItem>
                    }
                </MudSelect>

                <!-- Filtros adicionales -->
                <MudMenu Icon="@Icons.Material.Filled.FilterList" 
                        Color="Color.Default" 
                        Class="ml-auto">
                    <MudMenuItem>
                        <MudCheckBox T="bool?" 
                                    ValueChanged="@(EventCallback.Factory.Create<bool?>(this, v => OnStockFilterChange(v)))"
                                    Label="@L["Has Stock"]" />
                    </MudMenuItem>
                    <MudMenuItem>
                        <MudCheckBox T="bool?" 
                                    ValueChanged="@(EventCallback.Factory.Create<bool?>(this, v => OnMinStockFilterChange(v)))"
                                    Label="@L["Below Min Stock"]" />
                    </MudMenuItem>
                    <MudMenuItem>
                        <MudCheckBox T="bool?" 
                                    ValueChanged="@(EventCallback.Factory.Create<bool?>(this, v => OnMaxStockFilterChange(v)))"
                                    Label="@L["Above Max Stock"]" />
                    </MudMenuItem>
                </MudMenu>

                <!-- Botones de Export/Print -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                        Color="Color.Default">
                    <MudMenuItem Icon="@Icons.Material.Filled.FileDownload"
                                OnClick="ExportToExcel">
                        <div class="d-flex flex-column">
                            <MudText>@L["Export to Excel"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["Max. {0:N0} records", ExportOptions.Value.MaxExportRecords]
                            </MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Print"
                                OnClick="PrintInventory">
                        <div class="d-flex flex-column">
                            <MudText>@L["Print"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["Max. {0:N0} records", ExportOptions.Value.MaxPdfRecords]
                            </MudText>
                        </div>
                    </MudMenuItem>
                </MudMenu>
            </MudItem>

            <MudItem xs="12">
                @if (!_loading)
                {
                    <MudTable T="InventoryDto" 
                            ServerData="@LoadServerData"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading"
                            @ref="_table">
                        <HeaderContent>
                            <MudTh>@L["Code"]</MudTh>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Brand"]</MudTh>
                            <MudTh>@L["Description"]</MudTh>
                            <MudTh>@L["Warehouse"]</MudTh>
                            <MudTh Style="text-align: right">@L["Stock"]</MudTh>
                            <MudTh Style="text-align: right">@L["Min Stock"]</MudTh>
                            <MudTh Style="text-align: right">@L["Max Stock"]</MudTh>
                            <MudTh>@L["Content Per Unit"]</MudTh>
                            <MudTh Style="text-align: right">@L["Total Content"]</MudTh>
                            <MudTh>@L["Unit"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                            <MudTh>@L["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="contextInventory">
                            <MudTd DataLabel="@L["Code"]">@contextInventory.ProductCode</MudTd>
                            <MudTd DataLabel="@L["Name"]">@contextInventory.ProductName</MudTd>
                            <MudTd DataLabel="@L["Brand"]">@contextInventory.ProductBrand</MudTd>
                            <MudTd DataLabel="@L["Description"]">
                                @if (!string.IsNullOrEmpty(contextInventory.ProductDescription))
                                {
                                    @contextInventory.ProductDescription
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["No description"]</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Warehouse"]">@contextInventory.LocationName</MudTd>
                            <MudTd DataLabel="@L["Stock"]" Style="text-align: right">
                                @contextInventory.Quantity.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="@L["Min Stock"]" Style="text-align: right">
                                @(contextInventory.MinStock?.ToString("N2") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="@L["Max Stock"]" Style="text-align: right">
                                @(contextInventory.MaxStock?.ToString("N2") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="@L["Content Per Unit"]">
                                @if (contextInventory.ProductContent > 0)
                                {
                                    @contextInventory.ProductContent.ToString("N2")
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Total Content"]" Style="text-align: right">
                                @if (contextInventory.IndividualUnits > 0)
                                {
                                    @contextInventory.IndividualUnits.ToString("N2")
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Unit"]">@contextInventory.UnitMeasureName</MudTd>
                            <MudTd DataLabel="@L["Status"]">
                                @{
                                    var (color, text) = GetStockStatus(contextInventory);
                                    <MudChip T="string" Size="Size.Small" Color="@color">@text</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Policy="@ApplicationClaims.Shop.ManageInventory" Context="authContext">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   title="@L["Edit Stock Limits"]"
                                                   OnClick="@(() => OpenEditDialog(contextInventory))" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                        <NoRecordsContent>
                            <MudText>@L["No inventory records found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                }
                else
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private MudTable<InventoryDto> _table = null!;
    private List<LocationDto> _locations = new();
    private bool _loading = true;
    private bool _initialized = false;
    private string _searchString = "";
    private int? _selectedLocation;
    private bool? _hasStock;
    private bool? _belowMinStock;
    private bool? _aboveMaxStock;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
        _initialized = true;
        _loading = false;
    }

    private async Task LoadLocations()
    {
        try
        {
            _locations = (await LocationService.GetActiveLocationsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading locations");
            Snackbar.Add(L["Error loading locations"], Severity.Error);
        }
    }

    private async Task<TableData<InventoryDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            if (!_initialized)
            {
                return new TableData<InventoryDto> 
                { 
                    TotalItems = 0, 
                    Items = Enumerable.Empty<InventoryDto>() 
                };
            }

            _loading = true;
            var (totalItems, items) = await InventoryQueryService.GetInventoryStatusAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                locationId: _selectedLocation,
                hasStock: _hasStock,
                belowMinStock: _belowMinStock,
                aboveMaxStock: _aboveMaxStock);

            return new TableData<InventoryDto> { TotalItems = totalItems, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading inventory status");
            Snackbar.Add(L["Error loading inventory"], Severity.Error);
            return new TableData<InventoryDto> { TotalItems = 0, Items = Enumerable.Empty<InventoryDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private (Color Color, string Text) GetStockStatus(InventoryDto inventory)
    {
        if (inventory.Quantity == 0)
            return (Color.Error, L["Out of Stock"]);

        if (inventory.MinStock.HasValue && inventory.Quantity < inventory.MinStock.Value)
            return (Color.Warning, L["Low Stock"]);

        if (inventory.MaxStock.HasValue && inventory.Quantity > inventory.MaxStock.Value)
            return (Color.Info, L["Over Stock"]);

        return (Color.Success, L["In Stock"]);
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OnLocationFilterChange(int? location)
    {
        _selectedLocation = location;
        await _table.ReloadServerData();
    }

    private async Task OnStockFilterChange(bool? value)
    {
        _hasStock = value;
        await _table.ReloadServerData();
    }

    private async Task OnMinStockFilterChange(bool? value)
    {
        _belowMinStock = value;
        await _table.ReloadServerData();
    }

    private async Task OnMaxStockFilterChange(bool? value)
    {
        _aboveMaxStock = value;
        await _table.ReloadServerData();
    }

    private void ExportToExcel()
    {
        try
        {            
            // Build query parameters
            var queryParams = new List<string>
            {
                $"pageSize={ExportOptions.Value.MaxExportRecords}"
            };
            
            if (!string.IsNullOrEmpty(_searchString))
                queryParams.Add($"searchString={Uri.EscapeDataString(_searchString)}");
                
            if (_selectedLocation.HasValue)
                queryParams.Add($"locationId={_selectedLocation.Value}");
                
            if (_hasStock.HasValue)
                queryParams.Add($"hasStock={_hasStock.Value}");
                
            if (_belowMinStock.HasValue)
                queryParams.Add($"belowMinStock={_belowMinStock.Value}");
                
            if (_aboveMaxStock.HasValue)
                queryParams.Add($"aboveMaxStock={_aboveMaxStock.Value}");

            var queryString = queryParams.Any() ? $"?{string.Join("&", queryParams)}" : "";
            var exportUrl = $"api/InventoryExport/export{queryString}";

            NavigationManager.NavigateTo(exportUrl, true);
            Snackbar.Add(L["Export started"], Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting inventory");
            Snackbar.Add(L["Error exporting inventory"], Severity.Error);
        }
    }

    private async Task OpenEditDialog(InventoryDto item)
    {
        var parameters = new DialogParameters
        {
            [nameof(EditStockLimitsDialog.ProductId)] = item.ProductId,
            [nameof(EditStockLimitsDialog.LocationId)] = item.LocationId,
            [nameof(EditStockLimitsDialog.ProductName)] = item.ProductName,
            [nameof(EditStockLimitsDialog.LocationName)] = item.LocationName,
            [nameof(EditStockLimitsDialog.MinStock)] = item.MinStock,
            [nameof(EditStockLimitsDialog.MaxStock)] = item.MaxStock,
        };
        var options = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditStockLimitsDialog>(L["Edit Stock Limits"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _table.ReloadServerData();
    }

    private void PrintInventory()
    {
        try
        {
            // Build query parameters
            var queryParams = new List<string>
            {
                $"pageSize={ExportOptions.Value.MaxPdfRecords}"
            };
            
            if (!string.IsNullOrEmpty(_searchString))
                queryParams.Add($"searchString={Uri.EscapeDataString(_searchString)}");
                
            if (_selectedLocation.HasValue)
                queryParams.Add($"locationId={_selectedLocation.Value}");
                
            if (_hasStock.HasValue)
                queryParams.Add($"hasStock={_hasStock.Value}");
                
            if (_belowMinStock.HasValue)
                queryParams.Add($"belowMinStock={_belowMinStock.Value}");
                
            if (_aboveMaxStock.HasValue)
                queryParams.Add($"aboveMaxStock={_aboveMaxStock.Value}");

            var queryString = queryParams.Any() ? $"?{string.Join("&", queryParams)}" : "";
            var printUrl = $"api/InventoryExport/print{queryString}";

            NavigationManager.NavigateTo(printUrl, true);
            Snackbar.Add(L["Print started"], Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing inventory");
            Snackbar.Add(L["Error printing inventory"], Severity.Error);
        }
    }
}