@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Warehouse
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Core.Options
@using App.Shared.Services
@using App.Web.Services
@using Microsoft.Extensions.Options

@inject IStringLocalizer<InventoryAlertsTab> L
@inject IInventoryHistoryService InventoryHistoryService
@inject IWarehouseService WarehouseService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ICompanySettingsService CompanySettingsService
@inject IDateTime DateTimeService
@inject ISnackbar Snackbar
@inject IOptions<ExportOptions> ExportOptions
@inject ILogger<InventoryAlertsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryAlerts">
    <Authorized>
        <MudGrid>
            <MudItem xs="12" Class="d-flex gap-4 flex-grow-1">
                <!-- Filtro de Almacén -->
                <MudSelect T="int?"
                        Label="@L["Warehouse"]"
                        @bind-Value="_selectedWarehouse"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="int?" Value="@null">@L["All Warehouses"]</MudSelectItem>
                    @foreach (var warehouse in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                    }
                </MudSelect>

                <!-- Filtro por tipo de alerta -->
                <MudSelect T="string"
                        Label="@L["Alert Type"]"
                        @bind-Value="_selectedAlertType"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="string" Value="@null">@L["All Types"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@InventoryAlertType.LowStock">@L["Low Stock"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@InventoryAlertType.OverStock">@L["Over Stock"]</MudSelectItem>
                </MudSelect>

                <!-- Búsqueda -->
                <MudTextField T="string"
                            @bind-Value="_searchString"
                            Placeholder="@L["Search products"]"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Class="flex-1" />

                <!-- Botón de Refresh -->
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                            Color="Color.Primary" 
                            OnClick="RefreshAlerts"
                            title="@L["Refresh Alerts"]" />

                <!-- Botones de Export/Print -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                        Color="Color.Default">
                    <MudMenuItem Icon="@Icons.Material.Filled.FileDownload"
                                OnClick="ExportToExcel">
                        <div class="d-flex flex-column">
                            <MudText>@L["Export to Excel"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["Max. {0:N0} records", ExportOptions.Value.MaxExportRecords]
                            </MudText>
                        </div>
                    </MudMenuItem>
                </MudMenu>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4 mb-4" Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Current Inventory Alerts"]</MudText>
                    <MudText Color="Color.Secondary">@L["Showing {0} alerts", _filteredAlerts.Count]</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                @if (_loading)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
                else if (!_currentAlerts.Any())
                {
                    <MudPaper Class="pa-4 d-flex align-center justify-center" Height="200px" Elevation="0">
                        <MudText Align="Align.Center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                            <br />
                            @L["No inventory alerts found"]
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <MudTable Items="@_filteredAlerts"
                            Dense="true"
                            Hover="true"
                            Breakpoint="Breakpoint.Sm"
                            Loading="@_loading"
                            T="InventoryAlertDto"
                            Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["Product"]</MudTh>
                            <MudTh>@L["Warehouse"]</MudTh>
                            <MudTh>@L["Alert Type"]</MudTh>
                            <MudTh Style="text-align: right">@L["Current Stock"]</MudTh>
                            <MudTh Style="text-align: right">@L["Min Stock"]</MudTh>
                            <MudTh Style="text-align: right">@L["Max Stock"]</MudTh>
                            <MudTh>@L["Unit"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="contextAlert">
                            <MudTd DataLabel="@L["Product"]">
                                <div class="d-flex flex-column">
                                    <MudText>@contextAlert.ProductName</MudText>
                                    <MudText Typo="Typo.caption">@contextAlert.ProductCode</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="@L["Warehouse"]">@contextAlert.LocationName</MudTd>
                            <MudTd DataLabel="@L["Alert Type"]">
                                @if (contextAlert.AlertType == InventoryAlertType.LowStock)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.ArrowDownward">
                                        @L["Low Stock"]
                                    </MudChip>
                                }
                                else if (contextAlert.AlertType == InventoryAlertType.OverStock)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.ArrowUpward">
                                        @L["Over Stock"]
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Current Stock"]" Style="text-align: right">
                                <MudText Color="@GetStockColor(contextAlert)">
                                    @contextAlert.CurrentStock.ToString("N2")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="@L["Min Stock"]" Style="text-align: right">
                                @(contextAlert.MinStock?.ToString("N2") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="@L["Max Stock"]" Style="text-align: right">
                                @(contextAlert.MaxStock?.ToString("N2") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="@L["Unit"]">@contextAlert.UnitMeasureName</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                        </PagerContent>
                        <NoRecordsContent>
                            <MudText>@L["No alerts match the current filters"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    [Parameter]
    public EventCallback<int> AlertsCountChanged { get; set; }
    
    private List<WarehouseDto> _warehouses = new();
    private List<InventoryAlertDto> _currentAlerts = new();
    private List<InventoryAlertDto> _filteredAlerts = new();
    private bool _loading = true;
    private string _searchString = "";
    private int? _selectedWarehouse;
    private string? _selectedAlertType;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
        await LoadCurrentAlerts();
        
        // Notify parent component that alerts count has changed
        await InvokeAsync(() => AlertsCountChanged.InvokeAsync(_currentAlerts.Count));
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var (_, items) = await WarehouseService.GetWarehousesAsync(
                pageSize: 100,
                isActive: true);
            _warehouses = items.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading warehouses");
            Snackbar.Add(L["Error loading warehouses"], Severity.Error);
        }
    }

    private async Task LoadCurrentAlerts()
    {
        try
        {
            _loading = true;
            _currentAlerts = (await InventoryHistoryService.GetCurrentAlertsAsync(_selectedWarehouse)).ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading current inventory alerts");
            Snackbar.Add(L["Error loading alerts"], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var filteredAlerts = _currentAlerts.AsEnumerable();

        // Apply warehouse filter if selected
        if (_selectedWarehouse.HasValue)
        {
            filteredAlerts = filteredAlerts.Where(x => x.LocationId == _selectedWarehouse.Value);
        }

        // Apply alert type filter if selected
        if (!string.IsNullOrWhiteSpace(_selectedAlertType))
        {
            filteredAlerts = filteredAlerts.Where(x => x.AlertType == _selectedAlertType);
        }

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            filteredAlerts = filteredAlerts.Where(x =>
                x.ProductName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.ProductCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.LocationName.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
        }

        _filteredAlerts = filteredAlerts.ToList();
    }

    private async Task RefreshAlerts()
    {
        await LoadCurrentAlerts();
        await InvokeAsync(() => AlertsCountChanged.InvokeAsync(_currentAlerts.Count));
        Snackbar.Add(L["Alerts refreshed"], Severity.Success);
    }

    private Color GetStockColor(InventoryAlertDto alert)
    {
        return alert.AlertType switch
        {
            InventoryAlertType.LowStock => Color.Warning,
            InventoryAlertType.OverStock => Color.Info,
            _ => Color.Default
        };
    }


    private void ExportToExcel()
    {
        try
        {            
            // Build query parameters
            var queryParams = new List<string>
            {
                $"pageSize={ExportOptions.Value.MaxExportRecords}"
            };
            
            if (_selectedWarehouse.HasValue)
                queryParams.Add($"locationId={_selectedWarehouse.Value}");
                
            if (!string.IsNullOrEmpty(_selectedAlertType))
                queryParams.Add($"alertType={Uri.EscapeDataString(_selectedAlertType)}");
                
            if (!string.IsNullOrEmpty(_searchString))
                queryParams.Add($"searchString={Uri.EscapeDataString(_searchString)}");

            var queryString = queryParams.Any() ? $"?{string.Join("&", queryParams)}" : "";
            var exportUrl = $"api/InventoryExport/exportAlerts{queryString}";

            NavigationManager.NavigateTo(exportUrl, true);
            Snackbar.Add(L["Export started"], Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting alerts");
            Snackbar.Add(L["Error exporting alerts"], Severity.Error);
        }
    }


    // Event handlers para los filtros
    private void OnSearchTextChanged(string value)
    {
        _searchString = value;
        ApplyFilters();
    }

    private async Task OnWarehouseFilterChanged(int? value)
    {
        _selectedWarehouse = value;
        await LoadCurrentAlerts();
    }

    private void OnAlertTypeFilterChanged(string? value)
    {
        _selectedAlertType = value;
        ApplyFilters();
    }
}