@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Location
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Core.Options
@using App.Shared.Services
@using App.Web.Services
@using Microsoft.Extensions.Options

@inject IStringLocalizer<InventoryInputTab> L
@inject IInventoryHistoryService InventoryHistoryService
@inject ILocationService LocationService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ICompanySettingsService CompanySettingsService
@inject IDateTime DateTimeService
@inject ISnackbar Snackbar
@inject IOptions<ExportOptions> ExportOptions
@inject InventoryMovementService MovementService
@inject ILogger<InventoryInputTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryInputs">
    <Authorized>
        <MudGrid>
            <MudItem xs="12" Class="d-flex gap-4 flex-grow-1">
                <AuthorizeView Context="contextNew" Policy="@ApplicationClaims.Shop.ManageInventoryInputs">
                    <!-- Botón Nuevo Ingreso -->
                    <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenStockEntryDialog"
                            Class="da-button-rounded">
                        @L["New Input"]
                    </MudButton>
                </AuthorizeView>                

                <!-- Filtro de fechas -->
                <MudDateRangePicker @bind-DateRange="_dateRange"
                                Label="@L["Date Range"]"
                                AdornmentColor="Color.Primary"
                                PickerVariant="PickerVariant.Dialog"
                                Style="min-width: 300px;" />

                <!-- Filtro de Ubicación -->
                <MudSelect T="int?"
                        Label="@L["Location"]"
                        @bind-Value="_selectedLocation"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="int?" Value="@null">@L["All"]</MudSelectItem>
                    @foreach (var location in _locations)
                    {
                        <MudSelectItem T="int?" Value="@location.Id">@location.Name (@L[location.TypeName])</MudSelectItem>
                    }
                </MudSelect>

                <!-- Filtro de tipo de movimiento -->
                <MudSelect T="string"
                        Label="@L["Input Type"]"
                        @bind-Value="_selectedMovementType"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="string" Value="@null">@L["All Types"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@InventoryMovementType.StockIn">@L["Stock Input"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@InventoryMovementType.Purchase">@L["Purchase"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@InventoryMovementType.Return">@L["Return"]</MudSelectItem>
                </MudSelect>

                <!-- Búsqueda -->
                <MudTextField T="string"
                    @bind-Value="_searchString"
                    @bind-Value:after="OnSearchChanged"
                    Placeholder="@L["Search products"]"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Style="min-width: 250px;"
                    Class="flex-grow-1"
                    Immediate="true"
                    DebounceInterval="500" />
            </MudItem>

            <MudItem xs="12">
                <MudTable T="InventoryMovementDto"
                        ServerData="@LoadServerData"
                        Dense="true"
                        Hover="true"
                        Loading="@_loading"
                        @ref="_table">
                    <HeaderContent>
                        <MudTh>@L["Date"]</MudTh>
                        <MudTh>@L["Input Type"]</MudTh>
                        <MudTh>@L["Product"]</MudTh>
                        <MudTh>@L["Location"]</MudTh>
                        <MudTh Style="text-align: right">@L["Quantity"]</MudTh>
                        <MudTh>@L["Content Per Unit"]</MudTh>
                        <MudTh Style="text-align: right">@L["Total Content"]</MudTh>
                        <MudTh>@L["Unit"]</MudTh>
                        <MudTh Style="text-align: right">@L["Previous Balance"]</MudTh>
                        <MudTh Style="text-align: right">@L["New Balance"]</MudTh>
                        <MudTh>@L["Reference"]</MudTh>
                        <MudTh>@L["Created By"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="contextInput">
                        <MudTd DataLabel="@L["Date"]">
                            @FormatToCompanyTimezone(contextInput.MovementDate)
                        </MudTd>
                        <MudTd DataLabel="@L["Input Type"]">
                            <MudChip T="string" Size="Size.Small" Color="@MovementService.GetMovementTypeColor(contextInput.MovementType)">
                                @GetMovementTypeDisplay(contextInput.MovementType)
                            </MudChip>
                            <MudText Typo="Typo.caption">
                                @GetMovementSubTypeDisplay(contextInput.MovementSubType)
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="@L["Product"]">
                            <div class="d-flex flex-column">
                                <MudText>@contextInput.ProductName</MudText>
                                <MudText Typo="Typo.caption">@contextInput.ProductCode</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Location"]">@contextInput.LocationName</MudTd>
                        <MudTd DataLabel="@L["Quantity"]" Style="text-align: right">
                            @contextInput.Quantity.ToString("N2")
                        </MudTd>
                        <MudTd DataLabel="@L["Content Per Unit"]">
                            @if (contextInput.ProductContent > 0)
                            {
                                @contextInput.ProductContent.ToString("N2")
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Total Content"]" Style="text-align: right">
                            @if (contextInput.ProductContent > 0)
                            {
                                @contextInput.TotalContent.ToString("N2")
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Unit"]">@contextInput.UnitMeasureName</MudTd>
                        <MudTd DataLabel="@L["Previous Balance"]" Style="text-align: right">
                            @contextInput.PreviousBalance.ToString("N2")
                        </MudTd>
                        <MudTd DataLabel="@L["New Balance"]" Style="text-align: right">
                            @contextInput.NewBalance.ToString("N2")
                        </MudTd>
                        <MudTd DataLabel="@L["Reference"]">@contextInput.Reference</MudTd>
                        <MudTd DataLabel="@L["Created By"]">@contextInput.CreatedBy</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText>@L["No input records found"]</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private MudTable<InventoryMovementDto> _table = null!;
    private List<LocationDto> _locations = new();
    private TimeZoneInfo? _companyTimeZone;
    private bool _loading = true;
    private string _searchString = "";
    private int? _selectedLocation;
    private string? _selectedMovementType;
    private DateRange _dateRange = new(DateTime.Today.AddDays(-30), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
        _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
    }

    private async Task LoadLocations()
    {
        try
        {
            _locations = (await LocationService.GetActiveLocationsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading locations");
            Snackbar.Add(L["Error loading locations"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<TableData<InventoryMovementDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;

            string[]? movementTypes = null;
            
            if (string.IsNullOrWhiteSpace(_selectedMovementType))
            {
                // Si no hay tipo específico, usar todos los tipos de entrada
                movementTypes = new[]
                {
                    InventoryMovementType.StockIn,
                    InventoryMovementType.Purchase,
                    InventoryMovementType.Return
                };
            }
            else
            {
                // Si hay tipo específico, usar solo ese
                movementTypes = new[] { _selectedMovementType };
            }

            var (movements, totalCount) = await InventoryHistoryService.GetWarehouseMovementHistoryByTypesAsync(
                warehouseId: _selectedLocation,
                startDate: _dateRange.Start,
                endDate: _dateRange.End,
                searchString: _searchString,
                movementTypes: movementTypes,
                movementSubType: null,
                page: state.Page,
                pageSize: state.PageSize,
                cancellationToken: cancellationToken);

            return new TableData<InventoryMovementDto>
            {
                TotalItems = totalCount,
                Items = movements
            };
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Operation was canceled");
            return new TableData<InventoryMovementDto>
            {
                TotalItems = 0,
                Items = Enumerable.Empty<InventoryMovementDto>()
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading inventory movements");
            Snackbar.Add(L["Error loading movements"], Severity.Error);
            return new TableData<InventoryMovementDto>
            {
                TotalItems = 0,
                Items = Enumerable.Empty<InventoryMovementDto>()
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenStockEntryDialog()
    {
        var parameters = new DialogParameters
        {
            { "Locations", _locations }
        };

        var dialog = await DialogService.ShowAsync<CreateStockEntryDialog>(
            L["New Input"],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            });

        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private string GetMovementTypeDisplay(string movementType) => 
        MovementService.GetMovementTypeDisplay(movementType);

    private string GetMovementSubTypeDisplay(string movementSubType) => 
        MovementService.GetMovementSubTypeDisplay(movementSubType);

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            var convertedTime = DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
            return convertedTime;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }

    private async Task OnSearchChanged()
    {
        await _table.ReloadServerData();
    }

    private async Task OnLocationFilterChange(int? location)
    {
        _selectedLocation = location;
        await _table.ReloadServerData();
    }

    private async Task OnMovementTypeFilterChange(string? type)
    {
        _selectedMovementType = type;
        await _table.ReloadServerData();
    }

    private async Task OnDateRangeChanged(DateRange? range)
    {
        if (range?.Start != null && range?.End != null)
        {
            _dateRange = new DateRange(range.Start, range.End);
            await _table.ReloadServerData();
        }
    }
}