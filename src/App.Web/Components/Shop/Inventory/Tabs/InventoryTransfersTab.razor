@using App.Core.DTOs.Inventory
@using App.Core.DTOs.Warehouse
@using App.Core.Constants
@using App.Core.Interfaces
@using App.Core.Options
@using App.Shared.Services
@using App.Web.Services
@using Microsoft.Extensions.Options

@inject IStringLocalizer<InventoryTransfersTab> L
@inject IInventoryHistoryService InventoryHistoryService
@inject IInventoryService InventoryService
@inject IWarehouseService WarehouseService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IDateTime DateTimeService
@inject ICompanySettingsService CompanySettingsService
@inject ISnackbar Snackbar
@inject IOptions<ExportOptions> ExportOptions
@inject ILogger<InventoryTransfersTab> Logger
@inject InventoryMovementService MovementService

<AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventoryTransfers">
    <Authorized>
        <MudGrid>
            <MudItem xs="12" Class="d-flex gap-4 flex-grow-1">
                <AuthorizeView Context="contextNew" Policy="@ApplicationClaims.Shop.ManageInventoryTransfers">
                    <!-- Botón Nueva Transferencia -->
                    <MudButton Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            StartIcon="@Icons.Material.Filled.Add"
                            OnClick="OpenTransferDialog"
                            Style="min-width: 120px; height: 56px; white-space: normal; line-height: 1.2;">
                        <div style="text-align: center;">
                            @L["New Transfer"]
                        </div>
                    </MudButton>
                </AuthorizeView>                

                <!-- Filtro de fechas -->
                <MudDateRangePicker
                    @bind-DateRange="_dateRange"
                    @bind-DateRange:after="OnDateRangeChanged"
                    Label="@L["Date Range"]"
                    AdornmentColor="Color.Error"
                    PickerVariant="PickerVariant.Dialog"
                    Style="min-width: 250px;" />

                <!-- Filtro Almacén Origen -->
                <MudSelect T="int?" 
                        Label="@L["Source Warehouse"]"
                        @bind-Value="_selectedSourceWarehouse"
                        @bind-Value:after="OnSourceWarehouseFilterChange"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="int?" Value="@null">@L["All"]</MudSelectItem>
                    @foreach(var warehouse in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@warehouse.Id">
                            @warehouse.Name
                        </MudSelectItem>
                    }
                </MudSelect>

                <!-- Filtro Almacén Destino -->
                <MudSelect T="int?" 
                        Label="@L["Destination Warehouse"]"
                        @bind-Value="_selectedDestinationWarehouse"
                        @bind-Value:after="OnDestinationWarehouseFilterChange"
                        AnchorOrigin="Origin.BottomCenter"
                        Style="min-width: 200px;">
                    <MudSelectItem T="int?" Value="@null">@L["All"]</MudSelectItem>
                    @foreach(var warehouse in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@warehouse.Id">
                            @warehouse.Name
                        </MudSelectItem>
                    }
                </MudSelect>

                <!-- Búsqueda -->
                <MudTextField T="string" 
                    @bind-Value="_searchString"
                    @bind-Value:after="OnSearchChanged"
                    Placeholder="@L["Search products"]"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Style="min-width: 250px;"
                    Class="flex-grow-1"
                    Immediate="true"
                    DebounceInterval="500"/>

                <!-- Botones de Export/Print -->
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                        Color="Color.Default">
                    <MudMenuItem Icon="@Icons.Material.Filled.FileDownload"
                                OnClick="ExportToExcel">
                        <div class="d-flex flex-column">
                            <MudText>@L["Export to Excel"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["Max. {0:N0} records", ExportOptions.Value.MaxExportRecords]
                            </MudText>
                        </div>
                    </MudMenuItem>
                </MudMenu>
            </MudItem>

            <MudItem xs="12">
                @if (!_loading)
                {
                    <MudTable T="InventoryMovementDto" 
                            ServerData="@LoadServerData"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading"
                            @ref="_table">
                        <HeaderContent>
                            <MudTh>@L["Date"]</MudTh>
                            <MudTh>@L["Movement Type"]</MudTh>
                            <MudTh>@L["Transfer Type"]</MudTh>
                            <MudTh>@L["Product"]</MudTh>
                            <MudTh>@L["Brand"]</MudTh>
                            <MudTh>@L["Description"]</MudTh>
                            <MudTh>@L["Source"]</MudTh>
                            <MudTh>@L["Destination"]</MudTh>
                            <MudTh Style="text-align: right">@L["Quantity"]</MudTh>
                            <MudTh>@L["Content Per Unit"]</MudTh>
                            <MudTh Style="text-align: right">@L["Total Content"]</MudTh>
                            <MudTh>@L["Unit"]</MudTh>
                            <MudTh>@L["Reference"]</MudTh>
                            <MudTh>@L["Reason"]</MudTh>
                            <MudTh>@L["Created By"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="contextMovement">
                            <MudTd DataLabel="@L["Date"]">
                                @FormatToCompanyTimezone(contextMovement.MovementDate)
                            </MudTd>
                            <MudTd DataLabel="@L["Movement Type"]">
                                <MudChip T="string" Size="Size.Small" Color="@GetMovementTypeColor(contextMovement.MovementType)">
                                    @GetMovementTypeDisplay(contextMovement.MovementType)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Transfer Type"]">
                                @GetMovementSubTypeDisplay(contextMovement.MovementSubType)
                            </MudTd>
                            <MudTd DataLabel="@L["Product"]">
                                <div class="d-flex flex-column">
                                    <MudText>@contextMovement.ProductName</MudText>
                                    <MudText Typo="Typo.caption">@contextMovement.ProductCode</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="@L["Brand"]">
                                @contextMovement.BrandName
                            </MudTd>
                            <MudTd DataLabel="@L["Description"]">
                                @contextMovement.ProductDescription
                            </MudTd>
                            <MudTd DataLabel="@L["Source"]">@contextMovement.LocationName</MudTd>
                            <MudTd DataLabel="@L["Destination"]">
                                @contextMovement.DestinationLocationName
                            </MudTd>
                            <MudTd DataLabel="@L["Quantity"]" Style="text-align: right">
                                @contextMovement.Quantity.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="@L["Content Per Unit"]">
                                @if (contextMovement.ProductContent > 0)
                                {
                                    @contextMovement.ProductContent.ToString("N2")
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Total Content"]" Style="text-align: right">
                                @if (contextMovement.IndividualUnits > 0)
                                {
                                    @contextMovement.IndividualUnits.ToString("N2")
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Unit"]">@contextMovement.UnitMeasureName</MudTd>
                            <MudTd DataLabel="@L["Reference"]">@contextMovement.Reference</MudTd>
                            <MudTd DataLabel="@L["Reason"]">@contextMovement.Reason</MudTd>
                            <MudTd DataLabel="@L["Created By"]">@contextMovement.CreatedBy</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                        <NoRecordsContent>
                            <MudText>@L["No transfers found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                }
                else
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private MudTable<InventoryMovementDto> _table = null!;
    private List<WarehouseDto> _warehouses = new();
    private TimeZoneInfo? _companyTimeZone;
    private bool _loading = true;
    private bool _initialized = false;
    private string _searchString = "";
    private int? _selectedSourceWarehouse;
    private int? _selectedDestinationWarehouse;
    private DateRange _dateRange = new(DateTime.Today.AddDays(-30), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadWarehouses();
            _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
            _initialized = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing component");
            Snackbar.Add(L["Error initializing component"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var (_, items) = await WarehouseService.GetWarehousesAsync(
                pageSize: 100, 
                isActive: true);
            _warehouses = items.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading warehouses");
            Snackbar.Add(L["Error loading warehouses"], Severity.Error);
        }
    }

    private async Task<TableData<InventoryMovementDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            if (!_initialized)
            {
                return new TableData<InventoryMovementDto> 
                { 
                    TotalItems = 0, 
                    Items = Enumerable.Empty<InventoryMovementDto>() 
                };
            }

            _loading = true;

            var (transfers, totalCount) = await InventoryHistoryService.GetTransferHistoryAsync(
                _selectedSourceWarehouse,
                _selectedDestinationWarehouse,
                _dateRange.Start,
                _dateRange.End,
                _searchString,
                state.Page,
                state.PageSize,
                cancellationToken);

            return new TableData<InventoryMovementDto> 
            { 
                TotalItems = totalCount, 
                Items = transfers 
            };
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Transfer data loading was cancelled");
            return new TableData<InventoryMovementDto> 
            { 
                TotalItems = 0, 
                Items = Enumerable.Empty<InventoryMovementDto>() 
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading transfers");
            Snackbar.Add(L["Error loading transfers"], Severity.Error);
            return new TableData<InventoryMovementDto> 
            { 
                TotalItems = 0, 
                Items = Enumerable.Empty<InventoryMovementDto>() 
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenTransferDialog()
    {
        try
        {
            var parameters = new DialogParameters
            {
                { "Warehouses", _warehouses }
            };

            var dialog = await DialogService.ShowAsync<CreateTransferDialog>(
                L["New Transfer"],
                parameters,
                new DialogOptions
                {
                    MaxWidth = MaxWidth.Large,
                    FullWidth = true,
                    CloseButton = true,
                    BackdropClick = true
                });

            var result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                await _table.ReloadServerData();
                Snackbar.Add(L["Transfer created successfully"], Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening transfer dialog");
            Snackbar.Add(L["Error creating transfer"], Severity.Error);
        }
    }

    private void ExportToExcel()
    {
        try
        {            
            // Build query parameters
            var queryParams = new List<string>
            {
                $"pageSize={ExportOptions.Value.MaxExportRecords}"
            };
                    
            if (_selectedSourceWarehouse.HasValue)
                queryParams.Add($"sourceLocationId={_selectedSourceWarehouse.Value}");

            if (_selectedDestinationWarehouse.HasValue)
                queryParams.Add($"destinationLocationId={_selectedDestinationWarehouse.Value}");
                        
            if (_dateRange.Start.HasValue)
                queryParams.Add($"startDate={Uri.EscapeDataString(_dateRange.Start.Value.ToString("O"))}");
                        
            if (_dateRange.End.HasValue)
                queryParams.Add($"endDate={Uri.EscapeDataString(_dateRange.End.Value.ToString("O"))}");
                        
            if (!string.IsNullOrEmpty(_searchString))
                queryParams.Add($"searchString={Uri.EscapeDataString(_searchString)}");

            var queryString = queryParams.Any() ? $"?{string.Join("&", queryParams)}" : "";
            var exportUrl = $"api/InventoryExport/exportTransfers{queryString}";

            NavigationManager.NavigateTo(exportUrl, true);
            Snackbar.Add(L["Export started"], Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting transfers");
            Snackbar.Add(L["Error exporting transfers"], Severity.Error);
        }
    }

    private async Task OnDateRangeChanged()
    {
        await _table.ReloadServerData();
    }

    private async Task OnSourceWarehouseFilterChange()
    {
        await _table.ReloadServerData();
    }

    private async Task OnDestinationWarehouseFilterChange()
    {
        await _table.ReloadServerData();
    }

    private async Task OnSearchChanged()
    {
        await _table.ReloadServerData();
    }

    private string GetMovementTypeDisplay(string movementType) => 
        MovementService.GetMovementTypeDisplay(movementType);

    private string GetMovementSubTypeDisplay(string movementSubType) => 
        MovementService.GetMovementSubTypeDisplay(movementSubType);

    private Color GetMovementTypeColor(string movementType) => 
        MovementService.GetMovementTypeColor(movementType);

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            var convertedTime = DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
            return convertedTime;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }
}