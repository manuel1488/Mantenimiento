@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop

@inject ICashRegisterService CashRegisterService
@inject IStringLocalizer<CloseCashRegisterDialog> L
@inject ISnackbar Snackbar
@inject ILogger<CloseCashRegisterDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-3" />
            @L["Close Cash Register"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <!-- Session Summary — 4 stat cards in one compact row -->
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 rounded" Style="background: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Initial Fund"]</MudText>
                    <MudText Typo="Typo.body2"><strong>@Register.InitialFund.ToString("C2")</strong></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 rounded" Style="background: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Deposits"]</MudText>
                    <MudText Typo="Typo.body2"><strong>@Register.TotalDeposits.ToString("C2")</strong></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 rounded" Style="background: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Withdrawals"]</MudText>
                    <MudText Typo="Typo.body2"><strong>@Register.TotalWithdrawals.ToString("C2")</strong></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 rounded" Style="background: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Expected Cash"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary"><strong>@Register.ExpectedCash.ToString("C2")</strong></MudText>
                </MudPaper>
            </MudItem>

            <!-- Bills -->
            <MudItem xs="12" sm="5">
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Bills"]</MudText>
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <th>@L["Denomination"]</th>
                            <th style="width: 90px;">@L["Quantity"]</th>
                            <th class="text-right">@L["Subtotal"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _bills)
                        {
                            <tr>
                                <td>@entry.Value.ToString("C2")</td>
                                <td>
                                    <MudNumericField T="int"
                                                     @bind-Value="entry.Quantity"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Margin="Margin.Dense"
                                                     Class="my-0" />
                                </td>
                                <td class="text-right">@((entry.Value * entry.Quantity).ToString("C2"))</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>

            <!-- Coins -->
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Coins"]</MudText>
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <th>@L["Denomination"]</th>
                            <th style="width: 90px;">@L["Quantity"]</th>
                            <th class="text-right">@L["Subtotal"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _coins)
                        {
                            <tr>
                                <td>@entry.Value.ToString("C2")</td>
                                <td>
                                    <MudNumericField T="int"
                                                     @bind-Value="entry.Quantity"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Margin="Margin.Dense"
                                                     Class="my-0" />
                                </td>
                                <td class="text-right">@((entry.Value * entry.Quantity).ToString("C2"))</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>

            <!-- Totals + Notes — tercera columna, alineados con las tablas -->
            <MudItem xs="12" sm="3" Class="d-flex flex-column gap-2">
                <MudDivider />
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr>
                            <td>@L["Total Counted"]</td>
                            <td class="text-right"><strong>@TotalCounted.ToString("C2")</strong></td>
                        </tr>
                        <tr>
                            <td>@L["Expected Cash"]</td>
                            <td class="text-right"><strong>@Register.ExpectedCash.ToString("C2")</strong></td>
                        </tr>
                        <tr>
                            <td><strong>@L["Difference"]</strong></td>
                            <td class="text-right">
                                <MudText Color="@DifferenceColor">
                                    <strong>@DifferenceLabel</strong>
                                </MudText>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
                <MudTextField @bind-Value="_closingNotes"
                              Label="@L["Closing notes (optional)"]"
                              Variant="Variant.Outlined"
                              Lines="3" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_processing">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CloseRegister"
                   Disabled="@_processing">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                @L["Closing..."]
            }
            else
            {
                @L["Close Register"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public CashRegisterDto Register { get; set; } = null!;

    private bool _processing;
    private string? _closingNotes;
    private List<DenominationEntry> _bills = [];
    private List<DenominationEntry> _coins = [];

    private decimal TotalCounted =>
        _bills.Sum(e => e.Value * e.Quantity) + _coins.Sum(e => e.Value * e.Quantity);

    private decimal Difference => TotalCounted - Register.ExpectedCash;

    private Color DifferenceColor => Difference switch
    {
        > 0 => Color.Warning,
        < 0 => Color.Error,
        _ => Color.Success
    };

    private string DifferenceLabel
    {
        get
        {
            var diff = Difference;
            if (diff > 0) return $"+{diff:C2} ({L["Surplus"]})";
            if (diff < 0) return $"{diff:C2} ({L["Shortage"]})";
            return $"{diff:C2} ({L["Balanced"]})";
        }
    }

    protected override void OnInitialized()
    {
        _bills =
        [
            new(1000m), new(500m), new(200m),
            new(100m),  new(50m),  new(20m)
        ];
        _coins =
        [
            new(20m),   new(10m), new(5m),   new(2m),
            new(1m),    new(0.50m)
        ];
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task CloseRegister()
    {
        _processing = true;

        var denominationCounts = new Dictionary<decimal, int>();
        foreach (var e in _bills.Concat(_coins))
        {
            if (e.Quantity > 0)
                denominationCounts[e.Value] = e.Quantity;
        }

        var dto = new CloseCashRegisterDto
        {
            CashRegisterId = Register.Id,
            ClosingNotes = string.IsNullOrWhiteSpace(_closingNotes) ? null : _closingNotes,
            DenominationCounts = denominationCounts
        };

        var result = await CashRegisterService.CloseCashRegisterAsync(dto);
        _processing = false;

        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cash register closed successfully"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private sealed class DenominationEntry(decimal value)
    {
        public decimal Value { get; } = value;
        public int Quantity { get; set; }
    }
}
