@page "/shop/cash-register"
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using App.Shared.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewCashRegister)]

@inject ICashRegisterService CashRegisterService
@inject ICurrentUserService CurrentUserService
@inject IDialogService DialogService
@inject IStringLocalizer<CashRegisterPage> L
@inject ISnackbar Snackbar
@inject ILogger<CashRegisterPage> Logger

<PageTitle>@L["Cash Register"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Cash Register"]</MudText>

@if (_loading)
{
    <div class="d-flex justify-center mt-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_register == null)
{
    <MudPaper Elevation="2" Class="pa-8 text-center">
        <MudIcon Icon="@Icons.Material.Filled.PointOfSale"
                 Color="Color.Default"
                 Style="font-size: 72px;" />
        <MudText Typo="Typo.h5" Class="mt-4">@L["No Cash Register Open"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            @L["Open a cash register to start processing sales"]
        </MudText>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.LockOpen"
                   Size="Size.Large"
                   OnClick="OpenRegisterDialog">
            @L["Open Cash Register"]
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.History"
                   Size="Size.Large"
                   Class="ml-2"
                   Href="/shop/cash-register/history">
            @L["View History"]
        </MudButton>
    </MudPaper>
}
else
{
    <!-- Session Header -->
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" md="7">
                <div class="d-flex align-center gap-2 mb-1">
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Session Open"]</MudChip>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["Location"]: <strong>@_register.LocationName</strong> |
                    @L["Cashier"]: <strong>@_register.UserName</strong> |
                    @L["Opened At"]: <strong>@_register.OpenedAt.ToLocalTime().ToString("g")</strong>
                </MudText>
            </MudItem>
            <MudItem xs="12" md="5" Class="d-flex justify-end gap-2 flex-wrap">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowCircleUp"
                           Color="Color.Error"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="@(() => OpenMovementDialog(CashRegisterMovementType.Withdrawal))">
                    @L["Add Withdrawal"]
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.ArrowCircleDown"
                           Color="Color.Success"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="@(() => OpenMovementDialog(CashRegisterMovementType.Deposit))">
                    @L["Add Deposit"]
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Print"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           Href="@($"/shop/cash-register/report/{_register.Id}")">
                    @L["Print Report"]
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.History"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           Href="/shop/cash-register/history">
                    @L["View History"]
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Lock"
                           Color="Color.Error"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           OnClick="OpenCloseDialog">
                    @L["Close Cash Register"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Summary Cards -->
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Initial Fund"]</MudText>
                <MudText Typo="Typo.h6">@_register.InitialFund.ToString("C2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Cash Sales"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">@_register.TotalCashSales.ToString("C2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Deposits"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">@_register.TotalDeposits.ToString("C2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Withdrawals"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error">@_register.TotalWithdrawals.ToString("C2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="8" md="4">
            <MudPaper Elevation="2" Class="pa-4 text-center" Style="border: 2px solid var(--mud-palette-primary);">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Expected Cash"]</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@_register.ExpectedCash.ToString("C2")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <!-- Payment Summary -->
        @if (_register.PaymentSummary.Count > 0)
        {
            <MudItem xs="12" md="5">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["Payment Summary"]</MudText>
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th>@L["Payment Method"]</th>
                                <th class="text-right">@L["Transactions"]</th>
                                <th class="text-right">@L["Total"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ps in _register.PaymentSummary)
                            {
                                <tr>
                                    <td>@ps.Name</td>
                                    <td class="text-right">@ps.TransactionCount</td>
                                    <td class="text-right">@ps.TotalAmount.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
        }

        <!-- Movements -->
        <MudItem xs="12" md="@(_register.PaymentSummary.Count > 0 ? 7 : 12)">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Movements"]</MudText>
                @if (_register.Movements.Count == 0)
                {
                    <MudText Color="Color.Secondary">@L["No movements registered"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>@L["Type"]</th>
                                <th>@L["Reason"]</th>
                                <th class="text-right">@L["Amount"]</th>
                                <th>@L["Date"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _register.Movements.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td>
                                        <MudChip T="string"
                                                 Color="@(m.Type == CashRegisterMovementType.Withdrawal ? Color.Error : Color.Success)"
                                                 Size="Size.Small">
                                            @(m.Type == CashRegisterMovementType.Withdrawal ? L["Withdrawal"] : L["Deposit"])
                                        </MudChip>
                                    </td>
                                    <td>@m.Reason</td>
                                    <td class="text-right">
                                        <MudText Color="@(m.Type == CashRegisterMovementType.Withdrawal ? Color.Error : Color.Success)">
                                            @(m.Type == CashRegisterMovementType.Withdrawal ? "-" : "+")@m.Amount.ToString("C2")
                                        </MudText>
                                    </td>
                                    <td>@m.CreatedAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    #region Fields
    private bool _loading = true;
    private CashRegisterDto? _register;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadCashRegister();
    }
    #endregion

    #region Methods
    private async Task LoadCashRegister()
    {
        _loading = true;
        try
        {
            await CurrentUserService.EnsureInitializedAsync();
            var result = await CashRegisterService.GetActiveCashRegisterByUserAsync(
                CurrentUserService.UserId);
            if (result.IsSuccess)
                _register = result.Value;
            else
                Snackbar.Add(result.Error, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cash register");
            Snackbar.Add(L["Error loading cash register"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenRegisterDialog()
    {
        var options = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<OpenCashRegisterDialog>(L["Open Cash Register"], options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _register = (CashRegisterDto)result.Data!;
        }
    }

    private async Task OpenMovementDialog(CashRegisterMovementType type)
    {
        var parameters = new DialogParameters
        {
            [nameof(MovementDialog.CashRegisterId)] = _register!.Id,
            [nameof(MovementDialog.MovementType)] = type
        };
        var title = type == CashRegisterMovementType.Withdrawal ? L["Add Withdrawal"] : L["Add Deposit"];
        var options = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MovementDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadCashRegister();
        }
    }

    private async Task OpenCloseDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(CloseCashRegisterDialog.Register)] = _register!
        };
        var options = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CloseCashRegisterDialog>(L["Close Cash Register"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _register = null;
        }
    }
    #endregion
}
