@page "/shop/cash-register/history"
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using App.Shared.Services
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewCashRegisterHistory)]

@inject ICashRegisterService CashRegisterService
@inject ICurrentUserService CurrentUserService
@inject IStringLocalizer<CashRegisterHistoryPage> L
@inject ISnackbar Snackbar
@inject ILogger<CashRegisterHistoryPage> Logger

<PageTitle>@L["Cash Register History"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Cash Register History"]</MudText>

<!-- Filters -->
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudDatePicker @bind-Date="_startDate"
                           Label="@L["Start Date"]"
                           Variant="Variant.Outlined"
                           DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudDatePicker @bind-Date="_endDate"
                           Label="@L["End Date"]"
                           Variant="Variant.Outlined"
                           DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterAlt"
                       OnClick="@(() => _grid?.ReloadServerData())"
                       FullWidth="true">
                @L["Filter"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- History Grid -->
<MudPaper Elevation="2" Class="pa-0">
    <MudDataGrid T="CashRegisterDto"
                 @ref="_grid"
                 ServerData="LoadServerData"
                 SortMode="SortMode.None"
                 RowsPerPage="20"
                 Dense="true"
                 Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="@L["ID"]" />
            <PropertyColumn Property="x => x.LocationName" Title="@L["Location"]" />
            <PropertyColumn Property="x => x.UserName" Title="@L["Cashier"]" />
            <TemplateColumn Title="@L["Opened At"]">
                <CellTemplate>
                    @context.Item.OpenedAt.ToLocalTime().ToString("g")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Closed At"]">
                <CellTemplate>
                    @if (context.Item.ClosedAt.HasValue)
                    {
                        @context.Item.ClosedAt.Value.ToLocalTime().ToString("g")
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Initial Fund"]">
                <CellTemplate>
                    @context.Item.InitialFund.ToString("C2")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Status"]">
                <CellTemplate>
                    <MudChip T="string"
                             Color="@(context.Item.Status == CashRegisterStatus.Open ? Color.Success : Color.Default)"
                             Size="Size.Small">
                        @(context.Item.Status == CashRegisterStatus.Open ? L["Open"] : L["Closed"])
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Actions"]">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Assessment"
                                   title="@L["View Report"]"
                                   Color="Color.Primary"
                                   Href="@($"/shop/cash-register/report/{context.Item.Id}")" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="CashRegisterDto" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    #region Fields
    private MudDataGrid<CashRegisterDto>? _grid;
    private DateTime? _startDate;
    private DateTime? _endDate;
    #endregion

    #region Methods
    private async Task<GridData<CashRegisterDto>> LoadServerData(GridState<CashRegisterDto> state)
    {
        try
        {
            await CurrentUserService.EnsureInitializedAsync();
            var locationId = CurrentUserService.ActiveLocationId;
            var (total, items) = await CashRegisterService.GetHistoryAsync(
                locationId,
                page: state.Page + 1,
                pageSize: state.PageSize,
                startDate: _startDate,
                endDate: _endDate?.AddDays(1));

            return new GridData<CashRegisterDto> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cash register history");
            Snackbar.Add(L["Error loading history"], Severity.Error);
            return new GridData<CashRegisterDto> { Items = [], TotalItems = 0 };
        }
    }
    #endregion
}
