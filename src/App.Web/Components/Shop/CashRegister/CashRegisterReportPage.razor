@page "/shop/cash-register/report/{Id:long}"
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewCashRegisterReport)]

@inject ICashRegisterService CashRegisterService
@inject IStringLocalizer<CashRegisterReportPage> L
@inject ISnackbar Snackbar
@inject ILogger<CashRegisterReportPage> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@L["Cash Register Report"]</PageTitle>

<!-- Toolbar (no-print) -->
<div class="no-print mb-4">
    <MudPaper Elevation="2" Class="pa-3 d-flex gap-2 align-center flex-wrap">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/shop/cash-register/history"
                   Variant="Variant.Text">
            @L["Back"]
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   OnClick="ToggleFormat">
            @(_isTicket ? L["Switch to Letter"] : L["Switch to Ticket"])
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Print"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Print">
            @L["Print"]
        </MudButton>
    </MudPaper>
</div>

@if (_loading)
{
    <div class="d-flex justify-center mt-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_report == null)
{
    <MudAlert Severity="Severity.Error">@L["Report not found"]</MudAlert>
}
else if (_isTicket)
{
    <!-- 80mm Ticket Format -->
    <div class="ticket-container">
        <div style="text-align: center; margin-bottom: 8px;">
            <strong style="font-size: 14px;">@_report.CompanyName</strong><br />
            <span style="font-size: 11px;">@L["Cash Register Report"]</span><br />
            <span style="font-size: 10px;"># @_report.CashRegisterId</span>
        </div>
        <div class="ticket-divider"></div>
        <div style="font-size: 11px; margin-bottom: 4px;">
            <div>@L["Location"]: @_report.LocationName</div>
            <div>@L["Cashier"]: @_report.CashierName</div>
            <div>@L["Opened At"]: @_report.OpenedAt.ToLocalTime().ToString("g")</div>
            @if (_report.ClosedAt.HasValue)
            {
                <div>@L["Closed At"]: @_report.ClosedAt.Value.ToLocalTime().ToString("g")</div>
            }
        </div>
        <div class="ticket-divider"></div>
        <table style="width: 100%; font-size: 11px; border-collapse: collapse;">
            <tr>
                <td>@L["Initial Fund"]</td>
                <td style="text-align:right;">@_report.InitialFund.ToString("C2")</td>
            </tr>
            <tr>
                <td>@L["Cash Sales"]</td>
                <td style="text-align:right;">@_report.TotalCashSales.ToString("C2")</td>
            </tr>
            <tr>
                <td>@L["Deposits"]</td>
                <td style="text-align:right;">@_report.TotalDeposits.ToString("C2")</td>
            </tr>
            <tr>
                <td>@L["Withdrawals"]</td>
                <td style="text-align:right;">(@_report.TotalWithdrawals.ToString("C2"))</td>
            </tr>
            <tr style="font-weight: bold; border-top: 1px solid #000;">
                <td>@L["Expected Cash"]</td>
                <td style="text-align:right;">@_report.ExpectedCash.ToString("C2")</td>
            </tr>
            @if (_report.CountedCash != 0)
            {
                <tr style="font-weight: bold;">
                    <td>@L["Counted Cash"]</td>
                    <td style="text-align:right;">@_report.CountedCash.ToString("C2")</td>
                </tr>
                <tr style="font-weight: bold; color: @(_report.Difference >= 0 ? "green" : "red");">
                    <td>@L["Difference"]</td>
                    <td style="text-align:right;">@(_report.Difference >= 0 ? "+" : "")@_report.Difference.ToString("C2")</td>
                </tr>
            }
        </table>
        @if (_report.Movements.Count > 0)
        {
            <div class="ticket-divider"></div>
            <div style="font-size: 11px; font-weight: bold; margin-bottom: 4px;">@L["Movements"]</div>
            @foreach (var m in _report.Movements)
            {
                <table style="width: 100%; font-size: 10px; margin-bottom: 2px;">
                    <tr>
                        <td>@(m.Type == CashRegisterMovementType.Withdrawal ? L["Withdrawal"] : L["Deposit"])</td>
                        <td style="text-align:right; font-weight: bold;">
                            @(m.Type == CashRegisterMovementType.Withdrawal ? "-" : "+")@m.Amount.ToString("C2")
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="color: gray; font-size: 9px;">@m.Reason — @m.CreatedAt.ToLocalTime().ToString("t")</td>
                    </tr>
                </table>
            }
        }
        <div class="ticket-divider"></div>
        <div style="text-align: center; font-size: 10px; margin-top: 8px;">
            @L["Cashier Signature"]<br />
            ___________________________<br />
            <span style="font-size: 9px;">@_report.CashierName</span>
        </div>
    </div>
}
else
{
    <!-- Letter Format -->
    <div class="letter-container">
        <!-- Header -->
        <div class="report-header">
            <h1>@_report.CompanyName</h1>
            <h2>@L["Cash Register Report"]</h2>
            <p style="color: #666; margin: 0;">@L["Register"] #@_report.CashRegisterId</p>
        </div>

        <!-- Session Info -->
        <table class="info-table">
            <tr>
                <td><strong>@L["Location"]:</strong> @_report.LocationName</td>
                <td><strong>@L["Cashier"]:</strong> @_report.CashierName</td>
            </tr>
            <tr>
                <td><strong>@L["Opened At"]:</strong> @_report.OpenedAt.ToLocalTime().ToString("g")</td>
                <td>
                    @if (_report.ClosedAt.HasValue)
                    {
                        <span><strong>@L["Closed At"]:</strong> @_report.ClosedAt.Value.ToLocalTime().ToString("g")</span>
                    }
                </td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(_report.OpeningNotes))
            {
                <tr>
                    <td colspan="2"><strong>@L["Opening Notes"]:</strong> @_report.OpeningNotes</td>
                </tr>
            }
        </table>

        <!-- Financial Summary -->
        <h3>@L["Financial Summary"]</h3>
        <table class="report-table">
            <thead>
                <tr>
                    <th>@L["Concept"]</th>
                    <th class="text-right">@L["Amount"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@L["Initial Fund"]</td>
                    <td class="text-right">@_report.InitialFund.ToString("C2")</td>
                </tr>
                <tr>
                    <td>@L["Cash Sales"]</td>
                    <td class="text-right">@_report.TotalCashSales.ToString("C2")</td>
                </tr>
                <tr>
                    <td>@L["Deposits"]</td>
                    <td class="text-right">@_report.TotalDeposits.ToString("C2")</td>
                </tr>
                <tr>
                    <td>@L["Withdrawals"]</td>
                    <td class="text-right">(@_report.TotalWithdrawals.ToString("C2"))</td>
                </tr>
                <tr class="summary-row">
                    <td>@L["Expected Cash"]</td>
                    <td class="text-right">@_report.ExpectedCash.ToString("C2")</td>
                </tr>
                @if (_report.CountedCash != 0)
                {
                    <tr class="summary-row">
                        <td>@L["Counted Cash"]</td>
                        <td class="text-right">@_report.CountedCash.ToString("C2")</td>
                    </tr>
                    <tr class="@(_report.Difference >= 0 ? "surplus-row" : "shortage-row")">
                        <td>@L["Difference"]</td>
                        <td class="text-right">@(_report.Difference >= 0 ? "+" : "")@_report.Difference.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Payment Breakdown -->
        @if (_report.PaymentSummary.Count > 0)
        {
            <h3>@L["Payment Summary"]</h3>
            <table class="report-table">
                <thead>
                    <tr>
                        <th>@L["Payment Method"]</th>
                        <th class="text-right">@L["Transactions"]</th>
                        <th class="text-right">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ps in _report.PaymentSummary)
                    {
                        <tr>
                            <td>@ps.PaymentMethodName</td>
                            <td class="text-right">@ps.TransactionCount</td>
                            <td class="text-right">@ps.TotalAmount.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Movements -->
        @if (_report.Movements.Count > 0)
        {
            <h3>@L["Movements"]</h3>
            <table class="report-table">
                <thead>
                    <tr>
                        <th>@L["Type"]</th>
                        <th>@L["Reason"]</th>
                        <th class="text-right">@L["Amount"]</th>
                        <th>@L["Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _report.Movements)
                    {
                        <tr>
                            <td>@(m.Type == CashRegisterMovementType.Withdrawal ? L["Withdrawal"] : L["Deposit"])</td>
                            <td>@m.Reason</td>
                            <td class="text-right">@(m.Type == CashRegisterMovementType.Withdrawal ? "-" : "+")@m.Amount.ToString("C2")</td>
                            <td>@m.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Denominations -->
        @if (_report.Denominations.Count > 0)
        {
            <h3>@L["Denomination Count"]</h3>
            <div style="display: flex; gap: 24px;">
                <div style="flex: 1;">
                    <h4>@L["Bills"]</h4>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>@L["Denomination"]</th>
                                <th class="text-right">@L["Quantity"]</th>
                                <th class="text-right">@L["Subtotal"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _report.Denominations
                                .Where(d => d.DenominationType == DenominationType.Bill)
                                .OrderByDescending(d => d.DenominationValue))
                            {
                                <tr>
                                    <td>@d.DenominationValue.ToString("C2")</td>
                                    <td class="text-right">@d.Quantity</td>
                                    <td class="text-right">@d.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="flex: 1;">
                    <h4>@L["Coins"]</h4>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>@L["Denomination"]</th>
                                <th class="text-right">@L["Quantity"]</th>
                                <th class="text-right">@L["Subtotal"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _report.Denominations
                                .Where(d => d.DenominationType == DenominationType.Coin)
                                .OrderByDescending(d => d.DenominationValue))
                            {
                                <tr>
                                    <td>@d.DenominationValue.ToString("C2")</td>
                                    <td class="text-right">@d.Quantity</td>
                                    <td class="text-right">@d.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_report.ClosingNotes))
        {
            <div class="notes-box">
                <strong>@L["Closing Notes"]:</strong> @_report.ClosingNotes
            </div>
        }

        <!-- Signature Area -->
        <div class="signature-area">
            <div class="signature-block">
                <div class="signature-line"></div>
                <div>@_report.CashierName</div>
                <div class="signature-label">@L["Cashier Signature"]</div>
            </div>
            <div class="signature-block">
                <div class="signature-line"></div>
                <div>__________________</div>
                <div class="signature-label">@L["Supervisor Signature"]</div>
            </div>
        </div>
    </div>
}

<style>
    .no-print { display: block; }

    .letter-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 32px;
        background: white;
        font-family: Arial, sans-serif;
        font-size: 13px;
        color: #333;
    }

    .report-header {
        text-align: center;
        border-bottom: 2px solid #333;
        padding-bottom: 16px;
        margin-bottom: 20px;
    }

    .report-header h1 { margin: 0; font-size: 22px; }
    .report-header h2 { margin: 4px 0; font-size: 16px; color: #555; }

    .info-table { width: 100%; margin-bottom: 20px; border-collapse: collapse; }
    .info-table td { padding: 4px 8px; }

    .report-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    .report-table th { padding: 8px; text-align: left; background-color: #f5f5f5; border: 1px solid #ddd; }
    .report-table td { padding: 7px 8px; border: 1px solid #ddd; }
    .report-table .text-right { text-align: right; }
    .report-table .summary-row { font-weight: bold; background-color: #f0f4f8; }
    .report-table .surplus-row { font-weight: bold; color: #2e7d32; }
    .report-table .shortage-row { font-weight: bold; color: #c62828; }

    .notes-box {
        margin: 16px 0;
        padding: 12px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .signature-area {
        margin-top: 48px;
        display: flex;
        justify-content: space-around;
    }

    .signature-block { text-align: center; width: 200px; font-size: 12px; }
    .signature-line { border-top: 1px solid #333; margin-bottom: 6px; }
    .signature-label { color: #666; font-size: 11px; margin-top: 4px; }

    /* Ticket */
    .ticket-container {
        max-width: 300px;
        margin: 0 auto;
        padding: 16px;
        background: white;
        font-family: 'Courier New', monospace;
    }

    .ticket-divider {
        border-top: 1px dashed #000;
        margin: 6px 0;
    }

    @@media print {
        .no-print { display: none !important; }
        body { background: white; }
        .letter-container, .ticket-container { margin: 0; padding: 12px; max-width: 100%; }
    }
</style>

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name = "format")] public string? Format { get; set; }

    private bool _loading = true;
    private CashRegisterReportDto? _report;
    private bool _isTicket;

    protected override async Task OnInitializedAsync()
    {
        _isTicket = string.Equals(Format, "ticket", StringComparison.OrdinalIgnoreCase);
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        var result = await CashRegisterService.GetReportDataAsync(Id);
        if (result.IsSuccess)
            _report = result.Value;
        else
            Snackbar.Add(result.Error, Severity.Error);
        _loading = false;
    }

    private async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void ToggleFormat()
    {
        _isTicket = !_isTicket;
        var uri = NavigationManager.GetUriWithQueryParameter("format", _isTicket ? "ticket" : (string?)null);
        NavigationManager.NavigateTo(uri);
    }
}
