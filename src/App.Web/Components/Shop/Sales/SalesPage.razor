    };

    private async Task ProcessSale()
    {
        // Verificar si hay un descuento sin autorizar
        if (_model.DiscountPercentage > 0 && _discountAuthorizerId == null)
        {
            // Mostrar diálogo de autorización
            var dialog = await DialogService.ShowAsync<DiscountAuthorizationDialog>(L["Discount Authorization"]);
            var result = await dialog.Result;

            if (result != null && result.Canceled)
            {
                Snackbar.Add(L["Discount authorization was canceled. Sale cannot be completed."], Severity.Warning);
                return; // Salir sin procesar la venta
            }
            else if (result != null && !result.Canceled && result.Data != null)
            {
                // Guardar información de autorización
                var authorization = (DiscountAuthorizationDialog.DiscountAuthorization)result.Data;
                _discountAuthorizerId = authorization.AuthorizerId;
                _model.DiscountAuthorizedBy = authorization.AuthorizerName;
                _discountAuthorizedAt = authorization.AuthorizedAt;

                Snackbar.Add(L["Discount authorized successfully"], Severity.Success);
            }
        }

        if (!IsFormValid())
        {
            Snackbar.Add(L["Please complete all required fields"], Severity.Warning);
            return;
        }

        // Continuar con el resto de la lógica de procesamiento de venta...
        _isBusy = true;
        StateHasChanged();

        try
        {
            // Prepare sale details
            _model.CustomerId = _selectedCustomer!.Id;
            _model.SaleDate = DateTimeService.Now;
            _model.LocationId = _activeCashRegister?.LocationId;

            // Información de autorización para la venta completa
            _model.DiscountAuthorizerId = _discountAuthorizerId;
            _model.DiscountAuthorizedAt = _discountAuthorizedAt;

            // Map payment entries
            _model.Payments = _paymentEntries.Select(e => new CreateSalePaymentDto
            {
                PaymentMethodId = e.PaymentMethod.Id,
                Amount = e.Amount,
                CardLastFour = e.CardLastFour,
                AuthorizationCode = e.AuthorizationCode,
                CardBrand = e.CardBrand,
                Reference = e.Reference
            }).ToList();

            // Detalles sin información de autorización a nivel de producto
            _model.Details = _cart.Select(item => new CreateSaleDetailDto
            {
                ProductId = item.ProductId,
                Quantity = item.Quantity,
                DiscountPercentage = 0, // No hay descuento a nivel de producto
                IsDiscountAuthorized = false,
                DiscountAuthorizerId = null,
                DiscountAuthorizedBy = null,
                DiscountAuthorizedAt = null,
                IsCustomPrice = item.AllowCustomPricing && Math.Abs(item.UnitPrice - item.OriginalPrice) > 0.001M,
                PartialSaleFractionId = item.PartialSaleFractionId
            }).ToList();

            // Create the sale
            var result = await SaleService.CreateSaleAsync(_model);

            if (result.IsSuccess)
            {
                Snackbar.Add(L["Sale completed successfully"], Severity.Success);

                // Refresh cash register to get updated ExpectedCash
                await LoadActiveCashRegisterAsync();

                // Non-strict warning: notify if limit reached
                if (_cashSettings is { IsStrictCashLimit: false, MaxCashLimit: not null } &&
                    _activeCashRegister?.ExpectedCash >= _cashSettings.MaxCashLimit)
                {
                    Snackbar.Add(
                        L["Cash register has reached the limit ({0:C}). Please make a withdrawal.",
                          _cashSettings.MaxCashLimit],
                        Severity.Warning,
                        cfg => cfg.VisibleStateDuration = 8000);
                }

                // 1st: direct thermal print via ePOS SDK (silent, no dialog)
                var printResult = await ThermalPrinter.PrintSaleAsync(result.Value!.Id);
                if (!printResult.IsSuccess)
                {
                    // 2nd: browser popup (silent with Chrome --kiosk-printing, or shows OS dialog otherwise)
                    try
                    {
                        await JS.InvokeVoidAsync("printTicket", TicketService.GetSaleTicketUrl(result.Value!.Id));
                    }
                    catch (Exception printEx)
                    {
                        // 3rd: receipt modal as last resort
                        Logger.LogWarning(printEx, "printTicket failed, opening receipt dialog");
                        await DialogService.ShowAsync<SaleReceiptDialog>(
                            L["Sale Receipt"],
                            new DialogParameters<SaleReceiptDialog> { { x => x.SaleId, result.Value!.Id } });
                    }
                }

                // Auto-invoice logic
                // Prompt threshold: MX customer with RFC is enough to ask
                bool isMexicoWithRfc = _selectedCustomer!.CountryCode == "MX"
                    && !string.IsNullOrEmpty(_selectedCustomer.TaxId);

                if (isMexicoWithRfc && _pacSettings != null)
                {
                    if (_selectedCustomer.AutoInvoice)
                    {
                        // Silent auto-invoice: needs all CFDI fields (HasFiscalData) + PAC configured
                        if (_selectedCustomer.HasFiscalData && _pacSettings.IsConfigured)
                            await AutoGenerateInvoiceAsync(result.Value!.Id);
                        else if (_pacSettings.AutoInvoicePromptEnabled)
                            // Incomplete data or PAC not ready → fall back to prompt
                            await ShowInvoicePromptAsync(result.Value!.Id, result.Value!.Total);
                        else
                            Snackbar.Add(L["Auto-invoice failed. You can generate it from sales history."], Severity.Warning);
                    }
                    else if (_pacSettings.AutoInvoicePromptEnabled)
                    {
                        await ShowInvoicePromptAsync(result.Value!.Id, result.Value!.Total);
                    }
                }

                // Clear form for next sale
                await ClearCartAndFormAsync();
            }
            else
            {
                Snackbar.Add(result.Error!, Severity.Error);
                Logger.LogError("Error creating sale: {Error}", result.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing sale");
            Snackbar.Add(L["Error processing sale: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task AutoGenerateInvoiceAsync(long saleId)
    {
        try
        {
            var dto = new CreateMexicoInvoiceDto
            {
                SaleId = saleId,
                CfdiUse = _selectedCustomer!.DefaultCfdiUse ?? "G03",
                PaymentForm = "01",
                PaymentMethod = "PUE",
                CustomerRfc = _selectedCustomer.TaxId ?? string.Empty,
                CustomerLegalName = _selectedCustomer.LegalName ?? string.Empty,
                CustomerPostalCode = _selectedCustomer.PostalCode ?? string.Empty,
                CustomerFiscalRegime = _selectedCustomer.FiscalRegime ?? string.Empty,
                SendToEmail = _selectedCustomer.SendInvoiceEmail ? _selectedCustomer.Email : null
            };

            var invoiceResult = await InvoiceService.CreateAndStampAsync(dto);
            if (invoiceResult.IsSuccess)
                Snackbar.Add(L["Invoice generated automatically"] + $" ({invoiceResult.Value!.FolioDisplay})", Severity.Success);
            else
                Snackbar.Add(L["Auto-invoice failed. You can generate it from sales history."], Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error auto-generating invoice for sale {SaleId}", saleId);
            Snackbar.Add(L["Auto-invoice error. You can generate it from sales history."], Severity.Warning);
        }
    }

    private async Task ShowInvoicePromptAsync(long saleId, decimal saleTotal)
    {
        var parameters = new DialogParameters<InvoicePromptDialog>
        {
            { x => x.SaleId, saleId },
            { x => x.SaleTotal, saleTotal },
            { x => x.CustomerName, _selectedCustomer!.Name },
            { x => x.CustomerRfc, _selectedCustomer.TaxId },
            { x => x.CustomerLegalName, _selectedCustomer.LegalName },
            { x => x.CustomerPostalCode, _selectedCustomer.PostalCode },
            { x => x.CustomerFiscalRegime, _selectedCustomer.FiscalRegime },
            { x => x.CustomerEmail, _selectedCustomer.Email },
            { x => x.CustomerDefaultCfdiUse, _selectedCustomer.DefaultCfdiUse },
            { x => x.CustomerSendEmail, _selectedCustomer.SendInvoiceEmail },
            { x => x.AllowEditFiscalData, _pacSettings!.AllowEditFiscalDataInPrompt }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        await DialogService.ShowAsync<InvoicePromptDialog>(L["Invoice?"], parameters, options);
    }

    private async Task ClearCartAndFormAsync()
    {
        _cart.Clear();
        _paymentEntries.Clear();
        _discountAuthorizerId = null;
        _model = new CreateSaleDto
        {
            SaleType = SaleType.Public,
            DiscountPercentage = 0,
            Details = new List<CreateSaleDetailDto>(),
            Payments = new List<CreateSalePaymentDto>()
        };

        await LoadDefaultCustomerAsync();
        await UpdateTotalsAsync();
        await _productAutocomplete.FocusAsync();
    }

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            return DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }

    private bool IsLikelyBarcode(string text)
    {
        return !string.IsNullOrWhiteSpace(text) &&
            text.Length >= 8 &&
            text.All(char.IsDigit);
    }

    private static bool IsBulkProductBarcode(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || !text.Contains('|')) return false;
        var parts = text.Split('|');
        return parts.Length == 3
            && long.TryParse(parts[1], out _)
            && long.TryParse(parts[2], out _);
    }

    private static (string Code, decimal Quantity, decimal Price) ParseBulkBarcode(string text)
    {
        var parts = text.Split('|');
        return (parts[0].Trim(), long.Parse(parts[1]) / 1000m, long.Parse(parts[2]) / 100m);
    }

