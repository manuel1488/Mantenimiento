@page "/shop/sales-history"
@using App.Core.Constants
@using App.Core.DTOs.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Shop
@using App.Core.Options
@using App.Shared.Services
@using App.Web.Components.Shared.Dialogs
@using App.Web.Components.Shop.Sales
@using App.Web.Components.Shop.Invoices
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using MudBlazor

@inject ISaleService SaleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<SalesHistoryPage> L
@inject ILogger<SalesHistoryPage> Logger
@inject IDateTime DateTimeService
@inject ICompanySettingsService CompanySettingsService
@inject ICurrentUserService CurrentUserService
@inject ILocationService LocationService
@inject IUserLocationService UserLocationService
@inject IOptions<ExportOptions> ExportOptions

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewHistorySales)]

<PageTitle>@L["Sales History"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <!-- Header Section -->
        <MudItem xs="12" Class="d-flex justify-space-between align-center mb-4 flex-wrap gap-4">
            <MudText Typo="Typo.h4">@L["Sales History"]</MudText>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       Disabled="@_exporting"
                       OnClick="@ExportToExcel"
                       Class="da-button-rounded">
                <div class="d-flex flex-column">
                    <MudText>@L["Export Excel"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Max. {0:N0} records", ExportOptions.Value.MaxExportRecords]
                    </MudText>
                </div>
            </MudButton>
        </MudItem>
        
        <!-- Filters Section -->
        <MudItem xs="12" Class="mb-3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudGrid Spacing="3">
                    <!-- Search Field -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" 
                                     ValueChanged="@(s => OnSearch(s))"
                                     Placeholder="@L["Search sales"]"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     FullWidth/>
                    </MudItem>

                    <!-- Date Range Filter -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker @bind-DateRange="_dateRange" 
                                           Label="@L["Date Range"]" 
                                           AutoClose="true"
                                           AdornmentIcon="@Icons.Material.Filled.DateRange"
                                           PickerClosed="OnDateRangeChanged"/>
                    </MudItem>

                    <!-- Sale Type Filter -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="SaleType?" 
                                  Label="@L["Sale Type"]"
                                  ValueChanged="@(t => OnSaleTypeFilterChange(t))"
                                  AnchorOrigin="Origin.BottomCenter"
                                  FullWidth>
                            <MudSelectItem T="SaleType?" Value="@null">@L["All"]</MudSelectItem>
                            <MudSelectItem T="SaleType?" Value="@SaleType.Public">@L["Public"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- Status Filter -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string"
                                  Label="@L["Status"]"
                                  ValueChanged="@(s => OnStatusFilterChange(s))"
                                  AnchorOrigin="Origin.BottomCenter"
                                  FullWidth>
                            <MudSelectItem T="string" Value="@null">@L["All"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@SaleStatus.Created">@L["Created"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@SaleStatus.Cancelled">@L["Cancelled"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_locations.Count > 0)
                    {
                        <!-- Location Filter -->
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?"
                                      Label="@L["Location"]"
                                      Value="_selectedLocationId"
                                      ValueChanged="@(l => OnLocationFilterChange(l))"
                                      AnchorOrigin="Origin.BottomCenter"
                                      FullWidth>
                                <MudSelectItem T="int?" Value="@((int?)null)">@L["All"]</MudSelectItem>
                                @foreach (var location in _locations)
                                {
                                    <MudSelectItem T="int?" Value="@location.Id">@location.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Table Section -->
        <MudItem xs="12">
            <MudDataGrid T="SaleDto"
                         @ref="_dataGrid"
                         ServerData="@LoadServerData"
                         Dense="true"
                         Hover="true"
                         Loading="@_loading"
                         Striped="true"
                         RowsPerPage="10"
                         Filterable="true"
                         FilterMode="DataGridFilterMode.ColumnFilterMenu"
                         SortMode="SortMode.Single"
                         ColumnResizeMode="ResizeMode.Container">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="@L["Sale #"]" HeaderStyle="width: 50px;"
                                    Sortable="true" Filterable="true" />
                    <PropertyColumn Property="x => x.SaleDate" Title="@L["Date"]" HeaderStyle="width: 95px;"
                                    Sortable="true" Filterable="true">
                        <CellTemplate>
                            @FormatToCompanyTimezone(context.Item.SaleDate)
                        </CellTemplate>
                        <FilterTemplate>
                            <MudDateRangePicker DateRange="@_dateRange"
                                               DateRangeChanged="@(async r => { _dateRange = r; context.FilterDefinition.Value = r; await _dataGrid.ReloadServerData(); })"
                                               AutoClose="true"
                                               AdornmentIcon="@Icons.Material.Filled.DateRange"
                                               Class="mt-n2" />
                        </FilterTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CustomerName" Title="@L["Customer"]"
                                    Sortable="true" Filterable="true" />
                    <PropertyColumn Property="x => x.PaymentMethodName" Title="@L["Payment Method"]"
                                    Sortable="false" Filterable="true">
                        <CellTemplate>
                            @(context.Item.PaymentMethodName ?? "—")
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="@L["Amount"]" HeaderStyle="text-align: right; width: 90px;" CellStyle="text-align: right; white-space: nowrap;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @context.Item.Subtotal.ToString("C")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Discount"]" HeaderStyle="text-align: right; width: 80px;" CellStyle="text-align: right; white-space: nowrap;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @if (context.Item.DiscountAmount > 0)
                            {
                                @context.Item.DiscountAmount.ToString("C")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Subtotal"]" HeaderStyle="text-align: right; width: 90px;" CellStyle="text-align: right; white-space: nowrap;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @((context.Item.Subtotal - context.Item.DiscountAmount).ToString("C"))
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Tax Rate"]" HeaderStyle="text-align: center; width: 45px;" CellStyle="text-align: center; white-space: nowrap;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @((context.Item.TaxRate * 100).ToString("0.##"))%
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Tax"]" HeaderStyle="text-align: right; width: 80px;" CellStyle="text-align: right; white-space: nowrap;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @context.Item.TaxAmount.ToString("C")
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Total" Title="@L["Total"]" HeaderStyle="text-align: right; width: 90px;" CellStyle="text-align: right; white-space: nowrap;"
                                    Sortable="true" Filterable="true">
                        <CellTemplate>
                            @context.Item.Total.ToString("C")
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.LocationName" Title="@L["Location"]" HeaderStyle="width: 90px;"
                                    Sortable="false" Filterable="false" />
                    <TemplateColumn Title="@L["Origin"]" HeaderStyle="width: 120px;"
                                    Sortable="false" Filterable="false">
                        <CellTemplate>
                            @if (context.Item.QuotationNumber is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                                         title="@L["Quotation"]">
                                    @context.Item.QuotationNumber
                                </MudChip>
                            }
                            else if (context.Item.RemissionNumbers is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text"
                                         title="@L["Remission"]">
                                    @context.Item.RemissionNumbers
                                </MudChip>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.CreatedBy" Title="@L["Created By"]" HeaderStyle="width: 100px;"
                                    Sortable="true" Filterable="true">
                        <CellTemplate>
                            @(context.Item.CreatedBy ?? "—")
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Status" Title="@L["Status"]" Sortable="true" Filterable="true" HeaderStyle="width: 75px;">
                        <CellTemplate>
                            <MudChip Size="Size.Small" T="string" Color="@GetStatusColor(context.Item.Status)">
                                @GetStatusDisplayText(context.Item.Status)
                            </MudChip>
                        </CellTemplate>
                        <FilterTemplate>
                            <MudSelect T="string?"
                                       Value="@_columnStatusFilter"
                                       ValueChanged="@(async v => { _columnStatusFilter = v; context.FilterDefinition.Value = v; await _dataGrid.ReloadServerData(); })"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Clearable="true"
                                       Placeholder="@L["All"]"
                                       Class="mt-n2">
                                <MudSelectItem T="string?" Value="@null">@L["All"]</MudSelectItem>
                                <MudSelectItem T="string?" Value="@nameof(App.Core.Enums.Shop.SaleStatus.Created)">@L["Created"]</MudSelectItem>
                                <MudSelectItem T="string?" Value="@nameof(App.Core.Enums.Shop.SaleStatus.Cancelled)">@L["Cancelled"]</MudSelectItem>
                            </MudSelect>
                        </FilterTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false" CellClass="d-flex justify-end">
                        <CellTemplate>
                            @{
                                var sale = context.Item;
                            }
                            <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                                @if (sale.QuotationId.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   OnClick="@(() => Navigation.NavigateTo($"/shop/quotations?search={sale.QuotationNumber}"))"
                                                   title="@L["View quotation"]" />
                                }
                                else if (sale.RemissionNumbers is not null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                                   Size="Size.Small"
                                                   Color="Color.Tertiary"
                                                   OnClick="@(() => Navigation.NavigateTo($"/shop/remissions?search={sale.RemissionNumbers.Split(',')[0].Trim()}"))"
                                                   title="@L["View remission"]" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{sale.Id}"))"
                                               title="@L["View Sale"]" />
                                <MudIconButton Icon="@Icons.Material.Filled.Print"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => OpenReceiptDialog(sale.Id))"
                                               title="@L["Print Receipt"]" />
                                @if (sale.Status == App.Core.Enums.Shop.SaleStatus.Created)
                                {
                                    <AuthorizeView Policy="@ApplicationClaims.Shop.CreateInvoice" Context="invoiceAuth">
                                        <Authorized Context="invoiceCtx">
                                            @{ var cs = _cancellationStatus.GetValueOrDefault(sale.Id); }
                                            @if (cs?.BlockedByInvoice == true)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                                               Size="Size.Small"
                                                               Color="Color.Success"
                                                               OnClick="@(() => Navigation.NavigateTo($"/shop/invoices?saleId={sale.Id}"))"
                                                               title="@L["View Invoice"]" />
                                            }
                                            else if (cs?.BlockedByGlobalInvoice == true)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                                                               Size="Size.Small"
                                                               Color="Color.Success"
                                                               OnClick="@(() => Navigation.NavigateTo($"/admin/global-invoices/{cs.GlobalInvoiceId}"))"
                                                               title="@L["View Global Invoice"]" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Outlined.Receipt"
                                                               Size="Size.Small"
                                                               Color="Color.Default"
                                                               OnClick="@(() => OpenInvoiceDialog(sale))"
                                                               title="@L["Generate Invoice"]" />
                                            }
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                @if (sale.Status == App.Core.Enums.Shop.SaleStatus.Created)
                                {
                                    var cancelStatus = _cancellationStatus.GetValueOrDefault(sale.Id);
                                    if (cancelStatus?.BlockedByInvoice == true)
                                    {
                                        <MudTooltip Text="@L["Cannot cancel — sale has an active invoice. Cancel the invoice first."]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Default"
                                                           Disabled="true" />
                                        </MudTooltip>
                                    }
                                    else if (cancelStatus?.BlockedByGlobalInvoice == true)
                                    {
                                        <MudTooltip Text="@L["Cannot cancel — sale belongs to an active global invoice. Cancel the global invoice first."]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Default"
                                                           Disabled="true" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <AuthorizeView Context="contextCancel" Policy="@ApplicationClaims.Shop.CancelSale">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => OpenCancelDialog(sale))"
                                                           title="@L["Cancel Sale"]" />
                                        </AuthorizeView>
                                    }
                                }
                            </MudButtonGroup>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="SaleDto" />
                </PagerContent>
                <NoRecordsContent>
                    <MudText>@L["No sales found"]</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudItem>
    </MudGrid>
</MudContainer>


@code {
    [SupplyParameterFromQuery(Name = "saleId")]
    public long? FilterSaleId { get; set; }

    private MudDataGrid<SaleDto> _dataGrid = null!;
    private bool _loading;
    private bool _exporting;
    private string _searchString = "";
    private DateRange _dateRange = new();
    private SaleType? _selectedSaleType;
    private string? _selectedStatus;
    private string? _columnStatusFilter;
    private int? _selectedLocationId;
    private string _cancellationReason = "";
    private TimeZoneInfo? _companyTimeZone;
    private IList<App.Core.DTOs.Location.LocationDto> _locations = new List<App.Core.DTOs.Location.LocationDto>();
    private Dictionary<long, SaleCancellationStatusDto> _cancellationStatus = [];

    protected override async Task OnInitializedAsync()
    {
        // Initialize current user service to avoid deadlock when accessing ActiveLocationId synchronously
        await CurrentUserService.EnsureInitializedAsync();

        _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();

        if (FilterSaleId.HasValue)
        {
            // When filtering by specific sale, clear date/location filters
            _dateRange = new DateRange(null, null);
            _selectedLocationId = null;
        }
        else
        {
            // Set default date range to current month
            var today = DateTime.Today;
            var firstDayOfMonth = new DateTime(today.Year, today.Month, 1);
            var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

            _dateRange = new DateRange(firstDayOfMonth, lastDayOfMonth);

            // Default to active location if set
            _selectedLocationId = CurrentUserService.ActiveLocationId;
        }

        // Load locations for filter
        await LoadLocations();
    }

    private async Task LoadLocations()
    {
        if (CurrentUserService.IsGlobalAccess)
        {
            _locations = await LocationService.GetActiveLocationsAsync();
        }
        else
        {
            var userId = CurrentUserService.UserId;
            if (userId != null)
            {
                var result = await UserLocationService.GetUserLocationsAsync(userId);
                if (result.IsSuccess)
                    _locations = result.Value!;
            }
        }
    }

    private async Task ExportToExcel()
    {
        _exporting = true;
        StateHasChanged();

        try
        {
            await Task.Run(() =>
            {
                var queryParams = System.Web.HttpUtility.ParseQueryString(string.Empty);

                queryParams["startDate"] = ToUtc(_dateRange.Start)?.ToString("o");
                queryParams["endDate"] = ToUtc(_dateRange.End)?.ToString("o");

                if (!string.IsNullOrWhiteSpace(_searchString))
                    queryParams["searchString"] = _searchString;
                if (_selectedStatus is not null)
                    queryParams["status"] = _selectedStatus;
                if (_selectedSaleType.HasValue)
                    queryParams["saleType"] = _selectedSaleType.Value.ToString();
                if (_selectedLocationId.HasValue)
                    queryParams["locationId"] = _selectedLocationId.Value.ToString();

                queryParams["pageSize"] = ExportOptions.Value.MaxExportRecords.ToString();

                Navigation.NavigateTo($"/api/SalesReport/salesHistory/excel?{queryParams}", forceLoad: true);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting sales history to Excel");
            Snackbar.Add(L["Error exporting sales history"], Severity.Error);
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private async Task<GridData<SaleDto>> LoadServerData(GridState<SaleDto> state)
    {
        try
        {
            _loading = true;

            // Extract column filters from grid state (PropertyColumns)
            var customerColFilter  = GetStringFilter(state, "CustomerName");
            var createdByFilter    = GetStringFilter(state, "CreatedBy");
            var paymentFilter      = GetStringFilter(state, "PaymentMethodName");
            var saleIdFilter       = GetLongFilter(state, "Id");
            var minTotal           = GetDecimalFilter(state, "Total", FilterOperator.Number.GreaterThanOrEqual);
            var maxTotal           = GetDecimalFilter(state, "Total", FilterOperator.Number.LessThanOrEqual);

            // Merge column status filter with external panel filter (column takes precedence)
            var effectiveStatus = _columnStatusFilter ?? _selectedStatus;

            // Extract sort (single-column mode)
            var sort = state.SortDefinitions.FirstOrDefault();

            var (totalItems, items) = await SaleService.GetSalesAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                startDate: ToUtc(_dateRange.Start),
                endDate: ToUtc(_dateRange.End),
                status: effectiveStatus,
                saleType: _selectedSaleType,
                locationId: _selectedLocationId,
                saleId: saleIdFilter.HasValue ? (long?)saleIdFilter.Value : FilterSaleId,
                paymentMethodName: paymentFilter,
                minTotal: minTotal,
                maxTotal: maxTotal,
                customerNameFilter: customerColFilter,
                createdByFilter: createdByFilter,
                sortColumn: sort?.SortBy,
                sortDescending: sort?.Descending ?? true);

            // Load cancellation eligibility for the current page
            await LoadCancellationStatusAsync(items);

            return new GridData<SaleDto> { TotalItems = totalItems, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sales");
            Snackbar.Add(L["Error loading sales"], Severity.Error);
            return new GridData<SaleDto> { TotalItems = 0, Items = Enumerable.Empty<SaleDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    // --- Column filter extraction helpers ---

    private static string? GetStringFilter(GridState<SaleDto> state, string propertyName)
    {
        var fd = state.FilterDefinitions.FirstOrDefault(f => f.Column?.PropertyName == propertyName);
        return fd?.Value as string is { Length: > 0 } s ? s : null;
    }

    private static long? GetLongFilter(GridState<SaleDto> state, string propertyName)
    {
        var fd = state.FilterDefinitions.FirstOrDefault(f => f.Column?.PropertyName == propertyName);
        return fd?.Value switch
        {
            long l   => l,
            int i    => (long)i,
            double d => (long)d,
            string s when long.TryParse(s, out var parsed) => parsed,
            _        => null
        };
    }

    private static decimal? GetDecimalFilter(GridState<SaleDto> state, string propertyName, string @operator)
    {
        var fd = state.FilterDefinitions
            .FirstOrDefault(f => f.Column?.PropertyName == propertyName && f.Operator == @operator);
        return fd?.Value switch
        {
            decimal d => d,
            double d  => (decimal)d,
            string s when decimal.TryParse(s, out var parsed) => parsed,
            _         => null
        };
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _dataGrid.ReloadServerData();
    }

    private async Task OnDateRangeChanged()
    {
        await _dataGrid.ReloadServerData();
    }

    private async Task OnSaleTypeFilterChange(SaleType? saleType)
    {
        _selectedSaleType = saleType;
        await _dataGrid.ReloadServerData();
    }

    private async Task OnStatusFilterChange(string? status)
    {
        _selectedStatus = status;
        await _dataGrid.ReloadServerData();
    }

    private async Task OnLocationFilterChange(int? locationId)
    {
        _selectedLocationId = locationId;
        await _dataGrid.ReloadServerData();
    }

    private async Task OpenReceiptDialog(long saleId)
    {
        try
        {
            var dialog = await DialogService.ShowAsync<SaleReceiptDialog>(
                L["Sale Receipt"],
                new DialogParameters<SaleReceiptDialog> { { x => x.SaleId, saleId } },
                new DialogOptions 
                { 
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true
                });
            
            await dialog.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening receipt dialog for sale {SaleId}", saleId);
            Snackbar.Add(L["Error opening receipt dialog"], Severity.Error);
        }
    }

    private async Task LoadCancellationStatusAsync(IEnumerable<SaleDto> sales)
    {
        try
        {
            var ids = sales.Select(s => s.Id);
            var result = await SaleService.GetCancellationStatusAsync(ids);
            if (result.IsSuccess)
                _cancellationStatus = result.Value!;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cancellation status");
        }
    }

    private async Task OpenInvoiceDialog(SaleDto sale)
    {
        var parameters = new DialogParameters<CreateInvoiceDialog>
        {
            { x => x.SaleId, sale.Id },
            { x => x.SaleTotal, sale.Total },
            { x => x.CustomerName, sale.CustomerName }
        };
        var dialog = await DialogService.ShowAsync<CreateInvoiceDialog>(
            L["Invoice"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            _cancellationStatus[sale.Id] = new SaleCancellationStatusDto
            {
                CanCancel = false,
                BlockedByInvoice = true
            };
            StateHasChanged();
        }
    }

    private async Task OpenCancelDialog(SaleDto sale)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Cancel Sale"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to cancel this sale:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), $"#{sale.Id} - {sale.CustomerName}" },
            { nameof(ConfirmDialog.ConfirmText), L["Cancel Sale"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Keep Sale"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This will return all products to inventory"].ToString() },
            { nameof(ConfirmDialog.ShowWarning), true },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Warning },
            { nameof(ConfirmDialog.AdditionalContent), (RenderFragment)(@<MudTextField @bind-Value="@_cancellationReason" Label="@L["Reason for cancellation"]" Required="true" />) }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["Cancel Sale"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var cancelResult = await SaleService.CancelSaleAsync(sale.Id, _cancellationReason);
                if (cancelResult.IsSuccess)
                {
                    Snackbar.Add(L["Sale cancelled successfully"], Severity.Success);
                    await _dataGrid.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(cancelResult.Error!, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error cancelling sale {SaleId}", sale.Id);
                Snackbar.Add(L["Error cancelling sale"], Severity.Error);
            }
        }
    }

    private DateTime? ToUtc(DateTime? localDate)
    {
        if (localDate is null || _companyTimeZone is null)
            return localDate;
        return DateTimeService.ToUtc(
            DateTime.SpecifyKind(localDate.Value, DateTimeKind.Unspecified),
            _companyTimeZone);
    }

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            return DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }

    private Color GetStatusColor(App.Core.Enums.Shop.SaleStatus status) => status switch
    {
        App.Core.Enums.Shop.SaleStatus.Created => Color.Info,
        App.Core.Enums.Shop.SaleStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private string GetStatusDisplayText(App.Core.Enums.Shop.SaleStatus status) => status switch
    {
        App.Core.Enums.Shop.SaleStatus.Created => L["Created"],
        App.Core.Enums.Shop.SaleStatus.Cancelled => L["Cancelled"],
        _ => status.ToString()
    };
}