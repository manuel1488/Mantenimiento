@page "/shop/sales/receipt/{SaleId:long}"
@using App.Shared.Services
@using MudBlazor
@using App.Core.DTOs.Shop
@using App.Core.Interfaces.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Settings
@using App.Core.Constants

@inject ISaleService SaleService
@inject ITicketService TicketService
@inject App.Web.Services.IThermalPrinterService ThermalPrinter
@inject ICompanySettingsService CompanySettingsService
@inject IStringLocalizer<SaleReceiptDialog> L
@inject ISnackbar Snackbar
@inject ILogger<SaleReceiptDialog> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IDateTime DateTimeService

<MudDialog Options="@_dialogOptions">
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center align-center" style="height: 200px;">
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
                    <MudText Typo="Typo.caption">@L["Loading receipt"]...</MudText>
                </MudStack>
            </div>
        }
        else if (_sale == null)
        {
            <div style="padding: 16px;">
                <MudAlert Severity="Severity.Error">@L["Sale not found"]</MudAlert>
            </div>
        }
        else
        {
            <div style="padding: 12px; max-width: 100%; overflow: hidden;">
                <!-- Ultra Compact Header -->
                <div class="text-center" style="margin-bottom: 12px; border-bottom: 1px solid var(--mud-palette-divider); padding-bottom: 8px;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.h6" Style="margin: 0; line-height: 1.2;">@L["Receipt"] #@_sale.Id</MudText>
                            <MudText Typo="Typo.caption" Style="margin: 0;">@FormatToCompanyTimezone(_sale.SaleDate)</MudText>
                        </div>
                        <div class="d-flex gap-1">
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_sale.Status)" Variant="Variant.Filled" Style="height: 20px; font-size: 0.7rem;">
                                @GetStatusDisplayText(_sale.Status)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="height: 20px; font-size: 0.7rem;">
                                P
                            </MudChip>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Style="margin: 4px 0 0 0; font-weight: 500;">@_sale.CustomerName</MudText>
                </div>
                
                <!-- Ultra Compact Products Table -->
                <div style="margin-bottom: 12px;">
                    <div style="max-height: 240px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                            <thead style="background-color: var(--mud-palette-surface); position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th style="padding: 6px 8px; text-align: left; border-bottom: 1px solid var(--mud-palette-divider); font-weight: 600;">Producto</th>
                                    <th style="padding: 6px 4px; text-align: center; width: 50px; border-bottom: 1px solid var(--mud-palette-divider); font-weight: 600;">Cant</th>
                                    <th style="padding: 6px 8px; text-align: right; width: 80px; border-bottom: 1px solid var(--mud-palette-divider); font-weight: 600;">Precio</th>
                                    <th style="padding: 6px 8px; text-align: right; width: 80px; border-bottom: 1px solid var(--mud-palette-divider); font-weight: 600;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _sale.Details)
                                {
                                    <tr>
                                        <td style="padding: 4px 8px; border-bottom: 1px solid var(--mud-palette-divider-light);">
                                            <div style="line-height: 1.2;">
                                                <div style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">@item.ProductName</div>
                                                <div style="font-size: 0.75rem; color: var(--mud-palette-text-secondary); margin-top: 1px;">@item.ProductCode</div>
                                            </div>
                                        </td>
                                        <td style="padding: 4px; text-align: center; border-bottom: 1px solid var(--mud-palette-divider-light);">@item.Quantity</td>
                                        <td style="padding: 4px 8px; text-align: right; border-bottom: 1px solid var(--mud-palette-divider-light);">@item.UnitPrice.ToString("C0")</td>
                                        <td style="padding: 4px 8px; text-align: right; font-weight: 500; border-bottom: 1px solid var(--mud-palette-divider-light);">@item.Total.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Ultra Compact Totals -->
                <div class="d-flex justify-end" style="margin-bottom: 12px;">
                    <div style="min-width: 200px; font-size: 0.875rem;">
                        <div class="d-flex justify-space-between" style="padding: 2px 0;">
                            <span>@L["Subtotal"]:</span>
                            <span>@_sale.Subtotal.ToString("C")</span>
                        </div>
                        
                        @if (_sale.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-space-between" style="padding: 2px 0; color: var(--mud-palette-success);">
                                <span>@L["Discount"]:</span>
                                <span>-@_sale.DiscountAmount.ToString("C")</span>
                            </div>
                        }
                        
                        <div class="d-flex justify-space-between" style="padding: 2px 0;">
                            <span>@L["Tax"]:</span>
                            <span>@_sale.TaxAmount.ToString("C")</span>
                        </div>

                        @if (_sale.RoundingAmount != 0)
                        {
                            <div class="d-flex justify-space-between" style="padding: 2px 0; color: var(--mud-palette-text-secondary);">
                                <span>@L["Rounding"]:</span>
                                <span>@(_sale.RoundingAmount > 0 ? "+" : "")@_sale.RoundingAmount.ToString("C")</span>
                            </div>
                        }

                        <hr style="margin: 6px 0; border: none; border-top: 1px solid var(--mud-palette-divider);" />
                        
                        <div class="d-flex justify-space-between" style="padding: 4px 0; font-weight: 600; font-size: 1rem;">
                            <span>@L["Total"]:</span>
                            <span style="color: var(--mud-palette-primary);">@_sale.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>
                
                <!-- Ultra Compact Footer -->
                <div style="font-size: 0.75rem; color: var(--mud-palette-text-secondary); border-top: 1px solid var(--mud-palette-divider); padding-top: 8px;">
                    <div class="d-flex justify-space-between" style="margin-bottom: 4px;">
                        <span><strong>@L["Payment"]:</strong> @(string.Join(", ", _sale.Payments.Select(p => p.PaymentMethodName)))</span>
                    </div>
                    
                    @if (_sale.DiscountPercentage > 0 && !string.IsNullOrEmpty(_sale.DiscountAuthorizedBy))
                    {
                        <div style="margin-bottom: 4px;">
                            <strong>@L["Authorized by"]:</strong> @_sale.DiscountAuthorizedBy
                        </div>
                    }
                    
                    <div class="text-center" style="margin-top: 8px; font-style: italic;">
                        @L["Thank you for your purchase!"]
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-center gap-1" style="width: 100%; padding: 8px 12px;">
            <MudButton OnClick="DirectPrint" 
                      Variant="Variant.Outlined"
                      StartIcon="@Icons.Material.Filled.Print"
                      Color="Color.Primary"
                      Size="Size.Small"
                      Style="min-width: 110px;">
                @L["Print"]
            </MudButton>
            <MudButton OnClick="DownloadPdf"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       Style="min-width: 110px;">
                @L["PDF"]
            </MudButton>
            <MudButton OnClick="Close"
                      Variant="Variant.Filled"
                      Color="Color.Primary"
                      Size="Size.Small"
                      Style="min-width: 80px;">
                @L["Close"]
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public long SaleId { get; set; }
    
    private SaleDto? _sale;
    private bool _loading = true;
    private string _ticketUrl = string.Empty;
    private TimeZoneInfo? _companyTimeZone;

    private DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = false,
        CloseButton = true,
        BackdropClick = false,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get company timezone first
            _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
            
            await LoadSale();
            _ticketUrl = TicketService.GetSaleTicketUrl(SaleId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing sale receipt dialog");
            Snackbar.Add(L["Error loading receipt"], Severity.Error);
        }
    }

    private async Task LoadSale()
    {
        try
        {
            _loading = true;
            _sale = await SaleService.GetSaleByIdAsync(SaleId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sale");
            Snackbar.Add(L["Error loading sale"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DirectPrint()
    {
        try
        {
            var result = await ThermalPrinter.PrintSaleAsync(SaleId);
            if (!result.IsSuccess)
                await JS.InvokeVoidAsync("printTicket", _ticketUrl);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing ticket");
            Snackbar.Add(L["Error printing ticket"], Severity.Error);
        }
    }

    private void DownloadPdf()
    {
        Navigation.NavigateTo($"{_ticketUrl}?download=true", true);
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private string FormatToCompanyTimezone(DateTime utcDate)
    {
        try
        {
            if (_companyTimeZone == null)
                return utcDate.ToLocalTime().ToString("g");

            return DateTimeService.FormatToTimezone(utcDate, _companyTimeZone);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error converting date to company timezone");
            return utcDate.ToLocalTime().ToString("g");
        }
    }

    private Color GetStatusColor(App.Core.Enums.Shop.SaleStatus status) => status switch
    {
        App.Core.Enums.Shop.SaleStatus.Created => Color.Info,
        App.Core.Enums.Shop.SaleStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private string GetStatusDisplayText(App.Core.Enums.Shop.SaleStatus status) => status switch
    {
        App.Core.Enums.Shop.SaleStatus.Created => L["Created"],
        App.Core.Enums.Shop.SaleStatus.Cancelled => L["Cancelled"],
        _ => status.ToString()
    };
}