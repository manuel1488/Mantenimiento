@using App.Core.DTOs.Settings
@using App.Core.Enums.Shop
@using MudBlazor
@using CardBrand = App.Core.Enums.Shop.CardBrand

@inject IStringLocalizer<PaymentGroupDialog> L

<MudDialog>
    <DialogContent>
        <div @onkeydown="HandleKeyDown">
        <!-- Header -->
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; padding:12px 14px; border-radius:8px; background:@($"{GetPaymentColor(PaymentMethod.Type)}18"); border-left:4px solid @GetPaymentColor(PaymentMethod.Type);">
            <MudIcon Icon="@PaymentMethod.Icon" Size="Size.Large" Style="@($"color:{GetPaymentColor(PaymentMethod.Type)}")" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600; line-height:1.2;">@PaymentMethod.Name</MudText>
                <MudText Typo="Typo.body2" Style="color:#555;">
                    @L["Total to pay"]: <strong>@TotalSaleRemaining.ToString("C2")</strong>
                </MudText>
            </div>
        </div>

        @if (IsCash)
        {
            <!-- Cash: one field — what the customer gives -->
            <MudNumericField T="decimal" @bind-Value="_cashReceived"
                Label="@L["Customer gives"]"
                Format="C2" Min="0" Step="0.5M"
                Variant="Variant.Outlined"
                HideSpinButtons="true"
                AutoFocus="true"
                Immediate="true" />

            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; padding:14px 18px; border-radius:8px; background:@(CashChange >= 0 ? "#F1F8E9" : "#FFF3E0");">
                <span style="font-size:14px; color:#555; font-weight:500;">
                    @(CashChange >= 0 ? L["Cash change"] : L["Short"]):
                </span>
                <span style="font-size:28px; font-weight:700; color:@(CashChange >= 0 ? "#4CAF50" : "#FF9800");">
                    @Math.Abs(CashChange).ToString("C2")
                </span>
            </div>
        }
        else
        {
            <!-- Non-cash: editable list of sub-entries -->
            @foreach (var item in _items)
            {
                <div @key="item.Id" style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
                    @if (_items.Count > 1)
                    {
                        <span style="font-size:11px; color:#aaa; min-width:18px; text-align:right;">
                            #@(_items.IndexOf(item) + 1)
                        </span>
                    }
                    <MudNumericField T="decimal" @bind-Value="item.Amount"
                        Label="@L["Amount"]"
                        Format="C2" Min="0.01M"
                        Max="@(TotalSaleRemaining - _items.Where(i => i.Id != item.Id).Sum(i => i.Amount))"
                        Step="0.01M"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        HideSpinButtons="true"
                        AutoFocus="@(_items.IndexOf(item) == 0)"
                        Immediate="true"
                        Style="flex:1;" />
                    @if (PaymentMethod.Type == PaymentMethodType.Transfer || PaymentMethod.Type == PaymentMethodType.Check)
                    {
                        <MudTextField @bind-Value="item.Reference"
                            Placeholder="Ref."
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Style="width:110px;" />
                    }
                    @if (_items.Count > 1)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => RemoveSubEntry(item))" />
                    }
                </div>
                @if (PaymentMethod.Type == PaymentMethodType.Card)
                {
                    <div style="display:flex; gap:6px; margin-bottom:4px; padding-left:@(_items.Count > 1 ? "24px" : "0");">
                        <MudSelect T="CardBrand?" @bind-Value="item.CardBrand"
                            Label="@L["Card brand"]"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Style="width:140px;">
                            <MudSelectItem T="CardBrand?" Value="null">—</MudSelectItem>
                            <MudSelectItem T="CardBrand?" Value="CardBrand.Visa">Visa</MudSelectItem>
                            <MudSelectItem T="CardBrand?" Value="CardBrand.Mastercard">Mastercard</MudSelectItem>
                            <MudSelectItem T="CardBrand?" Value="CardBrand.AmericanExpress">Amex</MudSelectItem>
                            <MudSelectItem T="CardBrand?" Value="CardBrand.Other">@L["Other"]</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="item.CardLastFour"
                            Label="@L["Last 4 digits"]"
                            Placeholder="••••"
                            MaxLength="4"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Style="width:100px;" />
                        <MudTextField @bind-Value="item.AuthorizationCode"
                            Label="@L["Auth. code"]"
                            Placeholder="123456"
                            MaxLength="20"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Style="flex:1;" />
                    </div>
                }
            }

            @if (_items.Count > 1)
            {
                <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 4px; border-top:1px solid #eee; margin-bottom:8px;">
                    <span style="font-size:13px; color:#555; font-weight:500;">@L["Total"]:</span>
                    <span style="font-size:15px; font-weight:700; color:#333;">@_items.Sum(i => i.Amount).ToString("C2")</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(PaymentMethod.MxCfdiFormCode))
            {
                <div class="mb-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">CFDI: @PaymentMethod.MxCfdiFormCode</MudChip>
                </div>
            }

            <MudButton Variant="Variant.Outlined"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="AddSubEntry"
                FullWidth="true"
                Size="Size.Small"
                Color="Color.Primary"
                Disabled="@(_items.Sum(i => i.Amount) >= TotalSaleRemaining)">
                @L["Add another payment"]
            </MudButton>
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">
            @L["Cancel"]
            <kbd class="pos-kbd" style="margin-left:6px;">Esc</kbd>
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm"
            Disabled="@(!IsValid)">
            @L["Confirm"]
            <kbd class="pos-kbd" style="margin-left:6px;">Enter</kbd>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public PaymentMethodDto PaymentMethod { get; set; } = null!;
    [Parameter] public decimal TotalSaleRemaining { get; set; }
    [Parameter] public List<SubEntry> ExistingEntries { get; set; } = new();

    private List<SubEntry> _items = new();
    private decimal _cashReceived;

    private bool IsCash => PaymentMethod.Type == PaymentMethodType.Cash;
    private decimal CashChange => _cashReceived - TotalSaleRemaining;
    private decimal CashApplied => Math.Min(_cashReceived, TotalSaleRemaining);
    private bool IsValid => IsCash
        ? _cashReceived > 0
        : _items.Any() && _items.All(i => i.Amount >= 0.01M) && _items.Sum(i => i.Amount) <= TotalSaleRemaining;

    protected override void OnInitialized()
    {
        if (ExistingEntries.Any())
        {
            _items = ExistingEntries.Select(e => new SubEntry
            {
                Amount = e.Amount,
                CashReceived = e.CashReceived,
                CardLastFour = e.CardLastFour,
                Reference = e.Reference
            }).ToList();
            if (IsCash)
                _cashReceived = ExistingEntries.First().CashReceived > 0
                    ? ExistingEntries.First().CashReceived
                    : TotalSaleRemaining;
        }
        else
        {
            if (IsCash)
            {
                _cashReceived = TotalSaleRemaining;
            }
            else
            {
                _items.Add(new SubEntry { Amount = Math.Max(0.01M, TotalSaleRemaining) });
            }
        }
    }

    private void AddSubEntry()
    {
        var used = _items.Sum(i => i.Amount);
        var remaining = Math.Max(0.01M, TotalSaleRemaining - used);
        _items.Add(new SubEntry { Amount = remaining });
    }

    private void RemoveSubEntry(SubEntry item) => _items.Remove(item);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsValid)
            Confirm();
        else if (e.Key == "Escape")
            Cancel();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        List<SubEntry> result;
        if (IsCash)
        {
            result = new List<SubEntry>
            {
                new SubEntry { Amount = CashApplied, CashReceived = _cashReceived }
            };
        }
        else
        {
            result = _items.Where(i => i.Amount >= 0.01M).ToList();
        }
        MudDialog.Close(DialogResult.Ok(result));
    }

    private static string GetPaymentColor(PaymentMethodType type) => type switch
    {
        PaymentMethodType.Cash => "#4CAF50",
        PaymentMethodType.Card => "#2196F3",
        PaymentMethodType.Transfer => "#9C27B0",
        PaymentMethodType.Check => "#607D8B",
        _ => "#9E9E9E"
    };

    public class SubEntry
    {
        public Guid Id { get; } = Guid.NewGuid();
        public decimal Amount { get; set; }
        public decimal CashReceived { get; set; }
        public string? CardLastFour { get; set; }
        public string? AuthorizationCode { get; set; }
        public CardBrand? CardBrand { get; set; }
        public string? Reference { get; set; }
    }
}
