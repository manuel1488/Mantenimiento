@page "/shop/quotations/{Id:long}/edit"
@using App.Core.Common
@using App.Core.Constants
@using App.Core.DTOs.Shop
@using App.Core.DTOs.Customer
@using App.Core.DTOs.Product
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using App.Core.Interfaces
@using App.Core.DTOs.Shop.Calculation
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IQuotationService QuotationService
@inject IProductService ProductService
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<EditQuotationPage> L
@inject IJSRuntime JS
@inject IPricingCalculationService PricingService
@inject IProductWholesalePriceService WholesalePriceService

@attribute [Authorize(Policy = ApplicationClaims.Shop.EditQuotation)]
@implements IAsyncDisposable

<PageTitle>@L["Edit Quotation"]</PageTitle>

@* Outer wrapper: fills viewport height so nothing overflows the page *@
<div style="display:flex;flex-direction:column;gap:12px;">

    @* Title row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/shop/quotations"))"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h4">@L["Edit Quotation"] @_quotationNumber</MudText>
    </MudStack>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Error">@L["Quotation not found"]</MudAlert>
    }
    else if (_readOnly)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@L["This quotation is read-only because it is no longer in draft status"]</MudAlert>

            <MudGrid Class="mb-3">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Style="color:#888;">@L["Customer"]</MudText>
                    <MudText Typo="Typo.body1"><strong>@_roCustomerName</strong></MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Style="color:#888;">@L["Quote Date"]</MudText>
                    <MudText Typo="Typo.body1">@_quoteDate?.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Style="color:#888;">@L["Valid Until"]</MudText>
                    <MudText Typo="Typo.body1">@_validUntil?.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_notes))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Notes & Conditions"]</MudText>
                        <MudText Typo="Typo.body2">@_notes</MudText>
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="mb-3" />

            <MudSimpleTable Dense="true" Hover="false">
                <thead>
                    <tr>
                        <th>@L["Product"]</th>
                        <th style="text-align:right; width:90px">@L["Qty"]</th>
                        <th style="text-align:right; width:120px">@L["Unit Price"]</th>
                        <th style="text-align:right; width:120px">@L["Amount"]</th>
                        <th style="text-align:right; width:120px">@L["Discount"]</th>
                        <th style="text-align:right; width:120px">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _roDetails)
                    {
                        <tr>
                            <td>
                                @d.ProductName
                                <span style="font-size:11px; color:#888; margin-left:4px;">(@d.ProductCode)</span>
                            </td>
                            <td style="text-align:right">@d.Quantity.ToString("N2")</td>
                            <td style="text-align:right">@d.UnitPrice.ToString("C2")</td>
                            <td style="text-align:right">@((d.Quantity * d.UnitPrice).ToString("C2"))</td>
                            <td style="text-align:right">@(d.DiscountAmount > 0 ? $"-{d.DiscountAmount:C2}" : "—")</td>
                            <td style="text-align:right">@d.Total.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                <MudStack Spacing="1" Style="min-width:240px">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                        <MudText Typo="Typo.body2">@_roSubtotal.ToString("C2")</MudText>
                    </MudStack>
                    @if (_roDiscountAmount > 0)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Discount"]:</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">-@_roDiscountAmount.ToString("C2")</MudText>
                        </MudStack>
                    }
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                        <MudText Typo="Typo.body2">@_roTaxAmount.ToString("C2")</MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle1">@L["Total"]:</MudText>
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">@_roTotal.ToString("C2")</MudText>
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @* Main card: grows to fill remaining space, clips overflow *@
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">

            @* Top fields (fixed height) *@
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="CustomerDto"
                                         Label="@L["Customer"]"
                                         @bind-Value="_selectedCustomer"
                                         SearchFunc="@SearchCustomersAsync"
                                         ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                         Variant="Variant.Outlined"
                                         Required="true"
                                         RequiredError="@L["Customer is required"]" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="@L["Quote Date"]"
                                       @bind-Date="_quoteDate"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="@L["Valid Until"]"
                                       @bind-Date="_validUntil"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="12" md="12">
                        <MudTextField @bind-Value="_notes"
                                      Label="@L["Notes & Conditions"]"
                                      Variant="Variant.Outlined"
                                      Lines="2" />
                    </MudItem>
                </MudGrid>
            </MudForm>

            @* Products section: grows to fill remaining space *@
            <div style="display:flex;flex-direction:column;">

                @* Header *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">@L["Products"]</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@AddLine">
                        @L["Add product"]
                    </MudButton>
                </MudStack>

                @if (_lines.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@L["Add at least one product"]</MudAlert>
                }
                else
                {
                    @* Scrollable table — takes all remaining vertical space *@
                    <div style="overflow-x:auto;">
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>@L["Product"]</th>
                                    <th style="width:100px">@L["Qty"]</th>
                                    <th style="width:120px;text-align:right">@L["Unit Price"]</th>
                                    <th style="width:120px;text-align:right">@L["Amount"]</th>
                                    <th style="width:100px;text-align:right">@L["Discount"]</th>
                                    <th style="width:120px;text-align:right">@L["Total"]</th>
                                    <th style="width:48px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _lines)
                                {
                                    <tr>
                                        <td>
                                            <div id="@($"line-{line.LineId}")">
                                            <MudAutocomplete T="ProductDto"
                                                             Value="line.SelectedProduct"
                                                             ValueChanged="@((p) => OnProductSelected(line, p))"
                                                             SearchFunc="@SearchProductsAsync"
                                                             ToStringFunc="@(p => p is null ? string.Empty : $"{p.Code} - {p.Name}")"
                                                             Variant="Variant.Text"
                                                             Dense="true" />
                                            </div>
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal"
                                                             Value="line.Quantity"
                                                             ValueChanged="@(async (v) => await OnLineChanged(line, quantity: v))"
                                                             Min="0.001m"
                                                             Variant="Variant.Text"
                                                             Dense="true" />
                                        </td>
                                        <td style="text-align:right">@line.UnitPrice.ToString("C2")</td>
                                        <td style="text-align:right">@((line.Quantity * line.UnitPrice).ToString("C2"))</td>
                                        <td style="text-align:right">@(line.LineDiscount > 0 ? $"-{line.LineDiscount:C2}" : "—")
                                        </td>
                                        <td style="text-align:right">@line.LineTotal.ToString("C2")</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(async () => await RemoveLine(line))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>

                    @* Totals — always visible below the table *@
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                        <MudStack Spacing="1" Style="min-width:240px">
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                                <MudText Typo="Typo.body2">@_subtotal.ToString("C2")</MudText>
                            </MudStack>
                            @if (_discountTotal > 0)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Discount"]:</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Error">-@_discountTotal.ToString("C2")</MudText>
                                </MudStack>
                            }
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                                <MudText Typo="Typo.body2">@_taxTotal.ToString("C2")</MudText>
                            </MudStack>
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.subtitle1">@L["Total"]:</MudText>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@_grandTotal.ToString("C2")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudStack>
                }
            </div>

            @* Action buttons — always pinned at the bottom of the card *@
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           OnClick="@(() => Navigation.NavigateTo("/shop/quotations"))">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Save"
                           Disabled="@(_processing || _selectedCustomer == null || _lines.Count == 0 || _lines.Any(l => l.ProductId == 0))">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Save"]
                </MudButton>
            </MudStack>

        </MudPaper>
    }
</div>

@code {
    #region Lifecycle (overflow lock)
    private bool _jsReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            await JS.InvokeVoidAsync("eval",
                "var el=document.querySelector('.mud-main-content');if(el)el.style.overflow='hidden';");
        }

    }

    public async ValueTask DisposeAsync()
    {
        if (!_jsReady) return;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var el=document.querySelector('.mud-main-content');if(el)el.style.overflow='';");
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    #endregion

    #region Parameters
    [Parameter]
    public long Id { get; set; }
    #endregion

    #region Fields
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private bool _loading = true;
    private bool _notFound;
    private bool _readOnly;
    private string? _quotationNumber;

    // Read-only view fields
    private string? _roCustomerName;
    private List<QuotationDetailDto> _roDetails = [];
    private decimal _roSubtotal;
    private decimal _roDiscountAmount;
    private decimal _roTaxAmount;
    private decimal _roTotal;

    private CustomerDto? _selectedCustomer;
    private DateTime? _quoteDate = DateTime.Today;
    private DateTime? _validUntil = DateTime.Today.AddDays(15);
    private decimal _globalDiscount = 0;
    private string? _notes;

    private List<QuotationLine> _lines = [];
    private int _lineCounter = 0;

    private decimal _subtotal;
    private decimal _discountTotal;
    private decimal _taxTotal;
    private decimal _grandTotal;

    private decimal _taxRate = 0;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        var taxResult = await PricingService.GetEffectiveTaxRateAsync();
        if (taxResult.IsSuccess)
            _taxRate = taxResult.Value;

        var quotation = await QuotationService.GetByIdAsync(Id);
        if (quotation is null)
        {
            _notFound = true;
            _loading = false;
            return;
        }

        _quotationNumber = quotation.QuotationNumber;

        if (quotation.Status != QuotationStatus.Draft)
        {
            _readOnly = true;
            _roCustomerName = quotation.CustomerName;
            _quoteDate = quotation.QuoteDate;
            _validUntil = quotation.ValidUntil;
            _notes = quotation.Notes;
            _roDetails = quotation.Details;
            _roSubtotal = quotation.Subtotal;
            _roDiscountAmount = quotation.DiscountAmount;
            _roTaxAmount = quotation.TaxAmount;
            _roTotal = quotation.Total;
            _loading = false;
            return;
        }

        var customer = await CustomerService.GetCustomerByIdAsync(quotation.CustomerId);
        _selectedCustomer = customer;

        _quoteDate = quotation.QuoteDate;
        _validUntil = quotation.ValidUntil;
        _globalDiscount = quotation.DiscountPercentage;
        _notes = quotation.Notes;

        _lines = quotation.Details.Select(d => new QuotationLine
        {
            ProductId = d.ProductId,
            ProductName = d.ProductName,
            ProductCode = d.ProductCode,
            Quantity = d.Quantity,
            UnitPrice = d.UnitPrice,
            OriginalPrice = d.UnitPrice,
            DiscountPercentage = d.DiscountPercentage
        }).ToList();

        // Load product and wholesale prices for existing lines
        foreach (var line in _lines)
        {
            line.SelectedProduct = await ProductService.GetProductByIdAsync(line.ProductId);

            var wpResult = await WholesalePriceService.GetWholesalePricesForProductAsync(line.ProductId);
            line.WholesalePrices = wpResult.IsSuccess ? wpResult.Value.ToList() : [];
            ApplyWholesaleDiscount(line);
        }

        await RecalculateTotalsAsync();
        _loading = false;
    }
    #endregion

    #region Search
    private async Task<IEnumerable<CustomerDto>> SearchCustomersAsync(string? value, CancellationToken ct)
    {
        var (_, items) = await CustomerService.GetCustomersAsync(
            page: 1,
            pageSize: 30,
            searchString: string.IsNullOrWhiteSpace(value) ? null : value);
        return items;
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string? value, CancellationToken ct)
    {
        var (_, items) = await ProductService.GetProductsAsync(
            page: 1,
            pageSize: 30,
            searchString: string.IsNullOrWhiteSpace(value) ? null : value,
            isActive: true);
        return items;
    }
    #endregion

    #region Lines management
    private async Task AddLine()
    {
        var newLine = new QuotationLine { Quantity = 1, LineId = _lineCounter++ };
        _lines.Add(newLine);
        await RecalculateTotalsAsync();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        await JS.InvokeVoidAsync("eval",
            $"var w=document.getElementById('line-{newLine.LineId}');if(w){{var i=w.querySelector('input');if(i)i.focus();}}");
    }

    private async Task RemoveLine(QuotationLine line)
    {
        _lines.Remove(line);
        await RecalculateTotalsAsync();
    }

    private async Task OnProductSelected(QuotationLine line, ProductDto? product)
    {
        if (product is null) return;
        line.SelectedProduct = product;
        line.ProductId = product.Id;
        line.ProductName = product.Name;
        line.ProductCode = product.Code ?? string.Empty;
        line.UnitPrice = product.Price;
        line.OriginalPrice = product.Price;

        var wpResult = await WholesalePriceService.GetWholesalePricesForProductAsync(product.Id);
        line.WholesalePrices = wpResult.IsSuccess ? wpResult.Value.ToList() : [];

        ApplyWholesaleDiscount(line);
        await RecalculateTotalsAsync();
    }

    private async Task OnLineChanged(QuotationLine line, decimal? quantity = null)
    {
        if (quantity.HasValue) line.Quantity = quantity.Value;
        ApplyWholesaleDiscount(line);
        await RecalculateTotalsAsync();
    }

    private void ApplyWholesaleDiscount(QuotationLine line)
    {
        var result = PricingService.ResolveWholesaleDiscount(line.WholesalePrices, line.Quantity, line.OriginalPrice);
        line.DiscountPercentage = result.DiscountPercentage;
        line.FixedDiscountAmount = result.GetFixedLineDiscount(line.Quantity);
    }

    private async Task RecalculateTotalsAsync()
    {
        var documentLines = new List<DocumentLineInput>();

        foreach (var line in _lines)
        {
            var lineCalc = PricingService.CalculateLine(new LineCalculationInput
            {
                Quantity = line.Quantity,
                UnitPrice = line.UnitPrice,
                DiscountPercentage = line.DiscountPercentage,
                DiscountAmount = line.FixedDiscountAmount,
                TaxRate = _taxRate
            });

            line.LineDiscount = Math.Round(lineCalc.DiscountAmount, 2);
            line.LineTax = lineCalc.TaxAmount;
            line.LineTotal = Math.Round(lineCalc.Subtotal + line.LineTax, 2);

            documentLines.Add(new DocumentLineInput
            {
                Subtotal = lineCalc.Subtotal,
                DiscountAmount = line.FixedDiscountAmount ?? lineCalc.DiscountAmount,
                IsTaxable = true,
                TaxBase = lineCalc.TaxBase,
                TaxAmount = lineCalc.TaxAmount
            });
        }

        var docCalc = await PricingService.CalculateDocumentAsync(new DocumentCalculationInput
        {
            Lines = documentLines,
            GlobalDiscountPercentage = _globalDiscount,
            TaxRate = _taxRate,
            ApplyRounding = false
        });

        _subtotal = docCalc.Subtotal - docCalc.TotalDiscountAmount;
        _discountTotal = docCalc.TotalDiscountAmount;
        _taxTotal = docCalc.TaxAmount;
        _grandTotal = docCalc.Total;

        StateHasChanged();
    }
    #endregion

    #region Save
    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid || _lines.Count == 0 || _selectedCustomer is null) return;

        _processing = true;
        try
        {
            var updateDto = new UpdateQuotationDto
            {
                CustomerId = _selectedCustomer.Id,
                QuoteDate = _quoteDate,
                ValidUntil = _validUntil,
                DiscountPercentage = _globalDiscount,
                Notes = _notes,
                Details = _lines.Select(l => new CreateQuotationDetailDto
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    DiscountPercentage = l.DiscountPercentage,
                    DiscountAmount = l.FixedDiscountAmount
                }).ToList()
            };

            var result = await QuotationService.UpdateAsync(Id, updateDto);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Quotation saved successfully"], Severity.Success);
                Navigation.NavigateTo("/shop/quotations");
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        finally
        {
            _processing = false;
        }
    }
    #endregion

    #region Helper class
    private class QuotationLine
    {
        public int LineId { get; set; }
        public long ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string ProductCode { get; set; } = string.Empty;
        public ProductDto? SelectedProduct { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal OriginalPrice { get; set; }
        public decimal DiscountPercentage { get; set; }
        public decimal? FixedDiscountAmount { get; set; }
        public decimal LineTotal { get; set; }
        public decimal LineTax { get; set; }
        public decimal LineDiscount { get; set; }
        public List<ProductWholesalePriceDto> WholesalePrices { get; set; } = [];
    }
    #endregion
}
