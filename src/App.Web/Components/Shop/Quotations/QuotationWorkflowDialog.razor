@using App.Core.Enums.Shop
@using MudBlazor
@using System.Text
@inject IStringLocalizer<QuotationWorkflowDialog> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
            @L["Workflow description"]
        </MudText>

        @if (CurrentStatus.HasValue)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudText Typo="Typo.body2">@L["Current status:"]</MudText>
                <MudChip T="string" Size="MudBlazor.Size.Small" Color="@GetMudColor(CurrentStatus.Value)">
                    @L[CurrentStatus.Value.ToString()]
                </MudChip>
            </MudStack>
        }

        <div style="width:100%;overflow-x:auto;">
            <svg viewBox="0 0 520 415"
                 xmlns="http://www.w3.org/2000/svg"
                 style="width:100%;max-width:520px;display:block;margin:auto;font-family:Roboto,sans-serif;">
                <defs>
                    <marker id="wf-arrow" markerWidth="9" markerHeight="7" refX="8" refY="3.5" orient="auto">
                        <polygon points="0 0, 9 3.5, 0 7" fill="#BDBDBD" />
                    </marker>
                </defs>

                <!-- ── Arrows (drawn first, behind nodes) ── -->

                <!-- Draft → Pending -->
                <line x1="260" y1="53" x2="260" y2="105"
                      stroke="#BDBDBD" stroke-width="1.5" marker-end="url(#wf-arrow)" />

                <!-- Pending → Rejected (curve left) -->
                <path d="M 230,143 C 200,182 110,182 75,215"
                      stroke="#BDBDBD" stroke-width="1.5" fill="none" marker-end="url(#wf-arrow)" />

                <!-- Pending → Accepted (straight down) -->
                <line x1="260" y1="143" x2="260" y2="215"
                      stroke="#BDBDBD" stroke-width="1.5" marker-end="url(#wf-arrow)" />

                <!-- Pending → Expired (curve right) -->
                <path d="M 290,143 C 320,182 410,182 445,215"
                      stroke="#BDBDBD" stroke-width="1.5" fill="none" marker-end="url(#wf-arrow)" />

                <!-- Accepted → Sale (curve left) -->
                <path d="M 230,253 C 205,295 160,295 140,325"
                      stroke="#BDBDBD" stroke-width="1.5" fill="none" marker-end="url(#wf-arrow)" />

                <!-- Accepted → Remission (curve right) -->
                <path d="M 290,253 C 315,295 360,295 380,325"
                      stroke="#BDBDBD" stroke-width="1.5" fill="none" marker-end="url(#wf-arrow)" />

                <!-- ── Arrow labels ── -->
                <text x="268" y="79" font-size="9" fill="#9E9E9E" text-anchor="start">@L["Send / Mark pending"]</text>
                <text x="148" y="188" font-size="9" fill="#9E9E9E" text-anchor="middle">@L["Mark rejected"]</text>
                <text x="270" y="184" font-size="9" fill="#9E9E9E" text-anchor="start">@L["Mark accepted"]</text>
                <text x="370" y="188" font-size="9" fill="#9E9E9E" text-anchor="middle">@L["Mark expired"]</text>
                <text x="182" y="298" font-size="9" fill="#9E9E9E" text-anchor="middle">@L["Convert"]</text>
                <text x="340" y="298" font-size="9" fill="#9E9E9E" text-anchor="middle">@L["Convert"]</text>

                <!-- ── State nodes ── -->
                @DrawNode(QuotationStatus.Draft,    "#9E9E9E", 190,  17, 140, 36)
                @DrawNode(QuotationStatus.Pending,  "#2196F3", 190, 107, 140, 36)
                @DrawNode(QuotationStatus.Rejected, "#F44336",  15, 215, 120, 36)
                @DrawNode(QuotationStatus.Accepted, "#4CAF50", 190, 215, 140, 36)
                @DrawNode(QuotationStatus.Expired,  "#FF9800", 385, 215, 120, 36)

                <!-- ── Outcome nodes (rounded rectangle) ── -->
                @DrawOutcome(L["Sale"].Value,      "#1565C0",  80, 325, 120, 36)
                @DrawOutcome(L["Remission"].Value, "#E65100", 320, 325, 130, 36)
            </svg>
        </div>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
            <strong>@L["Legend"]</strong>
        </MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var (color, key) in _legendItems)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <div style="width:12px;height:12px;border-radius:50%;background:@color;flex-shrink:0;"></div>
                    <MudText Typo="Typo.caption">@L[key]</MudText>
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public QuotationStatus? CurrentStatus { get; set; }

    private static readonly (string Color, string Key)[] _legendItems =
    [
        ("#9E9E9E", "Draft — editable, not yet sent"),
        ("#2196F3", "Pending — sent to customer, awaiting response"),
        ("#4CAF50", "Accepted — customer approved, ready to convert"),
        ("#F44336", "Rejected — customer declined (terminal)"),
        ("#FF9800", "Expired — past validity date (terminal)"),
    ];

    private MarkupString DrawNode(QuotationStatus status, string color, double x, double y, double w, double h)
    {
        bool isCurrent = CurrentStatus == status;
        string label = L[status.ToString()].Value;
        double rx = h / 2; // pill shape
        double cx = x + w / 2;
        double cy = y + h / 2;

        var sb = new StringBuilder();
        sb.Append("<g>");

        if (isCurrent)
        {
            // Outer glow ring
            sb.Append($"<rect x='{x - 4}' y='{y - 4}' width='{w + 8}' height='{h + 8}' rx='{rx + 4}' fill='none' stroke='{color}' stroke-width='3' opacity='0.45'/>");
            sb.Append($"<rect x='{x - 2}' y='{y - 2}' width='{w + 4}' height='{h + 4}' rx='{rx + 2}' fill='none' stroke='{color}' stroke-width='1.5' opacity='0.7'/>");
        }

        sb.Append($"<rect x='{x}' y='{y}' width='{w}' height='{h}' rx='{rx}' fill='{color}'/>");
        sb.Append($"<text x='{cx}' y='{cy}' text-anchor='middle' dominant-baseline='middle' fill='white' font-size='13' font-weight='{(isCurrent ? "700" : "500")}'>{System.Net.WebUtility.HtmlEncode(label)}</text>");
        sb.Append("</g>");

        return new MarkupString(sb.ToString());
    }

    private MarkupString DrawOutcome(string label, string color, double x, double y, double w, double h)
    {
        double cx = x + w / 2;
        double cy = y + h / 2;

        var sb = new StringBuilder();
        sb.Append("<g>");
        sb.Append($"<rect x='{x}' y='{y}' width='{w}' height='{h}' rx='8' fill='{color}'/>");
        sb.Append($"<text x='{cx}' y='{cy}' text-anchor='middle' dominant-baseline='middle' fill='white' font-size='13' font-weight='500'>{System.Net.WebUtility.HtmlEncode(label)}</text>");
        sb.Append("</g>");

        return new MarkupString(sb.ToString());
    }

    private void Close() => MudDialog.Close();

    private static Color GetMudColor(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft    => Color.Default,
        QuotationStatus.Pending  => Color.Info,
        QuotationStatus.Accepted => Color.Success,
        QuotationStatus.Rejected => Color.Error,
        QuotationStatus.Expired  => Color.Warning,
        _                        => Color.Default
    };
}
