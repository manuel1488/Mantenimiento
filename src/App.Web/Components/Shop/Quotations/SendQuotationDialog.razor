@using App.Core.Interfaces.Shop
@using MudBlazor
@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SendQuotationDialog> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">@L["The quotation will be sent to the following email address:"]</MudText>
            <MudTextField @bind-Value="_email"
                          Label="@L["Email"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="@L["Email is required"]" />
            @if (_sending)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_sending">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_email) || _sending)">
            @L["Send"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    #region Parameters
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long QuotationId { get; set; }
    [Parameter] public string? CustomerEmail { get; set; }
    #endregion

    #region Fields
    private string? _email;
    private bool _sending;
    #endregion

    protected override void OnParametersSet()
    {
        _email = CustomerEmail;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;

        _sending = true;
        try
        {
            var result = await QuotationService.SendByEmailAsync(QuotationId, _email);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Quotation sent successfully"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        finally
        {
            _sending = false;
        }
    }
}
