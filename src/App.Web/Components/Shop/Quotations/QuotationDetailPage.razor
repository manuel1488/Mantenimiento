@page "/shop/quotations/{Id:long}/view"
@using App.Core.Constants
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<QuotationDetailPage> L

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewQuotations)]

<PageTitle>@L["Quotation Detail"]</PageTitle>

@if (_loading)
{
    <div style="display:flex; justify-content:center; padding:60px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_quotation is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@L["Quotation not found"]</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">@L["Back"]</MudButton>
}
else
{
    @* Title row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="GoBack"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h5" Style="flex:1;">@_quotation.QuotationNumber</MudText>
        <MudChip T="string" Color="@GetStatusColor(_quotation.Status)" Size="Size.Small">
            @L[_quotation.Status.ToString()]
        </MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                       Color="Color.Default"
                       title="@L["Preview PDF"]"
                       OnClick="PreviewPdfAsync" />
        <MudIconButton Icon="@Icons.Material.Filled.Download"
                       Color="Color.Secondary"
                       title="@L["Download PDF"]"
                       OnClick="DownloadPdfAsync" />
    </MudStack>

    <MudPaper Elevation="2" Class="pa-4">

        @* Header info *@
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.caption" Style="color:#888;">@L["Customer"]</MudText>
                <MudText Typo="Typo.body1"><strong>@_quotation.CustomerName</strong></MudText>
                @if (!string.IsNullOrWhiteSpace(_quotation.CustomerEmail))
                {
                    <MudText Typo="Typo.caption" Style="color:#888;">@_quotation.CustomerEmail</MudText>
                }
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Style="color:#888;">@L["Quote Date"]</MudText>
                <MudText Typo="Typo.body1">@_quotation.QuoteDate.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Style="color:#888;">@L["Valid Until"]</MudText>
                <MudText Typo="Typo.body1">@_quotation.ValidUntil.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
            @if (_quotation.SentAt.HasValue)
            {
                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.caption" Style="color:#888;">@L["Sent"]</MudText>
                    <MudText Typo="Typo.body2">@_quotation.SentAt.Value.ToString("dd/MM/yyyy")</MudText>
                    @if (!string.IsNullOrWhiteSpace(_quotation.SentToEmail))
                    {
                        <MudText Typo="Typo.caption" Style="color:#888;">@_quotation.SentToEmail</MudText>
                    }
                </MudItem>
            }
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Style="color:#888;">@L["Created by"]</MudText>
                <MudText Typo="Typo.body2">@_quotation.CreatedBy</MudText>
            </MudItem>
            @{
                var terminalLabel = _quotation.Status switch
                {
                    QuotationStatus.Accepted             => L["Authorized by"].Value,
                    QuotationStatus.Rejected             => L["Rejected by"].Value,
                    QuotationStatus.Expired              => L["Marked expired by"].Value,
                    QuotationStatus.ConvertedToSale      => L["Converted by"].Value,
                    QuotationStatus.ConvertedToRemission => L["Converted by"].Value,
                    _                                    => null
                };
            }
            @if (terminalLabel is not null && !string.IsNullOrWhiteSpace(_quotation.ModifiedBy))
            {
                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.caption" Style="color:#888;">@terminalLabel</MudText>
                    <MudText Typo="Typo.body2">@_quotation.ModifiedBy</MudText>
                </MudItem>
            }
            @if (!string.IsNullOrWhiteSpace(_quotation.Notes))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Style="color:#888;">@L["Notes & Conditions"]</MudText>
                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_quotation.Notes</MudText>
                </MudItem>
            }
        </MudGrid>

        <MudDivider Class="mb-3" />

        @* Products table *@
        <MudSimpleTable Dense="true" Hover="true" Style="margin-bottom:16px;">
            <thead>
                <tr>
                    <th>@L["Product"]</th>
                    <th style="text-align:right; width:90px">@L["Qty"]</th>
                    <th style="text-align:right; width:130px">@L["Unit Price"]</th>
                    <th style="text-align:right; width:130px">@L["Amount"]</th>
                    <th style="text-align:right; width:130px">@L["Discount"]</th>
                    <th style="text-align:right; width:130px">@L["Total"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in _quotation.Details)
                {
                    <tr>
                        <td>
                            <span>@d.ProductName</span>
                            <span style="font-size:11px; color:#888; margin-left:4px;">(@d.ProductCode)</span>
                        </td>
                        <td style="text-align:right">@d.Quantity.ToString("N2")</td>
                        <td style="text-align:right">@d.UnitPrice.ToString("C2")</td>
                        <td style="text-align:right">@((d.Quantity * d.UnitPrice).ToString("C2"))</td>
                        <td style="text-align:right; color:#E53935;">@(d.DiscountAmount > 0 ? $"-{d.DiscountAmount:C2}" : "—")</td>
                        <td style="text-align:right; font-weight:600;">@d.Total.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @* Totals *@
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudStack Spacing="1" Style="min-width:260px;">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                    <MudText Typo="Typo.body2">@_quotation.Subtotal.ToString("C2")</MudText>
                </MudStack>
                @if (_quotation.DiscountAmount > 0)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Discount"]:</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Error">-@_quotation.DiscountAmount.ToString("C2")</MudText>
                    </MudStack>
                }
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                    <MudText Typo="Typo.body2">@_quotation.TaxAmount.ToString("C2")</MudText>
                </MudStack>
                <MudDivider />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle1"><strong>@L["Total"]:</strong></MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@_quotation.Total.ToString("C2")</strong></MudText>
                </MudStack>
            </MudStack>
        </MudStack>

        @* Related links *@
        @if (_quotation.ConvertedSaleId.HasValue || _quotation.ConvertedRemissionId.HasValue)
        {
            <MudDivider Class="mt-4 mb-3" />
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Style="color:#888;">@L["Related"]:</MudText>
                @if (_quotation.ConvertedSaleId.HasValue)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PointOfSale"
                               Color="Color.Tertiary"
                               OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{_quotation.ConvertedSaleId}"))">
                        @L["View Sale"]
                    </MudButton>
                }
                @if (_quotation.ConvertedRemissionId.HasValue)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.LocalShipping"
                               Color="Color.Warning"
                               OnClick="@(() => Navigation.NavigateTo("/shop/remissions"))">
                        @L["View Remission"]
                    </MudButton>
                }
            </MudStack>
        }

    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }

    private QuotationDto? _quotation;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _quotation = await QuotationService.GetByIdAsync(Id);
        _loading = false;
    }

    private async Task PreviewPdfAsync()
        => await JS.InvokeVoidAsync("openInNewTab", $"/api/quotations/{Id}/pdf");

    private async Task DownloadPdfAsync()
    {
        try
        {
            var bytes = await QuotationService.GeneratePdfAsync(Id);
            await JS.InvokeVoidAsync("downloadFile",
                $"cotizacion_{_quotation?.QuotationNumber}.pdf",
                "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void GoBack() => Navigation.NavigateTo("/shop/quotations");

    private static Color GetStatusColor(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => Color.Default,
        QuotationStatus.Pending => Color.Warning,
        QuotationStatus.Accepted => Color.Success,
        QuotationStatus.Rejected => Color.Error,
        QuotationStatus.Expired => Color.Dark,
        QuotationStatus.ConvertedToSale => Color.Tertiary,
        QuotationStatus.ConvertedToRemission => Color.Info,
        _ => Color.Default
    };
}
