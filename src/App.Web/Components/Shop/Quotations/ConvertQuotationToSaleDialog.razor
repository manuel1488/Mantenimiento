


@using App.Core.DTOs.Settings
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Settings
@using App.Core.Interfaces.Shop
@using App.Shared.Services
@using MudBlazor
@inject IQuotationService QuotationService
@inject ISaleService SaleService
@inject IPaymentMethodService PaymentMethodService
@inject ICashRegisterService CashRegisterService
@inject ICurrentUserService CurrentUserService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConvertQuotationToSaleDialog> L

<MudDialog>
    <TitleContent>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <MudText Typo="Typo.h6">@L["Convert to Sale"]</MudText>
            @if (_quotation is not null && !_loading)
            {
                <MudText Typo="Typo.body2" Style="color:#888;">@_quotation.QuotationNumber</MudText>
                <MudText Typo="Typo.body2" Style="color:#555;">· @_quotation.CustomerName</MudText>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_quotation is not null)
        {
            @* Cash register status — compact banner *@
            @if (_activeCashRegister is null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                    @L["No open cash register. Open a cash register before converting to a sale."]
                </MudAlert>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:6px; padding:4px 10px; background:#E8F5E9; border-radius:6px; margin-bottom:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#388E3C;" />
                    <MudText Typo="Typo.body2" Style="color:#388E3C;">@_activeCashRegister.LocationName</MudText>
                </div>
            }

            @* Products table — scrollable *@
            <div style="max-height:200px; overflow-y:auto; border:1px solid #e0e0e0; border-radius:6px; margin-bottom:8px;">
                <MudTable T="QuotationDetailDto" Items="_quotation.Details" Dense="true" Hover="true" Elevation="0" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>@L["Product"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Qty"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Unit Price"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Product"]">@context.ProductName</MudTd>
                        <MudTd DataLabel="@L["Qty"]" Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd DataLabel="@L["Unit Price"]" Style="text-align:right">@context.UnitPrice.ToString("C2")</MudTd>
                        <MudTd DataLabel="@L["Total"]" Style="text-align:right">@context.Total.ToString("C2")</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            @* Totals — compact one-line summary *@
            <div style="display:flex; justify-content:flex-end; align-items:center; gap:16px; padding:6px 12px; background:#FAFAFA; border-radius:6px; margin-bottom:12px; flex-wrap:wrap;">
                <span style="font-size:13px; color:#666;">
                    @L["Subtotal"]: <strong>@_quotation.Subtotal.ToString("C2")</strong>
                </span>
                @if (_quotation.DiscountAmount > 0)
                {
                    <span style="font-size:13px; color:#E53935;">
                        @L["Discount"]: <strong>-@_quotation.DiscountAmount.ToString("C2")</strong>
                    </span>
                }
                @if (_quotation.TaxAmount > 0)
                {
                    <span style="font-size:13px; color:#666;">
                        @L["Tax"]: <strong>@_quotation.TaxAmount.ToString("C2")</strong>
                    </span>
                }
                <span style="font-size:16px; font-weight:700; color:#212121;">
                    @L["Total"]: @_quotation.Total.ToString("C2")
                </span>
            </div>

            <MudDivider Class="mb-2" />

            @* Payment section header *@
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <MudText Typo="Typo.subtitle2">@L["Payment"]</MudText>
                @if (Math.Abs(Remaining) <= 0.01m)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Complete"]</MudChip>
                }
                else if (Remaining > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        @L["Remaining"]: <strong>@Remaining.ToString("C2")</strong>
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">
                        @L["Overpaid"]: <strong>@Math.Abs(Remaining).ToString("C2")</strong>
                    </MudText>
                }
            </div>

            @* Payment method buttons *@
            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px;">
                @foreach (var pm in _paymentMethods)
                {
                    <MudButton StartIcon="@pm.Icon"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="@(() => AddPaymentForMethod(pm))">
                        @pm.Name
                    </MudButton>
                }
            </div>

            @* Payment lines — grouped by method, bounded height *@
            @if (_paymentLines.Count > 0)
            {
                <div style="max-height:260px; overflow-y:auto; border:1px solid #e0e0e0; border-radius:6px;">
                    @foreach (var pg in GroupedPayments)
                    {
                        @* Header row: one per unique payment method *@
                        <div style="display:flex; align-items:center; gap:4px; padding:0 4px 0 10px; min-height:42px; background:#FAFAFA; border-bottom:1px solid #e8e8e8; position:sticky; top:0; z-index:1;">
                            <MudIcon Icon="@pg.Icon" Size="Size.Small" Style="color:#555; flex-shrink:0;" />
                            <MudText Typo="Typo.body2" Style="flex:1; font-size:13px; font-weight:500;">@pg.Name</MudText>
                            @if (pg.Entries.Count == 1)
                            {
                                <MudNumericField T="decimal"
                                                 Value="pg.Entries[0].Amount"
                                                 ValueChanged="@(v => pg.Entries[0].Amount = v)"
                                                 Variant="Variant.Text"
                                                 Margin="Margin.Dense"
                                                 HideSpinButtons="true"
                                                 Format="N2"
                                                 Style="width:110px;" />
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="width:110px; text-align:right; font-weight:600; color:#333; padding-right:14px;">
                                    @pg.Entries.Sum(e => e.Amount).ToString("N2")
                                </MudText>
                            }
                            @if (pg.Type != PaymentMethodType.Cash)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               title="@L["Add another"]"
                                               OnClick="@(() => AddSubEntry(pg.Key))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           title="@L["Remove"]"
                                           OnClick="@(() => RemoveAllForMethod(pg.Key))" />
                        </div>

                        @* Sub-entries: only when there are 2+ payments for this method *@
                        @if (pg.Entries.Count > 1)
                        {
                            @foreach (var entry in pg.Entries)
                            {
                                <div style="display:flex; align-items:center; gap:4px; padding:0 4px 0 30px; min-height:36px; border-bottom:1px solid #f5f5f5; background:#fff;">
                                    <span style="color:#ccc; flex-shrink:0;">└</span>
                                    <MudNumericField T="decimal"
                                                     Value="entry.Amount"
                                                     ValueChanged="@(v => entry.Amount = v)"
                                                     Variant="Variant.Text"
                                                     Margin="Margin.Dense"
                                                     HideSpinButtons="true"
                                                     Format="N2"
                                                     Style="flex:1; max-width:110px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   title="@L["Remove"]"
                                                   OnClick="@(() => RemovePaymentLine(entry))" />
                                </div>
                            }
                        }
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="ConfirmAsync"
                   Disabled="@(!CanConfirm)">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["Confirm Sale"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long QuotationId { get; set; }

    #region Fields
    private QuotationDto? _quotation;
    private CashRegisterDto? _activeCashRegister;
    private List<PaymentMethodDto> _paymentMethods = [];
    private List<PaymentLine> _paymentLines = [];
    private bool _loading = true;
    private bool _processing;
    #endregion

    private decimal TotalPaid => _paymentLines.Sum(p => p.Amount);
    private decimal Remaining => (_quotation?.Total ?? 0) - TotalPaid;

    private IEnumerable<PaymentGroup> GroupedPayments =>
        _paymentLines
            .GroupBy(p => p.PaymentMethodId)
            .Select(g =>
            {
                var m = _paymentMethods.FirstOrDefault(pm => pm.Id == g.Key);
                return new PaymentGroup(
                    g.Key,
                    m?.Name ?? string.Empty,
                    m?.Icon ?? "payments",
                    m?.Type ?? PaymentMethodType.Cash,
                    g.ToList());
            });

    private bool CanConfirm =>
        _quotation is not null &&
        _activeCashRegister is not null &&
        _paymentLines.Count > 0 &&
        _paymentLines.All(p => p.PaymentMethodId > 0 && p.Amount > 0) &&
        Math.Abs(Remaining) <= 0.01m &&
        !_processing;

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUserService.UserId ?? string.Empty;
        var cashResult = await CashRegisterService.GetActiveCashRegisterByUserAsync(userId);
        if (cashResult.IsSuccess && cashResult.Value is not null)
            _activeCashRegister = cashResult.Value;

        _paymentMethods = (await PaymentMethodService.GetActiveAsync()).ToList();
        _quotation = await QuotationService.GetByIdAsync(QuotationId);

        if (_quotation is not null)
        {
            _paymentLines.Add(new PaymentLine
            {
                PaymentMethodId = _paymentMethods.FirstOrDefault()?.Id ?? 0,
                Amount = _quotation.Total
            });
        }

        _loading = false;
    }

    private void AddPaymentForMethod(PaymentMethodDto pm)
    {
        // Cash: only one entry allowed — update existing amount instead of adding new
        if (pm.Type == PaymentMethodType.Cash)
        {
            var existing = _paymentLines.FirstOrDefault(p => p.PaymentMethodId == pm.Id);
            if (existing is not null)
            {
                existing.Amount += Remaining > 0 ? Remaining : 0;
                return;
            }
        }

        _paymentLines.Add(new PaymentLine
        {
            PaymentMethodId = pm.Id,
            Amount = Remaining > 0 ? Remaining : 0
        });
    }

    private void AddSubEntry(int methodId)
    {
        // Guard: cash cannot have sub-entries
        var method = _paymentMethods.FirstOrDefault(m => m.Id == methodId);
        if (method?.Type == PaymentMethodType.Cash) return;

        _paymentLines.Add(new PaymentLine
        {
            PaymentMethodId = methodId,
            Amount = Remaining > 0 ? Remaining : 0
        });
    }

    private void RemoveAllForMethod(int methodId) =>
        _paymentLines.RemoveAll(p => p.PaymentMethodId == methodId);

    private void RemovePaymentLine(PaymentLine line) => _paymentLines.Remove(line);

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmAsync()
    {
        if (!CanConfirm || _quotation is null) return;

        _processing = true;

        var createDto = new CreateSaleDto
        {
            CustomerId = _quotation.CustomerId,
            QuotationId = _quotation.Id,
            LocationId = _activeCashRegister?.LocationId,
            DiscountPercentage = _quotation.DiscountPercentage,
            Details = _quotation.Details.Select(d => new CreateSaleDetailDto
            {
                ProductId = d.ProductId,
                Quantity = d.Quantity,
                UnitPrice = d.UnitPrice,
                IsCustomPrice = true,
                DiscountPercentage = d.DiscountPercentage,
                DiscountAmount = d.DiscountAmount > 0 ? d.DiscountAmount : null
            }).ToList(),
            Payments = _paymentLines.Select(p => new CreateSalePaymentDto
            {
                PaymentMethodId = p.PaymentMethodId,
                Amount = p.Amount
            }).ToList()
        };

        var result = await SaleService.CreateSaleAsync(createDto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Sale created successfully"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Value.Id));
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }

        _processing = false;
    }

    private class PaymentLine
    {
        public int PaymentMethodId { get; set; }
        public decimal Amount { get; set; }
    }

    private record PaymentGroup(int Key, string Name, string Icon, PaymentMethodType Type, List<PaymentLine> Entries);
}
