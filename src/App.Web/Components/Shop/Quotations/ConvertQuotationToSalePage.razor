@page "/shop/quotations/{QuotationId:long}/convert"
@using Microsoft.AspNetCore.Authorization
@using App.Core.DTOs.Settings
@using App.Web.Components.Shop.Sales
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Settings
@using App.Core.Interfaces.Shop
@using App.Shared.Services
@using MudBlazor

@inject IQuotationService QuotationService
@inject ISaleService SaleService
@inject IPaymentMethodService PaymentMethodService
@inject ICashRegisterService CashRegisterService
@inject ICurrentUserService CurrentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<ConvertQuotationToSalePage> L

@attribute [Authorize(Policy = ApplicationClaims.Shop.ConvertQuotationToSale)]

<PageTitle>@L["Convert Quotation to Sale"]</PageTitle>

@if (_loading)
{
    <div style="display:flex; justify-content:center; padding:60px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_quotation is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@L["Quotation not found"]</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">@L["Back"]</MudButton>
}
else
{
    <MudGrid Spacing="2">

        @* ── LEFT: Quotation details ── *@
        <MudItem xs="12" md="7">
            <MudPaper Elevation="2" Class="pa-4">

                @* Header *@
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap;">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Style="flex:1;">@_quotation.QuotationNumber</MudText>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Accepted"]</MudChip>
                </div>

                <MudGrid Spacing="1" Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Customer"]</MudText>
                        <MudText Typo="Typo.body2"><strong>@_quotation.CustomerName</strong></MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Date"]</MudText>
                        <MudText Typo="Typo.body2">@_quotation.QuoteDate.ToShortDateString()</MudText>
                    </MudItem>
                </MudGrid>

                @* Tax rate change — blocking: conversion is not allowed *@
                @if (_discrepancies?.TaxRateChanged == true)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                            @L["Conversion blocked: the tax rate changed"]
                        </MudText>
                        <MudText Typo="Typo.body2">
                            @L["Tax rate changed: quoted {0}, current {1}. Create a new quotation at the current rate.",
                                _discrepancies.QuotedTaxRate.ToString("P2"), _discrepancies.CurrentTaxRate.ToString("P2")]
                        </MudText>
                    </MudAlert>
                }

                @* Price / rounding — informational, non-blocking *@
                @if (_discrepancies is not null && (_discrepancies.PriceChanges.Count > 0 || _discrepancies.RoundingEnabled))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        <MudText Typo="Typo.body2" Style="font-weight:600; margin-bottom:4px;">
                            @L["This quotation was created earlier — some conditions have changed:"]
                        </MudText>
                        <ul style="margin:0; padding-left:18px;">
                            @if (_discrepancies.PriceChanges.Count > 0)
                            {
                                <li>
                                    <MudText Typo="Typo.body2">
                                        @L["Catalog price changed for {0} product(s). The sale will honor the quoted price:", _discrepancies.PriceChanges.Count]
                                    </MudText>
                                    <ul style="margin:0; padding-left:18px;">
                                        @foreach (var pc in _discrepancies.PriceChanges)
                                        {
                                            <li>
                                                <MudText Typo="Typo.caption">
                                                    @pc.ProductName (@pc.ProductCode): @L["quoted"] @pc.QuotedPrice.ToString("C2") → @L["current"] @pc.CurrentPrice.ToString("C2")
                                                </MudText>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (_discrepancies.RoundingEnabled)
                            {
                                <li>
                                    <MudText Typo="Typo.body2">
                                        @L["Rounding is enabled, but this conversion keeps the exact quoted total (no rounding applied)."]
                                    </MudText>
                                </li>
                            }
                        </ul>
                    </MudAlert>
                }

                @* Products table *@
                <MudTable T="QuotationDetailDto" Items="_quotation.Details"
                          Dense="true" Hover="true" Elevation="0"
                          FixedHeader="true" Style="max-height:45vh; overflow-y:auto;">
                    <HeaderContent>
                        <MudTh>@L["Product"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Qty"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Unit Price"]</MudTh>
                        <MudTh Style="text-align:right; white-space:nowrap;">@L["Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Product"]">
                            <div style="display:flex; align-items:center; gap:4px;">
                                <span>@context.ProductName (@context.ProductCode)</span>
                                @if (!context.RequiresInventory)
                                {
                                    <MudTooltip Text="@L["This product does not affect inventory"]">
                                        <MudIcon Icon="@Icons.Material.Outlined.Inventory"
                                                 Size="Size.Small" Color="Color.Warning" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Qty"]" Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd DataLabel="@L["Unit Price"]" Style="text-align:right">@context.UnitPrice.ToString("C2")</MudTd>
                        <MudTd DataLabel="@L["Total"]" Style="text-align:right">@context.Total.ToString("C2")</MudTd>
                    </RowTemplate>
                </MudTable>

                @* Totals *@
                <div style="display:flex; justify-content:flex-end; margin-top:14px;">
                    <div style="min-width:220px;">
                        @if (_quotation.DiscountAmount > 0)
                        {
                            <div style="display:flex; justify-content:space-between; padding:2px 0;">
                                <MudText Typo="Typo.body2">@L["Subtotal"]</MudText>
                                <MudText Typo="Typo.body2">@_quotation.Subtotal.ToString("C2")</MudText>
                            </div>
                            <div style="display:flex; justify-content:space-between; padding:2px 0;">
                                <MudText Typo="Typo.body2" Color="Color.Error">@L["Discount"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Error">-@_quotation.DiscountAmount.ToString("C2")</MudText>
                            </div>
                        }
                        @if (_quotation.TaxAmount > 0)
                        {
                            <div style="display:flex; justify-content:space-between; padding:2px 0;">
                                <MudText Typo="Typo.body2">@L["Tax"]</MudText>
                                <MudText Typo="Typo.body2">@_quotation.TaxAmount.ToString("C2")</MudText>
                            </div>
                        }
                        <MudDivider Class="my-1" />
                        <div style="display:flex; justify-content:space-between; padding:2px 0;">
                            <MudText Typo="Typo.subtitle1"><strong>@L["Total"]</strong></MudText>
                            <MudText Typo="Typo.subtitle1"><strong>@_quotation.Total.ToString("C2")</strong></MudText>
                        </div>
                    </div>
                </div>

            </MudPaper>
        </MudItem>

        @* ── RIGHT: Payment section ── *@
        <MudItem xs="12" md="5">
            <MudPaper Elevation="2" Class="pa-4" Style="display:flex; flex-direction:column; gap:14px; min-height:400px;">

                @* Cash register status *@
                @if (_activeCashRegister is null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @L["No open cash register. Open a cash register before converting to a sale."]
                    </MudAlert>
                }
                else
                {
                    <div style="display:flex; align-items:center; gap:6px; padding:6px 10px; background:#E8F5E9; border-radius:6px;">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#388E3C;" />
                        <MudText Typo="Typo.body2" Style="color:#388E3C;">@_activeCashRegister.LocationName</MudText>
                    </div>
                }

                @* Payment methods header + status chip *@
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <MudText Typo="Typo.subtitle2">@L["Payment Methods"]</MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(Remaining <= 0 ? Color.Success : Color.Warning)">
                        @(Remaining <= 0 ? L["Complete"] : $"{L["Remaining"]}: {Remaining:C2}")
                    </MudChip>
                </div>

                @* Method buttons *@
                @if (!_paymentMethods.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@L["No payment methods configured"]</MudAlert>
                }
                else
                {
                    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); gap:6px;">
                        @foreach (var pm in _paymentMethods)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="@(async () => await OpenPaymentGroupDialog(pm))"
                                       Style="height:44px; text-transform:none; font-size:11px; flex-direction:row; gap:4px; padding:4px 8px; justify-content:flex-start;"
                                       Disabled="@IsPaymentButtonDisabled(pm)">
                                <MudIcon Icon="@pm.Icon" Size="Size.Small" />
                                <span style="flex:1; line-height:1.1; text-align:left;">@pm.Name</span>
                            </MudButton>
                        }
                    </div>
                }

                @* Payment entries — grouped by method, click to edit *@
                @foreach (var group in _paymentEntries.GroupBy(e => e.PaymentMethod.Id))
                {
                    var grpPm = group.First().PaymentMethod;
                    var groupTotal = group.Sum(e => e.Amount);
                    var subCount = group.Count();
                    var cashEntry = group.FirstOrDefault(e => e.PaymentMethod.Type == PaymentMethodType.Cash);
                    <div @key="grpPm.Id"
                         style="display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:6px; background:#FAFAFA; border-left:3px solid @GetPaymentColor(grpPm.Type); cursor:pointer;"
                         @onclick="@(async () => await OpenPaymentGroupDialog(grpPm))">
                        <MudIcon Icon="@grpPm.Icon" Size="Size.Small" Style="@($"color:{GetPaymentColor(grpPm.Type)}")" />
                        <div style="flex:1; min-width:0; overflow:hidden;">
                            <span style="font-size:13px; font-weight:600;">@grpPm.Name</span>
                            @if (subCount > 1)
                            {
                                <span style="font-size:11px; color:#999; margin-left:4px;">(@subCount)</span>
                            }
                            @if (cashEntry is not null && cashEntry.CashReceived > cashEntry.Amount)
                            {
                                <span style="font-size:11px; color:#4CAF50; margin-left:6px;">(@L["Cash change"]: @GetCashChange(cashEntry).ToString("C2"))</span>
                            }
                        </div>
                        <span style="font-size:14px; font-weight:700; color:#333; white-space:nowrap;">@groupTotal.ToString("C2")</span>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemovePaymentGroup(grpPm.Id))"
                                           title="@L["Remove"]" />
                        </span>
                    </div>
                }

                @* Progress bar *@
                @if (_paymentEntries.Any())
                {
                    <MudProgressLinear Value="@PaidPercentage"
                                       Color="@(PaidPercentage >= 100 ? Color.Success : Color.Warning)"
                                       Style="height:4px; border-radius:2px;" />
                    <div style="display:flex; justify-content:space-between; margin-top:-8px;">
                        <span style="font-size:11px; color:@(PaidPercentage >= 100 ? "#4CAF50" : "#FF9800");">
                            @L["Paid"]: @PaidTotal.ToString("C2")
                        </span>
                        <span style="font-size:11px; color:@(PaidPercentage >= 100 ? "#4CAF50" : "#FF9800");">
                            @L["Remaining"]: @Math.Max(0, Remaining).ToString("C2")
                        </span>
                    </div>
                }

                @* Action buttons — al fondo *@
                <div style="margin-top:auto; padding-top:10px; border-top:1px solid rgba(0,0,0,0.08); display:flex; gap:8px;">
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                               Variant="Variant.Text"
                               OnClick="GoBack">
                        @L["Back"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Payment"
                               OnClick="ConfirmAsync"
                               Disabled="@(!CanConfirm)"
                               Class="da-button-rounded">
                        @if (_processing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            @L["Processing..."]
                        }
                        else
                        {
                            @L["Confirm Sale"]
                        }
                    </MudButton>
                </div>

            </MudPaper>
        </MudItem>

    </MudGrid>
}

@code {
    [Parameter] public long QuotationId { get; set; }

    #region Fields
    private QuotationDto? _quotation;
    private CashRegisterDto? _activeCashRegister;
    private List<PaymentMethodDto> _paymentMethods = [];
    private List<PaymentEntry> _paymentEntries = [];
    private QuotationConversionCheckDto? _discrepancies;
    private bool _loading = true;
    private bool _processing;
    #endregion

    #region Computed
    private decimal Total => _quotation?.Total ?? 0;
    private decimal PaidTotal => _paymentEntries.Sum(e => e.Amount);
    private decimal Remaining => Total - PaidTotal;
    private double PaidPercentage => Total > 0 ? Math.Min(100, (double)(PaidTotal / Total * 100)) : 0;

    private bool CanConfirm =>
        _quotation is not null &&
        _activeCashRegister is not null &&
        _paymentEntries.Count > 0 &&
        Remaining <= 0.01m &&
        _discrepancies?.TaxRateChanged != true &&
        !_processing;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUserService.UserId ?? string.Empty;

        var cashResult = await CashRegisterService.GetActiveCashRegisterByUserAsync(userId);
        if (cashResult.IsSuccess)
            _activeCashRegister = cashResult.Value;

        _paymentMethods = (await PaymentMethodService.GetActiveAsync()).ToList();
        _quotation = await QuotationService.GetByIdAsync(QuotationId);

        if (_quotation is not null)
        {
            var checkResult = await QuotationService.CheckConversionDiscrepanciesAsync(QuotationId);
            if (checkResult.IsSuccess && checkResult.Value!.HasWarnings)
                _discrepancies = checkResult.Value;
        }

        _loading = false;
    }
    #endregion

    #region Payment Methods
    private bool IsPaymentButtonDisabled(PaymentMethodDto pm)
    {
        if (_quotation is null || _activeCashRegister is null) return true;
        if (_paymentEntries.Any(e => e.PaymentMethod.Id == pm.Id)) return false;
        return PaidTotal >= Total;
    }

    private async Task OpenPaymentGroupDialog(PaymentMethodDto pm)
    {
        var otherTotal = _paymentEntries.Where(e => e.PaymentMethod.Id != pm.Id).Sum(e => e.Amount);
        var remaining = Total - otherTotal;

        var existing = _paymentEntries
            .Where(e => e.PaymentMethod.Id == pm.Id)
            .Select(e => new PaymentGroupDialog.SubEntry
            {
                Amount = e.Amount,
                CashReceived = e.CashReceived,
                CardLastFour = e.CardLastFour,
                AuthorizationCode = e.AuthorizationCode,
                CardBrand = e.CardBrand,
                Reference = e.Reference
            }).ToList();

        if (remaining <= 0 && !existing.Any()) return;

        remaining = Math.Max(0.01m, remaining);

        var parameters = new DialogParameters<PaymentGroupDialog>
        {
            { x => x.PaymentMethod, pm },
            { x => x.TotalSaleRemaining, remaining },
            { x => x.ExistingEntries, existing }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<PaymentGroupDialog>(pm.Name, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<PaymentGroupDialog.SubEntry> subEntries })
        {
            _paymentEntries.RemoveAll(e => e.PaymentMethod.Id == pm.Id);
            foreach (var sub in subEntries)
            {
                _paymentEntries.Add(new PaymentEntry
                {
                    PaymentMethod = pm,
                    Amount = sub.Amount,
                    CashReceived = sub.CashReceived,
                    CardLastFour = sub.CardLastFour,
                    AuthorizationCode = sub.AuthorizationCode,
                    CardBrand = sub.CardBrand,
                    Reference = sub.Reference
                });
            }
            StateHasChanged();
        }
    }

    private void RemovePaymentGroup(int methodId)
    {
        _paymentEntries.RemoveAll(e => e.PaymentMethod.Id == methodId);
        StateHasChanged();
    }

    private static decimal GetCashChange(PaymentEntry entry) => entry.CashReceived - entry.Amount;

    private static string GetPaymentColor(PaymentMethodType type) => type switch
    {
        PaymentMethodType.Cash => "#4CAF50",
        PaymentMethodType.Card => "#2196F3",
        PaymentMethodType.Transfer => "#9C27B0",
        PaymentMethodType.Check => "#607D8B",
        _ => "#9E9E9E"
    };
    #endregion

    #region Actions
    private async Task ConfirmAsync()
    {
        if (!CanConfirm || _quotation is null) return;

        _processing = true;

        var createDto = new CreateSaleDto
        {
            CustomerId = _quotation.CustomerId,
            QuotationId = _quotation.Id,
            LocationId = _activeCashRegister?.LocationId,
            DiscountPercentage = _quotation.DiscountPercentage,
            Details = _quotation.Details.Select(d => new CreateSaleDetailDto
            {
                ProductId = d.ProductId,
                Quantity = d.Quantity,
                UnitPrice = d.UnitPrice,
                DiscountPercentage = d.DiscountPercentage,
                DiscountAmount = d.DiscountAmount > 0 ? d.DiscountAmount : null,
                IsCustomPrice = true
            }).ToList(),
            Payments = _paymentEntries.Select(p => new CreateSalePaymentDto
            {
                PaymentMethodId = p.PaymentMethod.Id,
                Amount = p.Amount,
                CashTendered = p.CashReceived > 0 ? p.CashReceived : null,
                CashChange = p.CashReceived > p.Amount ? p.CashReceived - p.Amount : null,
                CardLastFour = p.CardLastFour,
                AuthorizationCode = p.AuthorizationCode,
                CardBrand = p.CardBrand,
                Reference = p.Reference
            }).ToList()
        };

        var result = await SaleService.CreateSaleAsync(createDto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Sale created successfully"], Severity.Success);
            Navigation.NavigateTo("/shop/quotations");
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
            _processing = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/shop/quotations");
    #endregion

    #region Nested Types
    private class PaymentEntry
    {
        public PaymentMethodDto PaymentMethod { get; set; } = null!;
        public decimal Amount { get; set; }
        public decimal CashReceived { get; set; }
        public string? CardLastFour { get; set; }
        public string? AuthorizationCode { get; set; }
        public CardBrand? CardBrand { get; set; }
        public string? Reference { get; set; }
    }
    #endregion
}
