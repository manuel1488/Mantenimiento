@page "/shop/quotations"
@using App.Core.Constants
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using App.Web.Components.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject IStringLocalizer<QuotationsPage> L
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewQuotations)]

<PageTitle>@L["Quotations"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudText Typo="Typo.h4">@L["Quotations"]</MudText>
    <MudTooltip Text="@L["View workflow"]">
        <MudIconButton Icon="@Icons.Material.Outlined.Help"
                       Size="Size.Small"
                       Color="Color.Default"
                       OnClick="@(() => OpenWorkflowDialog(null))" />
    </MudTooltip>
</MudStack>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
                <MudTextField @bind-Value="_search"
                              Placeholder="@L["Search by number or customer..."]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="@(_ => _grid?.ReloadServerData())"
                              Class="flex-grow-1" />
                <MudSelect T="string?"
                           Value="_statusFilter"
                           ValueChanged="@OnStatusFilterChanged"
                           Placeholder="@L["All statuses"]"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Style="min-width: 180px;">
                    <MudSelectItem T="string?" Value="@((string?)null)">@L["All"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Draft")">@L["Draft"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Pending")">@L["Pending"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Accepted")">@L["Accepted"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Rejected")">@L["Rejected"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Expired")">@L["Expired"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("ConvertedToSale")">@L["Converted to Sale"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("ConvertedToRemission")">@L["Converted to Remission"]</MudSelectItem>
                </MudSelect>
                <AuthorizeView Policy="@ApplicationClaims.Shop.CreateQuotation">
                    <Authorized Context="createAuth">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => Navigation.NavigateTo("/shop/quotations/new"))">
                            @L["New Quotation"]
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudStack>

            <MudDataGrid T="QuotationDto"
                         @ref="_grid"
                         ServerData="@LoadServerData"
                         SortMode="SortMode.None"
                         RowsPerPage="15"
                         Dense="true"
                         Hover="true"
                         HorizontalScrollbar="true">
                <Columns>
                    <PropertyColumn Property="x => x.QuotationNumber" Title="@L["#"]" CellStyle="white-space:nowrap" HeaderStyle="white-space:nowrap" />
                    <PropertyColumn Property="x => x.CustomerName" Title="@L["Customer"]" />
                    <TemplateColumn Title="@L["Date"]">
                        <CellTemplate>
                            @context.Item.QuoteDate.ToString("dd/MM/yyyy")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Valid Until"]">
                        <CellTemplate>
                            @context.Item.ValidUntil.ToString("dd/MM/yyyy")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Total"]">
                        <CellTemplate>
                            @context.Item.Total.ToString("C2")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Status"]">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                                @L[context.Item.Status.ToString()]
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.CreatedBy" Title="@L["Created by"]" />
                    <TemplateColumn Title="@L["Actions"]">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="0">
                                <AuthorizeView Policy="@ApplicationClaims.Shop.EditQuotation">
                                    <Authorized Context="editAuth">
                                        @if (context.Item.Status == QuotationStatus.Draft)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           title="@L["Edit"]"
                                                           OnClick="@(() => Navigation.NavigateTo($"/shop/quotations/{context.Item.Id}/edit"))" />
                                        }
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Policy="@ApplicationClaims.Shop.CreateQuotation">
                                    <Authorized Context="cloneAuth">
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       title="@L["Clone quotation"]"
                                                       OnClick="@(() => Navigation.NavigateTo($"/shop/quotations/new?cloneFrom={context.Item.Id}"))" />
                                    </Authorized>
                                </AuthorizeView>
                                <MudIconButton Icon="@Icons.Material.Filled.Article"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               title="@L["View detail"]"
                                               OnClick="@(() => Navigation.NavigateTo($"/shop/quotations/{context.Item.Id}/view"))" />
                                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               title="@L["Preview PDF"]"
                                               OnClick="@(() => PreviewPdfAsync(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Download"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               title="@L["Download PDF"]"
                                               OnClick="@(() => DownloadPdfAsync(context.Item))" />
                                @if (context.Item.Status == QuotationStatus.Accepted)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   title="@L["Pre-invoice"]"
                                                   OnClick="@(() => PreviewPreInvoiceAsync(context.Item))" />
                                }
                                <AuthorizeView Policy="@ApplicationClaims.Shop.SendQuotation">
                                    <Authorized Context="sendAuth">
                                        <MudIconButton Icon="@Icons.Material.Filled.Email"
                                                       Size="Size.Small"
                                                       Color="Color.Info"
                                                       title="@L["Send by email"]"
                                                       OnClick="@(() => OpenSendDialog(context.Item))" />
                                    </Authorized>
                                </AuthorizeView>
                                @if (context.Item.Status == QuotationStatus.Accepted)
                                {
                                    <AuthorizeView Policy="@ApplicationClaims.Shop.ConvertQuotationToRemission">
                                        <Authorized Context="remissionAuth">
                                            <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                                           Size="Size.Small"
                                                           Color="Color.Warning"
                                                           title="@L["Convert to Remission"]"
                                                           OnClick="@(() => Navigation.NavigateTo($"/shop/remissions/new?quotationId={context.Item.Id}"))" />
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="@ApplicationClaims.Shop.ConvertQuotationToSale">
                                        <Authorized Context="saleAuth">
                                            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCartCheckout"
                                                           Size="Size.Small"
                                                           Color="Color.Success"
                                                           title="@L["Convert to Sale"]"
                                                           OnClick="@(() => Navigation.NavigateTo($"/shop/quotations/{context.Item.Id}/convert"))" />
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                @if (context.Item.Status == QuotationStatus.ConvertedToSale && context.Item.ConvertedSaleId.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PointOfSale"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   title="@L["View sale"]"
                                                   OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{context.Item.ConvertedSaleId}"))" />
                                }
                                @if (context.Item.Status == QuotationStatus.ConvertedToRemission && context.Item.ConvertedRemissionId.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   title="@L["View remission"]"
                                                   OnClick="@(() => Navigation.NavigateTo($"/shop/remissions/{context.Item.ConvertedRemissionId}"))" />
                                }
                                @if (context.Item.Status == QuotationStatus.Draft || context.Item.Status == QuotationStatus.Pending)
                                {
                                    <AuthorizeView Policy="@ApplicationClaims.Shop.EditQuotation">
                                        <Authorized Context="statusAuth">
                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                                @if (context.Item.Status == QuotationStatus.Draft)
                                                {
                                                    <MudMenuItem OnClick="@(() => ChangeStatusAsync(context.Item, QuotationStatus.Pending))">
                                                        @L["Mark as Pending"]
                                                    </MudMenuItem>
                                                }
                                                @if (context.Item.Status == QuotationStatus.Pending)
                                                {
                                                    <MudMenuItem OnClick="@(() => ChangeStatusAsync(context.Item, QuotationStatus.Accepted))">
                                                        @L["Mark as Accepted"]
                                                    </MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => ChangeStatusAsync(context.Item, QuotationStatus.Rejected))">
                                                        @L["Mark as Rejected"]
                                                    </MudMenuItem>
                                                    <MudMenuItem OnClick="@(() => ChangeStatusAsync(context.Item, QuotationStatus.Expired))">
                                                        @L["Mark as Expired"]
                                                    </MudMenuItem>
                                                }
                                            </MudMenu>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                <AuthorizeView Policy="@ApplicationClaims.Shop.DeleteQuotation">
                                    <Authorized Context="deleteAuth">
                                        @if (context.Item.Status == QuotationStatus.Draft)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           title="@L["Delete"]"
                                                           OnClick="@(() => DeleteAsync(context.Item))" />
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="QuotationDto" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    #region Parameters
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }
    #endregion

    #region Fields
    private MudDataGrid<QuotationDto>? _grid;
    private string? _search;
    private string? _statusFilter;
    private string _rejectionReason = "";
    #endregion

    #region Lifecycle
    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
            _search = SearchQuery;
    }
    #endregion

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    #region Data loading
    private async Task<GridData<QuotationDto>> LoadServerData(GridState<QuotationDto> state)
    {
        var (total, items) = await QuotationService.GetQuotationsAsync(
            page: state.Page + 1,
            pageSize: state.PageSize,
            search: _search,
            status: _statusFilter);

        return new GridData<QuotationDto> { Items = items, TotalItems = total };
    }
    #endregion

    #region Actions
    private async Task OpenWorkflowDialog(QuotationStatus? status)
    {
        var parameters = new DialogParameters<QuotationWorkflowDialog>
        {
            { x => x.CurrentStatus, status }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<QuotationWorkflowDialog>(L["Quotation Workflow"], parameters, options);
    }

    private async Task PreviewPdfAsync(QuotationDto quotation)
    {
        await JS.InvokeVoidAsync("openInNewTab", $"/api/quotations/{quotation.Id}/pdf");
    }

    private async Task PreviewPreInvoiceAsync(QuotationDto quotation)
    {
        await JS.InvokeVoidAsync("openInNewTab", $"/api/quotations/{quotation.Id}/preinvoice-pdf");
    }

    private async Task DownloadPdfAsync(QuotationDto quotation)
    {
        try
        {
            var bytes = await QuotationService.GeneratePdfAsync(quotation.Id);
            await JS.InvokeVoidAsync("downloadFile",
                $"cotizacion_{quotation.QuotationNumber}.pdf",
                "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenConvertToSaleDialog(QuotationDto quotation)
    {
        var parameters = new DialogParameters<ConvertQuotationToSaleDialog>
        {
            { x => x.QuotationId, quotation.Id }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<ConvertQuotationToSaleDialog>(L["Convert to Sale"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _grid!.ReloadServerData();
    }

    private async Task OpenSendDialog(QuotationDto quotation)
    {
        var parameters = new DialogParameters<SendQuotationDialog>
        {
            { x => x.QuotationId, quotation.Id },
            { x => x.CustomerEmail, quotation.CustomerEmail }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SendQuotationDialog>(L["Send Quotation"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _grid!.ReloadServerData();
    }

    private async Task ChangeStatusAsync(QuotationDto quotation, QuotationStatus newStatus)
    {
        string? reason = null;

        if (newStatus == QuotationStatus.Rejected)
        {
            _rejectionReason = "";
            var parameters = new DialogParameters
            {
                { nameof(ConfirmDialog.Title), L["Reject Quotation"].ToString() },
                { nameof(ConfirmDialog.ContentText), L["Are you sure you want to reject this quotation:"].ToString() },
                { nameof(ConfirmDialog.HighlightedText), quotation.QuotationNumber },
                { nameof(ConfirmDialog.ConfirmText), L["Reject"].ToString() },
                { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
                { nameof(ConfirmDialog.Color), Color.Error },
                { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Warning },
                { nameof(ConfirmDialog.AdditionalContent), (RenderFragment)(@<MudTextField @bind-Value="@_rejectionReason" Label="@L["Reason for rejection"]" />) }
            };
            var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Reject Quotation"], parameters);
            var dialogResult = await dialog.Result;
            if (dialogResult is null || dialogResult.Canceled) return;
            reason = _rejectionReason;
        }

        var result = await QuotationService.UpdateStatusAsync(quotation.Id, newStatus, reason);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Status updated"], Severity.Success);
            await _grid!.ReloadServerData();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task DeleteAsync(QuotationDto quotation)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Message, string.Format(L["Are you sure you want to delete quotation {0}?"], quotation.QuotationNumber) },
            { x => x.YesText, L["Delete"].Value },
            { x => x.NoText, L["Cancel"].Value }
        };
        var dialog = await DialogService.ShowAsync<MudMessageBox>(L["Confirm Delete"], parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
        {
            var result = await QuotationService.DeleteAsync(quotation.Id);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Quotation deleted"], Severity.Success);
                await _grid!.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
    }

    private static Color GetStatusColor(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => Color.Default,
        QuotationStatus.Pending => Color.Info,
        QuotationStatus.Accepted => Color.Success,
        QuotationStatus.Rejected => Color.Error,
        QuotationStatus.Expired => Color.Warning,
        QuotationStatus.ConvertedToSale => Color.Tertiary,
        QuotationStatus.ConvertedToRemission => Color.Dark,
        _ => Color.Default
    };
    #endregion
}
