@using App.Core.DTOs.Customer
@using App.Core.DTOs.Settings
@using App.Core.DTOs.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Settings
@using App.Core.Interfaces.Shop
@using MudBlazor
@inject IRemissionService RemissionService
@inject ICustomerService CustomerService
@inject IPaymentMethodService PaymentMethodService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConsolidateRemissionsDialog> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            @* Step 1: Select customer *@
            <MudAutocomplete T="CustomerDto"
                             Label="@L["Customer"]"
                             Value="_selectedCustomer"
                             ValueChanged="OnCustomerSelected"
                             SearchFunc="SearchCustomers"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Variant="Variant.Outlined"
                             Dense="true"
                             ShowProgressIndicator="true" />

            @* Step 2: Pending remissions list *@
            @if (_pendingRemissions.Count > 0)
            {
                <MudText Typo="Typo.subtitle1">@L["Pending Remissions"]</MudText>
                <MudTable T="RemissionDto" Items="_pendingRemissions" Dense="true" Hover="true"
                          MultiSelection="true" @bind-SelectedItems="_selectedRemissions">
                    <HeaderContent>
                        <MudTh>@L["#"]</MudTh>
                        <MudTh>@L["Date"]</MudTh>
                        <MudTh>@L["Location"]</MudTh>
                        <MudTh Style="text-align:right">@L["Total"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["#"]">@context.RemissionNumber</MudTd>
                        <MudTd DataLabel="@L["Date"]">@context.RemissionDate.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="@L["Location"]">@context.LocationName</MudTd>
                        <MudTd DataLabel="@L["Total"]" Style="text-align:right">@context.Total.ToString("C2")</MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_selectedRemissions.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @string.Format(L["{0} remissions selected — Total: {1}"],
                            _selectedRemissions.Count,
                            _selectedRemissions.Sum(r => r.Total).ToString("C2"))
                    </MudAlert>

                    @* Step 3: Payment method *@
                    <MudSelect T="int"
                               @bind-Value="_selectedPaymentMethodId"
                               Label="@L["Payment Method"]"
                               Variant="Variant.Outlined">
                        @foreach (var pm in _paymentMethods)
                        {
                            <MudSelectItem T="int" Value="@pm.Id">@pm.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            else if (_selectedCustomer is not null && !_loadingRemissions)
            {
                <MudAlert Severity="Severity.Warning">@L["No pending remissions for this customer"]</MudAlert>
            }

            @if (_loadingRemissions)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Close"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Consolidate"
                   Disabled="@(!CanConsolidate)">
            @L["Consolidate"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    #region Fields
    private CustomerDto? _selectedCustomer;
    private List<RemissionDto> _pendingRemissions = [];
    private HashSet<RemissionDto> _selectedRemissions = [];
    private List<PaymentMethodDto> _paymentMethods = [];
    private int _selectedPaymentMethodId;
    private bool _loadingRemissions;
    private bool _processing;
    #endregion

    private bool CanConsolidate =>
        _selectedCustomer is not null &&
        _selectedRemissions.Count > 0 &&
        _selectedPaymentMethodId > 0 &&
        !_processing;

    protected override async Task OnInitializedAsync()
    {
        _paymentMethods = (await PaymentMethodService.GetActiveAsync()).ToList();
        if (_paymentMethods.Count > 0)
            _selectedPaymentMethodId = _paymentMethods[0].Id;
    }

    private async Task<IEnumerable<CustomerDto>> SearchCustomers(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return [];

        var (_, items) = await CustomerService.GetCustomersAsync(
            page: 1, pageSize: 10, searchString: value);
        return items;
    }

    private async Task OnCustomerSelected(CustomerDto? customer)
    {
        _selectedCustomer = customer;
        _pendingRemissions = [];
        _selectedRemissions = [];

        if (customer is null) return;

        _loadingRemissions = true;
        var result = await RemissionService.GetPendingByCustomerAsync(customer.Id);
        if (result.IsSuccess)
            _pendingRemissions = result.Value ?? [];
        else
            Snackbar.Add(result.Error, Severity.Error);
        _loadingRemissions = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Consolidate()
    {
        if (!CanConsolidate) return;

        _processing = true;
        var total = _selectedRemissions.Sum(r => r.Total);
        var locationId = _selectedRemissions.First().LocationId;

        var dto = new ConsolidateRemissionsDto
        {
            CustomerId = _selectedCustomer!.Id,
            RemissionIds = _selectedRemissions.Select(r => r.Id).ToList(),
            LocationId = locationId,
            Payments =
            [
                new CreateSalePaymentDto
                {
                    PaymentMethodId = _selectedPaymentMethodId,
                    Amount = total
                }
            ]
        };

        var result = await RemissionService.ConsolidateAsync(dto);
        if (result.IsSuccess)
        {
            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
        _processing = false;
    }
}
