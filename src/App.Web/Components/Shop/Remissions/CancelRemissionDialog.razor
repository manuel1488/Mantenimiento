@using App.Core.Interfaces.Shop
@using MudBlazor
@inject IRemissionService RemissionService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CancelRemissionDialog> L

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @string.Format(L["Are you sure you want to cancel remission {0}? Inventory will be reverted."], RemissionNumber)
        </MudText>
        <MudTextField @bind-Value="_reason"
                      Label="@L["Cancellation Reason"]"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Required="true"
                      RequiredError="@L["Reason is required"]" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Close"]</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   OnClick="ConfirmCancel"
                   Disabled="@(string.IsNullOrWhiteSpace(_reason) || _processing)">
            @L["Cancel Remission"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string RemissionNumber { get; set; } = null!;
    [Parameter] public long RemissionId { get; set; }

    private string? _reason;
    private bool _processing;

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmCancel()
    {
        if (string.IsNullOrWhiteSpace(_reason)) return;

        _processing = true;
        var result = await RemissionService.CancelAsync(RemissionId, _reason);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Remission cancelled successfully"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
        _processing = false;
    }
}
