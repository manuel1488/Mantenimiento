@page "/shop/remissions/consolidate"
@using App.Core.Constants
@using App.Core.DTOs.Customer
@using App.Core.DTOs.Settings
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Settings
@using App.Core.Interfaces.Shop
@using App.Shared.Services
@using App.Web.Components.Shop.Sales
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IRemissionService RemissionService
@inject ICustomerService CustomerService
@inject IPaymentMethodService PaymentMethodService
@inject ICashRegisterService CashRegisterService
@inject ICurrentUserService CurrentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<ConsolidateRemissionsPage> L

@attribute [Authorize(Policy = ApplicationClaims.Shop.ConsolidateRemissions)]

<PageTitle>@L["Consolidate Remissions"]</PageTitle>

<MudGrid Spacing="2">

    @* ── LEFT: Customer + remissions selection ── *@
    <MudItem xs="12" md="7">
        <MudPaper Elevation="2" Class="pa-4">

            @* Header *@
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                <MudIcon Icon="@Icons.Material.Filled.MergeType" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Style="flex:1;">@L["Consolidate Remissions"]</MudText>
            </div>

            @* Customer selector *@
            <MudAutocomplete T="CustomerDto"
                             Label="@L["Customer"]"
                             Value="_selectedCustomer"
                             ValueChanged="OnCustomerSelected"
                             SearchFunc="SearchCustomers"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Variant="Variant.Outlined"
                             Dense="true"
                             ShowProgressIndicator="true"
                             Class="mb-4" />

            @* Loading indicator *@
            @if (_loadingRemissions)
            {
                <div style="display:flex; justify-content:center; padding:20px;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                </div>
            }
            else if (_selectedCustomer is not null && _pendingRemissions.Count == 0)
            {
                <MudAlert Severity="Severity.Warning">@L["No pending remissions for this customer"]</MudAlert>
            }
            else if (_pendingRemissions.Count > 0)
            {
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                    <MudText Typo="Typo.subtitle2">@L["Pending Remissions"]</MudText>
                    @if (_selectedRemissions.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @string.Format(L["{0} selected — {1}"], _selectedRemissions.Count, SelectedTotal.ToString("C2"))
                        </MudChip>
                    }
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var remission in _pendingRemissions)
                    {
                        var isSelected = _selectedRemissions.Contains(remission);
                        <MudExpansionPanel @key="remission.Id"
                                           Style="@($"border:1px solid {(isSelected ? "#1976D2" : "#E0E0E0")}; border-radius:6px; margin-bottom:6px; background:{(isSelected ? "#F3F8FF" : "white")}")">
                            <TitleContent>
                                <div style="display:flex; align-items:center; gap:8px; width:100%;">
                                    <MudCheckBox T="bool"
                                                 Value="@isSelected"
                                                 ValueChanged="@(v => ToggleRemission(remission, v))"
                                                 Color="Color.Primary"
                                                 Size="Size.Small"
                                                 @onclick:stopPropagation="true" />
                                    <MudText Typo="Typo.body2" Style="font-weight:600; flex:1;">@remission.RemissionNumber</MudText>
                                    <MudText Typo="Typo.caption" Style="color:#888;">@remission.RemissionDate.ToString("dd/MM/yyyy")</MudText>
                                    <MudText Typo="Typo.caption" Style="color:#888; margin-left:8px;">@remission.LocationName</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight:700; margin-left:8px; white-space:nowrap;">@remission.Total.ToString("C2")</MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudTable T="RemissionDetailDto"
                                          Items="@remission.Details"
                                          Dense="true"
                                          Elevation="0"
                                          Hover="false"
                                          Style="background:transparent;">
                                    <HeaderContent>
                                        <MudTh>@L["Product"]</MudTh>
                                        <MudTh Style="text-align:right">@L["Qty"]</MudTh>
                                        <MudTh Style="text-align:right">@L["Unit Price"]</MudTh>
                                        <MudTh Style="text-align:right">@L["Total"]</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="@L["Product"]">
                                            <div>
                                                <span style="font-size:13px;">@context.ProductName</span>
                                                <span style="font-size:11px; color:#888; margin-left:4px;">(@context.ProductCode)</span>
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="@L["Qty"]" Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                                        <MudTd DataLabel="@L["Unit Price"]" Style="text-align:right">@context.UnitPrice.ToString("C2")</MudTd>
                                        <MudTd DataLabel="@L["Total"]" Style="text-align:right">@context.Total.ToString("C2")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }

        </MudPaper>
    </MudItem>

    @* ── RIGHT: Payment section ── *@
    <MudItem xs="12" md="5">
        <MudPaper Elevation="2" Class="pa-4" Style="display:flex; flex-direction:column; gap:14px; min-height:400px;">

            @* Cash register status *@
            @if (_activeCashRegister is null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @L["No open cash register. Open a cash register before consolidating."]
                </MudAlert>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:6px; padding:6px 10px; background:#E8F5E9; border-radius:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#388E3C;" />
                    <MudText Typo="Typo.body2" Style="color:#388E3C;">@_activeCashRegister.LocationName</MudText>
                </div>
            }

            @* Payment methods header + status chip *@
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <MudText Typo="Typo.subtitle2">@L["Payment Methods"]</MudText>
                <MudChip T="string" Size="Size.Small"
                         Color="@(Remaining <= 0 && _selectedRemissions.Count > 0 ? Color.Success : Color.Warning)">
                    @(Remaining <= 0 && _selectedRemissions.Count > 0 ? L["Complete"] : $"{L["Remaining"]}: {Math.Max(0, Remaining):C2}")
                </MudChip>
            </div>

            @* Method buttons *@
            @if (!_paymentMethods.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">@L["No payment methods configured"]</MudAlert>
            }
            else
            {
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); gap:6px;">
                    @foreach (var pm in _paymentMethods)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenPaymentGroupDialog(pm))"
                                   Style="height:44px; text-transform:none; font-size:11px; flex-direction:row; gap:4px; padding:4px 8px; justify-content:flex-start;"
                                   Disabled="@IsPaymentButtonDisabled(pm)">
                            <MudIcon Icon="@pm.Icon" Size="Size.Small" />
                            <span style="flex:1; line-height:1.1; text-align:left;">@pm.Name</span>
                        </MudButton>
                    }
                </div>
            }

            @* Payment entries — grouped by method, click to edit *@
            @foreach (var group in _paymentEntries.GroupBy(e => e.PaymentMethod.Id))
            {
                var grpPm = group.First().PaymentMethod;
                var groupTotal = group.Sum(e => e.Amount);
                var subCount = group.Count();
                var cashEntry = group.FirstOrDefault(e => e.PaymentMethod.Type == PaymentMethodType.Cash);
                <div @key="grpPm.Id"
                     style="display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:6px; background:#FAFAFA; border-left:3px solid @GetPaymentColor(grpPm.Type); cursor:pointer;"
                     @onclick="@(async () => await OpenPaymentGroupDialog(grpPm))">
                    <MudIcon Icon="@grpPm.Icon" Size="Size.Small" Style="@($"color:{GetPaymentColor(grpPm.Type)}")" />
                    <div style="flex:1; min-width:0; overflow:hidden;">
                        <span style="font-size:13px; font-weight:600;">@grpPm.Name</span>
                        @if (subCount > 1)
                        {
                            <span style="font-size:11px; color:#999; margin-left:4px;">(@subCount)</span>
                        }
                        @if (cashEntry is not null && cashEntry.CashReceived > cashEntry.Amount)
                        {
                            <span style="font-size:11px; color:#4CAF50; margin-left:6px;">(@L["Cash change"]: @GetCashChange(cashEntry).ToString("C2"))</span>
                        }
                    </div>
                    <span style="font-size:14px; font-weight:700; color:#333; white-space:nowrap;">@groupTotal.ToString("C2")</span>
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemovePaymentGroup(grpPm.Id))"
                                       title="@L["Remove"]" />
                    </span>
                </div>
            }

            @* Progress bar *@
            @if (_paymentEntries.Any() && _selectedRemissions.Count > 0)
            {
                <MudProgressLinear Value="@PaidPercentage"
                                   Color="@(PaidPercentage >= 100 ? Color.Success : Color.Warning)"
                                   Style="height:4px; border-radius:2px;" />
                <div style="display:flex; justify-content:space-between; margin-top:-8px;">
                    <span style="font-size:11px; color:@(PaidPercentage >= 100 ? "#4CAF50" : "#FF9800");">
                        @L["Paid"]: @PaidTotal.ToString("C2")
                    </span>
                    <span style="font-size:11px; color:@(PaidPercentage >= 100 ? "#4CAF50" : "#FF9800");">
                        @L["Remaining"]: @Math.Max(0, Remaining).ToString("C2")
                    </span>
                </div>
            }

            @* Action buttons *@
            <div style="margin-top:auto; padding-top:10px; border-top:1px solid rgba(0,0,0,0.08); display:flex; gap:8px;">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                           Variant="Variant.Text"
                           OnClick="GoBack">
                    @L["Back"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Payment"
                           OnClick="ConfirmAsync"
                           Disabled="@(!CanConfirm)"
                           Class="da-button-rounded">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @L["Processing..."]
                    }
                    else
                    {
                        @L["Confirm Consolidation"]
                    }
                </MudButton>
            </div>

        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    #region Fields
    private CustomerDto? _selectedCustomer;
    private List<RemissionDto> _pendingRemissions = [];
    private HashSet<RemissionDto> _selectedRemissions = [];
    private CashRegisterDto? _activeCashRegister;
    private List<PaymentMethodDto> _paymentMethods = [];
    private List<PaymentEntry> _paymentEntries = [];
    private bool _loadingRemissions;
    private bool _processing;
    #endregion

    #region Computed
    private decimal SelectedTotal => _selectedRemissions.Sum(r => r.Total);
    private decimal PaidTotal => _paymentEntries.Sum(e => e.Amount);
    private decimal Remaining => SelectedTotal - PaidTotal;
    private double PaidPercentage => SelectedTotal > 0 ? Math.Min(100, (double)(PaidTotal / SelectedTotal * 100)) : 0;

    private bool CanConfirm =>
        _selectedCustomer is not null &&
        _activeCashRegister is not null &&
        _selectedRemissions.Count > 0 &&
        _paymentEntries.Count > 0 &&
        Remaining <= 0.01m &&
        !_processing;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUserService.GetUserIdAsync();

        var cashResult = await CashRegisterService.GetActiveCashRegisterByUserAsync(userId);
        if (cashResult.IsSuccess)
            _activeCashRegister = cashResult.Value;

        _paymentMethods = (await PaymentMethodService.GetActiveAsync()).ToList();
    }
    #endregion

    #region Customer / Remissions
    private async Task<IEnumerable<CustomerDto>> SearchCustomers(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return [];

        var (_, items) = await CustomerService.GetCustomersAsync(
            page: 1, pageSize: 10, searchString: value);
        return items;
    }

    private void ToggleRemission(RemissionDto remission, bool selected)
    {
        if (selected)
            _selectedRemissions.Add(remission);
        else
            _selectedRemissions.Remove(remission);

        // Reset payments when selection changes to avoid amount mismatch
        _paymentEntries = [];
        StateHasChanged();
    }

    private async Task OnCustomerSelected(CustomerDto? customer)
    {
        _selectedCustomer = customer;
        _pendingRemissions = [];
        _selectedRemissions = [];
        _paymentEntries = [];

        if (customer is null) return;

        _loadingRemissions = true;
        var result = await RemissionService.GetPendingByCustomerAsync(customer.Id);
        if (result.IsSuccess)
            _pendingRemissions = result.Value ?? [];
        else
            Snackbar.Add(result.Error, Severity.Error);
        _loadingRemissions = false;
    }
    #endregion

    #region Payment Methods
    private bool IsPaymentButtonDisabled(PaymentMethodDto pm)
    {
        if (_selectedCustomer is null || _activeCashRegister is null || _selectedRemissions.Count == 0) return true;
        if (_paymentEntries.Any(e => e.PaymentMethod.Id == pm.Id)) return false;
        return PaidTotal >= SelectedTotal;
    }

    private async Task OpenPaymentGroupDialog(PaymentMethodDto pm)
    {
        if (_selectedRemissions.Count == 0) return;

        var otherTotal = _paymentEntries.Where(e => e.PaymentMethod.Id != pm.Id).Sum(e => e.Amount);
        var remaining = SelectedTotal - otherTotal;

        var existing = _paymentEntries
            .Where(e => e.PaymentMethod.Id == pm.Id)
            .Select(e => new PaymentGroupDialog.SubEntry
            {
                Amount = e.Amount,
                CashReceived = e.CashReceived,
                CardLastFour = e.CardLastFour,
                AuthorizationCode = e.AuthorizationCode,
                CardBrand = e.CardBrand,
                Reference = e.Reference
            }).ToList();

        if (remaining <= 0 && !existing.Any()) return;

        remaining = Math.Max(0.01m, remaining);

        var parameters = new DialogParameters<PaymentGroupDialog>
        {
            { x => x.PaymentMethod, pm },
            { x => x.TotalSaleRemaining, remaining },
            { x => x.ExistingEntries, existing }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<PaymentGroupDialog>(pm.Name, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<PaymentGroupDialog.SubEntry> subEntries })
        {
            _paymentEntries.RemoveAll(e => e.PaymentMethod.Id == pm.Id);
            foreach (var sub in subEntries)
            {
                _paymentEntries.Add(new PaymentEntry
                {
                    PaymentMethod = pm,
                    Amount = sub.Amount,
                    CashReceived = sub.CashReceived,
                    CardLastFour = sub.CardLastFour,
                    AuthorizationCode = sub.AuthorizationCode,
                    CardBrand = sub.CardBrand,
                    Reference = sub.Reference
                });
            }
            StateHasChanged();
        }
    }

    private void RemovePaymentGroup(int methodId)
    {
        _paymentEntries.RemoveAll(e => e.PaymentMethod.Id == methodId);
        StateHasChanged();
    }

    private static decimal GetCashChange(PaymentEntry entry) => entry.CashReceived - entry.Amount;

    private static string GetPaymentColor(PaymentMethodType type) => type switch
    {
        PaymentMethodType.Cash => "#4CAF50",
        PaymentMethodType.Card => "#2196F3",
        PaymentMethodType.Transfer => "#9C27B0",
        PaymentMethodType.Check => "#607D8B",
        _ => "#9E9E9E"
    };
    #endregion

    #region Actions
    private async Task ConfirmAsync()
    {
        if (!CanConfirm) return;

        _processing = true;
        var locationId = _selectedRemissions.First().LocationId;

        var dto = new ConsolidateRemissionsDto
        {
            CustomerId = _selectedCustomer!.Id,
            RemissionIds = _selectedRemissions.Select(r => r.Id).ToList(),
            LocationId = locationId,
            Payments = _paymentEntries.Select(p => new CreateSalePaymentDto
            {
                PaymentMethodId = p.PaymentMethod.Id,
                Amount = p.Amount,
                CashTendered = p.CashReceived > 0 ? p.CashReceived : null,
                CashChange = p.CashReceived > p.Amount ? p.CashReceived - p.Amount : null,
                CardLastFour = p.CardLastFour,
                AuthorizationCode = p.AuthorizationCode,
                CardBrand = p.CardBrand,
                Reference = p.Reference
            }).ToList()
        };

        var result = await RemissionService.ConsolidateAsync(dto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Remissions consolidated successfully"], Severity.Success);
            Navigation.NavigateTo("/shop/remissions");
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
            _processing = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/shop/remissions");
    #endregion

    #region Nested Types
    private class PaymentEntry
    {
        public PaymentMethodDto PaymentMethod { get; set; } = null!;
        public decimal Amount { get; set; }
        public decimal CashReceived { get; set; }
        public string? CardLastFour { get; set; }
        public string? AuthorizationCode { get; set; }
        public CardBrand? CardBrand { get; set; }
        public string? Reference { get; set; }
    }
    #endregion
}
