@page "/shop/remissions/new"
@using App.Core.Constants
@using App.Core.Utils
@using App.Core.DTOs.Shop
@using App.Core.DTOs.Customer
@using App.Core.DTOs.Product
@using App.Core.DTOs.Location
@using App.Core.DTOs.Shop.Calculation
@using App.Core.Interfaces.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Settings
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IRemissionService RemissionService
@inject IProductService ProductService
@inject ICustomerService CustomerService
@inject ILocationService LocationService
@inject IProductWholesalePriceService WholesalePriceService
@inject IWholesaleSettingsService WholesaleSettingsService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<CreateRemissionPage> L
@inject IJSRuntime JS
@inject IPricingCalculationService PricingService
@inject IQuotationService QuotationService

@attribute [Authorize(Policy = ApplicationClaims.Shop.CreateRemission)]
@implements IAsyncDisposable

<PageTitle>@L["New Remission"]</PageTitle>

<div style="display:flex;flex-direction:column;gap:12px;">

    @* Title row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/shop/remissions"))"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h4">@L["New Remission"]</MudText>
    </MudStack>

    @if (_sourceQuotation is not null)
    {
        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Info" Dense="true">
            @string.Format(L["Creating remission from quotation {0}"], _sourceQuotation.QuotationNumber)
        </MudAlert>
    }

    <MudPaper Elevation="2" Class="pa-4" Style="display:flex;flex-direction:column;gap:12px;">

        @* Top fields *@
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="CustomerDto"
                                     Label="@L["Customer"]"
                                     @bind-Value="_selectedCustomer"
                                     SearchFunc="@SearchCustomersAsync"
                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     RequiredError="@L["Customer is required"]" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int?"
                               Label="@L["Location"]"
                               Value="_selectedLocationId"
                               ValueChanged="OnLocationChanged"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="@L["Location is required"]">
                        @foreach (var loc in _locations)
                        {
                            <MudSelectItem T="int?" Value="@((int?)loc.Id)">@loc.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Label="@L["Remission Date"]"
                                   @bind-Date="_remissionDate"
                                   Variant="Variant.Outlined"
                                   DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes"
                                  Label="@L["Notes"]"
                                  Variant="Variant.Outlined"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>

        @* Products section *@
        <div style="display:flex;flex-direction:column;">

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1">@L["Products"]</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@AddLine">
                    @L["Add product"]
                </MudButton>
            </MudStack>

            @if (_lines.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L["Add at least one product"]</MudAlert>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>@L["Product"]</th>
                                <th style="width:100px">@L["Qty"]</th>
                                <th style="width:120px;text-align:right">@L["Unit Price"]</th>
                                <th style="width:120px;text-align:right">@L["Amount"]</th>
                                @if (_applyWholesale)
                                {
                                    <th style="width:100px;text-align:right">@L["Discount"]</th>
                                }
                                <th style="width:120px;text-align:right">@L["Total"]</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _lines)
                            {
                                <tr>
                                    <td>
                                        <div id="@($"line-{line.LineId}")" data-line-id="@line.LineId"
                                             class="line-product-autocomplete"
                                             style="display:flex;align-items:center;gap:4px;">
                                            <MudAutocomplete T="ProductDto"
                                                             Value="line.SelectedProduct"
                                                             ValueChanged="@((p) => OnProductSelected(line, p))"
                                                             SearchFunc="@SearchProductsAsync"
                                                             ToStringFunc="@(p => p is null ? string.Empty : $"{p.Code} - {p.Name}")"
                                                             Variant="Variant.Text"
                                                             Dense="true"
                                                             Style="flex:1" />
                                            @if (line.SelectedProduct?.RequiresInventory == false)
                                            {
                                                <MudTooltip Text="@L["This product does not affect inventory"]">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Inventory"
                                                             Size="Size.Small"
                                                             Color="Color.Warning" />
                                                </MudTooltip>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <MudNumericField T="decimal"
                                                         Value="line.Quantity"
                                                         ValueChanged="@(async (v) => await OnLineChanged(line, quantity: v))"
                                                         Min="0.001m"
                                                         Variant="Variant.Text"
                                                         Dense="true" />
                                    </td>
                                    <td style="text-align:right">@line.UnitPrice.ToString("C2")</td>
                                    <td style="text-align:right">@((line.Quantity * line.UnitPrice).ToString("C2"))</td>
                                    @if (_applyWholesale)
                                    {
                                        <td style="text-align:right">@(line.LineDiscount > 0 ? $"-{line.LineDiscount:C2}" : "—")</td>
                                    }
                                    <td style="text-align:right">@line.LineTotal.ToString("C2")</td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(async () => await RemoveLine(line))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>

                @* Totals *@
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                    <MudStack Spacing="1" Style="min-width:240px">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                            <MudText Typo="Typo.body2">@_subtotal.ToString("C2")</MudText>
                        </MudStack>
                        @if (_discountTotal > 0)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Discount"]:</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Error">-@_discountTotal.ToString("C2")</MudText>
                            </MudStack>
                        }
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                            <MudText Typo="Typo.body2">@_taxTotal.ToString("C2")</MudText>
                        </MudStack>
                        <MudDivider />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1">@L["Total"]:</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@_grandTotal.ToString("C2")</MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            }
        </div>

        @* Action buttons *@
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       OnClick="@(() => Navigation.NavigateTo("/shop/remissions"))">
                @L["Cancel"]
            </MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Save"
                       Disabled="@(_processing || !_isValid || _lines.Count == 0 || !_selectedLocationId.HasValue)">
                @if (_processing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Save"]
            </MudButton>
        </MudStack>

    </MudPaper>
</div>

@code {
    #region Parameters
    [SupplyParameterFromQuery(Name = "quotationId")]
    public long? QuotationId { get; set; }
    #endregion

    #region Lifecycle
    private bool _jsReady;
    private QuotationDto? _sourceQuotation;

    protected override async Task OnInitializedAsync()
    {
        _locations = (await LocationService.GetActiveLocationsAsync()).ToList();

        var taxResult = await PricingService.GetEffectiveTaxRateAsync();
        if (taxResult.IsSuccess)
            _taxRate = taxResult.Value;

        var wsResult = await WholesaleSettingsService.GetSettingsAsync();
        _applyWholesale = wsResult.IsSuccess && wsResult.Value.ApplyWholesaleToRemissions;

        if (QuotationId.HasValue)
            await PreFillFromQuotationAsync(QuotationId.Value);
    }

    private async Task PreFillFromQuotationAsync(long quotationId)
    {
        _sourceQuotation = await QuotationService.GetByIdAsync(quotationId);
        if (_sourceQuotation is null) return;

        // Pre-fill customer
        var customer = await CustomerService.GetCustomerByIdAsync(_sourceQuotation.CustomerId);
        if (customer is not null)
            _selectedCustomer = customer;

        // Pre-fill lines
        foreach (var detail in _sourceQuotation.Details)
        {
            var product = await ProductService.GetProductByIdAsync(detail.ProductId);
            if (product is null) continue;

            _lineCounter++;
            var line = new RemissionLine
            {
                LineId = _lineCounter,
                ProductId = detail.ProductId,
                ProductName = detail.ProductName,
                ProductCode = detail.ProductCode,
                SelectedProduct = product,
                Quantity = detail.Quantity,
                UnitPrice = detail.UnitPrice,
                OriginalPrice = detail.UnitPrice,
                DiscountPercentage = detail.DiscountPercentage,
                FixedDiscountAmount = detail.DiscountAmount > 0 ? detail.DiscountAmount : null
            };

            // When converting from a quotation, always preserve the agreed prices — never recalculate.
            // Wholesale tiers are loaded so that subsequent manual quantity changes can apply them.
            if (_applyWholesale)
            {
                var wpResult = await WholesalePriceService.GetWholesalePricesForProductAsync(detail.ProductId);
                line.WholesalePrices = wpResult.IsSuccess ? wpResult.Value.ToList() : [];
            }

            _lines.Add(line);
        }

        await RecalculateTotalsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            await JS.InvokeVoidAsync("eval",
                "var el=document.querySelector('.mud-main-content');if(el)el.style.overflow='hidden';");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_jsReady) return;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var el=document.querySelector('.mud-main-content');if(el)el.style.overflow='';");
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    #endregion

    #region Fields
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;

    private CustomerDto? _selectedCustomer;
    private int? _selectedLocationId;
    private DateTime? _remissionDate = DateTime.Today;
    private string? _notes;

    private List<LocationDto> _locations = [];
    private List<RemissionLine> _lines = [];
    private int _lineCounter = 0;

    private decimal _subtotal;
    private decimal _discountTotal;
    private decimal _taxTotal;
    private decimal _grandTotal;

    private decimal _taxRate = 0;
    private bool _applyWholesale;
    private decimal? _pendingBulkQty;
    #endregion

    private void OnLocationChanged(int? value) => _selectedLocationId = value;

    #region Search
    private async Task<IEnumerable<CustomerDto>> SearchCustomersAsync(string? value, CancellationToken ct)
    {
        var (_, items) = await CustomerService.GetCustomersAsync(
            page: 1,
            pageSize: 30,
            searchString: string.IsNullOrWhiteSpace(value) ? null : value);
        return items;
    }

    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _pendingBulkQty = null;
            return [];
        }

        if (BarcodeParser.TryParseBulkBarcode(value, out var bulkProductId, out var bulkQty, out _))
        {
            _pendingBulkQty = bulkQty;
            var product = await ProductService.GetProductByIdAsync(bulkProductId);
            return product is null ? [] : [product];
        }

        _pendingBulkQty = null;
        var (_, items) = await ProductService.GetProductsAsync(
            page: 1, pageSize: 30, searchString: value, isActive: true);
        return items;
    }
    #endregion

    #region Lines management
    private async Task AddLine()
    {
        var newLine = new RemissionLine { Quantity = 1, LineId = _lineCounter++ };
        _lines.Add(newLine);
        await RecalculateTotalsAsync();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        await JS.InvokeVoidAsync("eval",
            $"var w=document.getElementById('line-{newLine.LineId}');if(w){{var i=w.querySelector('input');if(i)i.focus();}}");
    }

    private async Task RemoveLine(RemissionLine line)
    {
        _lines.Remove(line);
        await RecalculateTotalsAsync();
    }

    private async Task OnProductSelected(RemissionLine line, ProductDto? product)
    {
        if (product is null) return;
        line.SelectedProduct = product;
        line.ProductId = product.Id;
        line.ProductName = product.Name;
        line.ProductCode = product.Code ?? string.Empty;
        line.UnitPrice = product.Price;
        line.OriginalPrice = product.Price;

        if (_pendingBulkQty.HasValue)
        {
            line.Quantity = _pendingBulkQty.Value;
            _pendingBulkQty = null;
        }

        if (_applyWholesale)
        {
            var wpResult = await WholesalePriceService.GetWholesalePricesForProductAsync(product.Id);
            line.WholesalePrices = wpResult.IsSuccess ? wpResult.Value.ToList() : [];
            ApplyWholesaleDiscount(line);
        }

        await RecalculateTotalsAsync();
    }

    private async Task OnLineChanged(RemissionLine line, decimal? quantity = null)
    {
        if (quantity.HasValue)
        {
            line.Quantity = quantity.Value;
            line.FixedDiscountAmount = null; // quantity changed — fall back to percentage-based discount
        }
        if (_applyWholesale) ApplyWholesaleDiscount(line);
        await RecalculateTotalsAsync();
    }

    private void ApplyWholesaleDiscount(RemissionLine line)
    {
        var result = PricingService.ResolveWholesaleDiscount(line.WholesalePrices, line.Quantity, line.OriginalPrice);
        line.DiscountPercentage = result.DiscountPercentage;
        line.FixedDiscountAmount = result.GetFixedLineDiscount(line.Quantity);
    }

    private async Task RecalculateTotalsAsync()
    {
        var documentLines = new List<DocumentLineInput>();

        foreach (var line in _lines)
        {
            var lineCalc = PricingService.CalculateLine(new LineCalculationInput
            {
                Quantity = line.Quantity,
                UnitPrice = line.UnitPrice,
                DiscountPercentage = line.DiscountPercentage,
                DiscountAmount = line.FixedDiscountAmount,
                TaxRate = _taxRate
            });

            line.LineDiscount = Math.Round(lineCalc.DiscountAmount, 2);
            line.LineTax = lineCalc.TaxAmount;
            line.LineTotal = Math.Round(lineCalc.Subtotal + line.LineTax, 2);

            documentLines.Add(new DocumentLineInput
            {
                Subtotal = lineCalc.Subtotal,
                DiscountAmount = lineCalc.DiscountAmount,
                IsTaxable = true,
                TaxBase = lineCalc.TaxBase,
                TaxAmount = lineCalc.TaxAmount
            });
        }

        var docCalc = await PricingService.CalculateDocumentAsync(new DocumentCalculationInput
        {
            Lines = documentLines,
            GlobalDiscountPercentage = 0,
            TaxRate = _taxRate,
            ApplyRounding = false
        });

        _subtotal = docCalc.Subtotal - docCalc.TotalDiscountAmount;
        _discountTotal = docCalc.TotalDiscountAmount;
        _taxTotal = docCalc.TaxAmount;
        _grandTotal = docCalc.Total;

        StateHasChanged();
    }
    #endregion

    #region Save
    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid || _lines.Count == 0 || _selectedCustomer is null || !_selectedLocationId.HasValue) return;

        _processing = true;
        try
        {
            var createDto = new CreateRemissionDto
            {
                CustomerId = _selectedCustomer.Id,
                LocationId = _selectedLocationId.Value,
                RemissionDate = _remissionDate,
                Notes = _notes,
                QuotationId = QuotationId,
                Details = _lines.Select(l => new CreateRemissionDetailDto
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    DiscountPercentage = l.DiscountPercentage,
                    DiscountAmount = l.FixedDiscountAmount
                }).ToList()
            };

            var result = await RemissionService.CreateAsync(createDto);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Remission saved successfully"], Severity.Success);
                Navigation.NavigateTo("/shop/remissions");
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        finally
        {
            _processing = false;
        }
    }
    #endregion

    #region Helper class
    private class RemissionLine
    {
        public int LineId { get; set; }
        public long ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string ProductCode { get; set; } = string.Empty;
        public ProductDto? SelectedProduct { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal OriginalPrice { get; set; }
        public decimal DiscountPercentage { get; set; }
        /// <summary>Exact discount amount carried from the source quotation. Cleared when user changes quantity.</summary>
        public decimal? FixedDiscountAmount { get; set; }
        public decimal LineTotal { get; set; }
        public decimal LineTax { get; set; }
        public decimal LineDiscount { get; set; }
        public List<ProductWholesalePriceDto> WholesalePrices { get; set; } = [];
    }
    #endregion
}
