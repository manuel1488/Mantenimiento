@page "/shop/remissions"
@using App.Core.Constants
@using App.Core.DTOs.Shop
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Shop
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject IRemissionService RemissionService
@inject ISnackbar Snackbar
@inject IStringLocalizer<RemissionsPage> L
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Shop.ViewRemissions)]

<PageTitle>@L["Remissions"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Remissions"]</MudText>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
                <MudTextField @bind-Value="_search"
                              Placeholder="@L["Search by number or customer..."]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="@(_ => _grid?.ReloadServerData())"
                              Class="flex-grow-1" />
                <MudSelect T="string?"
                           Value="_statusFilter"
                           ValueChanged="@OnStatusFilterChanged"
                           Placeholder="@L["All statuses"]"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Style="min-width: 180px;">
                    <MudSelectItem T="string?" Value="@((string?)null)">@L["All"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Pending")">@L["Pending"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Consolidated")">@L["Consolidated"]</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("Cancelled")">@L["Cancelled"]</MudSelectItem>
                </MudSelect>
                <AuthorizeView Policy="@ApplicationClaims.Shop.CreateRemission">
                    <Authorized Context="createAuth">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => Navigation.NavigateTo("/shop/remissions/new"))">
                            @L["New Remission"]
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@ApplicationClaims.Shop.ConsolidateRemissions">
                    <Authorized Context="consolidateAuth">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.MergeType"
                                   OnClick="@OpenConsolidateDialog">
                            @L["Consolidate"]
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudStack>

            <MudDataGrid T="RemissionDto"
                         @ref="_grid"
                         ServerData="@LoadServerData"
                         SortMode="SortMode.None"
                         RowsPerPage="15"
                         Dense="true"
                         Hover="true">
                <Columns>
                    <PropertyColumn Property="x => x.RemissionNumber" Title="@L["#"]" />
                    <PropertyColumn Property="x => x.CustomerName" Title="@L["Customer"]" />
                    <TemplateColumn Title="@L["Date"]">
                        <CellTemplate>
                            @context.Item.RemissionDate.ToString("dd/MM/yyyy")
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.LocationName" Title="@L["Location"]" />
                    <TemplateColumn Title="@L["Total"]">
                        <CellTemplate>
                            @context.Item.Total.ToString("C2")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Status"]">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                                @L[context.Item.Status.ToString()]
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Actions"]">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               title="@L["Preview PDF"]"
                                               OnClick="@(() => PreviewPdfAsync(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               title="@L["Download PDF"]"
                                               OnClick="@(() => DownloadPdfAsync(context.Item))" />
                                <AuthorizeView Policy="@ApplicationClaims.Shop.CancelRemission">
                                    <Authorized Context="cancelAuth">
                                        @if (context.Item.Status == RemissionStatus.Pending)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           title="@L["Cancel"]"
                                                           OnClick="@(() => CancelAsync(context.Item))" />
                                        }
                                    </Authorized>
                                </AuthorizeView>
                                @if (context.Item.Status == RemissionStatus.Consolidated && context.Item.ConsolidatedSaleId.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                                   Size="Size.Small"
                                                   Color="Color.Info"
                                                   title="@L["View Sale"]"
                                                   OnClick="@(() => Navigation.NavigateTo($"/shop/sales-history"))" />
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="RemissionDto" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    #region Fields
    private MudDataGrid<RemissionDto>? _grid;
    private string? _search;
    private string? _statusFilter;
    #endregion

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    #region Data loading
    private async Task<GridData<RemissionDto>> LoadServerData(GridState<RemissionDto> state)
    {
        var (total, items) = await RemissionService.GetRemissionsAsync(
            page: state.Page + 1,
            pageSize: state.PageSize,
            search: _search,
            status: _statusFilter);

        return new GridData<RemissionDto> { Items = items, TotalItems = total };
    }
    #endregion

    #region Actions
    private async Task PreviewPdfAsync(RemissionDto remission)
    {
        await JS.InvokeVoidAsync("openInNewTab", $"/api/remissions/{remission.Id}/pdf");
    }

    private async Task DownloadPdfAsync(RemissionDto remission)
    {
        try
        {
            var bytes = await RemissionService.GeneratePdfAsync(remission.Id);
            await JS.InvokeVoidAsync("downloadFile",
                $"remision_{remission.RemissionNumber}.pdf",
                "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CancelAsync(RemissionDto remission)
    {
        var parameters = new DialogParameters<CancelRemissionDialog>
        {
            { x => x.RemissionNumber, remission.RemissionNumber },
            { x => x.RemissionId, remission.Id }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CancelRemissionDialog>(
            L["Cancel Remission"], parameters, options);
        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
        {
            await _grid!.ReloadServerData();
        }
    }

    private async Task OpenConsolidateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConsolidateRemissionsDialog>(
            L["Consolidate Remissions"], options);
        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
        {
            Snackbar.Add(L["Remissions consolidated successfully"], Severity.Success);
            await _grid!.ReloadServerData();
        }
    }

    private static Color GetStatusColor(RemissionStatus status) => status switch
    {
        RemissionStatus.Pending => Color.Warning,
        RemissionStatus.Consolidated => Color.Success,
        RemissionStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
    #endregion
}
