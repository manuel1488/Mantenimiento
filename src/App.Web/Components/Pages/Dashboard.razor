@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using App.Core.Constants
@using App.Core.DTOs.Dashboard
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using App.Shared.Services
@using System.Globalization

@inject IDashboardService DashboardService
@inject IDateTime DateTimeService
@inject ICompanySettingsService CompanySettingsService
@inject IMexicoStampAlertService StampAlertService
@inject IStringLocalizer<Dashboard> L
@inject ISnackbar Snackbar
@inject ILogger<Dashboard> Logger

@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewDashboard)]

<PageTitle>@L["Dashboard"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <MudItem xs="12" Class="d-flex justify-space-between align-center flex-wrap gap-4 mb-4">
            <MudText Typo="Typo.h4">@L["Dashboard"]</MudText>
            <div class="d-flex gap-2">
                <MudSelect T="string" 
                          @bind-Value="_selectedPeriod" 
                          Label="@L["Period"]"
                          Style="min-width: 150px;"
                          Variant="Variant.Outlined"
                          Dense="true"
                          AnchorOrigin="Origin.BottomCenter"
                          OnClosed="RefreshDashboard">
                    <MudSelectItem Value="@("today")">@L["Today"]</MudSelectItem>
                    <MudSelectItem Value="@("week")">@L["This Week"]</MudSelectItem>
                    <MudSelectItem Value="@("month")">@L["This Month"]</MudSelectItem>
                    <MudSelectItem Value="@("custom")">@L["Custom Range"]</MudSelectItem>
                </MudSelect>
                @if (_selectedPeriod == "custom")
                {
                    <MudDateRangePicker @bind-DateRange="_dateRange"
                                       Label="@L["Date Range"]"
                                       AdornmentColor="Color.Primary"
                                       PickerVariant="PickerVariant.Dialog"
                                       OnRangeChanged="RefreshDashboard"/>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                             Color="Color.Primary" 
                             Size="Size.Medium"
                             OnClick="RefreshDashboard" 
                             title="@L["Refresh"]" />
            </div>
        </MudItem>
    </MudGrid>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="d-flex mx-auto my-8" />
    }
    else
    {
        <!-- Resumen de ventas -->
        <MudGrid>
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg mud-theme-primary">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2">@L["Today's Sales"]</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@_summary.TodaySales.ToString("C")</MudText>
                    <MudText Typo="Typo.caption">@L["{0} orders", _summary.TodaySalesCount]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2">@L["Week Sales"]</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" />
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@_summary.WeekSales.ToString("C")</MudText>
                    <MudText Typo="Typo.caption">@L["{0} orders", _summary.WeekSalesCount]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2">@L["Month Sales"]</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@_summary.MonthSales.ToString("C")</MudText>
                    <MudText Typo="Typo.caption">@L["{0} orders", _summary.MonthSalesCount]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2">@L["Average Order"]</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" />
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@_summary.AverageOrderValue.ToString("C")</MudText>
                    <MudText Typo="Typo.caption">@L["per order"]</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-4">
            <!-- Gráfica de rendimiento de ventas -->
            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <div class="d-flex justify-space-between mb-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6">@L["Sales Performance"]</MudText>
                            @if (_chartYAxisLabel.Contains("K$") || _chartYAxisLabel.Contains("M$"))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    (@_chartYAxisLabel.Split('(').Last().TrimEnd(')'))
                                </MudText>
                            }
                        </div>
                        <div>
                            <span class="mr-4">@L["Total: {0}", _performance.TotalRevenue.ToString("C")]</span>
                            <MudChip T="string" Size="Size.Small" 
                                    Color="@(_performance.RevenueGrowth >= 0 ? Color.Success : Color.Error)">
                                @(_performance.RevenueGrowth >= 0 ? "+" : "")@_performance.RevenueGrowth.ToString("0.00")%
                            </MudChip>
                        </div>
                    </div>
                    
                    <!-- Gráfica de ventas -->
                    @if (_salesChartSeries.Any() && _salesLabels.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Line" 
                                 ChartSeries="@_salesChartSeries"
                                 XAxisLabels="@_salesLabels"
                                 Width="100%" 
                                 Height="300px">
                        </MudChart>
                    }
                    else
                    {
                        <MudText Class="d-flex justify-center align-center pa-8" Color="Color.Secondary">
                            @L["No sales data available for the selected period"]
                        </MudText>
                    }
                </MudPaper>
            </MudItem>

            <!-- Alertas de inventario -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.h6">@L["Inventory Alerts"]</MudText>
                        <MudBadge Content="@(_stockAlerts.Count())" Color="Color.Error"
                                 Overlap="true" Bordered="true">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                        </MudBadge>
                    </div>

                    <div style="max-height: 320px; overflow-y: auto;">
                        <MudList T="object" Dense="true" Class="pb-0">
                            @foreach (var alert in _stockAlerts)
                            {
                                <MudListItem T="object">
                                    <div class="d-flex align-center justify-space-between">
                                        <div>
                                            <div class="d-flex gap-2 align-center">
                                                <MudChip T="string" Size="Size.Small"
                                                    Color="@(alert.AlertType == "OUT_OF_STOCK" ? Color.Error : Color.Warning)"
                                                    Label="true">
                                                    @(alert.AlertType == "OUT_OF_STOCK" ? L["Out of Stock"] : L["Low Stock"])
                                                </MudChip>
                                                <MudText Typo="Typo.body2">@alert.ProductName</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="ml-10">
                                                @L["Current: {0}", alert.CurrentStock] / @L["Min: {0}", alert.MinStock ?? 0]
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Style="white-space: nowrap">
                                            @alert.WarehouseName
                                        </MudText>
                                    </div>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    </div>

                    @if (!_stockAlerts.Any())
                    {
                        <MudText Class="d-flex justify-center align-center pa-8" Color="Color.Success">
                            @L["No inventory alerts"]
                        </MudText>
                    }

                    <div class="d-flex justify-end mt-2">
                        <MudButton Variant="Variant.Text"
                                  Size="Size.Small"
                                  Color="Color.Primary"
                                  Href="/shop/inventory"
                                  EndIcon="@Icons.Material.Filled.ArrowForward">
                            @L["View All"]
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-4">
            <!-- Ventas recientes -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Recent Sales"]</MudText>
                    
                    <MudTable Items="@_recentSales" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["ID"]</MudTh>
                            <MudTh>@L["Customer"]</MudTh>
                            <MudTh>@L["Date"]</MudTh>
                            <MudTh>@L["Total"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Id</MudTd>
                            <MudTd>@context.CustomerName</MudTd>
                            <MudTd>@DateTimeService.FormatToTimezone(context.SaleDate, _timeZone)</MudTd>
                            <MudTd>@context.Total.ToString("C")</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                    @L[context.Status]
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    
                    <div class="d-flex justify-end mt-2">
                        <MudButton Variant="Variant.Text" 
                                  Size="Size.Small" 
                                  Color="Color.Primary"
                                  Href="/shop/reports/sales"
                                  EndIcon="@Icons.Material.Filled.ArrowForward">
                            @L["View All Sales"]
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Distribución de ventas -->
            <MudItem xs="12" md="6">
                <MudGrid>
                    <!-- Ventas por tipo -->
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Sales by Type"]</MudText>
                            
                            @if (_summary.SalesByType.Any())
                            {
                                <MudChart ChartType="ChartType.Pie" 
                                         Width="100%" 
                                         Height="200px"
                                         InputData="@_summary.SalesByType.Values.Select(v => (double)v).ToArray()"
                                         InputLabels="@_summary.SalesByType.Keys.Select(k => L[k].Value).ToArray()" >
                                </MudChart>
                            }
                            else
                            {
                                <MudText Class="pa-4 text-center" Color="Color.Secondary">
                                    @L["No data available"]
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                    
                    <!-- Ventas por método de pago -->
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Payment Methods"]</MudText>
                            
                            @if (_summary.SalesByPaymentMethod.Any())
                            {
                                <MudChart ChartType="ChartType.Pie" 
                                         Width="100%" 
                                         Height="200px"
                                         InputData="@_summary.SalesByPaymentMethod.Values.Select(v => (double)v).ToArray()"
                                         InputLabels="@_summary.SalesByPaymentMethod.Keys.ToArray()" >
                                </MudChart>
                            }
                            else
                            {
                                <MudText Class="pa-4 text-center" Color="Color.Secondary">
                                    @L["No data available"]
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                    
                    <!-- Resumen de inventario -->
                    <MudItem xs="12">
                        <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                            <MudText Typo="Typo.h6" Class="mb-4">@L["Inventory Summary"]</MudText>

                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <div class="d-flex flex-column align-center">
                                        <MudText Typo="Typo.subtitle2">@L["Low Stock"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Warning">@_summary.LowStockCount</MudText>
                                        <MudText Typo="Typo.caption">@L["Products below min stock"]</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="d-flex flex-column align-center">
                                        <MudText Typo="Typo.subtitle2">@L["Out of Stock"]</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Error">@_summary.OutOfStockCount</MudText>
                                        <MudText Typo="Typo.caption">@L["Products with zero stock"]</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>

                            <div class="d-flex justify-end mt-2">
                                <MudButton Variant="Variant.Text"
                                          Size="Size.Small"
                                          Color="Color.Primary"
                                          Href="/shop/inventory"
                                          EndIcon="@Icons.Material.Filled.ArrowForward">
                                    @L["Manage Inventory"]
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Stamp Balance (compact, secondary) -->
                    <AuthorizeView Policy="@ApplicationClaims.Shop.ViewStampBalance">
                        <Authorized>
                            <MudItem xs="12">
                                <MudPaper Elevation="1" Class="pa-3 rounded-lg">
                                    @if (_loadingStamps)
                                    {
                                        <div class="d-flex align-center gap-3">
                                            <MudSkeleton Width="120px" Height="18px" />
                                            <MudSkeleton Width="60px" Height="18px" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-space-between align-center">
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber"
                                                         Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @L["Stamp Balance"]
                                                </MudText>
                                                @if (_stampBalance?.IsConfigured == true)
                                                {
                                                    <MudText Typo="Typo.body2">
                                                        <strong style="color: @(_stampBalance.IsUnlimited || _stampBalance.Available > _stampAlertThreshold ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                                                            @(_stampBalance.IsUnlimited ? "∞" : _stampBalance.Available.ToString("N0"))
                                                        </strong>
                                                        <span style="color: var(--mud-palette-text-secondary); font-size: 0.75rem;">
                                                            @L["stamps available"]
                                                        </span>
                                                    </MudText>
                                                    @if (!_stampBalance.IsUnlimited && _stampBalance.Available <= _stampAlertThreshold)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                                            @L["Low balance"]
                                                        </MudChip>
                                                    }
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @L["Not configured"]
                                                    </MudText>
                                                }
                                            </div>
                                            <MudButton Variant="Variant.Text"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Href="/shop/stamp-balance"
                                                       EndIcon="@Icons.Material.Filled.ArrowForward">
                                                @L["View Details"]
                                            </MudButton>
                                        </div>
                                        @if (_stampBalance?.IsConfigured == true && !_stampBalance.IsUnlimited && _stampBalance.TotalAssigned > 0)
                                        {
                                            <MudProgressLinear Value="@(_stampBalance.AvailablePercent ?? 0)"
                                                               Color="@GetStampProgressColor()"
                                                               Rounded="true"
                                                               Size="Size.Small"
                                                               Class="mt-2" />
                                        }
                                    }
                                </MudPaper>
                            </MudItem>
                        </Authorized>
                    </AuthorizeView>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <!-- Productos más vendidos -->
        <MudGrid Class="mt-4">
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">@L["Top Products"]</MudText>

                    @if (!_topProducts.Any())
                    {
                        <MudText Class="d-flex justify-center align-center pa-6" Color="Color.Secondary">
                            @L["No product sales data available"]
                        </MudText>
                    }
                    else
                    {
                        var maxUnits = _topProducts.First().UnitsSold;
                        <MudGrid>
                            @foreach (var (product, index) in _topProducts.Select((p, i) => (p, i)))
                            {
                                <MudItem xs="12" md="6">
                                    <div class="d-flex align-center gap-3 mb-1">
                                        <MudText Typo="Typo.caption" Style="min-width:20px; text-align:right; color:var(--mud-palette-text-secondary)">
                                            @(index + 1)
                                        </MudText>
                                        <div style="flex:1; min-width:0;">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                    @product.ProductName
                                                </MudText>
                                                <div class="d-flex gap-3 ml-2" style="white-space:nowrap;">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @product.UnitsSold.ToString("N0") @L["Units"]
                                                    </MudText>
                                                    <MudText Typo="Typo.caption">
                                                        <strong>@product.Revenue.ToString("C")</strong>
                                                    </MudText>
                                                </div>
                                            </div>
                                            <MudProgressLinear Value="@((double)(product.UnitsSold / maxUnits * 100))"
                                                               Color="@(index == 0 ? Color.Primary : Color.Default)"
                                                               Rounded="true"
                                                               Size="Size.Small" />
                                        </div>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private string _selectedPeriod = "month";
    private DateRange _dateRange = new(DateTime.Now.AddDays(-30), DateTime.Now);

    private DashboardSummaryDto _summary = new();
    private SalesPerformanceDto _performance = new();
    private IEnumerable<StockAlertDto> _stockAlerts = Array.Empty<StockAlertDto>();
    private IEnumerable<RecentSaleDto> _recentSales = Array.Empty<RecentSaleDto>();
    private IEnumerable<TopProductDto> _topProducts = Array.Empty<TopProductDto>();

    // Stamp balance
    private MexicoStampBalanceDto? _stampBalance;
    private int _stampAlertThreshold = 50;
    private bool _loadingStamps = true;

    // Datos para gráficas
    private string[] _salesLabels = Array.Empty<string>();
    private List<ChartSeries> _salesChartSeries = new();
    private string _chartYAxisLabel = "Ingresos";

    // Zona horaria
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _timeZone = await CompanySettingsService.GetCurrentTimeZoneAsync() ?? TimeZoneInfo.Utc;
            UpdateDateRangeFromPeriod();
            await Task.WhenAll(LoadDashboardData(), LoadStampBalanceAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing dashboard");
            Snackbar.Add(L["Error loading dashboard data"], Severity.Error);
        }
    }

    private async Task RefreshDashboard()
    {
        try
        {
            if (_selectedPeriod != "custom")
            {
                UpdateDateRangeFromPeriod();
            }
            await Task.WhenAll(LoadDashboardData(), LoadStampBalanceAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing dashboard");
            Snackbar.Add(L["Error refreshing dashboard data"], Severity.Error);
        }
    }

    private async Task LoadStampBalanceAsync()
    {
        _loadingStamps = true;
        try
        {
            var settings = await StampAlertService.GetAlertSettingsAsync();
            _stampAlertThreshold = settings.LowStampThreshold;

            var result = await StampAlertService.GetBalanceAsync();
            if (result.IsSuccess)
                _stampBalance = result.Value;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load stamp balance for dashboard");
        }
        finally
        {
            _loadingStamps = false;
        }
    }

    private void UpdateDateRangeFromPeriod()
    {
        var today = TimeZoneInfo.ConvertTimeFromUtc(DateTimeService.Now, _timeZone).Date;
        
        _dateRange = _selectedPeriod switch
        {
            "today" => new DateRange(today, today),
            "week" => new DateRange(today.AddDays(-(today.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)today.DayOfWeek - 1)), today),
            "month" => new DateRange(new DateTime(today.Year, today.Month, 1), today),
            _ => _dateRange // custom - mantener el rango actual
        };
    }

    private async Task LoadDashboardData()
    {
        _loading = true;
        StateHasChanged();
        
        try
        {
            // Cargar resumen del dashboard
            _summary = await DashboardService.GetDashboardSummaryAsync(
                _dateRange.Start,
                _dateRange.End);
                
            // Cargar rendimiento de ventas
            _performance = await DashboardService.GetSalesPerformanceAsync(
                _dateRange.Start,
                _dateRange.End);
                
            // Cargar alertas de inventario
            _stockAlerts = await DashboardService.GetStockAlertsAsync(10);
                
            // Cargar ventas recientes
            _recentSales = await DashboardService.GetRecentSalesAsync(10);

            // Cargar productos más vendidos
            _topProducts = await DashboardService.GetTopProductsAsync(
                _dateRange.Start,
                _dateRange.End,
                maxItems: 10);
                
            // Preparar datos para gráficas
            PrepareChartData();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void PrepareChartData()
    {
        if (_performance.DailySales == null || !_performance.DailySales.Any())
        {
            _salesLabels = Array.Empty<string>();
            _salesChartSeries = new List<ChartSeries>();
            return;
        }

        // Preparar etiquetas (fechas)
        _salesLabels = _performance.DailySales
            .Select(d => d.Date.ToString("dd/MM"))
            .ToArray();

        // Escalar el eje Y para evitar números largos
        var maxAmount = _performance.DailySales.Max(d => (double)d.Amount);
        double scale;
        if (maxAmount >= 1_000_000)
        {
            scale = 1_000_000;
            _chartYAxisLabel = L["Revenue"] + " (M$)";
        }
        else if (maxAmount >= 1_000)
        {
            scale = 1_000;
            _chartYAxisLabel = L["Revenue"] + " (K$)";
        }
        else
        {
            scale = 1;
            _chartYAxisLabel = L["Revenue"].Value;
        }

        _salesChartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = _chartYAxisLabel,
                Data = _performance.DailySales
                    .Select(d => Math.Round((double)d.Amount / scale, 2))
                    .ToArray()
            }
        };
    }

    private Color GetStatusColor(string status)
    {
        return status.ToLower() switch
        {
            "created" => Color.Info,
            "completed" => Color.Success,
            "cancelled" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetStampProgressColor()
    {
        if (_stampBalance == null) return Color.Default;
        if (_stampBalance.Available <= _stampAlertThreshold) return Color.Error;
        if (_stampBalance.AvailablePercent < 25) return Color.Warning;
        return Color.Success;
    }
}