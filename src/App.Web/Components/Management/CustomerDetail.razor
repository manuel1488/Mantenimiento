@page "/customers/{Id:long}"
@using App.Core.DTOs.Billing.Mexico
@using App.Core.DTOs.Customer
@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject ICustomerService CustomerService
@inject IMexicoFiscalCatalogService FiscalCatalogService
@inject IStringLocalizer<CustomerDetail> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILookupService LookupService
@inject ILogger<CustomerDetail> _logger
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewCustomers)]

<PageTitle>@L["Customer Details"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (_loading)
    {
        <MudProgressCircular Color="Color.Default" Indeterminate="true" />
    }
    else if (_customer == null)
    {
        <MudAlert Severity="Severity.Error">@L["Customer not found"]</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h4">@_customer.Name</MudText>
                <MudButton Variant="Variant.Outlined"
                          StartIcon="@Icons.Material.Filled.ArrowBack"
                          Class="da-button-rounded"
                          title="@L["Back to customers list"]"
                          OnClick="@(() => Navigation.NavigateTo("/customers"))">
                    @L["Back to List"]
                </MudButton>
            </MudItem>

            <!-- ═══════════════ DATOS COMERCIALES ═══════════════ -->
            <MudItem xs="12">
                <MudPaper Elevation="1" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-2" />
                        @L["Commercial Data"]
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Trade Name"]" Variant="Variant.Text">
                                @_customer.Name
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Country"]" Variant="Variant.Text">
                                @(_countries.FirstOrDefault(c => c.Code == _customer.CountryCode)?.Name ?? _customer.CountryCode)
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Email"]" Variant="Variant.Text">
                                @(_customer.Email ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Phone"]" Variant="Variant.Text">
                                @(_customer.Phone ?? "-")
                            </MudField>
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Commercial Address"]</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudField Label="@L["Street"]" Variant="Variant.Text">
                                @(_customer.Street ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Exterior Number"]" Variant="Variant.Text">
                                @(_customer.ExteriorNumber ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Interior Number"]" Variant="Variant.Text">
                                @(_customer.InteriorNumber ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Neighborhood"]" Variant="Variant.Text">
                                @(_customer.Neighborhood ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["City"]" Variant="Variant.Text">
                                @(_customer.City ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["State"]" Variant="Variant.Text">
                                @(_customer.State ?? "-")
                            </MudField>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudField Label="@L["Postal Code"]" Variant="Variant.Text">
                                @(_customer.PostalCode ?? "-")
                            </MudField>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- ═══════════════ DATOS FISCALES ═══════════════ -->
            <MudItem xs="12">
                <MudPaper Elevation="1" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                        @L["Fiscal Data"]
                    </MudText>

                    @if (_customer.FiscalProfile == null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["This customer has no fiscal profile. Add one to enable invoicing."]
                        </MudAlert>
                    }
                    else
                    {
                        var fp = _customer.FiscalProfile;
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Tax ID / RFC"]" Variant="Variant.Text">
                                    @fp.TaxId
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Legal Name / Razón Social"]" Variant="Variant.Text">
                                    @fp.LegalName
                                </MudField>
                            </MudItem>

                            @if (!string.IsNullOrWhiteSpace(fp.FiscalEmail))
                            {
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["Fiscal Email"]" Variant="Variant.Text">
                                        @fp.FiscalEmail
                                    </MudField>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Fiscal Address"]</MudText>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudField Label="@L["Street"]" Variant="Variant.Text">
                                    @(fp.Street ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Exterior Number"]" Variant="Variant.Text">
                                    @(fp.ExteriorNumber ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Interior Number"]" Variant="Variant.Text">
                                    @(fp.InteriorNumber ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Neighborhood"]" Variant="Variant.Text">
                                    @(fp.Neighborhood ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["City"]" Variant="Variant.Text">
                                    @(fp.City ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["State"]" Variant="Variant.Text">
                                    @(fp.State ?? "-")
                                </MudField>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudField Label="@L["Fiscal Postal Code"]" Variant="Variant.Text">
                                    @(fp.PostalCode ?? "-")
                                </MudField>
                            </MudItem>
                        </MudGrid>

                        @if (_customer.CountryCode == "MX")
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Mexico Billing Preferences"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["Fiscal Regime"]" Variant="Variant.Text">
                                        @{
                                            var regime = _fiscalRegimes.FirstOrDefault(r => r.Code == fp.FiscalRegime);
                                            @(regime != null ? $"{regime.Code} — {regime.Description}" : (fp.FiscalRegime ?? "-"))
                                        }
                                    </MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["Default CFDI Use"]" Variant="Variant.Text">
                                        @{
                                            var cfdiUse = _cfdiUses.FirstOrDefault(u => u.Code == fp.DefaultCfdiUse);
                                            @(cfdiUse != null ? $"{cfdiUse.Code} — {cfdiUse.Description}" : (fp.DefaultCfdiUse ?? "-"))
                                        }
                                    </MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["Auto-Invoice"]" Variant="Variant.Text">
                                        @if (fp.AutoInvoice)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">@L["Yes"]</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">@L["No"]</MudChip>
                                        }
                                    </MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["Send Invoice Email"]" Variant="Variant.Text">
                                        @if (fp.SendInvoiceEmail)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Email">@L["Yes"]</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">@L["No"]</MudChip>
                                        }
                                    </MudField>
                                </MudItem>
                            </MudGrid>
                        }

                        @if (_customer.CountryCode == "CA")
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Canadian Tax Numbers"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["GST Number"]" Variant="Variant.Text">@(fp.CaGstNumber ?? "-")</MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["PST Number"]" Variant="Variant.Text">@(fp.CaPstNumber ?? "-")</MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["HST Number"]" Variant="Variant.Text">@(fp.CaHstNumber ?? "-")</MudField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudField Label="@L["QST Number"]" Variant="Variant.Text">@(fp.CaQstNumber ?? "-")</MudField>
                                </MudItem>
                            </MudGrid>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public long Id { get; set; }
    private CustomerDto? _customer;
    private List<CountryDto> _countries = [];
    private List<MexicoFiscalRegimeDto> _fiscalRegimes = [];
    private List<MexicoCfdiUseDto> _cfdiUses = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var countriesTask = LookupService.GetCountriesAsync();
        var regimesTask = FiscalCatalogService.GetFiscalRegimesAsync();
        var cfdiUsesTask = FiscalCatalogService.GetCfdiUsesAsync();

        await Task.WhenAll(countriesTask, regimesTask, cfdiUsesTask);

        _countries = countriesTask.Result.ToList();
        _fiscalRegimes = regimesTask.Result.ToList();
        _cfdiUses = cfdiUsesTask.Result.ToList();

        await LoadCustomer();
    }

    private async Task LoadCustomer()
    {
        try
        {
            _customer = await CustomerService.GetCustomerByIdAsync(Id);
            if (_customer == null)
                Snackbar.Add(L["Customer not found"], Severity.Warning);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading customer");
            Snackbar.Add(L["Error loading customer"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
