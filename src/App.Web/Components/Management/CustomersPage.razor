@page "/customers"
@using App.Core.DTOs.Customer
@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Web.Components.Shared
@using App.Web.Components.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization

@inject ICustomerService CustomerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<CustomersPage> L
@inject ILookupService LookupService
@inject ILogger<CustomersPage> Logger
@attribute [Authorize (Policy = ApplicationClaims.Shared.ViewCustomers)]

<PageTitle>@L["Customers Management"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid>
        <MudItem xs="12" Class="d-flex gap-4">
            <!-- Búsqueda -->
            <MudTextField T="string" 
                         ValueChanged="@(s => OnSearch(s))"
                         Placeholder="@L["Search customers"]"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         Class="flex-1"/>

            <!-- Filtro de País -->
            <MudSelect T="string" 
                    Label="@L["Country"]"
                    ValueChanged="@(c => OnCountryFilterChange(c))"
                    AnchorOrigin="Origin.BottomCenter"
                    Style="min-width: 200px;">
                <MudSelectItem Value="@string.Empty">@L["All"]</MudSelectItem>
                @foreach(var country in _countries)
                {
                    <MudSelectItem Value="@country.Code">@country.Name</MudSelectItem>
                }
            </MudSelect>

            <!-- Estado -->
            <MudSelect T="bool?" 
                      Label="@L["Status"]"
                      ValueChanged="@(s => OnStatusFilterChange(s))"
                      AnchorOrigin="Origin.BottomCenter"
                      Style="min-width: 200px;">
                <MudSelectItem T="bool?" Value="@((bool?)null)">@L["All"]</MudSelectItem>
                <MudSelectItem T="bool?" Value="@true">@L["Active"]</MudSelectItem>
                <MudSelectItem T="bool?" Value="@false">@L["Inactive"]</MudSelectItem>
            </MudSelect>

            <AuthorizeView Context="contextNew" Policy="@ApplicationClaims.Shared.ManageCustomers">
                <!-- Botón Nuevo Cliente -->
                <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Add"
                        OnClick="OpenCreateDialog"
                        Class="da-button-rounded">
                    @L["New Customer"]
                </MudButton>
            </AuthorizeView>            
        </MudItem>

        <MudItem xs="12">
            <MudTable T="CustomerDto" 
                     ServerData="@LoadServerData"
                     Dense="true"
                     Hover="true"
                     Loading="@_loading"
                     @ref="_table">
                <HeaderContent>
                    <MudTh>@L["Trade Name"]</MudTh>
                    <MudTh>@L["Legal Name"]</MudTh>
                    <MudTh>@L["Tax ID"]</MudTh>
                    <MudTh>@L["Email"]</MudTh>
                    <MudTh>@L["Phone"]</MudTh>
                    <MudTh>@L["Country"]</MudTh>
                    <MudTh>@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Trade Name"]">@context.Name</MudTd>
                    <MudTd DataLabel="@L["Legal Name"]">@context.LegalName</MudTd>
                    <MudTd DataLabel="@L["Tax ID"]">@context.TaxId</MudTd>
                    <MudTd DataLabel="@L["Email"]">@context.Email</MudTd>
                    <MudTd DataLabel="@L["Phone"]">@context.Phone</MudTd>
                    <MudTd DataLabel="@L["Country"]">
                        @(_countries.FirstOrDefault(c => c.Code == context.CountryCode)?.Name ?? context.CountryCode)
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                            Size="Size.Small"
                            OnClick="@(() => Navigation.NavigateTo($"/customers/{context.Id}"))"
                            title="@L["View Customer"]" />
                        <AuthorizeView Context="contextEdit" Policy="@ApplicationClaims.Shared.ManageCustomers">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                     Size="Size.Small"
                                     OnClick="@(() => OpenEditDialog(context))"
                                     title="@L["Edit Customer"]" />
                        </AuthorizeView>
                        <AuthorizeView Context="contextDelete" Policy="@ApplicationClaims.Shared.DeleteCustomers">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                     Size="Size.Small"
                                     Color="Color.Error"
                                     title="@L["Delete Customer"]"
                                     OnClick="@(() => OpenDeleteDialog(context))" />
                        </AuthorizeView>                        
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
                <NoRecordsContent>
                    <MudText>@L["No customers found"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private MudTable<CustomerDto> _table = null!;
    private bool _loading;
    private string _searchString = "";
    private string? _selectedCountry;
    private bool? _selectedStatus;
    private List<CountryDto> _countries = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _countries = (await LookupService.GetCountriesAsync()).ToList();
    }

    private async Task<TableData<CustomerDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            var (totalItems, items) = await CustomerService.GetCustomersAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                countryCode: _selectedCountry,
                isActive: _selectedStatus);

            return new TableData<CustomerDto>() { TotalItems = totalItems, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customers");
            Snackbar.Add(L["Error loading customers"], Severity.Error);
            return new TableData<CustomerDto>() { TotalItems = 0, Items = Enumerable.Empty<CustomerDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OnCountryFilterChange(string? country)
    {
        _selectedCountry = country;
        await _table.ReloadServerData();
    }

    private async Task OnStatusFilterChange(bool? status)
    {
        _selectedStatus = status;
        await _table.ReloadServerData();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CustomerDialog>(L["New Customer"]);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenEditDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters<CustomerDialog>
        {
            { x => x.CustomerId, customer.Id }
        };

        var dialog = await DialogService.ShowAsync<CustomerDialog>(
            L["Edit Customer"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenDeleteDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Customer"] },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete customer:"] },
            { nameof(ConfirmDialog.HighlightedText), customer.Name },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"] },
            { nameof(ConfirmDialog.CancelText), L["Cancel"] },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["Delete Customer"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var success = await CustomerService.DeleteCustomerAsync(customer.Id);
                if (success)
                {
                    Snackbar.Add(L["Customer deleted successfully"], Severity.Success);
                    await _table.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(L["Error deleting customer"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting customer {CustomerId}", customer.Id);
                Snackbar.Add(L["Error deleting customer"], Severity.Error);
            }
        }
    }
}