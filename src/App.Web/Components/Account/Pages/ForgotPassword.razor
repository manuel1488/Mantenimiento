@page "/Account/ForgotPassword"
@layout EmptyLayout
@using App.Web.Components.Layout
@using App.Core.Identity.Interfaces
@using App.Core.DTOs.Identity
@using App.Core.Interfaces
@using App.Core.Options
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Options

@inject IIdentityService IdentityService
@inject IStringLocalizer<ForgotPassword> L
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPassword> Logger
@inject App.Web.Services.CurrentThemeService ThemeService
@inject IOptions<BrandingOptions> BrandingOptions
@inject ICompanySettingsService CompanySettingsService

<PageTitle>@L["Forgot Password"] - App</PageTitle>

<MudThemeProvider Theme="ThemeService.Theme"/>
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pt-0">
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
            <MudPaper Elevation="3" Class="pa-8" Style="width: 500px;">
                <MudStack Spacing="4">
                    <!-- Logo & Title -->
                    <MudPaper Class="d-flex justify-center align-center pa-4" Style="background-color: #000000; border-radius: 8px;">
                        <MudImage Src="@_logoSrc" Alt="@L["LogoAlt"]" Height="80" ObjectFit="ObjectFit.Contain" />
                    </MudPaper>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-4">@L["Forgot Password"]</MudText>

                    @if (_isSubmitted)
                    {
                        <MudAlert Severity="Severity.Success" Class="my-4">
                            @L["ResetLinkSent"]
                        </MudAlert>
                        <MudText Typo="Typo.body1" Align="Align.Center">
                            @L["ResetLinkSentDescription"]
                        </MudText>
                        <MudItem xs="12" Class="d-flex justify-center mt-4">
                            <MudLink Href="/Account/Login">@L["BackToLogin"]</MudLink>
                        </MudItem>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                            @L["EnterEmailInstructions"]
                        </MudText>

                        <EditForm Model="Input" method="post" OnValidSubmit="ProcessForgotPasswordAsync" FormName="forgot-password">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="mud-alert mud-alert-filled-error my-2" />

                            <MudGrid>
                                <MudItem xs="12">
                                    <MudStaticTextField For="@(() => Input.Email)" 
                                        @bind-Value="@Input.Email" 
                                        Label="@L["Email"]" 
                                        Placeholder="@L["Enter your email address"]"
                                        InputType="InputType.Email"
                                        UserAttributes="@(new() { { "aria-required", "true" }, { "autocomplete", "email" } })" />
                                </MudItem>
                                
                                <MudItem xs="12" Class="mt-4">
                                    <MudStaticButton id="reset-submit" 
                                        Variant="Variant.Filled" 
                                        Color="Color.Primary" 
                                        FullWidth="true" 
                                        FormAction="FormAction.Submit" 
                                        Disabled="@_isProcessing"
                                        Class="da-button-rounded">
                                        @if (_isProcessing)
                                        {
                                            <div class="d-flex align-center justify-center">
                                                <span class="mud-progress-circular mud-progress-small mud-progress-indeterminate mud-primary">
                                                    <svg class="mud-progress-circular-svg" viewBox="22 22 44 44">
                                                        <circle class="mud-progress-circular-circle" cx="44" cy="44" r="20" fill="none" stroke-width="4"></circle>
                                                    </svg>
                                                </span>
                                                <span class="ms-2">@L["Processing"]</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @L["SendResetLink"]
                                        }
                                    </MudStaticButton>
                                </MudItem>
                                
                                <MudItem xs="12" Class="d-flex justify-center mt-4">
                                    <MudLink Href="/Account/Login">@L["BackToLogin"]</MudLink>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    }
                </MudStack>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
    
    private bool _isProcessing = false;
    private bool _isSubmitted = false;
    private string _errorMessage = string.Empty;
    private string? _logoSrc;

    protected override async Task OnInitializedAsync()
    {
        _logoSrc = await CompanySettingsService.GetLogoDataUriAsync() ?? BrandingOptions.Value.LogoPath;
    }

    private async Task ProcessForgotPasswordAsync()
    {
        if (_isProcessing) return;

        try
        {
            _isProcessing = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(Input.Email))
            {
                _errorMessage = L["EmailRequired"];
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            var result = await IdentityService.ForgotPasswordAsync(Input.Email);
            
            if (result.Succeeded)
            {
                _isSubmitted = true;
                Logger.LogInformation("Password reset email requested for {Email}", Input.Email);
            }
            else
            {
                Logger.LogWarning("Error sending password reset email to {Email}: {Error}", 
                    Input.Email, result.Error);
                Snackbar.Add(result.Error ?? L["ErrorSendingEmail"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error in forgot password page for email {Email}", Input.Email);
            Snackbar.Add(L["UnexpectedError"], Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ForgotPassword), ErrorMessageResourceName = "EmailRequired")]
        [EmailAddress(ErrorMessageResourceType = typeof(ForgotPassword), ErrorMessageResourceName = "InvalidEmailFormat")]
        public string Email { get; set; } = "";
    }
}