@page "/Account/ResetPassword"
@layout EmptyLayout
@using App.Web.Components.Layout
@using App.Core.Identity.Interfaces
@using App.Core.DTOs.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities

@inject IStringLocalizer<ResetPassword> L
@inject NavigationManager NavigationManager
@inject ILogger<ResetPassword> Logger
@inject App.Web.Services.CurrentThemeService ThemeService

<PageTitle>@L["ResetPassword"] - App</PageTitle>

<MudThemeProvider Theme="ThemeService.Theme"/>
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pt-0">
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
            <MudPaper Elevation="3" Class="pa-8" Style="width: 500px;">
                <MudStack Spacing="4">
                    <!-- Logo & Title -->
                    <MudPaper Class="d-flex justify-center align-center pa-4" Style="background-color: #000000; border-radius: 8px;">
                        <MudImage Src="/images/logo.webp" Alt="@L["LogoAlt"]" Height="80" ObjectFit="ObjectFit.Contain" />
                    </MudPaper>
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-4">@L["ResetPassword"]</MudText>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="my-4">
                            @errorMessage
                        </MudAlert>
                    }

                    @if (_resetSuccess)
                    {
                        <MudAlert Severity="Severity.Success" Class="my-4">
                            @L["PasswordResetSuccess"]
                        </MudAlert>
                        <MudText Typo="Typo.body1" Align="Align.Center">
                            @L["PasswordResetSuccessDescription"]
                        </MudText>
                        <MudLink Href="/Account/Login">
                            @L["GoToLogin"]
                        </MudLink>
                    }
                    else if (_invalidToken)
                    {
                        <MudAlert Severity="Severity.Error" Class="my-4">
                            @L["InvalidResetLink"]
                        </MudAlert>
                        <MudText Typo="Typo.body1" Align="Align.Center">
                            @L["InvalidResetLinkDescription"]
                        </MudText>
                        <MudLink Href="/Account/ForgotPassword">
                            @L["RequestNewResetLink"]
                        </MudLink>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                            @L["EnterNewPasswordInstructions"]
                        </MudText>

                        <EditForm Model="@Input" method="post" Action="/api/Auth/ResetPassword" FormName="reset-password">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="mud-alert mud-alert-filled-error my-2" />
                            
                            <input type="hidden" name="Email" value="@Input.Email" />
                            <input type="hidden" name="Token" value="@Input.Token" />
                            
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudStaticTextField For="@(() => Input.NewPassword)" 
                                                @bind-Value="Input.NewPassword" 
                                                Label="@L["NewPassword"]"
                                                InputType="InputType.Password"
                                                Adornment="Adornment.End"
                                                AdornmentIcon="@Icons.Material.Filled.VisibilityOff"
                                                AdornmentClickFunction="showPassword"
                                                UserAttributes="@(new() { { "aria-required", "true" }, { "autocomplete", "new-password" } })" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudStaticTextField For="@(() => Input.ConfirmPassword)" 
                                                @bind-Value="Input.ConfirmPassword" 
                                                Label="@L["ConfirmPassword"]"
                                                InputType="InputType.Password"
                                                Adornment="Adornment.End"
                                                AdornmentIcon="@Icons.Material.Filled.VisibilityOff"
                                                AdornmentClickFunction="showPassword"
                                                UserAttributes="@(new() { { "aria-required", "true" }, { "autocomplete", "new-password" } })" />
                                </MudItem>
                                
                                <!-- Password requirements -->
                                <MudItem xs="12" Class="mt-2">
                                    <MudPaper Elevation="0" Class="pa-3 mud-background-gray rounded">
                                        <MudText Typo="Typo.subtitle2" Class="d-flex align-center mb-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Color="Color.Info" Size="Size.Small" />
                                            @L["PasswordRequirements"]
                                        </MudText>
                                        <MudGrid Spacing="1">
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.body2" Class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                                    @L["AtLeast8Chars"]
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.body2" Class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                                    @L["AtLeastOneUppercase"]
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.body2" Class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                                    @L["AtLeastOneLowercase"]
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.body2" Class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                                    @L["AtLeastOneDigit"]
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.body2" Class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                                    @L["AtLeastOneSpecial"]
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </MudItem>
                                
                                <MudItem xs="12" Class="mt-4">
                                    <MudStaticButton id="reset-submit" 
                                                Variant="Variant.Filled" 
                                                Color="Color.Primary" 
                                                FullWidth="true" 
                                                FormAction="FormAction.Submit" 
                                                Disabled="@_isProcessing"
                                                Class="da-button-rounded">
                                        @if (_isProcessing)
                                        {
                                            <div class="d-flex align-center justify-center">
                                                <span class="mud-progress-circular mud-progress-small mud-progress-indeterminate mud-primary">
                                                    <svg class="mud-progress-circular-svg" viewBox="22 22 44 44">
                                                        <circle class="mud-progress-circular-circle" cx="44" cy="44" r="20" fill="none" stroke-width="4"></circle>
                                                    </svg>
                                                </span>
                                                <span class="ms-2">@L["Processing"]</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @L["ResetPassword"]
                                        }
                                    </MudStaticButton>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    }
                </MudStack>
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [SupplyParameterFromForm]
    private ResetPasswordInputModel Input { get; set; } = new();
    
    [SupplyParameterFromQuery]
    private string? email { get; set; }
    
    [SupplyParameterFromQuery]
    private string? token { get; set; }
    
    [SupplyParameterFromQuery]
    private string? status { get; set; }
    
    [SupplyParameterFromQuery]
    private string? error { get; set; }
    
    private bool _isProcessing = false;
    private bool _resetSuccess = false;
    private bool _invalidToken = false;
    private string? errorMessage;
    
    protected override void OnInitialized()
    {
        // Manejar los parámetros de la consulta
        Input.Email = email ?? string.Empty;
        Input.Token = token ?? string.Empty;
        
        // Verificar si hay errores específicos
        if (!string.IsNullOrEmpty(error))
        {
            errorMessage = error switch
            {
                "empty" => L["PasswordFieldsCannotBeEmpty"],
                "mismatch" => L["PasswordsDoNotMatch"],
                "failed" => L["PasswordResetFailed"],
                "exception" => L["UnexpectedError"],
                _ => L["ErrorResettingPassword"]
            };
        }
        
        // Verificar si token/email son válidos
        if (string.IsNullOrEmpty(Input.Email) || string.IsNullOrEmpty(Input.Token))
        {
            _invalidToken = true;
        }
        
        // Verificar si hay un estado de retorno de la operación
        if (!string.IsNullOrEmpty(status))
        {
            if (status == "success")
            {
                _resetSuccess = true;
            } 
            else if (status == "invalid")
            {
                _invalidToken = true;
            }
        }
        
        Logger.LogInformation("ResetPassword initialized with email: {Email}, token valid: {IsValid}", 
            Input.Email, !_invalidToken);
    }

    public class ResetPasswordInputModel
    {
        public string Email { get; set; } = string.Empty;
        
        public string Token { get; set; } = string.Empty;
        
        [Required(ErrorMessageResourceType = typeof(ResetPassword), ErrorMessageResourceName = "PasswordRequired")]
        [StringLength(100, ErrorMessageResourceType = typeof(ResetPassword), ErrorMessageResourceName = "PasswordMin8Chars", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;
        
        [Required(ErrorMessageResourceType = typeof(ResetPassword), ErrorMessageResourceName = "ConfirmPasswordRequired")]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(ResetPassword), ErrorMessageResourceName = "PasswordsDoNotMatch")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

<script>
    let timeoutId;

    function showPassword(inputElement, button) {
        if (inputElement.type === 'password') {
            inputElement.type = 'text';
            clearTimeout(timeoutId);
            timeoutId = setTimeout(function () {
                inputElement.type = 'password';
            }, 5000);
        } else {
            inputElement.type = 'password';
            clearTimeout(timeoutId);
        }
    }
</script>