@using App.Core.DTOs.Billing
@using App.Core.Interfaces.Billing
@using MudBlazor

@inject IGlobalInvoiceService GlobalInvoiceService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CancelGlobalInvoiceDialog> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning">
                @L["This action will request cancellation of the CFDI from the SAT. This cannot be undone."]
            </MudAlert>

            <MudText Typo="Typo.body2">
                @L["Invoice:"] <strong>@(string.IsNullOrEmpty(Invoice.Serie) ? Invoice.Folio.ToString() : $"{Invoice.Serie}{Invoice.Folio}")</strong>
                &nbsp;|&nbsp; UUID: <code>@Invoice.Uuid</code>
            </MudText>

            <MudSelect T="string"
                       @bind-Value="_reason"
                       Label="@L["Cancellation Reason"]"
                       Variant="Variant.Outlined"
                       Required="true">
                <MudSelectItem Value="@("01")">01 — @L["Comprobante emitido con errores con relación"]</MudSelectItem>
                <MudSelectItem Value="@("02")">02 — @L["Comprobante emitido con errores sin relación"]</MudSelectItem>
                <MudSelectItem Value="@("03")">03 — @L["No se llevó a cabo la operación"]</MudSelectItem>
                <MudSelectItem Value="@("04")">04 — @L["Operación nominativa relacionada en la factura global"]</MudSelectItem>
            </MudSelect>

            @if (_reason == "01")
            {
                <MudTextField @bind-Value="_replacementUuid"
                              Label="@L["Replacement UUID"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["Replacement UUID is required for reason 01"]"
                              Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_processing">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="ConfirmAsync"
                   Disabled="@(!CanConfirm || _processing)">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L["Request Cancellation"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public GlobalInvoiceListDto Invoice { get; set; } = null!;

    #region Fields
    private string _reason = "02";
    private string _replacementUuid = string.Empty;
    private bool _processing = false;
    #endregion

    private bool CanConfirm => !string.IsNullOrEmpty(_reason)
        && (_reason != "01" || !string.IsNullOrEmpty(_replacementUuid));

    private async Task ConfirmAsync()
    {
        _processing = true;
        var result = await GlobalInvoiceService.CancelAsync(
            Invoice.Id, _reason,
            _reason == "01" ? _replacementUuid : null);
        _processing = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error, Severity.Error);
            return;
        }

        Snackbar.Add(L["Cancellation request sent successfully."], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
