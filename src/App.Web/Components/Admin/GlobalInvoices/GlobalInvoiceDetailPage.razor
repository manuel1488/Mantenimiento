@page "/admin/global-invoices/{Id:long}"
@using App.Core.Constants
@using App.Core.DTOs.Billing
@using App.Core.Enums.Billing
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IGlobalInvoiceService GlobalInvoiceService
@inject ICompanySettingsService CompanySettingsService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<GlobalInvoiceDetailPage> L

@attribute [Authorize(Policy = ApplicationClaims.Admin.ViewGlobalInvoices)]

<PageTitle>@L["Global Invoice Detail"]</PageTitle>

@if (_loading)
{
    <div style="display:flex; justify-content:center; padding:60px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (_invoice is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@L["Invoice not found"]</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">@L["Back"]</MudButton>
}
else
{
    @* Title row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="GoBack"
                       title="@L["Back"]" />
        <MudText Typo="Typo.h5" Style="flex:1;">@FolioDisplay</MudText>
        <MudChip T="string" Color="@GetStatusColor(_invoice.Status)" Size="Size.Small">
            @GetStatusText(_invoice.Status)
        </MudChip>
        @if (_invoice.Status == GlobalInvoiceStatus.Stamped || _invoice.Status == GlobalInvoiceStatus.Cancelled)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Code"
                           Color="Color.Info"
                           title="@L["Download XML"]"
                           OnClick="DownloadXmlAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                           Color="Color.Default"
                           title="@L["View PDF"]"
                           OnClick="ViewPdfAsync" />
        }
        @if (_invoice.HasCancellationAcuse)
        {
            <MudIconButton Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                           Color="Color.Warning"
                           title="@L["Download Cancellation Acuse"]"
                           OnClick="DownloadAcuseAsync" />
        }
    </MudStack>

    <MudGrid Spacing="3">

        @* Left column — Invoice info *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>@L["Invoice Information"]</strong></MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Folio"]</MudText>
                        <MudText Typo="Typo.body2">@FolioDisplay</MudText>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_invoice.Uuid))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Style="color:#888;">UUID</MudText>
                            <MudText Typo="Typo.body2" Style="font-family:monospace; font-size:12px; word-break:break-all;">@_invoice.Uuid</MudText>
                        </MudItem>
                    }
                    @if (_invoice.StampDate.HasValue)
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Style="color:#888;">@L["Stamp Date"]</MudText>
                            <MudText Typo="Typo.body2">@FormatDateTime(_invoice.StampDate.Value)</MudText>
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Period"]</MudText>
                        <MudText Typo="Typo.body2">@FormatDate(_invoice.StartDate) — @FormatDate(_invoice.EndDate)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Periodicity"]</MudText>
                        <MudText Typo="Typo.body2">@L[_invoice.Periodicity.ToString()]</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Payment Form"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.PaymentForm</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Generated At"]</MudText>
                        <MudText Typo="Typo.body2">@FormatDateTime(_invoice.CreatedAt)</MudText>
                    </MudItem>
                </MudGrid>

                @* Cancellation section *@
                @if (_invoice.CancellationDate.HasValue || !string.IsNullOrEmpty(_invoice.CancellationReason))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">@L["Cancellation"]</MudText>
                    <MudGrid Spacing="2">
                        @if (_invoice.CancellationDate.HasValue)
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Cancellation Date"]</MudText>
                                <MudText Typo="Typo.body2">@FormatDateTime(_invoice.CancellationDate.Value)</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.CancellationReason))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["SAT Reason"]</MudText>
                                <MudText Typo="Typo.body2">@_invoice.CancellationReason — @GetSatReasonText(_invoice.CancellationReason)</MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_invoice.CancellationNotes))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color:#888;">@L["Observations"]</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_invoice.CancellationNotes</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>

        @* Right column — Issuer *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>@L["Issuer"]</strong></MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Legal Name"]</MudText>
                        <MudText Typo="Typo.body2"><strong>@_invoice.IssuerLegalName</strong></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">RFC</MudText>
                        <MudText Typo="Typo.body2" Style="font-family:monospace;">@_invoice.IssuerRfc</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Fiscal Regime"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.IssuerFiscalRegime</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Style="color:#888;">@L["Postal Code"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.IssuerPostalCode</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* Included Sales *@
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <strong>@L["Included Sales"] (@_invoice.SaleCount)</strong>
                </MudText>
                <MudDataGrid T="GlobalInvoiceSaleDto"
                             Items="@_invoice.Sales"
                             Dense="true"
                             Hover="true"
                             SortMode="SortMode.Single"
                             RowsPerPage="20">
                    <Columns>
                        <TemplateColumn Title="@L["Sale #"]">
                            <CellTemplate>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.ShoppingCart"
                                           OnClick="@(() => Navigation.NavigateTo($"/shop/sales/{context.Item.SaleId}"))">
                                    #@context.Item.SaleId
                                </MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Date"]" SortBy="@(x => x.SaleDate)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@FormatDate(context.Item.SaleDate)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Subtotal"]" SortBy="@(x => x.Subtotal)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.Subtotal.ToString("C2")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Tax"]" SortBy="@(x => x.TaxAmount)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.TaxAmount.ToString("C2")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Total"]" SortBy="@(x => x.Total)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2"><strong>@context.Item.Total.ToString("C2")</strong></MudText>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="GlobalInvoiceSaleDto" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        @* Totals *@
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudStack Spacing="1" Style="min-width:260px;">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Subtotal"]:</MudText>
                            <MudText Typo="Typo.body2">@_invoice.Subtotal.ToString("C2")</MudText>
                        </MudStack>
                        @if (_invoice.DiscountAmount > 0)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Discount"]:</MudText>
                                <MudText Typo="Typo.body2">-@_invoice.DiscountAmount.ToString("C2")</MudText>
                            </MudStack>
                        }
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Tax"]:</MudText>
                            <MudText Typo="Typo.body2">@_invoice.TaxAmount.ToString("C2")</MudText>
                        </MudStack>
                        <MudDivider />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1"><strong>@L["Total"]:</strong></MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                <strong>@_invoice.Total.ToString("C2")</strong>
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>
}

@code {
    [Parameter] public long Id { get; set; }

    private GlobalInvoiceDto? _invoice;
    private bool _loading = true;
    private TimeZoneInfo? _companyTimeZone;

    private string FolioDisplay => _invoice is null ? ""
        : string.IsNullOrEmpty(_invoice.Serie) ? _invoice.Folio.ToString() : $"{_invoice.Serie}{_invoice.Folio}";

    protected override async Task OnInitializedAsync()
    {
        _companyTimeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
        var result = await GlobalInvoiceService.GetByIdAsync(Id);
        if (result.IsSuccess)
            _invoice = result.Value;
        else
            Snackbar.Add(result.Error, Severity.Error);
        _loading = false;
    }

    private string FormatDate(DateTime utcDate)
    {
        if (_companyTimeZone is null) return utcDate.ToLocalTime().ToString("dd/MM/yyyy");
        return TimeZoneInfo.ConvertTimeFromUtc(utcDate, _companyTimeZone).ToString("dd/MM/yyyy");
    }

    private string FormatDateTime(DateTime utcDate)
    {
        if (_companyTimeZone is null) return utcDate.ToLocalTime().ToString("g");
        return TimeZoneInfo.ConvertTimeFromUtc(utcDate, _companyTimeZone).ToString("g");
    }

    private void GoBack() => Navigation.NavigateTo("/admin/global-invoices");

    private async Task DownloadXmlAsync()
    {
        var result = await GlobalInvoiceService.GetXmlAsync(Id);
        if (result.IsSuccess)
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(result.Value!);
            await JS.InvokeVoidAsync("downloadFile", $"factura-global-{FolioDisplay}.xml", "application/xml", Convert.ToBase64String(bytes));
        }
        else
            Snackbar.Add(result.Error, Severity.Error);
    }

    private async Task ViewPdfAsync()
        => await JS.InvokeVoidAsync("openInNewTab", $"/api/global-invoices/{Id}/pdf");

    private async Task DownloadAcuseAsync()
    {
        var result = await GlobalInvoiceService.GetCancellationAcuseAsync(Id);
        if (result.IsSuccess)
            await JS.InvokeVoidAsync("downloadFile", $"Acuse_Cancelacion_{FolioDisplay}.xml", "application/xml", Convert.ToBase64String(result.Value!));
        else
            Snackbar.Add(result.Error, Severity.Error);
    }

    private static Color GetStatusColor(GlobalInvoiceStatus status) => status switch
    {
        GlobalInvoiceStatus.Stamped    => Color.Success,
        GlobalInvoiceStatus.Cancelled  => Color.Error,
        GlobalInvoiceStatus.StampError => Color.Warning,
        _                              => Color.Default
    };

    private string GetStatusText(GlobalInvoiceStatus status) => status switch
    {
        GlobalInvoiceStatus.Stamped    => L["Stamped"],
        GlobalInvoiceStatus.Cancelled  => L["Cancelled"],
        GlobalInvoiceStatus.StampError => L["Stamp Error"],
        _                              => L["Draft"]
    };

    private string GetSatReasonText(string? code) => code switch
    {
        "01" => L["Con errores con relación"],
        "02" => L["Con errores sin relación"],
        "03" => L["No se llevó a cabo la operación"],
        "04" => L["Operación nominativa en factura global"],
        _ => code ?? ""
    };
}
