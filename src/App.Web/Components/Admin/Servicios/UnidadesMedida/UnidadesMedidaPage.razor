@page "/gestion/unidades-medida"
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewUnidadesMedida)]

@using Microsoft.AspNetCore.Authorization
@using App.Core.Constants
@using App.Core.DTOs.Servicios
@using App.Core.Interfaces
@using App.Web.Components.Admin.Servicios.UnidadesMedida.Models
@using App.Web.Components.Shared.Dialogs
@using MudBlazor

@inject IStringLocalizer<UnidadesMedidaPage> L
@inject IUnidadMedidaService UnidadMedidaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<UnidadesMedidaPage> Logger

<PageTitle>@L["Unit Measures"]</PageTitle>

<AuthorizeView Policy="@ApplicationClaims.Shared.ViewUnidadesMedida">
    <Authorized Context="pageAuth">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            <MudText Typo="Typo.h4" GutterBottom="true">@L["Unit Measures"]</MudText>

            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudTextField T="string" ValueChanged="@(s => OnSearch(s))"
                                  Placeholder="@L["Search unit measures"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="flex-1" />

                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageUnidadesMedida">
                        <Authorized Context="authContext">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog" Class="da-button-rounded">
                                @L["New Unit Measure"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>

                <MudDataGrid T="UnidadMedidaDto" Items="@_filteredUnidades" Loading="_loading"
                             SortMode="SortMode.Multiple" Filterable="false"
                             Dense="true" Hover="true" RowsPerPage="10">
                        <Columns>
                            <PropertyColumn Property="x => x.Codigo" Title="@L["Code"]" HeaderStyle="width: 120px;" />
                            <PropertyColumn Property="x => x.Nombre" Title="@L["Name"]" />
                            <PropertyColumn Property="x => x.Descripcion" Title="@L["Description"]" />
                            <TemplateColumn Title="@L["SAT Unit Code"]" HeaderStyle="width: 220px;">
                                <CellTemplate>
                                    @if (context.Item.ClaveUnidadSatId.HasValue)
                                    {
                                        @($"{context.Item.ClaveUnidadSatNombre} ({context.Item.ClaveUnidadSatCodigo})")
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false"
                                            CellClass="d-flex justify-end">
                                <CellTemplate>
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageUnidadesMedida">
                                        <Authorized Context="authContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => OpenEditDialog(context.Item))"
                                                           title="@L["Edit Unit Measure"]" />
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.DeleteUnidadesMedida">
                                        <Authorized Context="authContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => OpenDeleteDialog(context.Item))"
                                                           title="@L["Delete Unit Measure"]" />
                                        </Authorized>
                                    </AuthorizeView>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText>@L["No unit measures found"]</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudDataGridPager T="UnidadMedidaDto" />
                        </PagerContent>
                    </MudDataGrid>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view unit measures."]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading;
    private List<UnidadMedidaDto> _unidades = new();
    private List<UnidadMedidaDto> _filteredUnidades = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var result = await UnidadMedidaService.GetAllAsync();
            if (result.IsSuccess)
            {
                _unidades = result.Value!;
                ApplyFilter();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading unidades de medida");
            Snackbar.Add(L["Error loading unit measures"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filteredUnidades = string.IsNullOrWhiteSpace(_searchString)
            ? _unidades
            : _unidades.Where(u => u.Nombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
                                    || u.Codigo.Contains(_searchString, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void OnSearch(string value)
    {
        _searchString = value;
        ApplyFilter();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<UnidadMedidaDialog>
        {
            { x => x.IsNew, true },
            { x => x.Model, new UnidadMedidaDialogModel() }
        };

        var dialog = await DialogService.ShowAsync<UnidadMedidaDialog>(L["New Unit Measure"], parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is UnidadMedidaDialogModel model)
        {
            var createDto = new CreateUnidadMedidaDto
            {
                Codigo = model.Codigo,
                Nombre = model.Nombre,
                Descripcion = model.Descripcion,
                ClaveUnidadSatId = model.ClaveUnidadSatId
            };

            var createResult = await UnidadMedidaService.CreateAsync(createDto);
            if (createResult.IsSuccess)
            {
                Snackbar.Add(L["Unit measure created successfully"], Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(createResult.Error, Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(UnidadMedidaDto unidad)
    {
        var parameters = new DialogParameters<UnidadMedidaDialog>
        {
            { x => x.IsNew, false },
            { x => x.Model, new UnidadMedidaDialogModel
                {
                    Id = unidad.Id,
                    Codigo = unidad.Codigo,
                    Nombre = unidad.Nombre,
                    Descripcion = unidad.Descripcion,
                    ClaveUnidadSatId = unidad.ClaveUnidadSatId,
                    ClaveUnidadSatCodigo = unidad.ClaveUnidadSatCodigo,
                    ClaveUnidadSatNombre = unidad.ClaveUnidadSatNombre
                }
            }
        };

        var dialog = await DialogService.ShowAsync<UnidadMedidaDialog>(L["Edit Unit Measure"], parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is UnidadMedidaDialogModel model)
        {
            var updateDto = new UpdateUnidadMedidaDto
            {
                Codigo = model.Codigo,
                Nombre = model.Nombre,
                Descripcion = model.Descripcion,
                ClaveUnidadSatId = model.ClaveUnidadSatId
            };

            var updateResult = await UnidadMedidaService.UpdateAsync(model.Id, updateDto);
            if (updateResult.IsSuccess)
            {
                Snackbar.Add(L["Unit measure updated successfully"], Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(updateResult.Error, Severity.Error);
            }
        }
    }

    private async Task OpenDeleteDialog(UnidadMedidaDto unidad)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Unit Measure Confirmation"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete unit measure:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), unidad.Nombre },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Unit Measure"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var deleteResult = await UnidadMedidaService.DeleteAsync(unidad.Id);
        if (deleteResult.IsSuccess)
        {
            Snackbar.Add(L["Unit measure deleted successfully"], Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(deleteResult.Error, Severity.Error);
        }
    }
}
