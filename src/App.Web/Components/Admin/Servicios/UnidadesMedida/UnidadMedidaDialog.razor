@using App.Core.DTOs.Fiscal
@using App.Core.Interfaces
@using App.Web.Components.Admin.Servicios.UnidadesMedida.Models
@using MudBlazor

@inject IFiscalCatalogService FiscalCatalogService
@inject IStringLocalizer<UnidadMedidaDialog> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsNew ? L["New Unit Measure"] : L["Edit Unit Measure"])
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@Model" @ref="@_form">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="Model.Codigo"
                                  Label="@L["Code"]"
                                  Required="true"
                                  RequiredError="@L["Code is required"]" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="Model.Nombre"
                                  Label="@L["Name"]"
                                  Required="true"
                                  RequiredError="@L["Name is required"]" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Descripcion"
                                  Label="@L["Description"]"
                                  Lines="2" />
                </MudItem>

                <MudItem xs="12">
                    <MudAutocomplete T="ClaveUnidadSatCatalogoDto"
                                     Label="@L["SAT Unit Code"]"
                                     HelperText="@L["SAT unit code for CFDI invoicing (c_ClaveUnidad)"]"
                                     SearchFunc="@SearchClavesUnidadSat"
                                     ToStringFunc="@(x => x == null ? string.Empty : $"{x.Nombre} ({x.Codigo})")"
                                     Value="_selectedClaveSat"
                                     ValueChanged="OnClaveSatSelected"
                                     MaxItems="null"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     MinCharacters="0"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     Immediate="true"
                                     Dense="true"
                                     AdornmentIcon="@(_selectedClaveSat == null ? Icons.Material.Filled.Search : Icons.Material.Filled.CheckCircle)"
                                     AdornmentColor="@(_selectedClaveSat == null ? Color.Default : Color.Success)"
                                     Adornment="Adornment.Start" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="da-button-rounded">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit"
                   Class="da-button-rounded" Variant="Variant.Filled">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public UnidadMedidaDialogModel Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private ClaveUnidadSatCatalogoDto? _selectedClaveSat;
    private IEnumerable<ClaveUnidadSatCatalogoDto> _initialClavesSat = Array.Empty<ClaveUnidadSatCatalogoDto>();
    private const int SatPageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        var (_, items) = await FiscalCatalogService.SearchClavesUnidadSatAsync(searchText: null, page: 1, pageSize: SatPageSize);
        _initialClavesSat = items;

        if (Model.ClaveUnidadSatId.HasValue)
        {
            _selectedClaveSat = new ClaveUnidadSatCatalogoDto
            {
                Id = Model.ClaveUnidadSatId.Value,
                Codigo = Model.ClaveUnidadSatCodigo ?? string.Empty,
                Nombre = Model.ClaveUnidadSatNombre ?? string.Empty
            };
        }
    }

    private async Task<IEnumerable<ClaveUnidadSatCatalogoDto>> SearchClavesUnidadSat(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _initialClavesSat;

        var (_, items) = await FiscalCatalogService.SearchClavesUnidadSatAsync(value, 1, SatPageSize);
        return items;
    }

    private void OnClaveSatSelected(ClaveUnidadSatCatalogoDto? value)
    {
        _selectedClaveSat = value;
        Model.ClaveUnidadSatId = value?.Id;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }
}
