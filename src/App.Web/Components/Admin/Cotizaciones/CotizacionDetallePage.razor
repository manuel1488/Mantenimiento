@page "/gestion/cotizaciones/{Id:int}"
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewCotizaciones)]

@using Microsoft.AspNetCore.Authorization
@using App.Core.Common
@using App.Core.Constants
@using App.Core.DTOs.Cotizaciones
@using App.Core.Enums.Cotizaciones
@using App.Core.Interfaces
@using App.Web.Components.Shared
@using App.Web.Components.Shared.Dialogs
@using App.Web.Components.Shared.Models
@using App.Web.Services
@using MudBlazor

@inject IStringLocalizer<CotizacionDetallePage> L
@inject ICotizacionService CotizacionService
@inject ICotizacionTemplateSettingsService TemplateSettingsService
@inject IWhatsAppShareService WhatsAppShareService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<CotizacionDetallePage> Logger
@inject NavigationManager NavigationManager

<PageTitle>@(_cotizacion is null ? L["Cotización Details"] : _cotizacion.ClienteNombre)</PageTitle>

<AuthorizeView Policy="@ApplicationClaims.Shared.ViewCotizaciones">
    <Authorized Context="pageAuth">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @if (_loading)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_cotizacion is null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Class="mb-2"
                               OnClick="@(() => NavigationManager.NavigateTo("/gestion/cotizaciones"))" />
                <MudAlert Severity="Severity.Warning">@L["Cotización not found"]</MudAlert>
            }
            else
            {
                @* ── Header card ─────────────────────────────────────────── *@
                <MudPaper Class="da-card pa-4 pa-sm-6 mb-4" Elevation="2">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                                       OnClick="@(() => NavigationManager.NavigateTo("/gestion/cotizaciones"))" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Cotizaciones"]</MudText>
                    </MudStack>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="4">
                        <div style="min-width: 0;">
                            <MudText Typo="Typo.h5" Style="font-weight: 600;">@_cotizacion.ClienteNombre</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Folio() — @_cotizacion.FechaGeneracion.ToString("dd/MM/yyyy")</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                <MudChip T="string" Size="Size.Small" Color="@EstadoColor(_cotizacion.Estado)" Variant="Variant.Filled">
                                    @EstadoLabel(_cotizacion.Estado)
                                </MudChip>
                            </MudStack>
                        </div>

                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="flex-shrink-0">
                            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary"
                                           Variant="Variant.Outlined"
                                           Href="@($"/api/cotizaciones/{Id}/pdf?inline=true")" Target="_blank"
                                           title="@L["View PDF"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Secondary"
                                           Variant="Variant.Outlined"
                                           Href="@($"/api/cotizaciones/{Id}/pdf")"
                                           title="@L["Download PDF"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Email" Color="Color.Secondary"
                                           Variant="Variant.Outlined" OnClick="OpenSendEmailDialog"
                                           title="@L["Send by Email"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Secondary"
                                           Variant="Variant.Outlined" OnClick="ShareByWhatsAppAsync" Disabled="@_sharing"
                                           title="@L["Share by WhatsApp"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Secondary"
                                           Variant="Variant.Outlined" OnClick="OpenHistorialDialog"
                                           title="@L["View History"]" />
                            @if (_cotizacion.Estado == CotizacionEstado.Pendiente)
                            {
                                <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                                    <Authorized Context="authContext">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Edit" Class="da-button-rounded"
                                                   OnClick="@(() => NavigationManager.NavigateTo($"/gestion/cotizaciones/{Id}/editar"))">
                                            @L["Edit"]
                                        </MudButton>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </MudStack>
                    </MudStack>

                    <MudDivider Class="my-3" />
                    <CamposDetalleGrid Campos="@CamposCotizacion()" />
                </MudPaper>

                @* ── Líneas ────────────────────────────────────────────────── *@
                <MudPaper Class="da-card pa-2 pa-sm-4 mb-4" Elevation="2">
                    <MudText Typo="Typo.subtitle1" Class="pa-2">@L["Lineas"]</MudText>

                    @* Desktop/tablet: regular table. Hidden below sm — a 4-column table with long
                       service names forces horizontal scroll and wrapped headers on phones. *@
                    <MudSimpleTable Dense="true" Hover="true" Class="d-none d-sm-block">
                        <thead>
                            <tr>
                                <th>@L["Service"]</th>
                                <th style="text-align: right;">@L["Quantity"]</th>
                                <th style="text-align: right;">@L["Unit Price"]</th>
                                <th style="text-align: right;">@L["Subtotal"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in _cotizacion.Lineas)
                            {
                                <tr>
                                    <td>@linea.ServicioNombre</td>
                                    <td style="text-align: right;">@linea.Cantidad.ToString("F2") @linea.UnidadMedida</td>
                                    <td style="text-align: right;">@linea.PrecioUnitario.ToString("C2")</td>
                                    <td style="text-align: right;">@linea.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @* Mobile: one stacked card per línea instead of a cramped table. *@
                    <div class="d-sm-none">
                        @foreach (var linea in _cotizacion.Lineas)
                        {
                            <MudPaper Class="pa-3 mb-2" Outlined="true">
                                <MudText Typo="Typo.subtitle2" Class="mb-1">@linea.ServicioNombre</MudText>
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Quantity"]</MudText>
                                    <MudText Typo="Typo.body2">@linea.Cantidad.ToString("F2") @linea.UnidadMedida</MudText>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Unit Price"]</MudText>
                                    <MudText Typo="Typo.body2">@linea.PrecioUnitario.ToString("C2")</MudText>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="font-weight: 600;">@L["Subtotal"]</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@linea.Subtotal.ToString("C2")</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </div>

                    <MudStack Spacing="0" Class="pa-2 mt-2" Style="align-items: flex-end;">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Subtotal"]: @_cotizacion.Subtotal.ToString("C2")</MudText>
                        @if (_cotizacion.IncluirIva)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["IVA"] (@_cotizacion.IvaTasa.ToString("F2")%): @_cotizacion.IvaMonto.ToString("C2")</MudText>
                        }
                        <MudText Typo="Typo.h6">@L["Total"]: @_cotizacion.Total.ToString("C2")</MudText>
                    </MudStack>
                </MudPaper>

                @* ── Fotos ────────────────────────────────────────────────── *@
                <MudPaper Class="da-card pa-4 pa-sm-6 mb-4" Elevation="2">
                    <CotizacionFotosSection CotizacionId="Id" ReadOnly="true" />
                </MudPaper>

                @* ── Aprobación ───────────────────────────────────────────── *@
                @if (_cotizacion.Estado == CotizacionEstado.Pendiente)
                {
                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                        <Authorized Context="authContext">
                            <MudPaper Class="da-card pa-4 mb-4" Elevation="2">
                                <MudText Typo="Typo.subtitle1" Class="mb-3">@L["Approval"]</MudText>
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_aprobadaPor" Label="@L["Approved By"]" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_medioAprobacion" Label="@L["Approval Method"]" />
                                    </MudItem>
                                </MudGrid>
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RechazarAsync" Class="da-button-rounded">
                                        @L["Reject"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AprobarAsync" Class="da-button-rounded">
                                        @L["Approve"]
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view cotizaciones."]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _sharing;
    private CotizacionDto? _cotizacion;
    private string _aprobadaPor = string.Empty;
    private string _medioAprobacion = string.Empty;
    private string? _folioPrefijo;
    private int? _folioDigitos;

    protected override async Task OnInitializedAsync()
    {
        var config = await TemplateSettingsService.GetConfigAsync();
        _folioPrefijo = config?.FolioPrefijo;
        _folioDigitos = config?.FolioDigitos;

        await LoadAsync();
    }

    private string Folio() => CotizacionFolioFormatter.Format(
        _cotizacion!.Id, _cotizacion.FolioAnio, _cotizacion.FolioNumero, _folioPrefijo, _folioDigitos);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await CotizacionService.GetByIdAsync(Id);
            _cotizacion = result.IsSuccess ? result.Value : null;
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cotización {Id}", Id);
            Snackbar.Add(L["Error loading cotización"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private List<CampoDetalle> CamposCotizacion() =>
    [
        new(Icons.Material.Filled.Business, L["Client"], _cotizacion!.ClienteNombre),
        new(Icons.Material.Filled.Event, L["Date"], _cotizacion.FechaGeneracion.ToString("dd/MM/yyyy")),
        new(Icons.Material.Filled.AttachMoney, L["Total"], _cotizacion.Total.ToString("C2"))
    ];

    private async Task AprobarAsync()
    {
        if (_cotizacion is null) return;

        if (string.IsNullOrWhiteSpace(_aprobadaPor) || string.IsNullOrWhiteSpace(_medioAprobacion))
        {
            Snackbar.Add(L["Approved By and Approval Method are required"], Severity.Warning);
            return;
        }

        var dto = new AprobarCotizacionDto { AprobadaPor = _aprobadaPor, MedioAprobacion = _medioAprobacion };
        var result = await CotizacionService.AprobarAsync(_cotizacion.Id, dto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización approved successfully"], Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task RechazarAsync()
    {
        if (_cotizacion is null) return;

        var result = await CotizacionService.RechazarAsync(_cotizacion.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización rejected successfully"], Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task OpenHistorialDialog()
    {
        var parameters = new DialogParameters<CotizacionHistorialDialog>
        {
            { x => x.CotizacionId, Id }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<CotizacionHistorialDialog>(L["History"], parameters, options);
    }

    private async Task OpenSendEmailDialog()
    {
        var parameters = new DialogParameters<SendCotizacionEmailDialog>
        {
            { x => x.DefaultEmail, _cotizacion?.ClienteCorreo }
        };

        var dialog = await DialogService.ShowAsync<SendCotizacionEmailDialog>(L["Send by Email"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not string email) return;

        var sendResult = await CotizacionService.SendCotizacionEmailAsync(Id, email);
        if (sendResult.IsSuccess)
        {
            Snackbar.Add(L["Cotización sent successfully"], Severity.Success);
        }
        else
        {
            Snackbar.Add(sendResult.Error, Severity.Error);
        }
    }

    private async Task ShareByWhatsAppAsync()
    {
        if (_cotizacion is null) return;

        _sharing = true;
        try
        {
            var pdfResult = await CotizacionService.GetCotizacionPdfAsync(Id);
            if (!pdfResult.IsSuccess)
            {
                Snackbar.Add(pdfResult.Error, Severity.Error);
                return;
            }

            var text = L["Quotation for {0} — Total: {1:C2}", _cotizacion.ClienteNombre, _cotizacion.Total].ToString();
            var shared = await WhatsAppShareService.ShareFileAsync(
                pdfResult.Value!, $"cotizacion-{Id}.pdf", "application/pdf", text);

            if (!shared)
            {
                Snackbar.Add(L["This browser can't attach the file directly — opened WhatsApp with a text message instead"], Severity.Info);
            }
        }
        finally
        {
            _sharing = false;
        }
    }

    private static Color EstadoColor(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => Color.Warning,
        CotizacionEstado.Aprobada => Color.Success,
        CotizacionEstado.Rechazada => Color.Error,
        _ => Color.Default
    };

    private string EstadoLabel(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => L["Pending"],
        CotizacionEstado.Aprobada => L["Approved"],
        CotizacionEstado.Rechazada => L["Rejected"],
        _ => estado.ToString()
    };
}
