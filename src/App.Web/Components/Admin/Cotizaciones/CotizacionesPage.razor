@page "/gestion/cotizaciones"
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewCotizaciones)]

@using Microsoft.AspNetCore.Authorization
@using App.Core.Constants
@using App.Core.DTOs.Cotizaciones
@using App.Core.DTOs.Obras
@using App.Core.Enums.Cotizaciones
@using App.Core.Common
@using App.Core.Interfaces
@using App.Web.Components.Shared.Dialogs
@using MudBlazor

@inject IStringLocalizer<CotizacionesPage> L
@inject ICotizacionService CotizacionService
@inject ICotizacionTemplateSettingsService TemplateSettingsService
@inject IObraService ObraService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<CotizacionesPage> Logger
@inject NavigationManager NavigationManager

<PageTitle>@L["Cotizaciones"]</PageTitle>

<AuthorizeView Policy="@ApplicationClaims.Shared.ViewCotizaciones">
    <Authorized Context="pageAuth">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            <MudText Typo="Typo.h4" GutterBottom="true">@L["Cotizaciones"]</MudText>

            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudTextField T="string" ValueChanged="@(s => OnSearch(s))"
                                  Placeholder="@L["Search cotizaciones"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="flex-1" />

                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                        <Authorized Context="authContext">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => NavigationManager.NavigateTo("/gestion/cotizaciones/nueva"))" Class="da-button-rounded">
                                @L["New Cotización"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>

                <MudDataGrid T="CotizacionDto" Items="@_filteredCotizaciones" Loading="_loading"
                             SortMode="SortMode.Multiple" Filterable="false"
                             Dense="true" Hover="true" RowsPerPage="10">
                    <Columns>
                        <TemplateColumn Title="@L["Folio"]" HeaderStyle="width: 150px;">
                            <CellTemplate>
                                <MudLink Href="@($"/gestion/cotizaciones/{context.Item.Id}")">@Folio(context.Item)</MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Client"]">
                            <CellTemplate>
                                @context.Item.ClienteNombre
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.FechaGeneracion" Title="@L["Date"]" Format="dd/MM/yyyy" HeaderStyle="width: 130px;" />
                        <TemplateColumn Title="@L["Total"]" HeaderStyle="text-align: right; width: 130px;" CellStyle="text-align: right;">
                            <CellTemplate>@context.Item.Total.ToString("C2")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Status"]" HeaderStyle="width: 130px;">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@EstadoColor(context.Item.Estado)" Variant="Variant.Filled">
                                    @EstadoLabel(context.Item.Estado)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false"
                                        HeaderStyle="width: 190px;" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Medium"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/gestion/cotizaciones/{context.Item.Id}"))"
                                               title="@L["View Cotización"]" />
                                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                               Size="Size.Medium"
                                               Href="@($"/api/cotizaciones/{context.Item.Id}/pdf?inline=true")"
                                               Target="_blank"
                                               title="@L["View PDF"]" />
                                @if (context.Item.Estado == CotizacionEstado.Pendiente)
                                {
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                                        <Authorized Context="authContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Medium"
                                                           OnClick="@(() => NavigationManager.NavigateTo($"/gestion/cotizaciones/{context.Item.Id}/editar"))"
                                                           title="@L["Edit Cotización"]" />
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                @if (context.Item.Estado == CotizacionEstado.Aprobada)
                                {
                                    @if (context.Item.ObraGeneradaId is int obraId)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Construction"
                                                       Size="Size.Medium"
                                                       OnClick="@(() => NavigationManager.NavigateTo($"/gestion/obras/{obraId}"))"
                                                       title="@L["View Obra"]" />
                                    }
                                    else
                                    {
                                        <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                            <Authorized Context="authContext">
                                                <MudIconButton Icon="@Icons.Material.Filled.Construction"
                                                               Size="Size.Medium"
                                                               OnClick="@(() => OpenConvertirAObraDialog(context.Item))"
                                                               title="@L["Convert to Obra"]" />
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                }
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Medium" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Href="@($"/api/cotizaciones/{context.Item.Id}/pdf")" Icon="@Icons.Material.Filled.Download">
                                        @L["Download PDF"]
                                    </MudMenuItem>
                                    @if (context.Item.Estado == CotizacionEstado.Pendiente)
                                    {
                                        <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                                            <Authorized Context="authContext">
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                                             OnClick="@(() => OpenDeleteDialog(context.Item))">
                                                    @L["Delete Cotización"]
                                                </MudMenuItem>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                </MudMenu>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText>@L["No cotizaciones found"]</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudDataGridPager T="CotizacionDto" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view cotizaciones."]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading;
    private List<CotizacionDto> _cotizaciones = new();
    private List<CotizacionDto> _filteredCotizaciones = new();
    private string _searchString = "";
    private string? _folioPrefijo;
    private int? _folioDigitos;

    protected override async Task OnInitializedAsync()
    {
        var config = await TemplateSettingsService.GetConfigAsync();
        _folioPrefijo = config?.FolioPrefijo;
        _folioDigitos = config?.FolioDigitos;

        await LoadDataAsync();
    }

    private string Folio(CotizacionDto cotizacion) => CotizacionFolioFormatter.Format(
        cotizacion.Id, cotizacion.FolioAnio, cotizacion.FolioNumero, _folioPrefijo, _folioDigitos);

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var result = await CotizacionService.GetAllAsync();
            if (result.IsSuccess)
            {
                _cotizaciones = result.Value!;
                ApplyFilter();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cotizaciones");
            Snackbar.Add(L["Error loading cotizaciones"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filteredCotizaciones = string.IsNullOrWhiteSpace(_searchString)
            ? _cotizaciones
            : _cotizaciones.Where(c => c.ClienteNombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void OnSearch(string value)
    {
        _searchString = value;
        ApplyFilter();
    }

    public static Color EstadoColor(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => Color.Warning,
        CotizacionEstado.Aprobada => Color.Success,
        CotizacionEstado.Rechazada => Color.Error,
        _ => Color.Default
    };

    private string EstadoLabel(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => L["Pending"],
        CotizacionEstado.Aprobada => L["Approved"],
        CotizacionEstado.Rechazada => L["Rejected"],
        _ => estado.ToString()
    };

    private async Task OpenConvertirAObraDialog(CotizacionDto cotizacion)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ConvertirCotizacionAObraDialog>(L["Convert to Obra"], options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not ConvertirCotizacionAObraDto dto) return;

        var convertResult = await ObraService.CreateFromCotizacionAsync(cotizacion.Id, dto);
        if (convertResult.IsSuccess)
        {
            Snackbar.Add(L["Obra created successfully"], Severity.Success);
            NavigationManager.NavigateTo($"/gestion/obras/{convertResult.Value!.Id}");
        }
        else
        {
            Snackbar.Add(convertResult.Error, Severity.Error);
        }
    }

    private async Task OpenDeleteDialog(CotizacionDto cotizacion)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Cotización Confirmation"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete this cotización:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), cotizacion.ClienteNombre },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Cotización"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var deleteResult = await CotizacionService.DeleteAsync(cotizacion.Id);
        if (deleteResult.IsSuccess)
        {
            Snackbar.Add(L["Cotización deleted successfully"], Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(deleteResult.Error, Severity.Error);
        }
    }
}
