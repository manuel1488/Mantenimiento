@using App.Core.Constants
@using App.Core.DTOs.Clientes
@using App.Core.DTOs.Cotizaciones
@using App.Core.DTOs.Servicios
@using App.Core.Enums.Cotizaciones
@using App.Core.Interfaces
@using MudBlazor

@inject IStringLocalizer<CotizacionDialog> L
@inject ICotizacionService CotizacionService
@inject IClienteService ClienteService
@inject IServicioService ServicioService
@inject ISnackbar Snackbar
@inject ILogger<CotizacionDialog> Logger
@inject NavigationManager NavigationManager

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsCreate ? L["New Cotización"] : L["Cotización"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-width: 800px;" Class="pa-0">
            @if (_loading)
            {
                <div class="d-flex justify-center pa-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (IsCreate)
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudAutocomplete T="ClienteDto"
                                         Label="@L["Client"]"
                                         Required="true"
                                         RequiredError="@L["Client is required"]"
                                         SearchFunc="@SearchClientes"
                                         ToStringFunc="@(c => c == null ? string.Empty : (c.NombreComercial ?? c.Nombre))"
                                         Value="_selectedCliente"
                                         ValueChanged="@(c => _selectedCliente = c)"
                                         MaxItems="null"
                                         CoerceText="false"
                                         ResetValueOnEmptyText="true"
                                         Clearable="true"
                                         Immediate="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         Adornment="Adornment.Start" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Add Linea"]</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="ServicioDto"
                                         Label="@L["Service"]"
                                         SearchFunc="@SearchServicios"
                                         ToStringFunc="@(s => s == null ? string.Empty : s.Nombre)"
                                         Value="_selectedServicio"
                                         ValueChanged="@(s => _selectedServicio = s)"
                                         MaxItems="null"
                                         CoerceText="false"
                                         ResetValueOnEmptyText="true"
                                         Clearable="true"
                                         Immediate="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         Adornment="Adornment.Start" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudNumericField @bind-Value="_cantidad" Label="@CantidadLabel" Format="F3" Min="0.001m" />
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="@(_selectedServicio is null || _cantidad <= 0)"
                                       OnClick="AgregarLinea" title="@L["Add"]" />
                    </MudItem>
                </MudGrid>

                <MudDataGrid T="LineaDraft" Items="@_lineas" Dense="true" Hover="true" Class="mt-3">
                    <Columns>
                        <PropertyColumn Property="x => x.ServicioNombre" Title="@L["Service"]" />
                        <TemplateColumn Title="@L["Quantity"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>@context.Item.Cantidad.ToString("F2") @context.Item.UnidadMedida</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Unit Price"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>@context.Item.PrecioUnitario.ToString("C2")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Subtotal"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <CellTemplate>@context.Item.Subtotal.ToString("C2")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => _lineas.Remove(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText>@L["No lineas added yet"]</MudText>
                    </NoRecordsContent>
                </MudDataGrid>

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                    <MudText Typo="Typo.h6">@L["Total"]: @_lineas.Sum(l => l.Subtotal).ToString("C2")</MudText>
                </MudStack>
            }
            else if (_cotizacion is not null)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@_cotizacion.ClienteNombre</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudChip T="string" Color="@EstadoColor(_cotizacion.Estado)" Variant="Variant.Filled">
                            @EstadoLabel(_cotizacion.Estado)
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary"
                                       OnClick="DescargarPdf" title="@L["Download PDF"]" />
                    </MudStack>
                </MudStack>

                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@L["Service"]</th>
                            <th style="text-align: right;">@L["Quantity"]</th>
                            <th style="text-align: right;">@L["Unit Price"]</th>
                            <th style="text-align: right;">@L["Subtotal"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in _cotizacion.Lineas)
                        {
                            <tr>
                                <td>@linea.ServicioNombre</td>
                                <td style="text-align: right;">@linea.Cantidad.ToString("F2") @linea.UnidadMedida</td>
                                <td style="text-align: right;">@linea.PrecioUnitario.ToString("C2")</td>
                                <td style="text-align: right;">@linea.Subtotal.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                    <MudText Typo="Typo.h6">@L["Total"]: @_cotizacion.Total.ToString("C2")</MudText>
                </MudStack>

                @if (_cotizacion.Estado == CotizacionEstado.Pendiente)
                {
                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                        <Authorized Context="authContext">
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Approval"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aprobadaPor" Label="@L["Approved By"]" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_medioAprobacion" Label="@L["Approval Method"]" />
                                </MudItem>
                            </MudGrid>
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RechazarAsync" Class="da-button-rounded">
                                    @L["Reject"]
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AprobarAsync" Class="da-button-rounded">
                                    @L["Approve"]
                                </MudButton>
                            </MudStack>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="da-button-rounded">@(IsCreate ? L["Cancel"] : L["Close"])</MudButton>
        @if (IsCreate)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="da-button-rounded"
                       Disabled="@(_selectedCliente is null || _lineas.Count == 0)"
                       OnClick="GuardarAsync">
                @L["Save"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? CotizacionId { get; set; }

    private bool IsCreate => CotizacionId is null;

    private bool _loading = true;
    private bool _changed;
    private CotizacionDto? _cotizacion;
    private string _aprobadaPor = string.Empty;
    private string _medioAprobacion = string.Empty;

    private List<ClienteDto> _clientes = new();
    private ClienteDto? _selectedCliente;
    private List<ServicioDto> _servicios = new();
    private ServicioDto? _selectedServicio;
    private decimal _cantidad;
    private List<LineaDraft> _lineas = new();

    private string CantidadLabel => _selectedServicio is null
        ? L["Quantity"].ToString()
        : $"{L["Quantity"]} ({_selectedServicio.UnidadMedidaNombre})";

    protected override async Task OnInitializedAsync()
    {
        if (IsCreate)
        {
            var clientesResult = await ClienteService.GetAllAsync();
            if (clientesResult.IsSuccess) _clientes = clientesResult.Value!;

            var serviciosResult = await ServicioService.GetAllAsync();
            if (serviciosResult.IsSuccess) _servicios = serviciosResult.Value!;

            _loading = false;
        }
        else
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await CotizacionService.GetByIdAsync(CotizacionId!.Value);
            if (result.IsSuccess)
            {
                _cotizacion = result.Value;
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cotización {Id}", CotizacionId);
            Snackbar.Add(L["Error loading cotización"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IEnumerable<ClienteDto>> SearchClientes(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_clientes.AsEnumerable());

        return Task.FromResult(_clientes.Where(c =>
            c.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (c.NombreComercial?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)));
    }

    private Task<IEnumerable<ServicioDto>> SearchServicios(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_servicios.AsEnumerable());

        return Task.FromResult(_servicios.Where(s => s.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void AgregarLinea()
    {
        if (_selectedServicio is null || _cantidad <= 0) return;

        var precioUnitario = _selectedServicio.PrecioUnitario;
        _lineas.Add(new LineaDraft
        {
            ServicioId = _selectedServicio.Id,
            ServicioNombre = _selectedServicio.Nombre,
            UnidadMedida = _selectedServicio.UnidadMedidaNombre,
            Cantidad = _cantidad,
            PrecioUnitario = precioUnitario,
            Subtotal = _cantidad * precioUnitario
        });

        _selectedServicio = null;
        _cantidad = 0;
    }

    private async Task GuardarAsync()
    {
        if (_selectedCliente is null || _lineas.Count == 0) return;

        var dto = new CreateCotizacionDto
        {
            ClienteId = _selectedCliente.Id,
            Lineas = _lineas.Select(l => new CreateCotizacionLineaDto
            {
                ServicioId = l.ServicioId,
                Cantidad = l.Cantidad,
                PrecioUnitarioOverride = l.PrecioUnitario
            }).ToList()
        };

        var result = await CotizacionService.CreateAsync(dto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización created successfully"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task AprobarAsync()
    {
        if (_cotizacion is null) return;

        if (string.IsNullOrWhiteSpace(_aprobadaPor) || string.IsNullOrWhiteSpace(_medioAprobacion))
        {
            Snackbar.Add(L["Approved By and Approval Method are required"], Severity.Warning);
            return;
        }

        var dto = new AprobarCotizacionDto { AprobadaPor = _aprobadaPor, MedioAprobacion = _medioAprobacion };
        var result = await CotizacionService.AprobarAsync(_cotizacion.Id, dto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización approved successfully"], Severity.Success);
            _changed = true;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task RechazarAsync()
    {
        if (_cotizacion is null) return;

        var result = await CotizacionService.RechazarAsync(_cotizacion.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización rejected successfully"], Severity.Success);
            _changed = true;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private void DescargarPdf()
    {
        if (_cotizacion is null) return;
        NavigationManager.NavigateTo($"/api/cotizaciones/{_cotizacion.Id}/pdf", forceLoad: true);
    }

    private static Color EstadoColor(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => Color.Warning,
        CotizacionEstado.Aprobada => Color.Success,
        CotizacionEstado.Rechazada => Color.Error,
        _ => Color.Default
    };

    private string EstadoLabel(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => L["Pending"],
        CotizacionEstado.Aprobada => L["Approved"],
        CotizacionEstado.Rechazada => L["Rejected"],
        _ => estado.ToString()
    };

    private void Close() => MudDialog.Close(DialogResult.Ok(_changed));

    private class LineaDraft
    {
        public int ServicioId { get; set; }
        public string ServicioNombre { get; set; } = null!;
        public string UnidadMedida { get; set; } = null!;
        public decimal Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }
}
