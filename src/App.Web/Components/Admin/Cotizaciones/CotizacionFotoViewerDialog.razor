@using MudBlazor

@inject IStringLocalizer<CotizacionFotoViewerDialog> L

<MudDialog>
    <DialogContent>
        <div class="d-flex justify-center mb-4">
            <img src="@ImageUrl" style="max-width: 100%; max-height: 60vh; border-radius: 4px;" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Descripcion))
        {
            <MudText Typo="Typo.body1">@Descripcion</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="da-button-rounded">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public string ImageUrl { get; set; } = null!;
    [Parameter] public string? Descripcion { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
