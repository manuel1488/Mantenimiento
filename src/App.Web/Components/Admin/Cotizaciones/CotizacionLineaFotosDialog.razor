@using MudBlazor

@inject IStringLocalizer<CotizacionLineaFotosDialog> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Photos"] — @ServicioNombre</MudText>
    </TitleContent>
    <DialogContent>
        <CotizacionFotosSection CotizacionLineaId="CotizacionLineaId" ReadOnly="ReadOnly" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="da-button-rounded">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int CotizacionLineaId { get; set; }
    [Parameter] public string ServicioNombre { get; set; } = string.Empty;
    [Parameter] public bool ReadOnly { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
