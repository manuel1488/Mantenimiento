@using App.Core.DTOs.Cotizaciones
@using MudBlazor

@inject IStringLocalizer<FirmarCotizacionDialog> L
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @L["Hand the device to the client so they can sign below."]
        </MudText>

        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
            @L["Signing will approve the Cotización and lock it — it can no longer be edited."]
        </MudAlert>

        <MudTextField @bind-Value="_firmanteNombre" Label="@L["Client Name"]" Required="true" MaxLength="150" />

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@L["Signature"]</MudText>
        <div style="border:1px solid var(--mud-palette-lines-default); border-radius:4px; background:#fff;">
            <canvas id="firmaCotizacionCanvas"
                    style="width:100%; height:220px; display:block; touch-action:none; cursor:crosshair;">
            </canvas>
        </div>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1">
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSignatureAsync">@L["Clear"]</MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAsync">
            @L["Sign"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? ClienteNombre { get; set; }

    private const string CanvasId = "firmaCotizacionCanvas";
    private string _firmanteNombre = string.Empty;

    protected override void OnInitialized()
    {
        _firmanteNombre = ClienteNombre ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("signaturePad.init", CanvasId);
    }

    private async Task ClearSignatureAsync() => await JS.InvokeVoidAsync("signaturePad.clear", CanvasId);

    private void Cancel() => MudDialog.Cancel();

    private async Task ConfirmAsync()
    {
        if (string.IsNullOrWhiteSpace(_firmanteNombre))
        {
            Snackbar.Add(L["Client name is required"], Severity.Warning);
            return;
        }

        var hasSignature = await JS.InvokeAsync<bool>("signaturePad.hasSignature", CanvasId);
        if (!hasSignature)
        {
            Snackbar.Add(L["Please sign before confirming"], Severity.Warning);
            return;
        }

        var dataUrl = await JS.InvokeAsync<string>("signaturePad.getData", CanvasId);
        MudDialog.Close(DialogResult.Ok(new FirmarCotizacionDto { FirmanteNombre = _firmanteNombre, SignatureDataUrl = dataUrl }));
    }
}
