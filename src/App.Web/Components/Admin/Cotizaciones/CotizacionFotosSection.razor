@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using App.Core.DTOs.Cotizaciones
@using App.Core.Interfaces
@using App.Core.Options
@using MudBlazor

@inject IStringLocalizer<CotizacionFotosSection> L
@inject ICotizacionService CotizacionService
@inject IOptions<ImageOptions> ImageOptions
@inject IOptions<CotizacionFotoOptions> CotizacionFotoOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<CotizacionFotosSection> Logger

<MudText Typo="Typo.subtitle1" Class="mb-2">
    @L["Photos"]
    @if (!ReadOnly)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display: inline;">(@_fotos.Count/@CotizacionFotoOptions.Value.MaxFotos)</MudText>
    }
</MudText>

@if (_loading)
{
    <div class="d-flex justify-center pa-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else
{
    @if (_fotos.Count == 0)
    {
        <MudText Class="mud-text-secondary" Typo="Typo.body2">@L["No photos"]</MudText>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3 mb-3">
            @foreach (var foto in _fotos)
            {
                <div style="position: relative; width: 96px; height: 96px; flex-shrink: 0;">
                    <img src="@(foto.ThumbnailPresignedUrl ?? foto.PresignedUrl)"
                         style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover; display: block; border: 1px solid var(--mud-palette-lines-default); cursor: pointer;"
                         @onclick="@(() => OpenViewer(foto))" />
                    @if (!ReadOnly)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       Class="pa-1" Style="position: absolute; top: -10px; right: -10px; background-color: var(--mud-palette-surface); box-shadow: 0 1px 3px rgba(0,0,0,.4);"
                                       OnClick="@(() => DeleteFotoAsync(foto.Id))" title="@L["Delete Photo"]" />
                    }
                    @if (!string.IsNullOrWhiteSpace(foto.Descripcion))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Color="Color.Default"
                                 Style="position: absolute; bottom: 4px; right: 4px; background-color: var(--mud-palette-surface); border-radius: 50%; padding: 2px; box-shadow: 0 1px 3px rgba(0,0,0,.4);" />
                    }
                </div>
            }
        </div>
    }

    @if (!ReadOnly)
    {
        <MudTextField @bind-Value="_nuevaDescripcion" Label="@L["Description"]"
                      Placeholder="@L["Optional caption for the next photo you upload"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                      MaxLength="3000" Class="mb-2" />
        <InputFile id="@_inputId" OnChange="UploadFotoAsync" accept="@_acceptedFileTypes" class="d-none" />
        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.CloudUpload" for="@_inputId"
                   Disabled="@(_uploading || _fotos.Count >= CotizacionFotoOptions.Value.MaxFotos)" FullWidth="true">
            @L["Upload Photo"]
        </MudButton>
    }
}

@code {
    [Parameter, EditorRequired] public int CotizacionLineaId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private readonly string _inputId = $"cotizacionFotoUpload-{Guid.NewGuid():N}";
    private bool _loading = true;
    private bool _uploading;
    private string? _nuevaDescripcion;
    private string _acceptedFileTypes => string.Join(",", ImageOptions.Value.AllowedExtensions);
    private List<CotizacionFotoDto> _fotos = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await CotizacionService.GetFotosAsync(CotizacionLineaId);
            if (result.IsSuccess)
            {
                _fotos = result.Value!;
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fotos for cotizacion linea {Id}", CotizacionLineaId);
            Snackbar.Add(L["Error loading photos"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadFotoAsync(InputFileChangeEventArgs e)
    {
        // File type/size validation is the responsibility of IImageService (App.Services/Images/ImageService.cs),
        // enforced against ImageOptions from appsettings — not duplicated here. We only cap the raw
        // read at that same configured max so a too-large file fails fast with the service's specific message
        // instead of loading the whole stream into memory first.
        try
        {
            var file = e.File;
            if (file == null) return;

            _uploading = true;

            using var stream = file.OpenReadStream(ImageOptions.Value.MaxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var data = memoryStream.ToArray();

            var uploadResult = await CotizacionService.UploadFotoAsync(
                CotizacionLineaId, data, file.ContentType, file.Name, _nuevaDescripcion);

            if (uploadResult.IsSuccess)
            {
                Snackbar.Add(L["Photo uploaded successfully"], Severity.Success);
                _nuevaDescripcion = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(uploadResult.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading foto file for cotizacion linea {Id}", CotizacionLineaId);
            Snackbar.Add(L["Error processing photo file"], Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task OpenViewer(CotizacionFotoDto foto)
    {
        if (foto.PresignedUrl is null) return;

        var parameters = new DialogParameters<CotizacionFotoViewerDialog>
        {
            { x => x.ImageUrl, foto.PresignedUrl },
            { x => x.FotoId, foto.Id },
            { x => x.Descripcion, foto.Descripcion },
            { x => x.ReadOnly, ReadOnly }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<CotizacionFotoViewerDialog>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            foto.Descripcion = result.Data as string;
    }

    private async Task DeleteFotoAsync(int fotoId)
    {
        var result = await CotizacionService.DeleteFotoAsync(fotoId);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Photo deleted successfully"], Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }
}
