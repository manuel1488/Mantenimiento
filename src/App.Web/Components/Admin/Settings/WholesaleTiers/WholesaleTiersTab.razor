@using App.Core.DTOs.Shop
@using App.Core.Interfaces.Shop
@using App.Web.Components.Shared.Dialogs

@inject IWholesaleTierService TierService
@inject IDialogService DialogService
@inject IStringLocalizer<WholesaleTiersTab> L
@inject ISnackbar Snackbar
@inject ILogger<WholesaleTiersTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudPaper Class="pa-4" Elevation="0">
            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">@L["Wholesale Tiers"]</MudText>

                    <AuthorizeView Context="authNew" Policy="@ApplicationClaims.Admin.ManageSettings">
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Add"
                                OnClick="OpenCreateDialog"
                                Class="da-button-rounded">
                            @L["New Tier"]
                        </MudButton>
                    </AuthorizeView>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                        @L["Configure the wholesale pricing tiers for bulk discounts (e.g., Medio Mayoreo, Mayoreo)."]
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudTable T="WholesaleTierDto"
                            Items="@_tiers"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading">
                        <HeaderContent>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Order"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                            <MudTh Style="width: 120px">@L["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="tier">
                            <MudTd DataLabel="@L["Name"]">@tier.Name</MudTd>
                            <MudTd DataLabel="@L["Order"]">@tier.DisplayOrder</MudTd>
                            <MudTd DataLabel="@L["Status"]">
                                <MudChip T="string"
                                        Color="@(tier.IsActive ? Color.Success : Color.Default)"
                                        Size="Size.Small">
                                    @(tier.IsActive ? L["Active"] : L["Inactive"])
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Context="authActions" Policy="@ApplicationClaims.Admin.ManageSettings">
                                    <MudIconButton Icon="@(tier.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                                Size="Size.Small"
                                                Color="@(tier.IsActive ? Color.Success : Color.Default)"
                                                OnClick="@(() => ToggleActive(tier))"
                                                title="@(tier.IsActive ? L["Deactivate"] : L["Activate"])" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                Size="Size.Small"
                                                OnClick="@(() => OpenEditDialog(tier))"
                                                title="@L["Edit"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                Size="Size.Small"
                                                Color="Color.Error"
                                                OnClick="@(() => OpenDeleteDialog(tier))"
                                                title="@L["Delete"]" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>@L["No wholesale tiers found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<WholesaleTierDto> _tiers = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadTiers();
    }

    private async Task LoadTiers()
    {
        try
        {
            _loading = true;
            var result = await TierService.GetAllTiersAsync();
            if (result.IsSuccess)
            {
                _tiers = result.Value!.ToList();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error loading wholesale tiers"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading wholesale tiers");
            Snackbar.Add(L["Error loading wholesale tiers"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<WholesaleTierDialog>();

        var dialog = await DialogService.ShowAsync<WholesaleTierDialog>(L["New Tier"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadTiers();
        }
    }

    private async Task OpenEditDialog(WholesaleTierDto tier)
    {
        var parameters = new DialogParameters<WholesaleTierDialog>
        {
            { x => x.TierId, tier.Id }
        };

        var dialog = await DialogService.ShowAsync<WholesaleTierDialog>(L["Edit Tier"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadTiers();
        }
    }

    private async Task OpenDeleteDialog(WholesaleTierDto tier)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Tier"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete this wholesale tier?"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), tier.Name },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Tier"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var deleteResult = await TierService.DeleteTierAsync(tier.Id);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add(L["Tier deleted successfully"], Severity.Success);
                    await LoadTiers();
                }
                else
                {
                    Snackbar.Add(deleteResult.Error ?? L["Error deleting tier"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting tier: {Message}", ex.Message);
                Snackbar.Add(L["Error deleting tier"], Severity.Error);
            }
        }
    }

    private async Task ToggleActive(WholesaleTierDto tier)
    {
        try
        {
            var result = await TierService.ToggleActiveAsync(tier.Id);
            if (result.IsSuccess)
            {
                var message = tier.IsActive ? L["Tier deactivated"] : L["Tier activated"];
                Snackbar.Add(message, Severity.Success);
                await LoadTiers();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error updating tier status"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling tier status");
            Snackbar.Add(L["Error updating tier status"], Severity.Error);
        }
    }
}
