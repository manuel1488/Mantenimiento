@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces.Billing
@using App.Core.Interfaces
@using App.Web.Services
@using MudBlazor

@inject IMexicoPacSettingsService PacSettingsService
@inject ISwSapienService SwSapienService
@inject IPermissionCheckService PermissionService
@inject ISnackbar Snackbar
@inject IStringLocalizer<PacSettingsTab> L
@inject ILogger<PacSettingsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewFiscalSettings">
    <Authorized Context="viewAuth">
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid Spacing="3">

                <!-- PAC Provider -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["PAC Provider (SW Sapien)"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.ProductionUrl"
                                          Label="@L["Production URL"]"
                                          MaxLength="250"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.TestUrl"
                                          Label="@L["Test URL"]"
                                          MaxLength="250"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)" />
                        </MudItem>

                        <!-- Authentication: Token or User/Password -->
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@L["Authentication"]</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Token"
                                          Label="@L["Infinite Token (recommended)"]"
                                          MaxLength="500"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)"
                                          HelperText="@L["Leave empty to use username/password instead"]"
                                          InputType="InputType.Password" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.User"
                                          Label="@L["User (optional)"]"
                                          MaxLength="100"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.Password"
                                          Label="@L["Password (optional)"]"
                                          MaxLength="200"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)"
                                          placeholder="@(string.IsNullOrEmpty(_model.Password) && _settings?.HasPassword == true ? "••••••••••••••••" : string.Empty)"
                                          HelperText="@(string.IsNullOrEmpty(_model.Password) && _settings?.HasPassword == true ? L["Password saved — enter to change"].Value : null)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="_model.IsProduction"
                                       Label="@(_model.IsProduction ? L["Production Mode"] : L["Test Mode (Sandbox)"])"
                                       Color="@(_model.IsProduction ? Color.Error : Color.Default)"
                                       Disabled="@(!_hasWriteAccess)" />
                        </MudItem>

                        @if (_hasWriteAccess)
                        {
                            <MudItem xs="12" sm="6" Class="d-flex align-center">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           OnClick="TestConnection"
                                           Disabled="@_testingConnection"
                                           StartIcon="@Icons.Material.Filled.NetworkCheck">
                                    @if (_testingConnection)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        @L["Testing..."]
                                    }
                                    else
                                    {
                                        @L["Test Connection"]
                                    }
                                </MudButton>
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>


                <!-- Status badge -->
                @if (_settings != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="@(_settings.IsConfigured ? Severity.Success : Severity.Warning)">
                            @if (_settings.IsConfigured)
                            {
                                @L["PAC billing is fully configured and ready to use."]
                            }
                            else
                            {
                                @L["PAC billing is not fully configured. Please fill all required fields."]
                            }
                        </MudAlert>
                    </MudItem>
                }

                <!-- Save Button -->
                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageFiscalSettings" Context="manageAuth">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SaveAsync"
                                   Disabled="@(_processing)"
                                   Class="da-button-rounded">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@L["Saving"]</MudText>
                            }
                            else
                            {
                                @L["Save Changes"]
                            }
                        </MudButton>
                    </MudItem>
                </AuthorizeView>
            </MudGrid>
        </MudForm>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">@L["You don't have permission to view this page"]</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private bool _testingConnection;
    private bool _hasWriteAccess;

    private MexicoPacSettingsDto? _settings;
    private UpdateMexicoPacSettingsDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageFiscalSettings);
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _settings = await PacSettingsService.GetAsync();
            if (_settings != null)
            {
                _model = new UpdateMexicoPacSettingsDto
                {
                    ProviderName = _settings.ProviderName,
                    User = _settings.User,
                    ProductionUrl = _settings.ProductionUrl,
                    TestUrl = _settings.TestUrl,
                    IsProduction = _settings.IsProduction
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading PAC settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private async Task TestConnection()
    {
        _testingConnection = true;
        StateHasChanged();
        try
        {
            var result = await SwSapienService.TestConnectionAsync();
            if (result.IsSuccess)
                Snackbar.Add(L["Connection successful"], Severity.Success);
            else
                Snackbar.Add(result.Error, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error testing PAC connection");
            Snackbar.Add(L["Connection test failed"], Severity.Error);
        }
        finally
        {
            _testingConnection = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        _processing = true;
        StateHasChanged();
        try
        {
            var result = await PacSettingsService.SaveAsync(_model);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Settings saved successfully"], Severity.Success);
                await LoadSettings();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving PAC settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
}
