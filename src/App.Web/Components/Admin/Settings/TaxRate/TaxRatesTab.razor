@using System.Globalization
@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Core.Options
@using App.Services.Settings
@using App.Shared.Services
@using App.Web.Components.Shared.Dialogs

@inject ITaxRateService TaxRateService
@inject ILookupService LookupService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IDateTime DateTimeService
@inject ICompanySettingsService CompanySettingsService
@inject CultureOptions CultureOptions
@inject IStringLocalizer<TaxRatesTab> L
@inject ILogger<TaxRatesTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewTaxRates">
    <Authorized>
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">@L["Tax Rates"]</MudText>

                <div class="d-flex gap-4">
                    <!-- Country Filter -->
                    <MudSelect T="string" 
                            Value="@_selectedCountry"
                            ValueChanged="@OnCountryChanged"
                            Label="@L["Country"]"
                            AnchorOrigin="Origin.BottomCenter"
                            Style="min-width: 200px;">
                        @foreach(var country in _countries)
                        {
                            <MudSelectItem Value="@country.Code">@country.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <AuthorizeView Context="contextNew" Policy="@ApplicationClaims.Admin.ManageTaxRates">
                        <!-- New Tax Rate Button -->
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Add"
                                OnClick="OpenCreateDialog"
                                Class="da-button-rounded">
                            @L["New Tax Rate"]
                        </MudButton>
                    </AuthorizeView>                    
                </div>
            </MudItem>

            <MudItem xs="12">
                @if (!string.IsNullOrEmpty(_selectedCountry))
                {
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.subtitle1" Class="mb-4">@L["Active Tax Rates"]</MudText>
                        <MudTable Items="@_activeTaxRates" 
                                Dense="true" 
                                Hover="true" 
                                Loading="@_loading">
                            <HeaderContent>
                                <MudTh>@L["Name"]</MudTh>
                                <MudTh>@L["Code"]</MudTh>
                                <MudTh>@L["Rate"]</MudTh>
                                <MudTh>@L["Province"]</MudTh>
                                <MudTh>@L["Type"]</MudTh>
                                <MudTh>@L["Effective From"]</MudTh>
                                <MudTh>@L["Effective To"]</MudTh>
                                <MudTh>@L["Default"]</MudTh>
                                <MudTh>@L["Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="contextRate">
                                <MudTd DataLabel="@L["Name"]">@contextRate.Name</MudTd>
                                <MudTd DataLabel="@L["Code"]">@contextRate.Code</MudTd>
                                <MudTd DataLabel="@L["Rate"]">@FormatPercentage(contextRate.Rate)</MudTd>
                                <MudTd DataLabel="@L["Province"]">@(contextRate.ProvinceCode ?? "-")</MudTd>
                                <MudTd DataLabel="@L["Type"]">@(contextRate.Type ?? "-")</MudTd>
                                <MudTd DataLabel="@L["Effective From"]">@FormatDate(contextRate.EffectiveFrom)</MudTd>
                                <MudTd DataLabel="@L["Effective To"]">
                                    @(contextRate.EffectiveTo.HasValue ? FormatDate(contextRate.EffectiveTo.Value) : "-")
                                </MudTd>
                                <MudTd DataLabel="@L["Default"]">
                                    <MudIcon Icon="@(contextRate.IsDefault ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                        Color="@(contextRate.IsDefault ? Color.Success : Color.Error)" />
                                </MudTd>
                                <MudTd>
                                    <AuthorizeView Context="contextEdit" Policy="@ApplicationClaims.Admin.ManageTaxRates">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                    Size="Size.Small"
                                                    OnClick="@(() => OpenEditDialog(contextRate))"
                                                    title="@L["Edit Tax Rate"]" />
                                    </AuthorizeView>
                                    <AuthorizeView Context="contextDelete" Policy="@ApplicationClaims.Admin.DeleteTaxRates">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                    Size="Size.Small"
                                                    Color="Color.Error"
                                                    OnClick="@(() => OpenDeleteDialog(contextRate))"
                                                    title="@L["Delete Tax Rate"]" />
                                    </AuthorizeView>                            
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText>@L["No active tax rates found"]</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>

                    <MudDivider Class="my-6" />

                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.subtitle1" Class="mb-4">@L["Historical Tax Rates"]</MudText>
                        <div class="d-flex gap-4 mb-4">
                            <MudDateRangePicker DateRange="_dateRange"
                                            Label="@L["Date Range"]"
                                            AdornmentColor="Color.Primary"
                                            Culture="@CultureInfo.CurrentUICulture"
                                            DateFormat="@GetLocalizedDateFormat()"
                                            Style="min-width: 300px;"
                                            DateRangeChanged="@OnDateRangeChanged" />
                        </div>

                        <MudTable Items="@_historicalTaxRates" 
                                Dense="true" 
                                Hover="true" 
                                Loading="@_loading">
                            <HeaderContent>
                                <MudTh>@L["Name"]</MudTh>
                                <MudTh>@L["Code"]</MudTh>
                                <MudTh>@L["Rate"]</MudTh>
                                <MudTh>@L["Province"]</MudTh>
                                <MudTh>@L["Type"]</MudTh>
                                <MudTh>@L["Effective From"]</MudTh>
                                <MudTh>@L["Effective To"]</MudTh>
                                <MudTh>@L["Default"]</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="contxtHistory">
                                <MudTd DataLabel="@L["Name"]">@contxtHistory.Name</MudTd>
                                <MudTd DataLabel="@L["Code"]">@contxtHistory.Code</MudTd>
                                <MudTd DataLabel="@L["Rate"]">@FormatPercentage(contxtHistory.Rate)</MudTd>
                                <MudTd DataLabel="@L["Province"]">@(contxtHistory.ProvinceCode ?? "-")</MudTd>
                                <MudTd DataLabel="@L["Type"]">@(contxtHistory.Type ?? "-")</MudTd>
                                <MudTd DataLabel="@L["Effective From"]">@FormatDate(contxtHistory.EffectiveFrom)</MudTd>
                                <MudTd DataLabel="@L["Effective To"]">
                                    @(contxtHistory.EffectiveTo.HasValue ? FormatDate(contxtHistory.EffectiveTo.Value) : "-")
                                </MudTd>
                                <MudTd DataLabel="@L["Default"]">
                                    <MudIcon Icon="@(contxtHistory.IsDefault ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                        Color="@(contxtHistory.IsDefault ? Color.Success : Color.Error)" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText>@L["No historical tax rates found"]</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">@L["Please select a country to view tax rates"]</MudAlert>
                }
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private bool _loading;
    private string _selectedCountry = "";
    private List<CountryDto> _countries = new();
    private List<TaxRateDto> _activeTaxRates = new();
    private List<TaxRateDto> _historicalTaxRates = new();
    private DateRange? _dateRange;
    private TimeZoneInfo _currentTimeZone = TimeZoneInfo.Utc;
    private CompanySettingsDto? _companySettings;

    protected override async Task OnInitializedAsync()
    {
        await InitializeCompanySettings();
        await LoadCountries();
        InitializeDateRange();
        await SelectCompanyCountry();
    }

    private async Task InitializeCompanySettings()
    {
        try
        {
            _companySettings = await CompanySettingsService.GetSettingsAsync();
            if (_companySettings != null)
            {
                // Set time zone from company settings
                var timeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
                if (timeZone != null)
                {
                    _currentTimeZone = timeZone;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing company settings");
            Snackbar.Add(L["Error loading company settings"], Severity.Error);
        }
    }

    private async Task SelectCompanyCountry()
    {
        if (_companySettings != null && !string.IsNullOrEmpty(_companySettings.CountryCode))
        {
            _selectedCountry = _companySettings.CountryCode;
            await LoadTaxRates();
        }
    }

    private void InitializeDateRange()
    {
        var now = DateTimeService.Now;
        var utcStart = now.AddYears(-1);
        var utcEnd = now;

        // Convert UTC dates to local time zone for display
        var localStart = TimeZoneInfo.ConvertTimeFromUtc(utcStart, _currentTimeZone);
        var localEnd = TimeZoneInfo.ConvertTimeFromUtc(utcEnd, _currentTimeZone);

        _dateRange = new DateRange(localStart, localEnd);
    }

    private string GetLocalizedDateFormat() => 
        CultureInfo.CurrentUICulture.DateTimeFormat.ShortDatePattern;

    private string FormatDate(DateTime utcDate)
    {
        var localDate = TimeZoneInfo.ConvertTimeFromUtc(utcDate, _currentTimeZone);
        return localDate.ToString(GetLocalizedDateFormat(), CultureInfo.CurrentUICulture);
    }

    private string FormatPercentage(decimal value)
    {
        // value is stored as fraction (0.16); P2 format multiplies by 100 and adds %
        return value.ToString("P2", CultureInfo.CurrentUICulture);
    }

    private async Task LoadCountries()
    {
        try
        {
            var countries = await LookupService.GetCountriesAsync();
            _countries = countries.ToList();

            if (_countries.Any() && string.IsNullOrEmpty(_selectedCountry))
            {
                _selectedCountry = _countries[0].Code;
                await LoadTaxRates();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading countries");
            Snackbar.Add(L["Error loading countries"], Severity.Error);
        }
    }

    private async Task LoadTaxRates()
    {
        if (string.IsNullOrEmpty(_selectedCountry)) return;

        try
        {
            _loading = true;
            StateHasChanged();

            // Load active rates
            _activeTaxRates = (await TaxRateService.GetActiveRatesAsync(_selectedCountry)).ToList();

            // Convert date range to UTC for API call
            if (_dateRange != null && _dateRange.Start.HasValue && _dateRange.End.HasValue)
            {
                var utcStart = TimeZoneInfo.ConvertTimeToUtc(_dateRange.Start.Value, _currentTimeZone);
                var utcEnd = TimeZoneInfo.ConvertTimeToUtc(_dateRange.End.Value, _currentTimeZone);

                _historicalTaxRates = (await TaxRateService.GetHistoricalRatesAsync(
                    _selectedCountry,
                    utcStart,
                    utcEnd)).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tax rates for country {CountryCode}", _selectedCountry);
            Snackbar.Add(L["Error loading tax rates"], Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnCountryChanged(string newCountry)
    {
        if (_selectedCountry != newCountry)
        {
            _selectedCountry = newCountry;
            await LoadTaxRates();
        }
    }

    private async Task OnDateRangeChanged(DateRange? dateRange)
    {
        if (_dateRange != null && (dateRange?.Start != _dateRange.Start || dateRange?.End != _dateRange.End))
        {
            _dateRange = dateRange ?? new DateRange(DateTime.Today.AddYears(-1), DateTime.Today);
            await LoadTaxRates();
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<TaxRateDialog>
        {
            { x => x.CountryCode, _selectedCountry }
        };

        var dialog = await DialogService.ShowAsync<TaxRateDialog>(
            L["New Tax Rate"], parameters);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadTaxRates();
        }
    }

    private async Task OpenEditDialog(TaxRateDto rate)
    {
        var parameters = new DialogParameters<TaxRateDialog>
        {
            { x => x.TaxRateId, rate.Id }
        };

        var dialog = await DialogService.ShowAsync<TaxRateDialog>(
            L["Edit Tax Rate"], parameters);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            await LoadTaxRates();
        }
    }

    private async Task OpenDeleteDialog(TaxRateDto rate)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Tax Rate"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete tax rate:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), rate.Name },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["Delete Tax Rate"], parameters);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            try
            {
                var success = await TaxRateService.DeleteRateAsync(rate.Id);
                if (success)
                {
                    Snackbar.Add(L["Tax rate deleted successfully"], Severity.Success);
                    await LoadTaxRates();
                }
                else
                {
                    Snackbar.Add(L["Error deleting tax rate"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting tax rate {Id}", rate.Id);
                Snackbar.Add(L["Error deleting tax rate"], Severity.Error);
            }
        }
    }

    public void DisposeAsync()
    {
        // Clean up any resources if needed
        GC.SuppressFinalize(this);
    }
}