@using System.Globalization
@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Core.Options
@using App.Services.Settings
@using App.Shared.Services

@inject ITaxRateService TaxRateService
@inject ICompanySettingsService CompanySettingsService
@inject IDateTime DateTimeService
@inject CultureOptions CultureOptions
@inject IStringLocalizer<TaxRateDialog> L
@inject ISnackbar Snackbar
@inject ILogger<TaxRateDialog> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ManageTaxRates">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 800px;" Class="pa-4">
                    <MudForm Model="@_model" @ref="@_form">
                        <MudGrid>
                            <!-- Name -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Name"
                                            Label="@L["Name"]"
                                            Required="true"
                                            RequiredError="@L["Name is required"]" />
                            </MudItem>

                            <!-- Code (only for new records) -->
                            @if (IsNew)
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_model.Code"
                                                Label="@L["Code"]"
                                                Required="true"
                                                RequiredError="@L["Code is required"]" />
                                </MudItem>
                            }

                            <!-- Rate -->
                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_ratePercent"
                                            Label="@L["Rate (%)"]"
                                            Required="true"
                                            RequiredError="@L["Rate is required"]"
                                            Min="0"
                                            Max="100"
                                            Format="N2"
                                            Culture="@CultureInfo.CurrentUICulture"
                                            AdornmentText="%"
                                            Adornment="Adornment.End" />
                            </MudItem>

                            <!-- Province (optional) -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.ProvinceCode"
                                            Label="@L["Province Code"]"
                                            MaxLength="2" />
                            </MudItem>

                            <!-- Type (optional) -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Type"
                                            Label="@L["Type"]"
                                            MaxLength="20" />
                            </MudItem>

                            <!-- Effective From -->
                            <MudItem xs="12" md="6">
                                <MudDatePicker Date="_effectiveFromLocal"
                                            Label="@L["Effective From"]"
                                            Required="true"
                                            Culture="@CultureInfo.CurrentUICulture"
                                            DateFormat="@GetLocalizedDateFormat()"
                                            RequiredError="@L["Effective from date is required"]"
                                            DateChanged="@OnEffectiveFromChanged" />
                            </MudItem>

                            <!-- Effective To (optional) -->
                            <MudItem xs="12" md="6">
                                <MudDatePicker Date="_effectiveToLocal"
                                            Label="@L["Effective To"]"
                                            Culture="@CultureInfo.CurrentUICulture"
                                            DateFormat="@GetLocalizedDateFormat()"
                                            MinDate="@(_effectiveFromLocal?.AddDays(1))"
                                            DateChanged="@OnEffectiveToChanged" />
                            </MudItem>

                            <!-- Default Rate -->
                            <MudItem xs="12">
                                <MudCheckBox @bind-Value="_model.IsDefault"
                                        Label="@L["Set as Default Rate"]"
                                        Color="Color.Primary" />
                            </MudItem>

                            <!-- Active (only for editing) -->
                            @if (!IsNew)
                            {
                                <MudItem xs="12">
                                    <MudCheckBox @bind-Value="_model.IsActive"
                                            Label="@L["Active"]"
                                            Color="Color.Primary" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudForm>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel" 
                        Class="da-button-rounded" 
                        title="@L["Cancel editing"]">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary"
                        OnClick="Submit"
                        Variant="Variant.Filled"
                        Disabled="@(_processing || !_isValid)"
                        Class="da-button-rounded"
                        title="@L["Save tax rate"]">
                    @if(_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@L["Saving"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? TaxRateId { get; set; }
    [Parameter] public string CountryCode { get; set; } = null!;

    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private TaxRateDto? _taxRate;
    private TimeZoneInfo _currentTimeZone = TimeZoneInfo.Utc;
    private bool IsNew => !TaxRateId.HasValue;

    // Local date representations for UI
    private DateTime? _effectiveFromLocal;
    private DateTime? _effectiveToLocal;

    // UI percentage (0-100); converted to/from fraction (0-1) at save/load boundary
    private decimal _ratePercent;

    private CreateTaxRateDto _model = new()
    {
        Rate = 0,
        IsActive = true,
        IsDefault = true
    };

    protected override async Task OnInitializedAsync()
    {
        await InitializeTimeZone();

        if (IsNew)
        {
            _model.CountryCode = CountryCode;
            _effectiveFromLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTimeService.Now, _currentTimeZone);
            _model.EffectiveFrom = DateTimeService.Now;
        }
        else
        {
            await LoadTaxRate();
        }
    }

    private async Task InitializeTimeZone()
    {
        try
        {
            var timeZone = await CompanySettingsService.GetCurrentTimeZoneAsync();
            if (timeZone != null)
            {
                _currentTimeZone = timeZone;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing time zone");
        }
    }

    private string GetLocalizedDateFormat() => 
        CultureInfo.CurrentUICulture.DateTimeFormat.ShortDatePattern;

    private async Task LoadTaxRate()
    {
        try
        {
            _taxRate = await TaxRateService.GetByIdAsync(TaxRateId!.Value);
            if (_taxRate != null)
            {
                _model = new CreateTaxRateDto
                {
                    CountryCode = _taxRate.CountryCode,
                    Name = _taxRate.Name,
                    Code = _taxRate.Code,
                    Rate = _taxRate.Rate,
                    EffectiveFrom = _taxRate.EffectiveFrom,
                    EffectiveTo = _taxRate.EffectiveTo,
                    IsDefault = _taxRate.IsDefault,
                    ProvinceCode = _taxRate.ProvinceCode,
                    Type = _taxRate.Type,
                    IsActive = _taxRate.IsActive
                };

                // Convert fraction rate to percentage for UI display
                _ratePercent = _taxRate.Rate * 100;

                // Convert UTC dates to local for display
                _effectiveFromLocal = TimeZoneInfo.ConvertTimeFromUtc(_taxRate.EffectiveFrom, _currentTimeZone);
                _effectiveToLocal = _taxRate.EffectiveTo.HasValue 
                    ? TimeZoneInfo.ConvertTimeFromUtc(_taxRate.EffectiveTo.Value, _currentTimeZone)
                    : null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tax rate");
            Snackbar.Add(L["Error loading tax rate"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private void OnEffectiveFromChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            _effectiveFromLocal = date.Value;
            // Convert local date to UTC for storage
            _model.EffectiveFrom = TimeZoneInfo.ConvertTimeToUtc(date.Value, _currentTimeZone);
        }
    }

    private void OnEffectiveToChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            _effectiveToLocal = date.Value;
            // Convert local date to UTC for storage
            _model.EffectiveTo = TimeZoneInfo.ConvertTimeToUtc(date.Value, _currentTimeZone);
        }
        else
        {
            _effectiveToLocal = null;
            _model.EffectiveTo = null;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                // Convert UI percentage back to fraction for storage
                _model.Rate = _ratePercent / 100;

                if (TaxRateId.HasValue)
                {
                    var updateDto = new UpdateTaxRateDto
                    {
                        Name = _model.Name,
                        Rate = _model.Rate,
                        EffectiveTo = _model.EffectiveTo,
                        IsDefault = _model.IsDefault,
                        IsActive = _model.IsActive
                    };

                    await TaxRateService.UpdateRateAsync(TaxRateId.Value, updateDto);
                    Snackbar.Add(L["Tax rate updated successfully"], Severity.Success);
                }
                else
                {
                    await TaxRateService.CreateRateAsync(_model);
                    Snackbar.Add(L["Tax rate created successfully"], Severity.Success);
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving tax rate");
                Snackbar.Add(L["Error saving tax rate"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }

    public void DisposeAsync()
    {
        // Clean up any resources if needed
        GC.SuppressFinalize(this);
    }
}