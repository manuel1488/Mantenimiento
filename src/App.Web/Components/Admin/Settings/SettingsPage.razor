@page "/admin/settings"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using App.Web.Components.Admin.Settings.General
@using App.Web.Components.Admin.Settings.Email
@using App.Web.Components.Admin.Settings.Minio
@using App.Web.Components.Admin.Settings.Cotizacion

@inject IStringLocalizer<SettingsPage> L
@attribute [Authorize(Policy = ApplicationClaims.Admin.ViewSettings)]

<PageTitle>@L["Settings"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudCard Elevation="0">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">@L["Company Settings"]</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="pt-0">
            <MudTabs Elevation="0"
                     Color="Color.Primary"
                     ApplyEffectsToContainer="true"
                     PanelClass="pt-6">
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
                    <MudTabPanel Text="@L["General"]" Icon="@Icons.Material.Filled.Settings">
                        <GeneralSettingsTab />
                    </MudTabPanel>
                </AuthorizeView>
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewEmailSettings">
                    <MudTabPanel Text="@L["Email"]" Icon="@Icons.Material.Filled.Email">
                        <EmailSettingsTab />
                    </MudTabPanel>
                </AuthorizeView>
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
                    <MudTabPanel Text="@L["Photo Storage"]" Icon="@Icons.Material.Filled.CloudUpload">
                        <MinioSettingsTab />
                    </MudTabPanel>
                </AuthorizeView>
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
                    <MudTabPanel Text="@L["Cotización"]" Icon="@Icons.Material.Filled.RequestQuote">
                        <CotizacionSettingsTab />
                    </MudTabPanel>
                </AuthorizeView>
            </MudTabs>
        </MudCardContent>
    </MudCard>
</MudContainer>
