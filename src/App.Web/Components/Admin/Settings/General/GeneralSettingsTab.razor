@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Core.Constants
@using App.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ICompanySettingsService CompanySettingsService
@inject IPermissionCheckService PermissionService
@inject IStringLocalizer<GeneralSettingsTab> L
@inject ISnackbar Snackbar
@inject ILogger<GeneralSettingsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudForm Model="@_model" @ref="@_form">
            <MudGrid>
                <!-- Company Information section -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-4">@L["Company Information"]</MudText>
                    <MudGrid>
                        <!-- Company Name -->
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CompanyName"
                                        Label="@L["Company Name"]"
                                        Required="@_hasWriteAccess"
                                        RequiredError="@L["Company name is required"]"
                                        ReadOnly="@(!_hasWriteAccess)" />
                        </MudItem>

                        <!-- Time Zone -->
                        <MudItem xs="12" md="6">
                            @if (_hasWriteAccess)
                            {
                                <MudAutocomplete T="string"
                                            Label="@L["Time Zone"]"
                                            @bind-Value="_model.TimeZoneId"
                                            SearchFunc="@SearchTimeZones"
                                            Required="true"
                                            RequiredError="@L["Time zone is required"]"
                                            ToStringFunc="@((string t) => GetTimeZoneDisplayName(t))"
                                            AdornmentIcon="@Icons.Material.Filled.Schedule"
                                            AdornmentColor="Color.Secondary" />
                            }
                            else
                            {
                                <MudTextField Value="@GetTimeZoneDisplayName(_model.TimeZoneId)"
                                            Label="@L["Time Zone"]"
                                            ReadOnly="true" />
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <!-- Brand Logo -->
                <MudItem xs="12">
                    <MudDivider Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-3">@L["Brand Logo"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block;">
                        @L["Shown in the navigation menu, login screen, and generated documents."]
                    </MudText>

                    @if (!string.IsNullOrEmpty(_model.LogoBase64))
                    {
                        <div class="d-flex justify-center mb-4">
                            <img src="data:image/png;base64,@_model.LogoBase64"
                                 style="max-width: 240px; max-height: 120px;" />
                        </div>
                    }

                    @if (_hasWriteAccess)
                    {
                        <div class="d-flex align-center gap-3">
                            <InputFile id="brandLogoInput" OnChange="@HandleLogoSelected" accept="image/*" class="d-none" />

                            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload" for="brandLogoInput">
                                @L["Upload Logo"]
                            </MudButton>

                            @if (!string.IsNullOrEmpty(_model.LogoBase64))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                           OnClick="@(() => _model.LogoBase64 = null)">
                                    @L["Remove Logo"]
                                </MudButton>
                            }
                        </div>
                    }
                </MudItem>

                <!-- Action buttons -->
                <MudItem xs="12" Class="d-flex justify-end">
                    @if (_hasWriteAccess)
                    {
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                OnClick="SaveChangesAsync"
                                Disabled="@(_processing || !_isValid)"
                                Class="da-button-rounded">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@L["Saving"]</MudText>
                            }
                            else
                            {
                                @L["Save Changes"]
                            }
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>

    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool _hasWriteAccess;
    private List<TimeZoneInfo> _timeZones = new();
    private UpdateCompanySettingsDto _model = new();
    private CompanySettingsDto? _settings;

    protected override async Task OnInitializedAsync()
    {
        // Check permissions
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageSettings);

        // Load available time zones — merge Windows IDs and IANA equivalents so that
        // IANA IDs (e.g. "America/Mexico_City") are selectable regardless of platform.
        _timeZones = BuildTimeZoneList();

        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _settings = await CompanySettingsService.GetSettingsAsync();
            if (_settings != null)
            {
                _model = new UpdateCompanySettingsDto
                {
                    CompanyName = _settings.CompanyName,
                    TimeZoneId = _settings.TimeZoneId,
                    LogoBase64 = _settings.LogoBase64
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading company settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private static List<TimeZoneInfo> BuildTimeZoneList()
    {
        var zones = TimeZoneInfo.GetSystemTimeZones().ToList();

        // On Windows the list only contains Windows timezone IDs.
        // Add IANA equivalents so the user can store IANA IDs (required for Linux/Docker).
        if (OperatingSystem.IsWindows())
        {
            var existing = new HashSet<string>(zones.Select(z => z.Id), StringComparer.OrdinalIgnoreCase);
            var extras = new List<TimeZoneInfo>();

            foreach (var wz in zones.ToList())
            {
                if (TimeZoneInfo.TryConvertWindowsIdToIanaId(wz.Id, out var ianaId)
                    && !existing.Contains(ianaId))
                {
                    try
                    {
                        extras.Add(TimeZoneInfo.FindSystemTimeZoneById(ianaId));
                        existing.Add(ianaId);
                    }
                    catch { /* IANA timezone not available on this system */ }
                }
            }

            zones.AddRange(extras);
            zones = zones.OrderBy(z => z.BaseUtcOffset).ThenBy(z => z.DisplayName).ToList();
        }

        return zones;
    }

    private async Task<IEnumerable<string>> SearchTimeZones(string value, CancellationToken cancellationToken)
    {
        return await Task.Run(() =>
        {
            if (string.IsNullOrEmpty(value))
                return _timeZones.Select(tz => tz.Id);

            return _timeZones
                .Where(tz => tz.DisplayName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                            tz.Id.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Select(tz => tz.Id)
                .ToList();

        }, cancellationToken);
    }

    private string GetTimeZoneDisplayName(string timeZoneId)
    {
        var timeZone = _timeZones.FirstOrDefault(tz => tz.Id == timeZoneId);
        if (timeZone == null)
            return timeZoneId;

        var offset = timeZone.BaseUtcOffset;
        var offsetStr = $"UTC{(offset >= TimeSpan.Zero ? "+" : "-")}{Math.Abs(offset.Hours):D2}:{Math.Abs(offset.Minutes):D2}";
        return $"{timeZone.DisplayName} ({offsetStr})";
    }

    private async Task HandleLogoSelected(InputFileChangeEventArgs e)
    {
        if (!_hasWriteAccess) return;

        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 1024 * 1024) // 1MB
            {
                Snackbar.Add(L["Logo file is too large (max 1MB)"], Severity.Warning);
                return;
            }

            if (!file.ContentType.StartsWith("image/"))
            {
                Snackbar.Add(L["Only image files are allowed"], Severity.Warning);
                return;
            }

            using var stream = file.OpenReadStream(1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            _model.LogoBase64 = Convert.ToBase64String(memoryStream.ToArray());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing brand logo upload");
            Snackbar.Add(L["Error processing logo file"], Severity.Error);
        }
    }

    private async Task SaveChangesAsync()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                await CompanySettingsService.UpdateSettingsAsync(_model);
                Snackbar.Add(L["Settings updated successfully"], Severity.Success);
                await LoadSettings(); // Reload settings
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving company settings");
                Snackbar.Add(L["Error saving settings"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }
}
