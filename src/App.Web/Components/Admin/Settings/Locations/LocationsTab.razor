@using App.Core.DTOs.Location
@using App.Core.Interfaces
@using App.Core.Enums.Shop
@using App.Web.Components.Shared.Dialogs

@inject ILocationService LocationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<LocationsTab> L
@inject ILogger<LocationsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewBranchSettings">
    <Authorized>
        <MudPaper Class="pa-4" Elevation="0">
            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">@L["Locations"]</MudText>

                    <div class="d-flex gap-4">
                        <MudSelect T="LocationType?"
                                  @bind-Value="_filterType"
                                  Label="@L["Type"]"
                                  Style="width: 150px"
                                  Dense="true"
                                  Clearable="true">
                            <MudSelectItem T="LocationType?" Value="@null">@L["All"]</MudSelectItem>
                            <MudSelectItem T="LocationType?" Value="@LocationType.Branch">@L["Branch"]</MudSelectItem>
                            <MudSelectItem T="LocationType?" Value="@LocationType.Warehouse">@L["Warehouse"]</MudSelectItem>
                        </MudSelect>

                        <MudTextField T="string"
                                    ValueChanged="@(s => OnSearch(s))"
                                    Placeholder="@L["Search locations"]"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Search"
                                    Style="width: 300px" />

                        <AuthorizeView Context="authNew" Policy="@ApplicationClaims.Admin.ManageBranchSettings">
                            <MudButton Variant="Variant.Filled"
                                    Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.Add"
                                    OnClick="OpenCreateDialog"
                                    Class="da-button-rounded">
                                @L["New Location"]
                            </MudButton>
                        </AuthorizeView>
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <MudTable T="LocationDto"
                            ServerData="@LoadServerData"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading"
                            @ref="_table">
                        <HeaderContent>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Type"]</MudTh>
                            <MudTh>@L["Address"]</MudTh>
                            <MudTh>@L["Phone"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                            <MudTh Style="width: 100px">@L["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="locationContext">
                            <MudTd DataLabel="@L["Name"]">@locationContext.Name</MudTd>
                            <MudTd DataLabel="@L["Type"]">
                                <MudChip T="string" Size="Size.Small"
                                        Color="@(locationContext.Type == LocationType.Branch ? Color.Primary : Color.Secondary)">
                                    @L[locationContext.TypeName]
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Address"]">@(locationContext.Address ?? "-")</MudTd>
                            <MudTd DataLabel="@L["Phone"]">@(locationContext.Phone ?? "-")</MudTd>
                            <MudTd DataLabel="@L["Status"]">
                                <MudChip T="bool" Size="Size.Small"
                                        Color="@(locationContext.IsActive ? Color.Success : Color.Error)">
                                    @(locationContext.IsActive ? L["Active"] : L["Inactive"])
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Context="authActions" Policy="@ApplicationClaims.Admin.ManageBranchSettings">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                Size="Size.Small"
                                                OnClick="@(() => OpenEditDialog(locationContext))"
                                                title="@L["Edit Location"]" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                Size="Size.Small"
                                                Color="Color.Error"
                                                title="@L["Delete Location"]"
                                                OnClick="@(() => OpenDeleteDialog(locationContext))" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                        <NoRecordsContent>
                            <MudText>@L["No locations found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudTable<LocationDto> _table = null!;
    private bool _loading;
    private string _searchString = "";
    private LocationType? _filterType;

    private async Task<TableData<LocationDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            var (totalCount, items) = await LocationService.GetLocationsAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString,
                type: _filterType);

            return new TableData<LocationDto>()
            {
                TotalItems = totalCount,
                Items = items
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading locations");
            Snackbar.Add(L["Error loading locations"], Severity.Error);
            return new TableData<LocationDto>() { TotalItems = 0, Items = Enumerable.Empty<LocationDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<LocationDialog>(L["New Location"]);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenEditDialog(LocationDto location)
    {
        var parameters = new DialogParameters<LocationDialog>
        {
            { x => x.LocationId, location.Id }
        };

        var dialog = await DialogService.ShowAsync<LocationDialog>(
            L["Edit Location"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenDeleteDialog(LocationDto location)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Location"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete location:"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() },
            { nameof(ConfirmDialog.HighlightedText), location.Name },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["Delete Location"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var deleted = await LocationService.DeleteLocationAsync(location.Id);
                if (deleted)
                {
                    Snackbar.Add(L["Location deleted successfully"], Severity.Success);
                    await _table.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(L["Error deleting location"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting location {LocationId}", location.Id);
                Snackbar.Add(L["Error deleting location"], Severity.Error);
            }
        }
    }
}
