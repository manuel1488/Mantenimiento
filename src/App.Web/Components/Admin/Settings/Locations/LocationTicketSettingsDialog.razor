@using App.Core.DTOs.Location
@using App.Core.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@inject ILocationTicketSettingsService TicketSettingsService
@inject ILocationService LocationService
@inject IStringLocalizer<LocationTicketSettingsDialog> L
@inject ISnackbar Snackbar
@inject ILogger<LocationTicketSettingsDialog> Logger

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-width: 900px;" Class="pa-4">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_model != null)
            {
                <MudForm Model="@_model" @ref="@_form">
                    <MudGrid>
                        <!-- Location Info Header -->
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @L["Configuring ticket settings for"]: <strong>@_locationName</strong>
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12">
                            @if (!_hasSettings)
                            {
                                <MudAlert Severity="Severity.Info" Dense="false" Variant="Variant.Filled" Class="mb-2">
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.body1">
                                            <strong>@L["Currently using GLOBAL ticket settings"]</strong>
                                        </MudText>
                                        <MudText Typo="Typo.body2">
                                            @L["Create specific settings for this location to override the global configuration."]
                                        </MudText>
                                        <div class="mt-2">
                                            <MudButton OnClick="CopyFromGlobal"
                                                     Size="Size.Small"
                                                     Variant="Variant.Outlined"
                                                     Color="Color.Primary"
                                                     StartIcon="@Icons.Material.Filled.ContentCopy">
                                                @L["Copy from Global"]
                                            </MudButton>
                                        </div>
                                    </MudStack>
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                                    <strong>@L["This location has SPECIFIC ticket settings (overriding global)"]</strong>
                                </MudAlert>
                            }
                        </MudItem>

                        <!-- Printer Configuration -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Printer Configuration"]</MudText>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.PrinterName"
                                        Label="@L["Printer Name"]"
                                        Placeholder="@L["Default printer"]" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField @bind-Value="_model.PaperWidth"
                                           Label="@L["Paper Width (mm)"]"
                                           Min="58"
                                           Max="80"
                                           HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField @bind-Value="_model.Copies"
                                           Label="@L["Copies"]"
                                           Min="1"
                                           Max="10"
                                           HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_model.AutoPrint"
                                     Label="@L["Auto-print on sale"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <!-- Content Customization -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Content Customization"]</MudText>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.HeaderText"
                                        Label="@L["Header Text"]"
                                        Lines="2"
                                        Placeholder="@L["Custom header message"]" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.FooterText"
                                        Label="@L["Footer Text"]"
                                        Lines="2"
                                        Placeholder="@L["Thank you for your purchase!"]" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Company Logo"]</MudText>

                            @if (!string.IsNullOrEmpty(_model.LogoBase64))
                            {
                                <div class="d-flex justify-center mb-4">
                                    <img src="data:image/png;base64,@_model.LogoBase64"
                                        style="max-width: 200px; max-height: 100px;" />
                                </div>
                            }

                            <div class="d-flex align-center gap-3 mb-3">
                                <InputFile id="logoFileInput" OnChange="@HandleFileSelected" accept="image/*"
                                    class="d-none" />

                                <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.CloudUpload" for="logoFileInput"
                                    Size="Size.Small">
                                    @L["Upload Logo"]
                                </MudButton>

                                @if (!string.IsNullOrEmpty(_model.LogoBase64))
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                        OnClick="@(() => _model.LogoBase64 = null)"
                                        Size="Size.Small">
                                        @L["Remove Logo"]
                                    </MudButton>
                                }
                            </div>

                            <MudSwitch @bind-Value="_model.ShowLogo"
                                     Label="@L["Show Logo"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <!-- Fiscal Information -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Fiscal Information"]</MudText>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.TaxId"
                                        Label="@L["Tax ID (RFC)"]"
                                        Placeholder="@L["XAXX010101000"]"
                                        MaxLength="20" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.LegalName"
                                        Label="@L["Legal Name"]"
                                        Placeholder="@L["Company legal name"]" />
                        </MudItem>

                        <!-- Display Options -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Display Options"]</MudText>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_model.ShowFullAddress"
                                     Label="@L["Show Full Address"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_model.ShowPrices"
                                     Label="@L["Show Prices"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_model.ShowTaxBreakdown"
                                     Label="@L["Show Tax Breakdown"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <!-- QR Code -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.h6" Class="mb-2">@L["QR Code"]</MudText>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_model.ShowQrCode"
                                     Label="@L["Show QR Code"]"
                                     Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.QrCodeContent"
                                        Label="@L["QR Code Content"]"
                                        Placeholder="@L["https://mywebsite.com"]"
                                        Disabled="@(!_model.ShowQrCode)" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                 Class="da-button-rounded"
                 title="@L["Cancel editing"]">
            @L["Cancel"]
        </MudButton>

        @if (_hasSettings)
        {
            <MudButton Color="Color.Warning"
                     OnClick="DeleteSettings"
                     Variant="Variant.Text"
                     title="@L["Delete specific settings and use global"]"
                     Class="da-button-rounded">
                @L["Use Global Settings"]
            </MudButton>
        }

        <MudButton Color="Color.Primary"
                 OnClick="Submit"
                 Variant="Variant.Filled"
                 Disabled="@(_processing || !_isValid)"
                 title="@L["Save ticket settings"]"
                 Class="da-button-rounded">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Saving"]</MudText>
            }
            else
            {
                @L["Save"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int LocationId { get; set; }

    private MudForm _form = null!;
    private bool _processing;
    private bool _loading = true;
    private bool _isValid = true;
    private bool _hasSettings;
    private string _locationName = "";
    private int? _settingsId;

    private UpdateLocationTicketSettingsDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            _loading = true;

            // Load location info
            var location = await LocationService.GetLocationByIdAsync(LocationId);
            if (location != null)
            {
                _locationName = location.Name;
            }

            // Check if location has specific settings
            _hasSettings = await TicketSettingsService.HasSettingsAsync(LocationId);

            if (_hasSettings)
            {
                // Load existing settings
                var result = await TicketSettingsService.GetByLocationIdAsync(LocationId);
                if (result.IsSuccess && result.Value != null)
                {
                    var settings = result.Value;
                    _settingsId = settings.Id;
                    _model = new UpdateLocationTicketSettingsDto
                    {
                        PrinterName = settings.PrinterName,
                        PaperWidth = settings.PaperWidth,
                        AutoPrint = settings.AutoPrint,
                        Copies = settings.Copies,
                        HeaderText = settings.HeaderText,
                        FooterText = settings.FooterText,
                        LogoBase64 = settings.LogoBase64,
                        ShowLogo = settings.ShowLogo,
                        TaxId = settings.TaxId,
                        LegalName = settings.LegalName,
                        ShowFullAddress = settings.ShowFullAddress,
                        ShowQrCode = settings.ShowQrCode,
                        QrCodeContent = settings.QrCodeContent,
                        ShowPrices = settings.ShowPrices,
                        ShowTaxBreakdown = settings.ShowTaxBreakdown
                    };
                }
            }
            else
            {
                // Initialize with defaults
                _model = new UpdateLocationTicketSettingsDto
                {
                    PaperWidth = 80,
                    AutoPrint = false,
                    Copies = 1,
                    ShowLogo = true,
                    ShowFullAddress = true,
                    ShowQrCode = false,
                    ShowPrices = true,
                    ShowTaxBreakdown = true
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading ticket settings for location {LocationId}", LocationId);
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CopyFromGlobal()
    {
        try
        {
            _processing = true;
            var result = await TicketSettingsService.CopyFromGlobalAsync(LocationId);

            if (result.IsSuccess)
            {
                Snackbar.Add(L["Settings copied from global configuration"], Severity.Success);
                await LoadSettings(); // Reload to show new settings
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error copying global settings"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying global settings");
            Snackbar.Add(L["Error copying global settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task DeleteSettings()
    {
        if (!_settingsId.HasValue) return;

        try
        {
            _processing = true;
            var result = await TicketSettingsService.DeleteAsync(_settingsId.Value);

            if (result.IsSuccess)
            {
                Snackbar.Add(L["Specific settings removed. Will use global settings."], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error deleting settings"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting ticket settings");
            Snackbar.Add(L["Error deleting settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        try
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                _isValid = false;
                return;
            }

            _processing = true;

            if (_hasSettings && _settingsId.HasValue)
            {
                // Update existing settings
                var result = await TicketSettingsService.UpdateAsync(_settingsId.Value, _model);
                if (result.IsSuccess)
                {
                    Snackbar.Add(L["Settings updated successfully"], Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result.Value));
                }
                else
                {
                    Snackbar.Add(result.Error ?? L["Error updating settings"], Severity.Error);
                }
            }
            else
            {
                // Create new settings
                var createDto = new CreateLocationTicketSettingsDto
                {
                    LocationId = LocationId,
                    PrinterName = _model.PrinterName,
                    PaperWidth = _model.PaperWidth,
                    AutoPrint = _model.AutoPrint,
                    Copies = _model.Copies,
                    HeaderText = _model.HeaderText,
                    FooterText = _model.FooterText,
                    LogoBase64 = _model.LogoBase64,
                    ShowLogo = _model.ShowLogo,
                    TaxId = _model.TaxId,
                    LegalName = _model.LegalName,
                    ShowFullAddress = _model.ShowFullAddress,
                    ShowQrCode = _model.ShowQrCode,
                    QrCodeContent = _model.QrCodeContent,
                    ShowPrices = _model.ShowPrices,
                    ShowTaxBreakdown = _model.ShowTaxBreakdown
                };

                var result = await TicketSettingsService.CreateAsync(createDto);
                if (result.IsSuccess)
                {
                    Snackbar.Add(L["Settings created successfully"], Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result.Value));
                }
                else
                {
                    Snackbar.Add(result.Error ?? L["Error creating settings"], Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving ticket settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Validar tamaño y tipo
            if (file.Size > 1024 * 1024) // 1MB
            {
                Snackbar.Add(L["Logo file is too large (max 1MB)"], Severity.Warning);
                return;
            }

            if (!file.ContentType.StartsWith("image/"))
            {
                Snackbar.Add(L["Only image files are allowed"], Severity.Warning);
                return;
            }

            // Leer el archivo como array de bytes
            using var stream = file.OpenReadStream(1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            // Convertir a Base64
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            _model.LogoBase64 = base64;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing logo upload");
            Snackbar.Add(L["Error processing logo file"], Severity.Error);
        }
    }
}
