@using App.Core.Common
@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Services.Email
@using MudBlazor
@using App.Web.Components.Admin.Settings.Email

@inject ICotizacionTemplateSettingsService TemplateSettingsService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<CotizacionSettingsTab> L

<MudForm @ref="_form" @bind-IsValid="_isValid">
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-1">@L["Folio Numbering"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block;">
                @L["The consecutive number resets every year and never changes once assigned; only the prefix/padding shown here are applied retroactively to existing folios."]
            </MudText>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_folioPrefijo"
                          Label="@L["Folio Prefix"]"
                          Required="true"
                          RequiredError="@L["Folio prefix is required"]"
                          Variant="Variant.Outlined"
                          MaxLength="20" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudNumericField @bind-Value="_folioDigitos"
                             Label="@L["Folio Digits"]"
                             Min="1" Max="10"
                             Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @L["Preview"]: @FolioPreview
            </MudText>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-1">@L["Footer Content"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block;">
                @L["Optional content shown in the Cotización PDF footer."]
            </MudText>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_paymentTermsText"
                          Label="@L["Payment Terms"]"
                          HelperText="@L["Leave blank to hide this section from the PDF."]"
                          Lines="3"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          MaxLength="2000" Counter="2000" />
        </MudItem>

        <MudItem xs="12">
            <MudSwitch @bind-Value="_mostrarDireccion" Color="Color.Primary" Label="@L["Show company address on the Cotización PDF"]" />
        </MudItem>

        @if (_mostrarDireccion)
        {
            <MudItem xs="12">
                <MudTextField @bind-Value="_direccion"
                              Label="@L["Company Address"]"
                              Lines="2"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              MaxLength="300" Counter="300" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudSwitch @bind-Value="_mostrarDatosBancarios" Color="Color.Primary" Label="@L["Show bank transfer details on the Cotización PDF"]" />
        </MudItem>

        @if (_mostrarDatosBancarios)
        {
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_bancoBeneficiario" Label="@L["Beneficiary"]" Variant="Variant.Outlined" MaxLength="150" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_bancoRfc" Label="@L["RFC"]" Variant="Variant.Outlined" MaxLength="13" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_bancoNombre" Label="@L["Bank"]" Variant="Variant.Outlined" MaxLength="100" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_bancoNumeroCuenta" Label="@L["Account Number"]" Variant="Variant.Outlined" MaxLength="50" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_bancoClabe" Label="@L["CLABE"]" Variant="Variant.Outlined" FullWidth="true" MaxLength="18" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_bancoSwift" Label="@L["SWIFT/BIC"]" Variant="Variant.Outlined" MaxLength="20" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        <MudItem xs="12" Class="d-flex align-center gap-2">
            <MudText Typo="Typo.h6">@L["Contact and Social Media"]</MudText>
            <MudSwitch @bind-Value="_mostrarContacto" Color="Color.Primary" Label="@L["Show on PDF"]" />
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">
                @L["Contact details shown in the Cotización PDF footer."]
            </MudText>
        </MudItem>

        @if (_mostrarContacto)
        {
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_sitioWeb" Label="@L["Website"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Language" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_telefono" Label="@L["Phone"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" MaxLength="30" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_correoElectronico" Label="@L["Email"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" MaxLength="150" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_whatsApp" Label="@L["WhatsApp"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Chat" MaxLength="30" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_facebook" Label="@L["Facebook"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Groups" MaxLength="150" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_instagram" Label="@L["Instagram"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CameraAlt" MaxLength="150" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-1">@L["Cotización PDF Template"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block;">
                @L["Customize the HTML/CSS used to render the Cotización PDF. Leave blank and reset to use the default template."]
            </MudText>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudText Typo="Typo.subtitle1" Class="mb-1">@L["HTML Body"]</MudText>
            <MudTextField @bind-Value="_htmlContent"
                          Lines="20"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["HTML content is required"]"
                          Style="font-family: monospace; font-size: 12px;"
                          FullWidth="true" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle1" Class="mb-1">@L["CSS Styles"]</MudText>
            <MudTextField @bind-Value="_cssContent"
                          Lines="20"
                          Variant="Variant.Outlined"
                          Style="font-family: monospace; font-size: 12px;"
                          FullWidth="true" />
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-2" />
        </MudItem>

        <MudItem xs="12">
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="@L["Available Variables"]" Dense="true">
                    <MudSimpleTable Dense="true" Style="max-height: 240px; overflow-y: auto;">
                        <tbody>
                            @foreach (var v in Variables)
                            {
                                <tr>
                                    <td><code style="font-size:12px; color:#c0392b;">@("{{ " + v.Key + " }}")</code></td>
                                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">@v.Value</MudText></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetAsync"
                       Disabled="@_resetting">
                @L["Reset to Default"]
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="PreviewAsync"
                       Disabled="@(string.IsNullOrWhiteSpace(_htmlContent) || _previewing)">
                @L["Preview"]
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync"
                       Disabled="@(!_isValid || _saving)">
                @L["Save"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudForm>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _saving;
    private bool _previewing;
    private bool _resetting;
    private string _htmlContent = string.Empty;
    private string _cssContent = string.Empty;
    private string? _paymentTermsText;
    private bool _mostrarDireccion;
    private string? _direccion;
    private bool _mostrarDatosBancarios;
    private string? _bancoBeneficiario;
    private string? _bancoRfc;
    private string? _bancoNombre;
    private string? _bancoNumeroCuenta;
    private string? _bancoClabe;
    private string? _bancoSwift;
    private bool _mostrarContacto;
    private string? _sitioWeb;
    private string? _telefono;
    private string? _correoElectronico;
    private string? _whatsApp;
    private string? _facebook;
    private string? _instagram;
    private string _folioPrefijo = "COT";
    private int _folioDigitos = 4;

    private string FolioPreview => CotizacionFolioFormatter.Format(
        1, DateTime.Now.Year, 1, _folioPrefijo, _folioDigitos);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (html, css) = await TemplateSettingsService.GetEffectiveTemplateAsync();
        _htmlContent = html;
        _cssContent = css;

        var config = await TemplateSettingsService.GetConfigAsync();
        _direccion = config?.Direccion;
        _paymentTermsText = config?.PaymentTermsText;
        _mostrarDireccion = config?.MostrarDireccionEnCotizacion ?? false;
        _mostrarDatosBancarios = config?.MostrarDatosBancarios ?? false;
        _bancoBeneficiario = config?.BancoBeneficiario;
        _bancoRfc = config?.BancoRfc;
        _bancoNombre = config?.BancoNombre;
        _bancoNumeroCuenta = config?.BancoNumeroCuenta;
        _bancoClabe = config?.BancoClabe;
        _bancoSwift = config?.BancoSwift;
        _mostrarContacto = config?.MostrarContacto ?? false;
        _sitioWeb = config?.SitioWeb;
        _telefono = config?.Telefono;
        _correoElectronico = config?.CorreoElectronico;
        _whatsApp = config?.WhatsApp;
        _facebook = config?.Facebook;
        _instagram = config?.Instagram;
        _folioPrefijo = config?.FolioPrefijo ?? "COT";
        _folioDigitos = config?.FolioDigitos ?? 4;
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            await TemplateSettingsService.UpdateConfigAsync(new UpdateCotizacionTemplateSettingsDto
            {
                HtmlContent = _htmlContent,
                CssContent = _cssContent,
                PaymentTermsText = _paymentTermsText,
                MostrarDireccionEnCotizacion = _mostrarDireccion,
                Direccion = _direccion,
                MostrarDatosBancarios = _mostrarDatosBancarios,
                BancoBeneficiario = _bancoBeneficiario,
                BancoRfc = _bancoRfc,
                BancoNombre = _bancoNombre,
                BancoNumeroCuenta = _bancoNumeroCuenta,
                BancoClabe = _bancoClabe,
                BancoSwift = _bancoSwift,
                MostrarContacto = _mostrarContacto,
                SitioWeb = _sitioWeb,
                Telefono = _telefono,
                CorreoElectronico = _correoElectronico,
                WhatsApp = _whatsApp,
                Facebook = _facebook,
                Instagram = _instagram,
                FolioPrefijo = _folioPrefijo,
                FolioDigitos = _folioDigitos
            });

            Snackbar.Add(L["Template saved successfully"], Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["Error saving template"], Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync()
    {
        _resetting = true;
        try
        {
            await TemplateSettingsService.ResetAsync();
            await LoadAsync();
            Snackbar.Add(L["Template reset to default"], Severity.Success);
        }
        catch
        {
            Snackbar.Add(L["Error resetting template"], Severity.Error);
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task PreviewAsync()
    {
        _previewing = true;
        try
        {
            var sampleData = CotizacionTemplateSampleData.GetSampleData();
            var fullHtml = "<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><style>" +
                           _cssContent + "</style></head><body>" + _htmlContent + "</body></html>";
            var template = Scriban.Template.Parse(fullHtml);
            var rendered = await template.RenderAsync(sampleData);

            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
            await DialogService.ShowAsync<EmailTemplatePreviewDialog>(L["Preview"],
                new DialogParameters<EmailTemplatePreviewDialog>
                {
                    { x => x.HtmlContent, rendered },
                    { x => x.PreviewUrl, null }
                }, options);
        }
        catch
        {
            Snackbar.Add(L["Error rendering preview"], Severity.Error);
        }
        _previewing = false;
    }

    private static readonly Dictionary<string, string> Variables = new()
    {
        { "company_name",        "Nombre de la empresa" },
        { "company_direccion",   "Dirección de la empresa (si mostrar_direccion es true)" },
        { "mostrar_direccion",   "true si se debe mostrar la dirección de la empresa" },
        { "logo_base64",         "Logo en base64 (usar dentro de has_logo)" },
        { "has_logo",            "true si hay logo configurado" },
        { "primary_color",       "Color primario de marca (hex)" },
        { "secondary_color",     "Color secundario de marca (hex)" },
        { "cotizacion_id",       "ID interno de la cotización (no usar para mostrar el folio)" },
        { "cotizacion_folio",    "Folio formateado de la cotización (ej. COT-2026-0001), según Prefijo/Dígitos configurados" },
        { "fecha_generacion",    "Fecha de generación (dd/MM/yyyy)" },
        { "hora_generacion",     "Hora de generación (HH:mm)" },
        { "generado_por",        "Nombre de quien generó la cotización (usar dentro de has_generado_por)" },
        { "has_generado_por",    "true si se pudo resolver el nombre de quien la generó" },
        { "integridad_hash",     "Huella SHA-256 de 64 caracteres (usar dentro de has_integridad_hash)" },
        { "has_integridad_hash", "true si la cotización tiene huella de integridad calculada" },
        { "cliente_nombre",      "Nombre del cliente" },
        { "cliente_correo",      "Correo del cliente (usar dentro de has_cliente_correo)" },
        { "has_cliente_correo",  "true si el cliente tiene correo" },
        { "cliente_telefono",    "Teléfono del cliente (usar dentro de has_cliente_telefono)" },
        { "has_cliente_telefono", "true si el cliente tiene teléfono" },
        { "cliente_direccion",   "Dirección comercial del cliente (usar dentro de has_cliente_direccion)" },
        { "has_cliente_direccion", "true si el cliente tiene dirección comercial" },
        { "cliente_tiene_datos_fiscales", "true si el cliente tiene datos fiscales capturados" },
        { "cliente_razon_social", "Razón social del cliente" },
        { "cliente_rfc",         "RFC del cliente" },
        { "cliente_regimen_fiscal", "Régimen fiscal del cliente" },
        { "subtotal",            "Subtotal formateado como moneda" },
        { "incluir_iva",         "true si la cotización incluye IVA" },
        { "iva_tasa",            "Tasa de IVA aplicada (%)" },
        { "iva_monto",           "Monto de IVA formateado como moneda" },
        { "total",               "Total formateado como moneda" },
        { "has_payment_terms",   "true si hay términos de pago configurados" },
        { "payment_terms_text",  "Texto de términos de pago" },
        { "mostrar_datos_bancarios", "true si se deben mostrar los datos bancarios" },
        { "banco_beneficiario",  "Nombre del beneficiario" },
        { "banco_rfc",           "RFC del beneficiario" },
        { "banco_nombre",        "Nombre del banco" },
        { "banco_numero_cuenta", "Número de cuenta" },
        { "banco_clabe",         "CLABE interbancaria" },
        { "banco_swift",         "SWIFT/BIC" },
        { "mostrar_contacto",    "true si se deben mostrar los datos de contacto y redes sociales" },
        { "contacto_sitio_web",  "Sitio web, texto mostrado (usar dentro de has_contacto_sitio_web)" },
        { "contacto_sitio_web_href", "URL del sitio web para el enlace (https:// agregado automáticamente si falta)" },
        { "has_contacto_sitio_web", "true si hay sitio web de contacto" },
        { "contacto_telefono",   "Teléfono de contacto, texto mostrado (usar dentro de has_contacto_telefono)" },
        { "contacto_telefono_href", "Enlace tel: del teléfono de contacto" },
        { "has_contacto_telefono", "true si hay teléfono de contacto" },
        { "contacto_correo",     "Correo electrónico de contacto, texto mostrado (usar dentro de has_contacto_correo)" },
        { "contacto_correo_href", "Enlace mailto: del correo de contacto" },
        { "has_contacto_correo", "true si hay correo electrónico de contacto" },
        { "contacto_whatsapp",   "WhatsApp, texto mostrado (usar dentro de has_contacto_whatsapp)" },
        { "contacto_whatsapp_href", "Enlace https://wa.me/ construido a partir de los dígitos del número" },
        { "has_contacto_whatsapp", "true si hay WhatsApp de contacto" },
        { "contacto_facebook",   "Facebook, texto mostrado (usar dentro de has_contacto_facebook)" },
        { "contacto_facebook_href", "URL de Facebook para el enlace (https:// agregado automáticamente si falta)" },
        { "has_contacto_facebook", "true si hay Facebook de contacto" },
        { "contacto_instagram",  "Instagram, texto mostrado (usar dentro de has_contacto_instagram)" },
        { "contacto_instagram_href", "URL de Instagram para el enlace (https:// agregado automáticamente si falta)" },
        { "has_contacto_instagram", "true si hay Instagram de contacto" },
        { "lineas",              "Lista de líneas (loop: for linea in lineas)" },
        { "linea.indice",        "Número de fila (1-based)" },
        { "linea.servicio_nombre", "Nombre del servicio" },
        { "linea.descripcion",   "Descripción de la línea (usar dentro de linea.has_descripcion)" },
        { "linea.has_descripcion", "true si la línea tiene descripción" },
        { "linea.unidad_medida", "Unidad de medida" },
        { "linea.cantidad",      "Cantidad" },
        { "linea.precio_unitario", "Precio unitario" },
        { "linea.subtotal",      "Subtotal de la línea" },
        { "has_fotos",           "true si al menos una línea tiene fotos adjuntas" },
        { "label_photos_annex",  "Título del anexo de fotos" },
        { "label_photo",         "Etiqueta \"Foto\" usada antes del número de cada foto" },
        { "lineas_con_fotos",    "Líneas que tienen fotos, agrupadas (loop: for linea in lineas_con_fotos) — solo incluye las líneas con al menos una foto" },
        { "linea.fotos",         "Fotos de esa línea (loop anidado: for foto in linea.fotos)" },
        { "foto.indice",         "Número de foto dentro de su línea (1-based)" },
        { "foto.url",            "URL prefirmada de la imagen" },
        { "foto.descripcion",    "Descripción de la foto (usar dentro de foto.has_descripcion)" },
        { "foto.has_descripcion", "true si la foto tiene descripción" },
    };
}
