@using App.Core.DTOs.Branch
@using App.Core.Interfaces

@inject IBranchService BranchService
@inject IStringLocalizer<BranchDialog> L
@inject ISnackbar Snackbar
@inject ILogger<BranchDialog> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ManageBranchSettings">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 800px;" Class="pa-4">
                    <MudForm Model="@_model" @ref="@_form">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Name"
                                            Label="@L["Name"]"
                                            Required="true"
                                            RequiredError="@L["Name is required"]"
                                            OnBlur="@(() => ValidateName(_model.Name))"
                                            Error="@_nameError"
                                            ErrorText="@(_nameError ? L["Branch name already exists"]?.ToString() : null)" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudCheckBox T="bool"
                                        @bind-Value="_model.IsActive"
                                        Label="@L["Active"]"
                                        Color="Color.Primary"
                                        Dense="true" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.Description"
                                            Label="@L["Description"]"
                                            Lines="2" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Address"]</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.Street"
                                            Label="@L["Street"]" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_model.City"
                                            Label="@L["City"]" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_model.State"
                                            Label="@L["State"]" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_model.ZipCode"
                                            Label="@L["Zip Code"]" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Contact"]</MudText>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Phone"
                                            Label="@L["Phone"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Email"
                                            Label="@L["Email"]" />
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel"
                        Class="da-button-rounded"
                        title="@L["Cancel editing"]">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Error"
                        OnClick="Submit"
                        Variant="Variant.Filled"
                        Disabled="@(_processing || !_isValid)"
                        title="@L["Save branch data"]"
                        Class="da-button-rounded">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@L["Saving"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? BranchId { get; set; }

    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool _nameError;
    private bool IsNew => !BranchId.HasValue;

    private CreateBranchDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        if (BranchId.HasValue)
        {
            await LoadBranch();
        }
    }

    private async Task LoadBranch()
    {
        try
        {
            var result = await BranchService.GetBranchByIdAsync(BranchId!.Value);
            if (result.IsSuccess)
            {
                var branch = result.Value;
                _model = new CreateBranchDto
                {
                    Name = branch.Name,
                    Description = branch.Description,
                    Street = branch.Street,
                    City = branch.City,
                    State = branch.State,
                    ZipCode = branch.ZipCode,
                    Country = branch.Country,
                    Phone = branch.Phone,
                    Email = branch.Email,
                    IsActive = branch.IsActive
                };
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error loading branch"], Severity.Error);
                MudDialog.Cancel();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading branch {BranchId}", BranchId);
            Snackbar.Add(L["Error loading branch"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                if (BranchId.HasValue)
                {
                    var updateDto = new UpdateBranchDto
                    {
                        Name = _model.Name,
                        Description = _model.Description,
                        Street = _model.Street,
                        City = _model.City,
                        State = _model.State,
                        ZipCode = _model.ZipCode,
                        Country = _model.Country,
                        Phone = _model.Phone,
                        Email = _model.Email,
                        IsActive = _model.IsActive
                    };

                    var result = await BranchService.UpdateBranchAsync(BranchId.Value, updateDto);
                    if (result.IsSuccess)
                    {
                        Snackbar.Add(L["Branch updated successfully"], Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add(result.Error ?? L["Error updating branch"], Severity.Error);
                    }
                }
                else
                {
                    var nameResult = await BranchService.ValidateUniqueNameAsync(_model.Name, BranchId);
                    if (nameResult.IsSuccess && !nameResult.Value)
                    {
                        _nameError = true;
                        _isValid = false;
                        Snackbar.Add(L["Branch name already exists"], Severity.Warning);
                        StateHasChanged();
                        return;
                    }

                    var result = await BranchService.CreateBranchAsync(_model);
                    if (result.IsSuccess)
                    {
                        Snackbar.Add(L["Branch created successfully"], Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add(result.Error ?? L["Error creating branch"], Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving branch");
                Snackbar.Add(L["Error saving branch"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }

    private async Task ValidateName(string name)
    {
        if (string.IsNullOrEmpty(name))
            return;

        try
        {
            var result = await BranchService.ValidateUniqueNameAsync(name, BranchId);
            if (result.IsSuccess)
            {
                _nameError = !result.Value;
                _isValid = result.Value;

                if (_nameError)
                {
                    Snackbar.Add(L["Branch name already exists"], Severity.Warning);
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating branch name");
        }
    }
}
