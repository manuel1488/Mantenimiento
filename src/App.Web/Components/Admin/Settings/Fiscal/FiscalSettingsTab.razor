@using App.Core.DTOs.Settings
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.Interfaces.Billing
@using App.Core.Validators
@using App.Core.Constants
@using App.Web.Services

@inject ITaxSettingsService TaxSettingsService
@inject ICfdiPostalCodeService CfdiPostalCodeService
@inject IMexicoFiscalCatalogService MexicoFiscalCatalogService
@inject IMexicoPacSettingsService PacSettingsService
@inject IPermissionCheckService PermissionService
@inject ILookupService LookupService
@inject IStringLocalizer<FiscalSettingsTab> L
@inject ISnackbar Snackbar
@inject ILogger<FiscalSettingsTab> Logger
@inject TaxIdValidator TaxIdValidator


<AuthorizeView Policy="@ApplicationClaims.Admin.ViewFiscalSettings">
    <Authorized>
        <MudForm Model="@_model" @ref="@_form">
            <MudGrid>
                <!-- Base Information -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-4">@L["Base Information"]</MudText>
                    <MudGrid>
                        <!-- Country -->
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" 
                                    Value="@_model.CountryCode"
                                    ValueChanged="@((value) => OnCountryChanged(value))"
                                    Label="@L["Country"]"
                                    Required="@_hasWriteAccess"
                                    ReadOnly="@(!_hasWriteAccess)"
                                    RequiredError="@L["Country is required"]">
                                @foreach (var country in _countries)
                                {
                                    <MudSelectItem Value="@country.Code">@country.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- Business Name -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                Value="@_model.BusinessName"
                                ValueChanged="@((value) => OnBusinessNameChanged(value))"
                                Label="@L["Business Name"]"
                                Required="@_hasWriteAccess"
                                ReadOnly="@(!_hasWriteAccess)"
                                RequiredError="@L["Business name is required"]"/>
                        </MudItem>

                        <!-- Tax ID -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                Value="@_model.TaxId"
                                ValueChanged="@OnTaxIdChanged"
                                Label="@L["Tax ID"]"
                                Required="@_hasWriteAccess"
                                ReadOnly="@(!_hasWriteAccess)"
                                RequiredError="@L["Tax ID is required"]"
                                Error="@_taxIdError"
                                ErrorText="@_taxIdErrorText"
                                Immediate="false"                        
                                MaxLength="@(GetTaxIdMaxLength() ?? 0)"
                                Validation="@(new Func<string, string?>(ValidateTaxId))">
                                </MudTextField>
                        </MudItem>

                        <!-- Fiscal Regime (Only for Mexico) -->
                        <MudItem xs="12" md="6">
                            @if (_model.CountryCode == "MX")
                            {
                                <MudSelect T="string"
                                        Value="@_model.FiscalRegime"
                                        ValueChanged="@((value) => { _model.FiscalRegime = value; StateHasChanged(); })"
                                        Label="@L["Fiscal Regime"]"
                                        ReadOnly="@(!_hasWriteAccess)"
                                        Required="@_hasWriteAccess"
                                        RequiredError="@L["Fiscal regime is required"]">
                                    @foreach (var regime in _fiscalRegimes)
                                    {
                                        <MudSelectItem Value="@regime.Code">@regime.Description (@regime.Code)</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else 
                            {
                                <MudTextField Value="_model.FiscalRegime"
                                            ValueChanged="(string value) => { _model.FiscalRegime = value; StateHasChanged(); }"
                                            Label="@L["Fiscal Regime"]"
                                            ReadOnly="@(!_hasWriteAccess)"
                                            Required="@_hasWriteAccess"
                                            RequiredError="@L["Fiscal regime is required"]"/>
                            }
                        </MudItem>

                        <!-- Address -->
                        <MudItem xs="12">
                            <MudTextField Value="_model.Address"
                                    ReadOnly="@(!_hasWriteAccess)"
                                    ValueChanged="(string? value) => { _model.Address = value; StateHasChanged(); }"
                                    Label="@L["Address"]"
                                    Lines="3"/>
                        </MudItem>

                        <!-- Postal Code -->
                        <MudItem xs="12" md="6">
                            <MudTextField Value="_model.PostalCode"
                                    ReadOnly="@(!_hasWriteAccess)"
                                    ValueChanged="@((string? value) => OnPostalCodeChanged(value))"
                                    Label="@L["Postal Code"]"/>
                            @if (_model.CountryCode == "MX" && !string.IsNullOrEmpty(_model.PostalCode))
                            {
                                @if (_postalCodeTz != null)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                                        <MudText Typo="Typo.caption">
                                            <b>@L["Timezone"]:</b> @_postalCodeTz.TimeZoneName
                                            — UTC@(_postalCodeTz.OffsetWinter > 0 ? "+" : "")@_postalCodeTz.OffsetWinter
                                            @if (_postalCodeTz.OffsetWinter != _postalCodeTz.OffsetSummer)
                                            {
                                                <span>/ UTC@(_postalCodeTz.OffsetSummer > 0 ? "+" : "")@_postalCodeTz.OffsetSummer @L["DST"]</span>
                                            }
                                        </MudText>
                                    </MudAlert>
                                }
                                else if (_postalCodeNotFound)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                        <MudText Typo="Typo.caption">@L["PostalCodeTimezoneNotFound"]</MudText>
                                    </MudAlert>
                                }
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>

                @if (_model.CountryCode == "MX")
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">@L["Mexico Settings"]</MudText>
                        <MudGrid>
                            <!-- CFDI Use -->
                            <MudItem xs="12" md="4">
                                <MudSelect T="string"
                                        Value="@_model.MxDefaultCfdiUse"
                                        ValueChanged="@((value) => { _model.MxDefaultCfdiUse = value; StateHasChanged(); })"
                                        Label="@L["Default CFDI Use"]"
                                        ReadOnly="@(!_hasWriteAccess)"
                                        Required="@_hasWriteAccess"
                                        RequiredError="@L["CFDI use is required"]">
                                    @foreach (var cfdiUse in _cfdiUses)
                                    {
                                        <MudSelectItem Value="@cfdiUse.Code">@cfdiUse.Description (@cfdiUse.Code)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Payment Method -->
                            <MudItem xs="12" md="4">
                                <MudSelect T="string"
                                        Value="@_model.MxDefaultPaymentMethod"
                                        ValueChanged="@((value) => { _model.MxDefaultPaymentMethod = value; StateHasChanged(); })"
                                        Label="@L["Default Payment Method"]"
                                        ReadOnly="@(!_hasWriteAccess)"
                                        Required="@_hasWriteAccess"
                                        RequiredError="@L["Payment method is required"]">
                                    @foreach (var method in _paymentMethods)
                                    {
                                        <MudSelectItem Value="@method.Code">@method.Description (@method.Code)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Payment Type -->
                            <MudItem xs="12" md="4">
                                <MudSelect T="string"
                                        Value="@_model.MxDefaultPaymentType"
                                        ValueChanged="@((value) => { _model.MxDefaultPaymentType = value; StateHasChanged(); })"
                                        Label="@L["Default Payment Type"]"
                                        ReadOnly="@(!_hasWriteAccess)"
                                        Required="@_hasWriteAccess"
                                        RequiredError="@L["Payment type is required"]">
                                    @foreach (var form in _paymentForms)
                                    {
                                        <MudSelectItem Value="@form.Code">@form.Description (@form.Code)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Max Backdate Hours -->
                            <MudItem xs="12" md="4">
                                <MudNumericField T="int?"
                                                 Value="@_model.MxMaxBackdateHours"
                                                 ValueChanged="@((int? value) => { _model.MxMaxBackdateHours = value; StateHasChanged(); })"
                                                 Label="@L["Max Backdate Hours"]"
                                                 Min="0"
                                                 Max="168"
                                                 ReadOnly="@(!_hasWriteAccess)"
                                                 Variant="Variant.Outlined"
                                                 HelperText="@L["MaxBackdateHoursHelp"]"
                                                 Clearable="true" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>

                    <!-- CSD Digital Certificate -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-3">@L["CSD Digital Certificate"]</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Class="mb-2">
                                    @L["Certificate (.cer)"] —
                                    @if (_pacSettings?.HasCsdCertificate == true)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Uploaded"]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Not uploaded"]</MudChip>
                                    }
                                </MudText>
                                @if (_hasWriteAccess)
                                {
                                    <MudFileUpload T="IBrowserFile"
                                                   FilesChanged="OnCertificateFileChanged"
                                                   Accept=".cer,.pem">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Upload"
                                                       Color="Color.Primary">
                                                @L["Upload Certificate"]
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    @if (!string.IsNullOrEmpty(_certFileName))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1">@_certFileName</MudText>
                                    }
                                }
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Class="mb-2">
                                    @L["Private Key (.key)"] —
                                    @if (_pacSettings?.HasCsdPrivateKey == true)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["Uploaded"]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Not uploaded"]</MudChip>
                                    }
                                </MudText>
                                @if (_hasWriteAccess)
                                {
                                    <MudFileUpload T="IBrowserFile"
                                                   FilesChanged="OnPrivateKeyFileChanged"
                                                   Accept=".key">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Key"
                                                       Color="Color.Primary">
                                                @L["Upload Private Key"]
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    @if (!string.IsNullOrEmpty(_keyFileName))
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-1">@_keyFileName</MudText>
                                    }
                                }
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_csdPassword"
                                              Label="@L["CSD Password"]"
                                              InputType="InputType.Password"
                                              MaxLength="200"
                                              Variant="Variant.Outlined"
                                              ReadOnly="@(!_hasWriteAccess)"
                                              placeholder="@(_pacSettings?.HasCsdPassword == true ? "••••••••••••••••" : string.Empty)"
                                              HelperText="@(_pacSettings?.HasCsdPassword == true ? L["Password saved — enter to change"].Value : L["Password to decrypt the private key"].Value)" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                }
                else if (_model.CountryCode == "CA")
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">@L["Canada Settings"]</MudText>
                        <MudGrid>
                            <!-- GST Number -->
                            <MudItem xs="12" md="6">
                                <MudTextField Value="_model.CaGstNumber"
                                            ValueChanged="(string? value) => { _model.CaGstNumber = value; StateHasChanged(); }"
                                            Label="@L["GST Number"]"
                                            ReadOnly="@(!_hasWriteAccess)"
                                            Required="@_hasWriteAccess"
                                            RequiredError="@L["GST number is required"]"/>
                            </MudItem>

                            <!-- PST Number -->
                            <MudItem xs="12" md="6">
                                <MudTextField Value="_model.CaPstNumber"
                                            ReadOnly="@(!_hasWriteAccess)"
                                            ValueChanged="(string? value) => { _model.CaPstNumber = value; StateHasChanged(); }"
                                            Label="@L["PST Number"]"/>
                            </MudItem>

                            <!-- HST Number -->
                            <MudItem xs="12" md="6">
                                <MudTextField Value="_model.CaHstNumber"
                                            ReadOnly="@(!_hasWriteAccess)"
                                            ValueChanged="(string? value) => { _model.CaHstNumber = value; StateHasChanged(); }"
                                            Label="@L["HST Number"]"/>
                            </MudItem>

                            <!-- QST Number -->
                            <MudItem xs="12" md="6">
                                <MudTextField Value="_model.CaQstNumber"
                                            ReadOnly="@(!_hasWriteAccess)"
                                            ValueChanged="(string? value) => { _model.CaQstNumber = value; StateHasChanged(); }"
                                            Label="@L["QST Number"]"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                }

                <!-- Save Button -->
                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageFiscalSettings" Context="authSaveButton">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                OnClick="SaveChangesAsync"
                                Disabled="@(_processing || !_isValid)"
                                Class="da-button-rounded">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@L["Saving"]</MudText>
                            }
                            else
                            {
                                @L["Save Changes"]
                            }
                        </MudButton>
                    </MudItem>
                </AuthorizeView>                
            </MudGrid>
        </MudForm>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool _taxIdError;
    private string _taxIdErrorText = string.Empty;
    private bool _hasWriteAccess;
    private List<CountryDto> _countries = new();
    private UpdateTaxSettingsDto _model = new();
    private TaxSettingsDto? _settings;

    // Mexico Fiscal Catalogs
    private List<MexicoFiscalRegimeDto> _fiscalRegimes = new();
    private List<MexicoCfdiUseDto> _cfdiUses = new();
    private List<MexicoPaymentMethodDto> _paymentMethods = new();
    private List<MexicoPaymentFormDto> _paymentForms = new();

    // Postal code timezone preview
    private CfdiPostalCodeDto? _postalCodeTz;
    private bool _postalCodeNotFound;

    // CSD certificate (Mexico only)
    private MexicoPacSettingsDto? _pacSettings;
    private string? _certFileName;
    private string? _keyFileName;
    private string? _csdCertBase64;
    private string? _csdKeyBase64;
    private string? _csdPassword;

    protected override async Task OnInitializedAsync()
    {
        // Check permissions
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageFiscalSettings);

        var countries = await LookupService.GetCountriesAsync();
        _countries = countries.ToList();

        // Load Mexico fiscal catalogs
        await LoadMexicoFiscalCatalogsAsync();

        await LoadSettings();
        await RefreshPostalCodeTimezoneAsync();
        _pacSettings = await PacSettingsService.GetAsync();
    }

    private async Task LoadMexicoFiscalCatalogsAsync()
    {
        try 
        {
            _fiscalRegimes = (await MexicoFiscalCatalogService.GetFiscalRegimesAsync()).ToList();
            _cfdiUses = (await MexicoFiscalCatalogService.GetCfdiUsesAsync()).ToList();
            _paymentMethods = (await MexicoFiscalCatalogService.GetPaymentMethodsAsync()).ToList();
            _paymentForms = (await MexicoFiscalCatalogService.GetPaymentFormsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Mexico fiscal catalogs");
            Snackbar.Add(L["Error loading fiscal catalogs"], Severity.Error);
        }
    }

    private async Task OnPostalCodeChanged(string? value)
    {
        _model.PostalCode = value;
        await RefreshPostalCodeTimezoneAsync();
        StateHasChanged();
    }

    private async Task RefreshPostalCodeTimezoneAsync()
    {
        if (_model.CountryCode != "MX" || string.IsNullOrWhiteSpace(_model.PostalCode))
        {
            _postalCodeTz = null;
            _postalCodeNotFound = false;
            return;
        }

        var result = await CfdiPostalCodeService.GetByCodeAsync(_model.PostalCode);
        if (result.IsSuccess)
        {
            _postalCodeTz = result.Value;
            _postalCodeNotFound = false;
        }
        else
        {
            _postalCodeTz = null;
            _postalCodeNotFound = true;
        }
    }

    private void OnBusinessNameChanged(string value)
    {
        _model.BusinessName = value;
        StateHasChanged();
    }

    private async Task OnCountryChanged(string value)
    {
        _model.CountryCode = value;
        _taxIdError = false;
        _taxIdErrorText = string.Empty;

        // Clear Mexico-specific fields if country is not Mexico
        if (value != "MX")
        {
            _model.MxDefaultCfdiUse = null;
            _model.MxDefaultPaymentMethod = null;
            _model.MxDefaultPaymentType = null;
        }

        await ValidateSettings();
        StateHasChanged();
    }

    private void OnTaxIdChanged(string value)
    {
        _model.TaxId = value;
        ValidateTaxId(value);
        StateHasChanged();
    }

    private string? ValidateTaxId(string value)
    {
        if (string.IsNullOrEmpty(_model.CountryCode)) 
            return null;

        var result = TaxIdValidator.ValidateTaxId(_model.CountryCode, value);
        _taxIdError = !result.IsSuccess;
        _taxIdErrorText = result.Error ?? string.Empty;
        _isValid = result.IsSuccess;

        return _taxIdErrorText;
    }

    private async Task LoadSettings()
    {
        try
        {
            _settings = await TaxSettingsService.GetSettingsAsync();
            if (_settings != null)
            {
                _model = new UpdateTaxSettingsDto
                {
                    CountryCode = _settings.CountryCode,
                    BusinessName = _settings.BusinessName,
                    TaxId = _settings.TaxId,
                    FiscalRegime = _settings.FiscalRegime,
                    PostalCode = _settings.PostalCode,
                    Address = _settings.Address,
                    MxDefaultCfdiUse = _settings.MxDefaultCfdiUse,
                    MxDefaultPaymentMethod = _settings.MxDefaultPaymentMethod,
                    MxDefaultPaymentType = _settings.MxDefaultPaymentType,
                    CaGstNumber = _settings.CaGstNumber,
                    CaPstNumber = _settings.CaPstNumber,
                    CaHstNumber = _settings.CaHstNumber,
                    CaQstNumber = _settings.CaQstNumber,
                    MxMaxBackdateHours = _settings.MxMaxBackdateHours
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tax settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private int? GetTaxIdMaxLength()
    {
        if (string.IsNullOrEmpty(_model.CountryCode))
            return null;
            
        var format = TaxIdValidator.GetFormatForCountry(_model.CountryCode);
        return format?.MaxLength;
    }

    private async Task ValidateSettings()
    {
        if (string.IsNullOrEmpty(_model.CountryCode)) return;

        try
        {
            var errors = await TaxSettingsService.ValidateSettingsAsync(_model.CountryCode, _model);
            _isValid = !errors.Any();
            
            if (!_isValid)
            {
                var taxIdError = errors.FirstOrDefault(e => e.Contains("RFC") || e.Contains("BN"));
                if (taxIdError != null)
                {
                    _taxIdError = true;
                    _taxIdErrorText = taxIdError;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating settings");
            Snackbar.Add(L["Error validating settings"], Severity.Error);
        }
    }

    private async Task OnCertificateFileChanged(IBrowserFile? file)
    {
        if (file == null) return;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024).CopyToAsync(ms);
            _csdCertBase64 = Convert.ToBase64String(ms.ToArray());
            _certFileName = file.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading certificate file");
            Snackbar.Add(L["Error reading file"], Severity.Error);
        }
    }

    private async Task OnPrivateKeyFileChanged(IBrowserFile? file)
    {
        if (file == null) return;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024).CopyToAsync(ms);
            _csdKeyBase64 = Convert.ToBase64String(ms.ToArray());
            _keyFileName = file.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading private key file");
            Snackbar.Add(L["Error reading file"], Severity.Error);
        }
    }

    private async Task SaveCsdAsync()
    {
        if (_csdCertBase64 == null && _csdKeyBase64 == null && string.IsNullOrEmpty(_csdPassword))
            return;

        var dto = new UpdateMexicoPacSettingsDto
        {
            ProviderName = _pacSettings?.ProviderName ?? "SW Sapien",
            User = _pacSettings?.User,
            ProductionUrl = _pacSettings?.ProductionUrl ?? "https://services.sw.com.mx",
            TestUrl = _pacSettings?.TestUrl,
            IsProduction = _pacSettings?.IsProduction ?? false,
            CsdCertificateBase64 = _csdCertBase64,
            CsdPrivateKeyBase64 = _csdKeyBase64,
            CsdPassword = _csdPassword
        };

        var result = await PacSettingsService.SaveAsync(dto);
        if (result.IsSuccess)
        {
            _pacSettings = result.Value;
            _csdCertBase64 = null;
            _csdKeyBase64 = null;
            _csdPassword = null;
            _certFileName = null;
            _keyFileName = null;
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task SaveChangesAsync()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                await ValidateSettings();
                if (_isValid)
                {
                    await TaxSettingsService.UpdateSettingsAsync(_model);
                    await SaveCsdAsync();
                    Snackbar.Add(L["Settings updated successfully"], Severity.Success);
                    await LoadSettings();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving tax settings");
                Snackbar.Add(L["Error saving settings"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }
}