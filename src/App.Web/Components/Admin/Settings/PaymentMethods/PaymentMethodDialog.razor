@using App.Core.DTOs.Settings
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Settings
@using MudBlazor

@inject IStringLocalizer<PaymentMethodDialog> L
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_dto.Name"
                                  Label="@L["Name"]"
                                  Required="true"
                                  RequiredError="@L["Name is required"]"
                                  MaxLength="100"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_dto.Type"
                               Label="@L["Type"]"
                               Required="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="PaymentMethodType.Cash">@L["Cash"]</MudSelectItem>
                        <MudSelectItem Value="PaymentMethodType.Card">@L["Card"]</MudSelectItem>
                        <MudSelectItem Value="PaymentMethodType.Transfer">@L["Transfer"]</MudSelectItem>
                        <MudSelectItem Value="PaymentMethodType.Check">@L["Check"]</MudSelectItem>
                        <MudSelectItem Value="PaymentMethodType.Other">@L["Other"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (_dto.Type == PaymentMethodType.Card)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="_dto.CardSubtype"
                                   Label="@L["Card Subtype"]"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="CardSubtype?" Value="null">@L["Not specified"]</MudSelectItem>
                            <MudSelectItem T="CardSubtype?" Value="CardSubtype.Debit">@L["Debit"]</MudSelectItem>
                            <MudSelectItem T="CardSubtype?" Value="CardSubtype.Credit">@L["Credit"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12" sm="@(_dto.Type == PaymentMethodType.Card ? 6 : 12)">
                    <MudTextField @bind-Value="_dto.MxCfdiFormCode"
                                  Label="@L["CFDI Form Code (MX)"]"
                                  Placeholder="01"
                                  MaxLength="5"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["Code from SAT catalog (mx_payment_forms)"]" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_dto.Icon"
                                  Label="@L["Icon (Material Icons name)"]"
                                  Placeholder="payments"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_dto.Icon" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_dto.SortOrder"
                                     Label="@L["Sort Order"]"
                                     Min="0"
                                     Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_dto.IsActive"
                               Label="@L["Active in point of sale"]"
                               Color="Color.Success" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save" Disabled="@(!_isValid)">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public CreatePaymentMethodDto Dto { get; set; } = new() { IsActive = true };

    private MudForm _form = null!;
    private bool _isValid;
    private CreatePaymentMethodDto _dto = new() { IsActive = true };

    protected override void OnParametersSet()
    {
        _dto = Dto;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        await _form.Validate();
        if (_form.IsValid)
            MudDialog.Close(DialogResult.Ok(_dto));
    }
}
