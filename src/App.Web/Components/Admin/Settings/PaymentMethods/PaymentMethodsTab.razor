@using App.Core.Constants
@using App.Core.DTOs.Settings
@using App.Core.Enums.Shop
@using App.Core.Interfaces.Settings
@using MudBlazor

@inject IPaymentMethodService PaymentMethodService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<PaymentMethodsTab> L
@inject ILogger<PaymentMethodsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudGrid>
            <MudItem xs="12">
                <div class="d-flex justify-space-between align-center mb-4">
                    <div>
                        <MudText Typo="Typo.h6">@L["Payment Methods"]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @L["Configure the payment methods available at the point of sale"]
                        </MudText>
                    </div>
                    <AuthorizeView Policy="@ApplicationClaims.Admin.ManageSettings" Context="authCtx">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog"
                                   Class="da-button-rounded">
                            @L["New Payment Method"]
                        </MudButton>
                    </AuthorizeView>
                </div>
            </MudItem>

            <MudItem xs="12">
                @if (_loading)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
                else if (!_paymentMethods.Any())
                {
                    <MudAlert Severity="Severity.Info">
                        @L["No payment methods configured. Create at least one to accept payments."]
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_paymentMethods" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width:50px"></MudTh>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Type"]</MudTh>
                            <MudTh>@L["Card Subtype"]</MudTh>
                            <MudTh>@L["CFDI Code (MX)"]</MudTh>
                            <MudTh Style="width:80px">@L["Order"]</MudTh>
                            <MudTh Style="width:100px">@L["Active"]</MudTh>
                            <MudTh Style="width:100px"></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="pm">
                            <MudTd>
                                <MudIcon Icon="@pm.Icon" Size="Size.Small"
                                         Style="@($"color:{GetTypeColor(pm.Type)}")" />
                            </MudTd>
                            <MudTd DataLabel="@L["Name"]">
                                <strong>@pm.Name</strong>
                            </MudTd>
                            <MudTd DataLabel="@L["Type"]">
                                <MudChip T="string" Size="Size.Small">@GetTypeName(pm.Type)</MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Card Subtype"]">
                                @if (pm.CardSubtype.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(pm.CardSubtype == CardSubtype.Debit ? Color.Info : Color.Warning)">
                                        @GetCardSubtypeName(pm.CardSubtype.Value)
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["CFDI Code (MX)"]">
                                @if (!string.IsNullOrEmpty(pm.MxCfdiFormCode))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                        @pm.MxCfdiFormCode
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Order"]">@pm.SortOrder</MudTd>
                            <MudTd DataLabel="@L["Active"]">
                                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageSettings" Context="authSwitch">
                                    <Authorized>
                                        <MudSwitch Value="@pm.IsActive"
                                                   ValueChanged="@((bool v) => ToggleActive(pm))"
                                                   Color="Color.Success"
                                                   T="bool" />
                                    </Authorized>
                                    <NotAuthorized>
                                        <MudIcon Icon="@(pm.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                 Color="@(pm.IsActive ? Color.Success : Color.Error)"
                                                 Size="Size.Small" />
                                    </NotAuthorized>
                                </AuthorizeView>
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageSettings" Context="authBtn">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(pm))"
                                                   title="@L["Edit"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => OpenDeleteDialog(pm))"
                                                   title="@L["Delete"]" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">@L["You don't have permission to view this section"]</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private List<PaymentMethodDto> _paymentMethods = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _paymentMethods = (await PaymentMethodService.GetAllAsync(includeInactive: true)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading payment methods");
            Snackbar.Add(L["Error loading payment methods"], Severity.Error);
        }
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var dto = new CreatePaymentMethodDto { IsActive = true };
        var parameters = new DialogParameters<PaymentMethodDialog>
        {
            { x => x.Dto, dto }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<PaymentMethodDialog>(L["New Payment Method"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreatePaymentMethodDto created })
        {
            var serviceResult = await PaymentMethodService.CreateAsync(created);
            if (serviceResult.IsSuccess)
            {
                Snackbar.Add(L["Payment method created"], Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Error!, Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(PaymentMethodDto pm)
    {
        var dto = new CreatePaymentMethodDto
        {
            Name = pm.Name,
            Type = pm.Type,
            CardSubtype = pm.CardSubtype,
            MxCfdiFormCode = pm.MxCfdiFormCode,
            Icon = pm.Icon,
            IsActive = pm.IsActive,
            SortOrder = pm.SortOrder
        };
        var parameters = new DialogParameters<PaymentMethodDialog>
        {
            { x => x.Dto, dto }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<PaymentMethodDialog>(L["Edit Payment Method"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreatePaymentMethodDto updated })
        {
            var updateDto = new UpdatePaymentMethodDto
            {
                Name = updated.Name,
                Type = updated.Type,
                CardSubtype = updated.CardSubtype,
                MxCfdiFormCode = updated.MxCfdiFormCode,
                Icon = updated.Icon,
                IsActive = updated.IsActive,
                SortOrder = updated.SortOrder
            };
            var serviceResult = await PaymentMethodService.UpdateAsync(pm.Id, updateDto);
            if (serviceResult.IsSuccess)
            {
                Snackbar.Add(L["Payment method updated"], Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Error!, Severity.Error);
            }
        }
    }

    private async Task ToggleActive(PaymentMethodDto pm)
    {
        var result = await PaymentMethodService.ToggleActiveAsync(pm.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Payment method updated"], Severity.Success);
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private async Task OpenDeleteDialog(PaymentMethodDto pm)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Confirm Delete"],
            (MarkupString)L["Are you sure you want to delete {0}?", pm.Name].ToString(),
            yesText: L["Delete"],
            cancelText: L["Cancel"]);

        if (confirmed == true)
        {
            var serviceResult = await PaymentMethodService.DeleteAsync(pm.Id);
            if (serviceResult.IsSuccess)
            {
                Snackbar.Add(L["Payment method deleted"], Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Error!, Severity.Error);
            }
        }
    }

    private static string GetTypeName(PaymentMethodType type) => type switch
    {
        PaymentMethodType.Cash => "Cash",
        PaymentMethodType.Card => "Card",
        PaymentMethodType.Transfer => "Transfer",
        PaymentMethodType.Check => "Check",
        _ => "Other"
    };

    private static string GetCardSubtypeName(CardSubtype subtype) => subtype switch
    {
        CardSubtype.Debit => "Debit",
        CardSubtype.Credit => "Credit",
        _ => ""
    };

    private static string GetTypeColor(PaymentMethodType type) => type switch
    {
        PaymentMethodType.Cash => "#4CAF50",
        PaymentMethodType.Card => "#2196F3",
        PaymentMethodType.Transfer => "#9C27B0",
        PaymentMethodType.Check => "#607D8B",
        _ => "#9E9E9E"
    };
}
