@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Core.Constants
@using App.Core.Interfaces.Settings
@using App.Web.Services

@inject IInventorySettingsService InventorySettingsService
@inject IPermissionCheckService PermissionService
@inject IStringLocalizer<InventorySettingsTab> L
@inject ISnackbar Snackbar
@inject ILogger<InventorySettingsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudForm Model="@_model" @ref="@_form">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-4">@L["Inventory Settings"]</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.ShowStockDuringPhysicalCount"
                               Label="@L["Show system stock during physical count"]"
                               Color="Color.Primary"
                               ReadOnly="@(!_hasWriteAccess)" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @L["When disabled, the current system quantity is hidden while counting to avoid biasing the counted value. It is always shown in the review step before applying the count."]
                    </MudText>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-end mt-8">
                    <AuthorizeView Policy="@ApplicationClaims.Admin.ManageSettings">
                        <Authorized Context="authContext">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="SaveChangesAsync"
                                       Disabled="@_processing"
                                       Class="da-button-rounded">
                                @if (_processing)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">@L["Saving"]</MudText>
                                }
                                else
                                {
                                    @L["Save Changes"]
                                }
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudItem>
            </MudGrid>
        </MudForm>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm _form = null!;
    private bool _processing;
    private bool _hasWriteAccess;
    private UpdateInventorySettingsDto _model = new()
    {
        ShowStockDuringPhysicalCount = true
    };

    protected override async Task OnInitializedAsync()
    {
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageSettings);
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            var result = await InventorySettingsService.GetSettingsAsync();
            if (result.IsSuccess && result.Value != null)
            {
                _model = new UpdateInventorySettingsDto
                {
                    ShowStockDuringPhysicalCount = result.Value.ShowStockDuringPhysicalCount
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading inventory settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private async Task SaveChangesAsync()
    {
        _processing = true;
        StateHasChanged();

        try
        {
            var result = await InventorySettingsService.CreateOrUpdateSettingsAsync(_model);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Inventory settings updated successfully"], Severity.Success);
                await LoadSettings();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error updating settings"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving inventory settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
}
