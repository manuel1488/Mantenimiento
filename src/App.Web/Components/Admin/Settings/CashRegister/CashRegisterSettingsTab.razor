@using App.Core.DTOs.Shop
@using App.Core.Interfaces.Shop

@inject ICashRegisterService CashRegisterService
@inject IStringLocalizer<CashRegisterSettingsTab> L
@inject ISnackbar Snackbar
@inject ILogger<CashRegisterSettingsTab> Logger

@if (_loading)
{
    <div class="d-flex justify-center pa-4">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <MudForm @ref="_form" @bind-IsValid="_isValid">
        <MudGrid>

            @* ── Withdrawal Limit ── *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1"><strong>@L["Withdrawal Limit"]</strong></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal?"
                                 @bind-Value="_model.MaxWithdrawalAmount"
                                 Label="@L["Maximum Withdrawal Amount (optional)"]"
                                 Variant="Variant.Outlined"
                                 Min="0.01m"
                                 Format="C2"
                                 Required="@(_model.IsStrictWithdrawalLimit)"
                                 RequiredError="@L["Withdrawal limit is required when strict mode is enabled"]"
                                 HelperText="@L["Leave empty for no withdrawal limit"]" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
                <MudSwitch T="bool"
                           @bind-Value="_model.IsStrictWithdrawalLimit"
                           Label="@L["Strict Withdrawal Limit"]"
                           Color="Color.Warning"
                           Disabled="@(!_model.MaxWithdrawalAmount.HasValue)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @L["If enabled, withdrawals exceeding the limit are blocked"]
                </MudText>
            </MudItem>

            <MudItem xs="12"><MudDivider Class="my-3" /></MudItem>

            @* ── Cash Register Limit ── *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1"><strong>@L["Cash Register Limit"]</strong></MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal?"
                                 @bind-Value="_model.MaxCashLimit"
                                 Label="@L["Maximum Cash in Register (optional)"]"
                                 Variant="Variant.Outlined"
                                 Min="0.01m"
                                 Format="C2"
                                 Required="@(_model.IsStrictCashLimit)"
                                 RequiredError="@L["Cash limit is required when strict mode is enabled"]"
                                 HelperText="@L["Leave empty for no cash limit in register"]" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
                <MudSwitch T="bool"
                           @bind-Value="_model.IsStrictCashLimit"
                           Label="@L["Strict Cash Limit"]"
                           Color="Color.Warning"
                           Disabled="@(!_model.MaxCashLimit.HasValue)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @L["If enabled, new cash sales are blocked when the register reaches the limit"]
                </MudText>
            </MudItem>

            <MudItem xs="12"><MudDivider Class="my-3" /></MudItem>

            @* ── General ── *@
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal?"
                                 @bind-Value="_model.DefaultInitialFund"
                                 Label="@L["Default Initial Fund (optional)"]"
                                 Variant="Variant.Outlined"
                                 Min="0m"
                                 Format="C2"
                                 HelperText="@L["Pre-filled when opening a new cash register"]" />
            </MudItem>

            <MudItem xs="12">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="Save"
                           Disabled="@(!_isValid || _processing)">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @L["Saving..."]
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudForm>
}

@code {
    #region Fields
    private MudForm _form = null!;
    private bool _isValid;
    private bool _loading = true;
    private bool _processing;
    private UpdateCashRegisterSettingsDto _model = new();
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        var result = await CashRegisterService.GetSettingsAsync();
        if (result.IsSuccess && result.Value is not null)
        {
            _model.MaxWithdrawalAmount = result.Value.MaxWithdrawalAmount;
            _model.IsStrictWithdrawalLimit = result.Value.IsStrictWithdrawalLimit;
            _model.MaxCashLimit = result.Value.MaxCashLimit;
            _model.IsStrictCashLimit = result.Value.IsStrictCashLimit;
            _model.DefaultInitialFund = result.Value.DefaultInitialFund;
        }
        _loading = false;
    }
    #endregion

    #region Methods
    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        // Reset strict flags if limit was cleared
        if (!_model.MaxWithdrawalAmount.HasValue) _model.IsStrictWithdrawalLimit = false;
        if (!_model.MaxCashLimit.HasValue) _model.IsStrictCashLimit = false;

        _processing = true;
        var result = await CashRegisterService.UpdateSettingsAsync(_model);
        _processing = false;

        if (result.IsSuccess)
            Snackbar.Add(L["Settings saved successfully"], Severity.Success);
        else
            Snackbar.Add(result.Error, Severity.Error);
    }
    #endregion
}
