@using App.Core.DTOs.Shop
@using App.Core.Interfaces.Shop
@using App.Web.Components.Shared.Dialogs

@inject IPartialSaleFractionService FractionService
@inject IDialogService DialogService
@inject IStringLocalizer<PartialSaleFractionsTab> L
@inject ISnackbar Snackbar
@inject ILogger<PartialSaleFractionsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudPaper Class="pa-4" Elevation="0">
            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">@L["Partial Sale Fractions"]</MudText>

                    <AuthorizeView Context="authNew" Policy="@ApplicationClaims.Admin.ManageSettings">
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Error"
                                StartIcon="@Icons.Material.Filled.Add"
                                OnClick="OpenCreateDialog"
                                Class="da-button-rounded">
                            @L["New Fraction"]
                        </MudButton>
                    </AuthorizeView>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                        @L["Configure the fractions available for partial product sales (e.g., 1/2, 1/4, 1/8)."]
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudTable T="PartialSaleFractionDto"
                            Items="@_fractions"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading">
                        <HeaderContent>
                            <MudTh>@L["Code"]</MudTh>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Fraction"]</MudTh>
                            <MudTh>@L["Value"]</MudTh>
                            <MudTh>@L["Order"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                            <MudTh Style="width: 120px">@L["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="fraction">
                            <MudTd DataLabel="@L["Code"]">@fraction.Code</MudTd>
                            <MudTd DataLabel="@L["Name"]">@fraction.Name</MudTd>
                            <MudTd DataLabel="@L["Fraction"]">@fraction.Numerator / @fraction.Denominator</MudTd>
                            <MudTd DataLabel="@L["Value"]">@fraction.FractionValue.ToString("P2")</MudTd>
                            <MudTd DataLabel="@L["Order"]">@fraction.DisplayOrder</MudTd>
                            <MudTd DataLabel="@L["Status"]">
                                <MudChip T="string"
                                        Color="@(fraction.IsActive ? Color.Success : Color.Default)"
                                        Size="Size.Small">
                                    @(fraction.IsActive ? L["Active"] : L["Inactive"])
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Context="authActions" Policy="@ApplicationClaims.Admin.ManageSettings">
                                    <MudIconButton Icon="@(fraction.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                                Size="Size.Small"
                                                Color="@(fraction.IsActive ? Color.Success : Color.Default)"
                                                OnClick="@(() => ToggleActive(fraction))"
                                                title="@(fraction.IsActive ? L["Deactivate"] : L["Activate"])" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                Size="Size.Small"
                                                OnClick="@(() => OpenEditDialog(fraction))"
                                                title="@L["Edit"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                Size="Size.Small"
                                                Color="Color.Error"
                                                OnClick="@(() => OpenDeleteDialog(fraction))"
                                                title="@L["Delete"]" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>@L["No fractions found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PartialSaleFractionDto> _fractions = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadFractions();
    }

    private async Task LoadFractions()
    {
        try
        {
            _loading = true;
            var result = await FractionService.GetAllFractionsAsync();
            if (result.IsSuccess)
            {
                _fractions = result.Value!.ToList();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error loading fractions"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fractions");
            Snackbar.Add(L["Error loading fractions"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<PartialSaleFractionDialog>();

        var dialog = await DialogService.ShowAsync<PartialSaleFractionDialog>(L["New Fraction"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadFractions();
        }
    }

    private async Task OpenEditDialog(PartialSaleFractionDto fraction)
    {
        var parameters = new DialogParameters<PartialSaleFractionDialog>
        {
            { x => x.FractionId, fraction.Id }
        };

        var dialog = await DialogService.ShowAsync<PartialSaleFractionDialog>(L["Edit Fraction"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadFractions();
        }
    }

    private async Task OpenDeleteDialog(PartialSaleFractionDto fraction)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Fraction"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete this fraction?"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), $"{fraction.Name} ({fraction.Code})" },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Fraction"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var deleteResult = await FractionService.DeleteFractionAsync(fraction.Id);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add(L["Fraction deleted successfully"], Severity.Success);
                    await LoadFractions();
                }
                else
                {
                    Snackbar.Add(deleteResult.Error ?? L["Error deleting fraction"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting fraction: {Message}", ex.Message);
                Snackbar.Add(L["Error deleting fraction"], Severity.Error);
            }
        }
    }

    private async Task ToggleActive(PartialSaleFractionDto fraction)
    {
        try
        {
            var result = await FractionService.ToggleActiveAsync(fraction.Id);
            if (result.IsSuccess)
            {
                var message = fraction.IsActive ? L["Fraction deactivated"] : L["Fraction activated"];
                Snackbar.Add(message, Severity.Success);
                await LoadFractions();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error updating fraction status"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling fraction status");
            Snackbar.Add(L["Error updating fraction status"], Severity.Error);
        }
    }
}
