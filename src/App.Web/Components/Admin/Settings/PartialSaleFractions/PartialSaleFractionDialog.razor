@using App.Core.DTOs.Shop
@using App.Core.Interfaces.Shop

@inject IPartialSaleFractionService FractionService
@inject IStringLocalizer<PartialSaleFractionDialog> L
@inject ISnackbar Snackbar
@inject ILogger<PartialSaleFractionDialog> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ManageSettings">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 500px;" Class="pa-4">
                    <MudForm Model="@_model" @ref="@_form">
                        <MudGrid>
                            <!-- Code -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Code"
                                            Label="@L["Code"]"
                                            Required="true"
                                            HelperText="@L["e.g., 1/2, 1/4, 1/8"]"
                                            RequiredError="@L["Code is required"]"
                                            Error="@_codeError"
                                            ErrorText="@_codeErrorText"
                                            OnBlur="@ValidateCode" />
                            </MudItem>

                            <!-- Name -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Name"
                                            Label="@L["Name"]"
                                            Required="true"
                                            HelperText="@L["e.g., Half, Quarter"]"
                                            RequiredError="@L["Name is required"]" />
                            </MudItem>

                            <!-- Numerator -->
                            <MudItem xs="6">
                                <MudNumericField T="int"
                                                Value="_model.Numerator"
                                                ValueChanged="@((int val) => OnNumeratorChanged(val))"
                                                Label="@L["Numerator"]"
                                                Required="true"
                                                Min="1"
                                                Max="100"
                                                RequiredError="@L["Numerator is required"]" />
                            </MudItem>

                            <!-- Denominator -->
                            <MudItem xs="6">
                                <MudNumericField T="int"
                                                Value="_model.Denominator"
                                                ValueChanged="@((int val) => OnDenominatorChanged(val))"
                                                Label="@L["Denominator"]"
                                                Required="true"
                                                Min="1"
                                                Max="100"
                                                RequiredError="@L["Denominator is required"]" />
                            </MudItem>

                            <!-- Calculated Value -->
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    @L["Fraction value"]: @_calculatedValue.ToString("P2") (@_calculatedValue.ToString("F6"))
                                </MudAlert>
                            </MudItem>

                            <!-- Display Order -->
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_model.DisplayOrder"
                                                Label="@L["Display Order"]"
                                                Min="0"
                                                Max="100"
                                                HelperText="@L["Lower numbers appear first"]" />
                            </MudItem>

                            <!-- Is Active -->
                            <MudItem xs="6" Class="d-flex align-center">
                                <MudSwitch @bind-Value="_model.IsActive"
                                          Label="@L["Active"]"
                                          Color="Color.Success" />
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel"
                        Class="da-button-rounded"
                        title="@L["Cancel"]">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary"
                        OnClick="Submit"
                        Variant="Variant.Filled"
                        Disabled="@(_processing || !_isValid)"
                        title="@L["Save"]"
                        Class="da-button-rounded">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@L["Saving"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to perform this action"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? FractionId { get; set; }

    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool _codeError;
    private string _codeErrorText = string.Empty;
    private decimal _calculatedValue;
    private bool IsNew => !FractionId.HasValue;

    private UpdatePartialSaleFractionDto _model = new()
    {
        Code = "",
        Name = "",
        Numerator = 1,
        Denominator = 2,
        DisplayOrder = 0,
        IsActive = true
    };

    protected override async Task OnInitializedAsync()
    {
        if (FractionId.HasValue)
        {
            await LoadFraction();
        }
        else
        {
            // Set initial calculated value
            UpdateCalculatedValue();
        }
    }

    private async Task LoadFraction()
    {
        try
        {
            var result = await FractionService.GetFractionByIdAsync(FractionId!.Value);
            if (result.IsSuccess && result.Value != null)
            {
                var fraction = result.Value;
                _model = new UpdatePartialSaleFractionDto
                {
                    Code = fraction.Code,
                    Name = fraction.Name,
                    Numerator = fraction.Numerator,
                    Denominator = fraction.Denominator,
                    DisplayOrder = fraction.DisplayOrder,
                    IsActive = fraction.IsActive
                };
                _calculatedValue = fraction.FractionValue;
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error loading fraction"], Severity.Error);
                MudDialog.Cancel();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fraction");
            Snackbar.Add(L["Error loading fraction"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private void OnNumeratorChanged(int value)
    {
        _model.Numerator = value;
        UpdateCalculatedValue();
    }

    private void OnDenominatorChanged(int value)
    {
        _model.Denominator = value;
        UpdateCalculatedValue();
    }

    private void UpdateCalculatedValue()
    {
        if (_model.Denominator > 0)
        {
            _calculatedValue = (decimal)_model.Numerator / _model.Denominator;
        }
        else
        {
            _calculatedValue = 0;
        }
    }

    private async Task ValidateCode()
    {
        if (string.IsNullOrWhiteSpace(_model.Code))
            return;

        try
        {
            var result = await FractionService.ValidateUniqueCodeAsync(_model.Code, FractionId);
            if (result.IsSuccess)
            {
                _codeError = !result.Value;
                _codeErrorText = result.Value ? string.Empty : L["Code already exists"];
                _isValid = result.Value;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating code");
            Snackbar.Add(L["Error validating code"], Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        await ValidateCode();

        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                if (FractionId.HasValue)
                {
                    var result = await FractionService.UpdateFractionAsync(FractionId.Value, _model);
                    if (result.IsSuccess)
                    {
                        Snackbar.Add(L["Fraction updated successfully"], Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add(result.Error ?? L["Error updating fraction"], Severity.Error);
                    }
                }
                else
                {
                    var createDto = new CreatePartialSaleFractionDto
                    {
                        Code = _model.Code,
                        Name = _model.Name,
                        Numerator = _model.Numerator,
                        Denominator = _model.Denominator,
                        DisplayOrder = _model.DisplayOrder,
                        IsActive = _model.IsActive
                    };

                    var result = await FractionService.CreateFractionAsync(createDto);
                    if (result.IsSuccess)
                    {
                        Snackbar.Add(L["Fraction created successfully"], Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add(result.Error ?? L["Error creating fraction"], Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving fraction");
                Snackbar.Add(L["Error saving fraction"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }
}
