@using App.Core.Constants
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces.Billing
@using App.Web.Services
@using MudBlazor

@inject IMexicoPacSettingsService PacSettingsService
@inject IPermissionCheckService PermissionService
@inject ISnackbar Snackbar
@inject IStringLocalizer<BillingSettingsTab> L
@inject ILogger<BillingSettingsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewBillingSettings">
    <Authorized Context="viewAuth">
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid Spacing="3">

                <!-- Invoice Numbering -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["Invoice Numbering"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_model.InvoiceSerie"
                                          Label="@L["Invoice Serie"]"
                                          MaxLength="10"
                                          Variant="Variant.Outlined"
                                          ReadOnly="@(!_hasWriteAccess)"
                                          HelperText="@L["Letter prefix for folio (e.g. A, B, F)"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField @bind-Value="_model.StartFolio"
                                             Label="@L["Start Folio"]"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             ReadOnly="@(!_hasWriteAccess)"
                                             HelperText="@L["First folio number to use (applied when no invoices exist yet)"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField @bind-Value="_model.FolioLength"
                                             Label="@L["Folio Length (zero-pad)"]"
                                             Min="0"
                                             Max="20"
                                             Variant="Variant.Outlined"
                                             ReadOnly="@(!_hasWriteAccess)"
                                             HelperText="@L["Total digits padded with zeros. 0 = no padding. Example: length 6, folio 42 → 000042"]" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem xs="12"><MudDivider /></MudItem>

                <!-- Auto-Invoice Settings -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Auto-Invoice Settings"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="_model.AutoInvoicePromptEnabled"
                                       Label="@L["Show invoice prompt after sale"]"
                                       Color="Color.Primary"
                                       Disabled="@(!_hasWriteAccess)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-10">
                                @L["Ask customer if they want an invoice after each sale (for customers with fiscal data)"]
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="_model.AllowEditFiscalDataInPrompt"
                                       Label="@L["Allow editing fiscal data in prompt"]"
                                       Color="Color.Primary"
                                       Disabled="@(!_hasWriteAccess || !_model.AutoInvoicePromptEnabled)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-10">
                                @L["When disabled, only the email is shown in the invoice prompt"]
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <!-- Save Button -->
                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageBillingSettings" Context="manageAuth">
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SaveAsync"
                                   Disabled="@_processing"
                                   Class="da-button-rounded">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@L["Saving"]</MudText>
                            }
                            else
                            {
                                @L["Save Changes"]
                            }
                        </MudButton>
                    </MudItem>
                </AuthorizeView>

            </MudGrid>
        </MudForm>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">@L["You don't have permission to view this page"]</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private bool _hasWriteAccess;

    private UpdateMexicoBillingPreferencesDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageBillingSettings);
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            var settings = await PacSettingsService.GetAsync();
            if (settings != null)
            {
                _model = new UpdateMexicoBillingPreferencesDto
                {
                    InvoiceSerie = settings.InvoiceSerie ?? "A",
                    StartFolio = settings.StartFolio,
                    FolioLength = settings.FolioLength,
                    AutoInvoicePromptEnabled = settings.AutoInvoicePromptEnabled,
                    AllowEditFiscalDataInPrompt = settings.AllowEditFiscalDataInPrompt
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading billing settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        _processing = true;
        StateHasChanged();
        try
        {
            var result = await PacSettingsService.UpdateBillingPreferencesAsync(_model);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Settings saved successfully"], Severity.Success);
                await LoadSettings();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving billing settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
}
