@using App.Core.DTOs.Settings
@using App.Core.Interfaces
@using App.Services.Resources.PdfTemplates
@using App.Web.Components.Admin.Settings.Email
@using App.Web.Services

@inject IQuotationSettingsService QuotationSettingsService
@inject ISnackbar Snackbar
@inject IStringLocalizer<QuotationSettingsTab> L
@inject ILogger<QuotationSettingsTab> Logger
@inject IPermissionCheckService PermissionService
@inject IDialogService DialogService

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="3">

                    @* ── Payment Terms ──────────────────────────────────────────────── *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Payment Terms"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @L["Shown on every quotation PDF. Leave blank to hide the section."]
                        </MudText>
                        <MudTextField @bind-Value="_model.PaymentTermsText"
                                      Label="@L["Payment Terms Text"]"
                                      Lines="4"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="2000"
                                      FullWidth="true"
                                      HelperText="@L["e.g. 30 days net, 50% advance..."]" />
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>

                    @* ── Bank / Wire-transfer ───────────────────────────────────────── *@
                    <MudItem xs="12">
                        <div style="display:flex; align-items:center; gap:12px;" class="mb-2">
                            <MudText Typo="Typo.h6">@L["Wire Transfer Details"]</MudText>
                            <MudSwitch @bind-Value="_model.ShowBankDetails"
                                       Color="Color.Primary"
                                       Disabled="@(!_hasWriteAccess)"
                                       Label="@L["Show on PDF"]" />
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @L["Bank account information printed at the bottom of the quotation."]
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankBeneficiary"
                                      Label="@L["Beneficiary Name"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="150"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankRfc"
                                      Label="@L["RFC"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="30"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankName"
                                      Label="@L["Bank Name"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="100"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankAccountNumber"
                                      Label="@L["Account Number"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="50"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankClabeNumber"
                                      Label="CLABE"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="20"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.BankSwift"
                                      Label="SWIFT / BIC"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="20"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>

                    @* ── Contact / Social Media ─────────────────────────────────────── *@
                    <MudItem xs="12">
                        <div style="display:flex; align-items:center; gap:12px;" class="mb-2">
                            <MudText Typo="Typo.h6">@L["Contact & Social Media"]</MudText>
                            <MudSwitch @bind-Value="_model.ShowContactInfo"
                                       Color="Color.Primary"
                                       Disabled="@(!_hasWriteAccess)"
                                       Label="@L["Show on PDF"]" />
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @L["Contact details shown in the footer of the quotation."]
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactWebsite"
                                      Label="@L["Website"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="200"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Language" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactPhone"
                                      Label="@L["Phone"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="20"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactEmail"
                                      Label="@L["Email"]"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="100"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactWhatsapp"
                                      Label="WhatsApp"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="20"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Chat" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactFacebook"
                                      Label="Facebook"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="200"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Groups" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_model.ContactInstagram"
                                      Label="Instagram"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      MaxLength="200"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.PhotoCamera" />
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>

                    @* ── Template Customisation ─────────────────────────────────────── *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Template Customisation"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @L["Advanced: provide a full custom HTML body and/or CSS to override the default template. Leave blank to use the defaults."]
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_model.HtmlBody"
                                      Label="@L["HTML Body"]"
                                      Lines="20"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      Style="font-family: monospace; font-size: 12px;"
                                      FullWidth="true"
                                      HelperText="@L["Replaces the entire document body. Leave blank to use the default template."]" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_model.CustomCss"
                                      Label="@L["CSS Styles"]"
                                      Lines="20"
                                      Variant="Variant.Outlined"
                                      ReadOnly="@(!_hasWriteAccess)"
                                      Style="font-family: monospace; font-size: 12px;"
                                      FullWidth="true"
                                      HelperText="@L["Injected inside the style tag. Override --primary-color, fonts, etc."]" />
                    </MudItem>

                    @* ── Actions ────────────────────────────────────────────────────── *@
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.Preview"
                                       OnClick="OpenPreviewAsync"
                                       Disabled="@_saving">
                                @L["Preview"]
                            </MudButton>
                            @if (_hasWriteAccess)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                           OnClick="ResetTemplateAsync"
                                           Disabled="@(_saving || (string.IsNullOrWhiteSpace(_model.HtmlBody) && string.IsNullOrWhiteSpace(_model.CustomCss)))"
                                           title="@L["Clears HtmlBody and CustomCss — the embedded default template will be used."]">
                                    @L["Reset Template"]
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="SaveAsync"
                                           Disabled="@_saving">
                                    @if (_saving)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    }
                                    @L["Save"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudItem>

                </MudGrid>
            </MudForm>
        }
    </Authorized>
</AuthorizeView>

@code {
    #region Fields
    private MudForm _form = null!;
    private bool _isValid;
    private bool _loading = true;
    private bool _saving = false;
    private bool _hasWriteAccess = false;
    private QuotationSettingsDto _model = new();
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ManageSettings);
        await LoadAsync();
    }
    #endregion

    #region Methods
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _model = await QuotationSettingsService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading quotation settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_isValid) return;

        _saving = true;
        try
        {
            _model = await QuotationSettingsService.SaveSettingsAsync(_model);
            Snackbar.Add(L["Settings saved"], Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving quotation settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetTemplateAsync()
    {
        _model.HtmlBody = null;
        _model.CustomCss = null;
        await SaveAsync();
    }

    private async Task OpenPreviewAsync()
    {
        var bodyHtml = !string.IsNullOrWhiteSpace(_model.HtmlBody)
            ? _model.HtmlBody
            : DefaultQuotationTemplate.Html;

        var css = DefaultQuotationTemplate.Css
                  + (!string.IsNullOrWhiteSpace(_model.CustomCss) ? "\n" + _model.CustomCss : string.Empty);

        var fullHtml = $"<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><style>{css}</style></head><body>{bodyHtml}</body></html>";
        var template = Scriban.Template.Parse(fullHtml);
        var sampleData = QuotationTemplateSampleData.GetSampleData();
        var rendered = await template.RenderAsync(sampleData);

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<EmailTemplatePreviewDialog>(L["Preview"], new DialogParameters<EmailTemplatePreviewDialog>
        {
            { x => x.HtmlContent, rendered },
            { x => x.AlertMessage, L["This preview uses sample data. The actual PDF will use real quotation data."].Value }
        }, options);
    }
    #endregion
}
