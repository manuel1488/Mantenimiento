@using App.Core.DTOs.Branch
@using App.Core.DTOs.Warehouse
@using App.Core.Interfaces
@using App.Web.Components.Shared.Dialogs

@inject IWarehouseService WarehouseService
@inject IBranchService BranchService
@inject IStringLocalizer<WarehouseDialog> L
@inject ISnackbar Snackbar
@inject ILogger<WarehouseDialog> Logger
@inject IDialogService DialogService

<AuthorizeView Policy="@ApplicationClaims.Admin.ManageWarehouseSettings">
    <Authorized>
        <MudDialog>
            <DialogContent>
                <MudContainer Style="max-width: 800px;" Class="pa-4">
                    <MudForm Model="@_model" @ref="@_form">
                        <MudGrid>
                            <!-- Name -->
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.Name"
                                            Label="@L["Name"]"
                                            Required="true"
                                            RequiredError="@L["Name is required"]"
                                            OnBlur="@(() => ValidateName(_model.Name))"
                                            Error="@_nameError"
                                            ErrorText="@(_nameError ? L["Warehouse name already exists"]?.ToString() : null)" />
                            </MudItem>

                            <!-- Branch -->
                            <MudItem xs="12" md="6">
                                <MudSelect T="int?" @bind-Value="_model.BranchId"
                                          Label="@L["Branch"]"
                                          Clearable="true"
                                          Placeholder="@L["No branch assigned"]">
                                    @foreach (var branch in _branches)
                                    {
                                        <MudSelectItem T="int?" Value="@branch.Id">@branch.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Description -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.Description"
                                            Label="@L["Description"]"
                                            Lines="2" />
                            </MudItem>

                            <MudItem xs="12">
                                <!-- Active status -->
                                <MudCheckBox T="bool"
                                        @bind-Value="_model.IsActive"
                                        Label="@L["Active"]"
                                        Color="Color.Primary"
                                        Dense="true" />
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="Cancel" 
                        Class="da-button-rounded" 
                        title="@L["Cancel editing"]">
                    @L["Cancel"]
                </MudButton>
                <MudButton Color="Color.Error"
                        OnClick="Submit"
                        Variant="Variant.Filled"
                        Disabled="@(_processing || !_isValid)"
                        title="@L["Save warehouse data"]"
                        Class="da-button-rounded">
                    @if(_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">@L["Saving"]</MudText>
                    }
                    else
                    {
                        @L["Save"]
                    }
                </MudButton>
            </DialogActions>
        </MudDialog>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? WarehouseId { get; set; }

    private MudForm _form = null!;
    private bool _processing;
    private bool _isValid = true;
    private bool _nameError;
    private WarehouseDto? _warehouse;
    private bool IsNew => !WarehouseId.HasValue;
    private IList<BranchDto> _branches = new List<BranchDto>();

    private CreateWarehouseDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBranches();

        if (WarehouseId.HasValue)
        {
            await LoadWarehouse();
        }
    }

    private async Task LoadBranches()
    {
        try
        {
            var result = await BranchService.GetActiveBranchesAsync();
            if (result.IsSuccess)
            {
                _branches = result.Value;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading branches");
        }
    }

    private async Task LoadWarehouse()
    {
        try
        {
            _warehouse = await WarehouseService.GetWarehouseByIdAsync(WarehouseId!.Value);
            if (_warehouse != null)
            {
                _model = new CreateWarehouseDto
                {
                    Name = _warehouse.Name,
                    Description = _warehouse.Description,
                    IsActive = _warehouse.IsActive,
                    BranchId = _warehouse.BranchId
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading warehouse {WarehouseId}", WarehouseId);
            Snackbar.Add(L["Error loading warehouse"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid && _isValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                if (WarehouseId.HasValue)
                {
                    var updateDto = new UpdateWarehouseDto
                    {
                        Name = _model.Name,
                        Description = _model.Description,
                        IsActive = _model.IsActive,
                        BranchId = _model.BranchId
                    };

                    await WarehouseService.UpdateWarehouseAsync(WarehouseId.Value, updateDto);
                    Snackbar.Add(L["Warehouse updated successfully"], Severity.Success);
                }
                else
                {
                    // Check if exists and wharehouse with the same name
                    var isUnique = await WarehouseService.ValidateUniqueNameAsync(_model.Name, WarehouseId);
                    if(!isUnique)
                    {
                        _nameError = true;
                        _isValid = false;
                        Snackbar.Add(L["Warehouse name already exists"], Severity.Warning);
                        StateHasChanged();
                        return;
                    }

                    var createdWarehouse = await WarehouseService.CreateWarehouseAsync(_model);
                    Snackbar.Add(L["Warehouse created successfully"], Severity.Success);
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error saving warehouse");
                Snackbar.Add(L["Error saving warehouse"], Severity.Error);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }

    private async Task ValidateName(string name)
    {
        if (string.IsNullOrEmpty(name))
            return;

        try
        {
            var isUnique = await WarehouseService.ValidateUniqueNameAsync(name, WarehouseId);
            _nameError = !isUnique;
            _isValid = isUnique;
            
            if (_nameError)
            {
                Snackbar.Add(L["Warehouse name already exists"], Severity.Warning);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating warehouse name");
            Snackbar.Add(L["Error validating warehouse name"], Severity.Error);
        }
    }
}