@using App.Core.DTOs.Warehouse
@using App.Core.Interfaces
@using App.Web.Components.Shared.Dialogs

@inject IWarehouseService WarehouseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<WarehousesTab> L
@inject ILogger<WarehousesTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewWarehouseSettings">
    <Authorized>
        <MudPaper Class="pa-4" Elevation="0">
            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">@L["Warehouses"]</MudText>

                    <!-- Filter and New Button -->
                    <div class="d-flex gap-4">
                        <MudTextField T="string" 
                                    ValueChanged="@(s => OnSearch(s))"
                                    Placeholder="@L["Search warehouses"]"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Search"
                                    Style="width: 300px"/>

                        <AuthorizeView Context="authNew" Policy="@ApplicationClaims.Admin.ManageWarehouseSettings">
                            <MudButton Variant="Variant.Filled"
                                    Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.Add"
                                    OnClick="OpenCreateDialog"
                                    Class="da-button-rounded">
                                @L["New Warehouse"]
                            </MudButton>
                        </AuthorizeView>                        
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <MudTable T="WarehouseDto" 
                            ServerData="@LoadServerData"
                            Dense="true"
                            Hover="true"
                            Loading="@_loading"
                            @ref="_table">
                        <HeaderContent>
                            <MudTh>@L["Name"]</MudTh>
                            <MudTh>@L["Description"]</MudTh>
                            <MudTh>@L["Branch"]</MudTh>
                            <MudTh>@L["Status"]</MudTh>
                            <MudTh Style="width: 100px">@L["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="warehouseContext">
                            <MudTd DataLabel="@L["Name"]">@warehouseContext.Name</MudTd>
                            <MudTd DataLabel="@L["Description"]">@warehouseContext.Description</MudTd>
                            <MudTd DataLabel="@L["Branch"]">
                                @if (!string.IsNullOrEmpty(warehouseContext.BranchName))
                                {
                                    @warehouseContext.BranchName
                                }
                                else
                                {
                                    <MudText>-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Status"]">
                                <MudChip T="bool" Size="Size.Small"
                                        Color="@(warehouseContext.IsActive ? Color.Success : Color.Error)">
                                    @(warehouseContext.IsActive ? L["Active"] : L["Inactive"])
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <AuthorizeView Context="authActions" Policy="@ApplicationClaims.Admin.ManageWarehouseSettings">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                Size="Size.Small"
                                                OnClick="@(() => OpenEditDialog(warehouseContext))"
                                                title="@L["Edit Warehouse"]" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                Size="Size.Small"
                                                Color="Color.Error"
                                                title="@L["Delete Warehouse"]"
                                                OnClick="@(() => OpenDeleteDialog(warehouseContext))" />
                                </AuthorizeView>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                        <NoRecordsContent>
                            <MudText>@L["No warehouses found"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>


@code {
    private MudTable<WarehouseDto> _table = null!;
    private bool _loading;
    private string _searchString = "";

    private async Task<TableData<WarehouseDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            var (totalItems, items) = await WarehouseService.GetWarehousesAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                searchString: _searchString);

            return new TableData<WarehouseDto>() { TotalItems = totalItems, Items = items };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading warehouses");
            Snackbar.Add(L["Error loading warehouses"], Severity.Error);
            return new TableData<WarehouseDto>() { TotalItems = 0, Items = Enumerable.Empty<WarehouseDto>() };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        await _table.ReloadServerData();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<WarehouseDialog>(L["New Warehouse"]);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenEditDialog(WarehouseDto warehouse)
    {
        var parameters = new DialogParameters<WarehouseDialog>
        {
            { x => x.WarehouseId, warehouse.Id }
        };

        var dialog = await DialogService.ShowAsync<WarehouseDialog>(
            L["Edit Warehouse"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenDeleteDialog(WarehouseDto warehouse)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Warehouse"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete warehouse:"].ToString() },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() },
            { nameof(ConfirmDialog.HighlightedText), warehouse.Name },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["Delete Warehouse"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var success = await WarehouseService.DeleteWarehouseAsync(warehouse.Id);
                if (success)
                {
                    Snackbar.Add(L["Warehouse deleted successfully"], Severity.Success);
                    await _table.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(L["Error deleting warehouse"], Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting warehouse {WarehouseId}", warehouse.Id);
                Snackbar.Add(L["Error deleting warehouse"], Severity.Error);
            }
        }
    }
}