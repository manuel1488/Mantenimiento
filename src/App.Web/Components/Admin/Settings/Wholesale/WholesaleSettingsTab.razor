@using App.Core.DTOs.Settings
@using App.Core.Enums.Shop
@using App.Core.Interfaces
@using App.Core.Constants
@using App.Core.Interfaces.Settings
@using App.Web.Services

@inject IWholesaleSettingsService WholesaleSettingsService
@inject IPermissionCheckService PermissionService
@inject IStringLocalizer<WholesaleSettingsTab> L
@inject ISnackbar Snackbar
@inject ILogger<WholesaleSettingsTab> Logger

<AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
    <Authorized>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-4">@L["Wholesale Price Mode"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @L["Choose how wholesale prices are defined for products."]
                </MudText>
                <MudRadioGroup T="WholesalePriceMode"
                               Value="_model.PriceMode"
                               ValueChanged="OnModeChanged"
                               ReadOnly="@(!_hasWriteAccess)">
                    <MudRadio Value="WholesalePriceMode.Percentage" Color="Color.Primary">
                        <MudText>@L["Discount Percentage"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Wholesale price is defined as a percentage discount over the base price."]
                        </MudText>
                    </MudRadio>
                    <MudRadio Value="WholesalePriceMode.FixedPrice" Color="Color.Primary" Class="mt-2">
                        <MudText>@L["Fixed Wholesale Price"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Wholesale price is defined as a direct fixed price per unit."]
                        </MudText>
                    </MudRadio>
                </MudRadioGroup>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-4">@L["Remissions"]</MudText>
                <MudSwitch T="bool"
                           Value="_model.ApplyWholesaleToRemissions"
                           ValueChanged="@(v => _model.ApplyWholesaleToRemissions = v)"
                           Label="@L["Apply wholesale discounts to remissions"]"
                           Color="Color.Primary"
                           ReadOnly="@(!_hasWriteAccess)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["When enabled, wholesale discounts are automatically applied when creating remissions."]
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-8">
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
                    <Authorized Context="contextWholesale">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="SaveChangesAsync"
                                   Disabled="@(_processing || !_hasWriteAccess)"
                                   Class="da-button-rounded">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@L["Saving"]</MudText>
                            }
                            else
                            {
                                @L["Save Changes"]
                            }
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view this page"]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _processing;
    private bool _hasWriteAccess;
    private UpdateWholesaleSettingsDto _model = new()
    {
        PriceMode = WholesalePriceMode.Percentage
    };

    protected override async Task OnInitializedAsync()
    {
        _hasWriteAccess = await PermissionService.HasWriteAccessAsync(ApplicationClaims.Admin.ViewSettings);
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            var result = await WholesaleSettingsService.GetSettingsAsync();
            if (result.IsSuccess && result.Value != null)
            {
                _model = new UpdateWholesaleSettingsDto
                {
                    PriceMode = result.Value.PriceMode,
                    ApplyWholesaleToRemissions = result.Value.ApplyWholesaleToRemissions
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading wholesale settings");
            Snackbar.Add(L["Error loading settings"], Severity.Error);
        }
    }

    private void OnModeChanged(WholesalePriceMode mode)
    {
        _model.PriceMode = mode;
    }

    private async Task SaveChangesAsync()
    {
        _processing = true;
        StateHasChanged();

        try
        {
            var result = await WholesaleSettingsService.CreateOrUpdateSettingsAsync(_model);
            if (result.IsSuccess)
            {
                Snackbar.Add(L["Wholesale settings updated successfully"], Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error updating settings"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving wholesale settings");
            Snackbar.Add(L["Error saving settings"], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
}
