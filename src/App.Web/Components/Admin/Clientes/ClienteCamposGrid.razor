@using App.Web.Components.Admin.Clientes.Models
@using MudBlazor

@inject IStringLocalizer<ClienteDialog> L

<MudGrid Spacing="2">
    @foreach (var campo in Campos)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Outlined="true" Class="pa-3 rounded-lg" Style="height: 100%;">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                    <MudIcon Icon="@campo.Icon" Class="mud-text-secondary mt-1" Size="Size.Small" />
                    <div style="min-width: 0;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@campo.Etiqueta</MudText>
                        @if (string.IsNullOrWhiteSpace(campo.Valor))
                        {
                            <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="font-style: italic;">
                                @L["Not specified"]
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Class="text-truncate" Style="font-weight: 500;">@campo.Valor</MudText>
                        }
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public List<ClienteCampoDetalle> Campos { get; set; } = [];
}
