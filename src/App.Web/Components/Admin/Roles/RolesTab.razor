@using App.Web.Components.Admin.Roles.Models
@using App.Web.Components.Admin.Users.Models
@using App.Web.Components.Shared
@using App.Web.Components.Shared.Dialogs
@using Microsoft.AspNetCore.Authorization
@inject IStringLocalizer<RolesTab> L
@inject IRoleService RoleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@attribute [Authorize]

<MudPaper Class="pa-4" Elevation="0">
    <MudGrid>

        <!-- Toolbar -->
        <MudItem xs="12" Class="d-flex justify-end">
            <AuthorizeView Policy="@ApplicationClaims.Admin.ManageRoles">
                <Authorized Context="authCtx">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="da-button-rounded"
                               OnClick="OpenCreateDialog">
                        @L["New Role"]
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </MudItem>

        <!-- Table -->
        <MudItem xs="12">
            <MudTable T="RoleModel"
                      Items="@_roles"
                      Dense="true"
                      Hover="true"
                      Loading="@_loading"
                      Elevation="0"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["Name"]</MudTh>
                    <MudTh>@L["Users"]</MudTh>
                    <MudTh>@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="role">
                    <MudTd DataLabel="@L["Name"]">
                        @role.Name
                        @if (IsSystemRole(role.Name))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@L["System"]</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["Users"]">@role.UserCount</MudTd>
                    <MudTd>
                        <AuthorizeView Policy="@ApplicationClaims.Admin.ManageRoles">
                            <Authorized Context="editCtx">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditDialog(role))"
                                               title="@L["Edit"]" />
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="@ApplicationClaims.Admin.ViewRoles">
                            <Authorized Context="permCtx">
                                <MudIconButton Icon="@Icons.Material.Filled.Security"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenPermissionsDialog(role))"
                                               title="@L["Permissions"]" />
                            </Authorized>
                        </AuthorizeView>
                        @if (!IsSystemRole(role.Name))
                        {
                            <AuthorizeView Policy="@ApplicationClaims.Admin.DeleteRoles">
                                <Authorized Context="delCtx">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => OpenDeleteDialog(role))"
                                                   title="@L["Delete"]" />
                                </Authorized>
                            </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>@L["No roles found"]</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>@L["Loading..."]</MudText>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>

    </MudGrid>
</MudPaper>

@code {
    private List<RoleModel> _roles = new();
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        _loading = true;
        var details = await RoleService.GetRolesWithDetailsAsync();
        _roles = details.Select(r => new RoleModel
        {
            Id = r.Id,
            Name = r.Name,
            UserCount = r.UserCount
        }).ToList();
        _loading = false;
    }

    private bool IsSystemRole(string roleName) =>
        roleName.Equals(ApplicationRoles.SuperAdmin, StringComparison.OrdinalIgnoreCase)
        || roleName.Equals(ApplicationRoles.Admin, StringComparison.OrdinalIgnoreCase);

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<RoleDialog>
        {
            { x => x.IsNew, true }
        };

        var dialog = await DialogService.ShowAsync<RoleDialog>(L["New Role"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is RoleDialogModel model)
        {
            var (succeeded, _) = await RoleService.CreateRoleAsync(model.Name);
            if (succeeded)
            {
                Snackbar.Add(L["Role created successfully"], Severity.Success);
                await LoadRoles();
            }
            else
            {
                Snackbar.Add(L["Error creating role"], Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(RoleModel role)
    {
        var parameters = new DialogParameters<RoleDialog>
        {
            { x => x.Model, new RoleDialogModel { Id = role.Id, Name = role.Name } },
            { x => x.IsNew, false }
        };

        var dialog = await DialogService.ShowAsync<RoleDialog>(L["Edit Role"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is RoleDialogModel model)
        {
            var succeeded = await RoleService.UpdateRoleAsync(role.Id, model.Name);
            if (succeeded)
            {
                Snackbar.Add(L["Role updated successfully"], Severity.Success);
                await LoadRoles();
            }
            else
            {
                Snackbar.Add(L["Error updating role"], Severity.Error);
            }
        }
    }

    private async Task OpenPermissionsDialog(RoleModel role)
    {
        var parameters = new DialogParameters<RolePermissionsDialog>
        {
            { x => x.RoleId, role.Name },
            { x => x.RoleName, role.Name }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<RolePermissionsDialog>(
            string.Format(L["Permissions for role {0}"], role.Name), parameters, options);
        await dialog.Result;
    }

    private async Task OpenDeleteDialog(RoleModel role)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", string.Format(L["Are you sure you want to delete the role {0}?"], role.Name) },
            { "ConfirmText", L["Delete"] },
            { "Color", Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Role"], parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var succeeded = await RoleService.DeleteRoleAsync(role.Id);
            if (succeeded)
            {
                Snackbar.Add(L["Role deleted successfully"], Severity.Success);
                await LoadRoles();
            }
            else
            {
                Snackbar.Add(L["Error deleting role"], Severity.Error);
            }
        }
    }
}
