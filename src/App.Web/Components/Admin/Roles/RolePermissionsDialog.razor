@using App.Core.Constants
@using App.Web.Services
@inject IStringLocalizer<RolePermissionsDialog> L
@inject IRoleService RoleService
@inject PermissionTranslationService PermissionService

<MudDialog>
    <DialogContent>
        <MudContainer Class="pa-0">
            <MudTabs Elevation="0"
                     Color="Color.Primary"
                     ApplyEffectsToContainer="true"
                     PanelClass="pt-4">
                @foreach (var group in _permissionGroups)
                {
                    <MudTabPanel Text="@PermissionService.GetModuleDisplayName(group.Key)">
                        <MudGrid>
                            @foreach (var permission in group.Value)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox Label="@PermissionService.GetFullPermissionDisplayName(permission)"
                                                 Color="Color.Primary"
                                                 Value="@SelectedPermissions.Contains(permission)"
                                                 ValueChanged="@((bool value) => OnPermissionToggle(value, permission))" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudTabPanel>
                }
            </MudTabs>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="da-button-rounded">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   OnClick="Submit"
                   Class="da-button-rounded"
                   Variant="Variant.Filled">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialogInstance { get; set; } = null!;
    [Parameter] public string RoleId { get; set; } = string.Empty;
    [Parameter] public string RoleName { get; set; } = string.Empty;

    private HashSet<string> SelectedPermissions = new();
    private Dictionary<string, List<string>> _permissionGroups = new();

    protected override async Task OnInitializedAsync()
    {
        _permissionGroups = ApplicationClaims.GetAllClaims()
            .GroupBy(p => p.Split('.')[0])
            .ToDictionary(g => g.Key, g => g.ToList());

        var currentPermissions = await RoleService.GetRoleClaimsAsync(RoleId);
        SelectedPermissions = new HashSet<string>(currentPermissions);
    }

    private void OnPermissionToggle(bool value, string permission)
    {
        if (value)
            SelectedPermissions.Add(permission);
        else
            SelectedPermissions.Remove(permission);
    }

    private async Task Submit()
    {
        await RoleService.UpdateRoleClaimsAsync(RoleId, SelectedPermissions);
        MudDialogInstance.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialogInstance.Cancel();
}
