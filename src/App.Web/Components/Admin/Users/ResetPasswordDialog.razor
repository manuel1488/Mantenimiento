@using App.Core.DTOs.Identity
@using App.Core.Identity.Interfaces
@using App.Core.Interfaces.Identity
@using App.Core.Services
@using App.Web.Components.Shared

@inject IStringLocalizer<ResetPasswordDialog> L
@inject ILogger<ResetPasswordDialog> Logger
@inject IPasswordValidationService PasswordValidator

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["ResetUserPassword"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-width: 500px;" Class="py-4">
            <MudForm @ref="_form" Model="@Model">
                <MudGrid>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                            <div class="d-flex align-center">                                
                                <div>
                                    <MudText Typo="Typo.body1">@L["PasswordResetWarning"]</MudText>
                                    <MudText Typo="Typo.body2">@L["PasswordResetWarningDetails"]</MudText>
                                </div>
                            </div>
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="Model.NewPassword"
                                    InputType="@_passwordInputType"
                                    Adornment="Adornment.End"
                                    AdornmentAriaLabel="@(_passwordVisible ? L["HidePasswordTooltip"] : L["ShowPasswordTooltip"])"
                                    AdornmentIcon="@(_passwordVisibilityIcon)"
                                    OnAdornmentClick="ToggleNewPasswordVisibility"
                                    Label="@L["NewPassword"]"
                                    Required="true"
                                    RequiredError="@L["PasswordRequired"]"
                                    Validation="@((string password) => PasswordValidator.ValidatePassword(password, L))" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-value="Model.ConfirmPassword"
                                    InputType="@_confirmPasswordInputType"
                                    Adornment="Adornment.End"
                                    AdornmentAriaLabel="@(_confirmPasswordVisible ? L["HidePasswordTooltip"] : L["ShowPasswordTooltip"])"
                                    AdornmentIcon="@(_confirmPasswordVisibilityIcon)"
                                    OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                    Label="@L["ConfirmPassword"]"
                                    Required="true"
                                    RequiredError="@L["ConfirmPasswordRequired"]"
                                    Validation="@((string confirmPassword) => ValidatePasswordMatch(confirmPassword))" />
                    </MudItem>
                    
                    <!-- Password requirements -->
                    <MudItem xs="12" Class="mt-2">
                        <PasswordRequirements />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="da-button-rounded">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit" 
                  Class="da-button-rounded" Variant="Variant.Filled">
            @L["ResetPassword"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AdminResetPasswordDto Model { get; set; } = new();

    private MudForm _form = null!;

    private bool _passwordVisible = false;
    private bool _confirmPasswordVisible = false;
    private InputType _passwordInputType = InputType.Password;
    private InputType _confirmPasswordInputType = InputType.Password;

    private string _passwordVisibilityIcon = Icons.Material.Filled.VisibilityOff;
    private string _confirmPasswordVisibilityIcon = Icons.Material.Filled.VisibilityOff;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }

    private void ValueChanged(string value)
    {
        Model.ConfirmPassword = value;
    }

    private string? ValidatePasswordMatch(string confirmPassword)
    {
        if (string.IsNullOrWhiteSpace(confirmPassword))
            return L["ConfirmPasswordRequired"];

        if (confirmPassword != Model.NewPassword)
            return L["PasswordsDoNotMatch"];

        return null;
    }

    private void ToggleNewPasswordVisibility()
    {
        if (_passwordVisible)
        {
            _passwordVisible = false;
            _passwordInputType = InputType.Password;
            _passwordVisibilityIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            _passwordVisible = true;
            _passwordInputType = InputType.Text;
            _passwordVisibilityIcon = Icons.Material.Filled.Visibility;
        }
    }

    private void ToggleConfirmPasswordVisibility()
    {
        if (_confirmPasswordVisible)
        {
            _confirmPasswordVisible = false;
            _confirmPasswordInputType = InputType.Password;
            _confirmPasswordVisibilityIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            _confirmPasswordVisible = true;
            _confirmPasswordInputType = InputType.Text;
            _confirmPasswordVisibilityIcon = Icons.Material.Filled.Visibility;
        }
    }
}