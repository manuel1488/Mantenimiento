@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using App.Web.Components.Admin.Users
@using App.Web.Components.Admin.Roles

@inject IStringLocalizer<UsersPage> L

@attribute [Authorize(Policy = ApplicationClaims.Admin.ViewUsers)]

<PageTitle>@L["Administration"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["Administration"]</MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             PanelClass="pa-6" Color="Color.Primary">
        <AuthorizeView Policy="@ApplicationClaims.Admin.ViewUsers">
            <MudTabPanel Text="@L["Users"]">
                <UsersTab />
            </MudTabPanel>
        </AuthorizeView>
        @* <MudTabPanel Text="@L["Roles"]">
            <RolesTab />
        </MudTabPanel> *@
        <AuthorizeView Policy="@ApplicationClaims.Admin.ManageUsers">
            <MudTabPanel Text="@L["Permissions"]">
                <PermissionsTab />
            </MudTabPanel>
        </AuthorizeView>
        @*<MudTabPanel Text="@L["Activity"]">
            <ActivityTab />
        </MudTabPanel> *@
    </MudTabs>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        // Verificar permisos
        // TODO: Implementar lógica de autorización
    }
}