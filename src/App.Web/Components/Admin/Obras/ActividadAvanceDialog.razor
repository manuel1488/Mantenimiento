@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using App.Core.Options
@using App.Web.Components.Admin.Obras.Models
@using MudBlazor

@inject IStringLocalizer<ActividadAvanceDialog> L
@inject IOptions<ImageOptions> ImageOptions
@inject ISnackbar Snackbar
@inject ILogger<ActividadAvanceDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Update Progress"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@Model.ServicioNombre</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
            <MudSlider T="int" @bind-Value="Model.PorcentajeAvance" Min="0" Max="100" Step="5"
                       Color="Color.Primary" Class="flex-grow-1" />
            <MudText Typo="Typo.h6" Style="min-width: 3.5rem; text-align: right;">@Model.PorcentajeAvance%</MudText>
        </MudStack>

        <MudTextField @bind-Value="Model.Observaciones" Label="@L["Observation (optional)"]"
                      Lines="3" MaxLength="1000" Counter="1000" Immediate="true" Class="mt-4" />

        <MudText Typo="Typo.body2" Class="mt-4 mb-2">@L["Photo (optional)"]</MudText>
        @if (_fotoPreviewUrl is not null)
        {
            <div style="position: relative; width: 96px; height: 96px;">
                <img src="@_fotoPreviewUrl"
                     style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover; display: block; border: 1px solid var(--mud-palette-lines-default);" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               Class="pa-1" Style="position: absolute; top: -10px; right: -10px; background-color: var(--mud-palette-surface); box-shadow: 0 1px 3px rgba(0,0,0,.4);"
                               OnClick="RemoveFoto" title="@L["Remove Photo"]" />
            </div>
        }
        else
        {
            <InputFile id="avanceFotoUpload" OnChange="OnFotoSelected" accept="@_acceptedFileTypes" class="d-none" />
            <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.CloudUpload" for="avanceFotoUpload"
                       Disabled="@_processingFoto">
                @L["Attach Photo"]
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="da-button-rounded">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit"
                   Class="da-button-rounded" Variant="Variant.Filled">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ActividadAvanceDialogModel Model { get; set; } = new();

    private bool _processingFoto;
    private string? _fotoPreviewUrl;
    private string _acceptedFileTypes => string.Join(",", ImageOptions.Value.AllowedExtensions);

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));

    private async Task OnFotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            _processingFoto = true;

            // File type/size validation is the responsibility of IImageService (App.Services/Images/ImageService.cs),
            // enforced against ImageOptions from appsettings when the service processes it — we only cap the raw
            // read at that same configured max here so a too-large file fails fast client-side.
            using var stream = file.OpenReadStream(ImageOptions.Value.MaxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var data = memoryStream.ToArray();

            Model.FotoData = data;
            Model.FotoContentType = file.ContentType;
            Model.FotoFileName = file.Name;
            _fotoPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(data)}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading avance photo file");
            Snackbar.Add(L["Error processing photo file"], Severity.Error);
        }
        finally
        {
            _processingFoto = false;
        }
    }

    private void RemoveFoto()
    {
        Model.FotoData = null;
        Model.FotoContentType = null;
        Model.FotoFileName = null;
        _fotoPreviewUrl = null;
    }
}
