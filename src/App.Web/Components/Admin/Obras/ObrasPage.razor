@page "/gestion/obras"
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewObras)]

@using Microsoft.AspNetCore.Authorization
@using App.Core.Constants
@using App.Core.DTOs.Obras
@using App.Core.Enums.Obras
@using App.Core.Interfaces
@using App.Web.Components.Admin.Obras.Models
@using App.Web.Components.Shared.Dialogs
@using MudBlazor

@inject IStringLocalizer<ObrasPage> L
@inject IObraService ObraService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ObrasPage> Logger
@inject NavigationManager NavigationManager

<PageTitle>@L["Works"]</PageTitle>

<AuthorizeView Policy="@ApplicationClaims.Shared.ViewObras">
    <Authorized Context="pageAuth">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            <MudText Typo="Typo.h4" GutterBottom="true">@L["Works"]</MudText>

            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudTextField T="string" ValueChanged="@(s => OnSearch(s))"
                                  Placeholder="@L["Search works"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="flex-1" />

                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                        <Authorized Context="authContext">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => NavigationManager.NavigateTo("/gestion/obras/nueva"))" Class="da-button-rounded">
                                @L["New Obra"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>

                <MudDataGrid T="ObraDto" Items="@_filteredObras" Loading="_loading"
                             SortMode="SortMode.Multiple" Filterable="false"
                             Dense="true" Hover="true" RowsPerPage="10">
                    <Columns>
                        <PropertyColumn Property="x => x.ClienteNombre" Title="@L["Client"]" />
                        <PropertyColumn Property="x => x.Direccion" Title="@L["Address"]" />
                        <TemplateColumn Title="@L["Status"]" HeaderStyle="width: 130px;">
                            <CellTemplate>
                                @if (context.Item.Estado is ObraEstado.EnProceso or ObraEstado.Finalizada or ObraEstado.Facturada)
                                {
                                    <MudProgressLinear Color="@EstadoColor(context.Item.Estado)" Value="@context.Item.PorcentajeAvance"
                                                        Rounded="true" Style="height: 22px; width: 90px;" title="@EstadoLabel(context.Item.Estado)">
                                        <MudText Typo="Typo.caption" Style="font-weight: 600;">@context.Item.PorcentajeAvance%</MudText>
                                    </MudProgressLinear>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@EstadoColor(context.Item.Estado)" Variant="Variant.Filled">
                                        @EstadoLabel(context.Item.Estado)
                                    </MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Urgent"]" HeaderStyle="width: 90px; text-align: center;" CellStyle="text-align: center;">
                            <CellTemplate>
                                @if (context.Item.Urgente)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.FechaSolicitud" Title="@L["Request Date"]" Format="dd/MM/yyyy" HeaderStyle="width: 130px;" />
                        <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false"
                                        HeaderStyle="width: 150px;" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Medium"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/gestion/obras/{context.Item.Id}"))"
                                               title="@L["View Obra"]" />
                                <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                    <Authorized Context="authContext">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Medium"
                                                       OnClick="@(() => NavigationManager.NavigateTo($"/gestion/obras/{context.Item.Id}/editar"))"
                                                       title="@L["Edit Obra"]" />
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Policy="@ApplicationClaims.Shared.DeleteObras">
                                    <Authorized Context="authContext">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Medium"
                                                       Color="Color.Error"
                                                       OnClick="@(() => OpenDeleteDialog(context.Item))"
                                                       title="@L["Delete Obra"]" />
                                    </Authorized>
                                </AuthorizeView>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText>@L["No works found"]</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudDataGridPager T="ObraDto" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view works."]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading;
    private List<ObraDto> _obras = new();
    private List<ObraDto> _filteredObras = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var result = await ObraService.GetAllAsync();
            if (result.IsSuccess)
            {
                _obras = result.Value!;
                ApplyFilter();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading obras");
            Snackbar.Add(L["Error loading works"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filteredObras = string.IsNullOrWhiteSpace(_searchString)
            ? _obras
            : _obras.Where(o =>
                o.ClienteNombre.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                o.Direccion.Contains(_searchString, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void OnSearch(string value)
    {
        _searchString = value;
        ApplyFilter();
    }

    public static Color EstadoColor(ObraEstado estado) => estado switch
    {
        ObraEstado.Solicitada => Color.Default,
        ObraEstado.Cotizada => Color.Info,
        ObraEstado.Rechazada => Color.Error,
        ObraEstado.Aprobada => Color.Success,
        ObraEstado.EnProceso => Color.Primary,
        ObraEstado.Finalizada => Color.Success,
        ObraEstado.Facturada => Color.Secondary,
        _ => Color.Default
    };

    private string EstadoLabel(ObraEstado estado) => estado switch
    {
        ObraEstado.Solicitada => L["Requested"],
        ObraEstado.Cotizada => L["Quoted"],
        ObraEstado.Rechazada => L["Rejected"],
        ObraEstado.Aprobada => L["Approved"],
        ObraEstado.EnProceso => L["In Progress"],
        ObraEstado.Finalizada => L["Finished"],
        ObraEstado.Facturada => L["Invoiced"],
        _ => estado.ToString()
    };

    private async Task OpenDeleteDialog(ObraDto obra)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Obra Confirmation"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete this obra:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), obra.Direccion },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Obra"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var deleteResult = await ObraService.DeleteAsync(obra.Id);
        if (deleteResult.IsSuccess)
        {
            Snackbar.Add(L["Obra deleted successfully"], Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(deleteResult.Error, Severity.Error);
        }
    }
}
