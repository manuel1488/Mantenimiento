@using App.Core.Constants
@using App.Core.DTOs.Cotizaciones
@using App.Core.Enums.Cotizaciones
@using App.Core.Interfaces
@using MudBlazor

@inject IStringLocalizer<CotizacionDialog> L
@inject ICotizacionService CotizacionService
@inject ISnackbar Snackbar
@inject ILogger<CotizacionDialog> Logger
@inject NavigationManager NavigationManager

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Cotización"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-width: 700px;">
            @if (_loading)
            {
                <div class="d-flex justify-center pa-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_cotizacion is null)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Class="mud-text-secondary" />
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">@L["No cotización has been generated for this obra yet."]</MudText>
                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                        <Authorized Context="authContext">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.RequestQuote"
                                       OnClick="GenerarAsync" Class="da-button-rounded">
                                @L["Generate Cotización"]
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@L["Version"] @_cotizacion.Version</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudChip T="string" Color="@EstadoColor(_cotizacion.Estado)" Variant="Variant.Filled">
                            @EstadoLabel(_cotizacion.Estado)
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary"
                                       OnClick="DescargarPdf" title="@L["Download PDF"]" />
                    </MudStack>
                </MudStack>

                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@L["Service"]</th>
                            <th style="text-align: right;">@L["Quantity"]</th>
                            <th style="text-align: right;">@L["Unit Price"]</th>
                            <th style="text-align: right;">@L["Subtotal"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in _cotizacion.Lineas)
                        {
                            <tr>
                                <td>@linea.ServicioNombre</td>
                                <td style="text-align: right;">@linea.Cantidad.ToString("F2") @linea.UnidadMedida</td>
                                <td style="text-align: right;">@linea.PrecioUnitario.ToString("C2")</td>
                                <td style="text-align: right;">@linea.Subtotal.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                    <MudText Typo="Typo.h6">@L["Total"]: @_cotizacion.Total.ToString("C2")</MudText>
                </MudStack>

                @if (_cotizacion.Estado == CotizacionEstado.Pendiente)
                {
                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageCotizaciones">
                        <Authorized Context="authContext">
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Approval"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_aprobadaPor" Label="@L["Approved By"]" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_medioAprobacion" Label="@L["Approval Method"]" />
                                </MudItem>
                            </MudGrid>
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RechazarAsync" Class="da-button-rounded">
                                    @L["Reject"]
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AprobarAsync" Class="da-button-rounded">
                                    @L["Approve"]
                                </MudButton>
                            </MudStack>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="da-button-rounded">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ObraId { get; set; }

    private bool _loading = true;
    private CotizacionDto? _cotizacion;
    private bool _changed;
    private string _aprobadaPor = string.Empty;
    private string _medioAprobacion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await CotizacionService.GetLatestByObraIdAsync(ObraId);
            if (result.IsSuccess)
            {
                _cotizacion = result.Value;
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cotización for obra {ObraId}", ObraId);
            Snackbar.Add(L["Error loading cotización"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color EstadoColor(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => Color.Warning,
        CotizacionEstado.Aprobada => Color.Success,
        CotizacionEstado.Rechazada => Color.Error,
        _ => Color.Default
    };

    private string EstadoLabel(CotizacionEstado estado) => estado switch
    {
        CotizacionEstado.Pendiente => L["Pending"],
        CotizacionEstado.Aprobada => L["Approved"],
        CotizacionEstado.Rechazada => L["Rejected"],
        _ => estado.ToString()
    };

    private async Task GenerarAsync()
    {
        var result = await CotizacionService.GenerarAsync(ObraId);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización generated successfully"], Severity.Success);
            _changed = true;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task AprobarAsync()
    {
        if (_cotizacion is null) return;

        if (string.IsNullOrWhiteSpace(_aprobadaPor) || string.IsNullOrWhiteSpace(_medioAprobacion))
        {
            Snackbar.Add(L["Approved By and Approval Method are required"], Severity.Warning);
            return;
        }

        var dto = new AprobarCotizacionDto { AprobadaPor = _aprobadaPor, MedioAprobacion = _medioAprobacion };
        var result = await CotizacionService.AprobarAsync(_cotizacion.Id, dto);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización approved successfully"], Severity.Success);
            _changed = true;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private async Task RechazarAsync()
    {
        if (_cotizacion is null) return;

        var result = await CotizacionService.RechazarAsync(_cotizacion.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Cotización rejected successfully"], Severity.Success);
            _changed = true;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private void DescargarPdf()
    {
        if (_cotizacion is null) return;
        NavigationManager.NavigateTo($"/api/cotizaciones/{_cotizacion.Id}/pdf", forceLoad: true);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(_changed));
}
