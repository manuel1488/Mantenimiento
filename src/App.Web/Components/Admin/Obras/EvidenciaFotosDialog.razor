@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using App.Core.DTOs.Obras
@using App.Core.Enums.Obras
@using App.Core.Interfaces
@using App.Core.Options
@using App.Web.Components.Shared
@using MudBlazor

@inject IStringLocalizer<EvidenciaFotosDialog> L
@inject IActividadService ActividadService
@inject IOptions<ImageOptions> ImageOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<EvidenciaFotosDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["Evidence Photos"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="pa-0">
            @if (_loading)
            {
                <div class="d-flex justify-center pa-6">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Before"]</MudText>
                        @if (_antes.Count == 0)
                        {
                            <MudText Class="mud-text-secondary" Typo="Typo.body2">@L["No photos"]</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                @foreach (var foto in _antes)
                                {
                                    <div style="position: relative; width: 96px; height: 96px; flex-shrink: 0;">
                                        <img src="@(foto.ThumbnailPresignedUrl ?? foto.PresignedUrl)"
                                             style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover; display: block; border: 1px solid var(--mud-palette-lines-default); cursor: pointer;"
                                             @onclick="@(() => OpenLightbox(foto))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       Class="pa-1" Style="position: absolute; top: -10px; right: -10px; background-color: var(--mud-palette-surface); box-shadow: 0 1px 3px rgba(0,0,0,.4);"
                                                       OnClick="@(() => DeleteFotoAsync(foto.Id))" title="@L["Delete Photo"]" />
                                    </div>
                                }
                            </div>
                        }
                        <InputFile id="evidenciaAntesUpload" OnChange="@(e => UploadFotoAsync(e, TipoEvidencia.Antes))" accept="@_acceptedFileTypes" class="d-none" />
                        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload" for="evidenciaAntesUpload"
                                   Disabled="@_uploading" FullWidth="true">
                            @L["Upload Before Photo"]
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["After"]</MudText>
                        @if (_despues.Count == 0)
                        {
                            <MudText Class="mud-text-secondary" Typo="Typo.body2">@L["No photos"]</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                @foreach (var foto in _despues)
                                {
                                    <div style="position: relative; width: 96px; height: 96px; flex-shrink: 0;">
                                        <img src="@(foto.ThumbnailPresignedUrl ?? foto.PresignedUrl)"
                                             style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover; display: block; border: 1px solid var(--mud-palette-lines-default); cursor: pointer;"
                                             @onclick="@(() => OpenLightbox(foto))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       Class="pa-1" Style="position: absolute; top: -10px; right: -10px; background-color: var(--mud-palette-surface); box-shadow: 0 1px 3px rgba(0,0,0,.4);"
                                                       OnClick="@(() => DeleteFotoAsync(foto.Id))" title="@L["Delete Photo"]" />
                                    </div>
                                }
                            </div>
                        }
                        <InputFile id="evidenciaDespuesUpload" OnChange="@(e => UploadFotoAsync(e, TipoEvidencia.Despues))" accept="@_acceptedFileTypes" class="d-none" />
                        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload" for="evidenciaDespuesUpload"
                                   Disabled="@_uploading" FullWidth="true">
                            @L["Upload After Photo"]
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="da-button-rounded">@L["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ActividadId { get; set; }

    private bool _loading = true;
    private bool _uploading;
    private string _acceptedFileTypes => string.Join(",", ImageOptions.Value.AllowedExtensions);
    private List<ActividadEvidenciaFotoDto> _antes = new();
    private List<ActividadEvidenciaFotoDto> _despues = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await ActividadService.GetEvidenciasAsync(ActividadId);
            if (result.IsSuccess)
            {
                var fotos = result.Value!;
                _antes = fotos.Where(f => f.Tipo == TipoEvidencia.Antes).ToList();
                _despues = fotos.Where(f => f.Tipo == TipoEvidencia.Despues).ToList();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading evidencias for actividad {Id}", ActividadId);
            Snackbar.Add(L["Error loading evidence photos"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadFotoAsync(InputFileChangeEventArgs e, TipoEvidencia tipo)
    {
        // File type/size validation is the responsibility of IImageService (App.Services/Images/ImageService.cs),
        // enforced against ImageOptions from appsettings — not duplicated here. We only cap the raw
        // read at that same configured max so a too-large file fails fast with the service's specific message
        // instead of loading the whole stream into memory first.
        try
        {
            var file = e.File;
            if (file == null) return;

            _uploading = true;

            using var stream = file.OpenReadStream(ImageOptions.Value.MaxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var data = memoryStream.ToArray();

            var uploadResult = await ActividadService.UploadEvidenciaAsync(
                ActividadId, tipo, data, file.ContentType, file.Name);

            if (uploadResult.IsSuccess)
            {
                Snackbar.Add(L["Photo uploaded successfully"], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(uploadResult.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading evidencia file for actividad {Id}", ActividadId);
            Snackbar.Add(L["Error processing photo file"], Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task OpenLightbox(ActividadEvidenciaFotoDto foto)
    {
        if (foto.PresignedUrl is null) return;

        var parameters = new DialogParameters<PhotoLightboxDialog>
        {
            { x => x.ImageUrl, foto.PresignedUrl }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };

        await DialogService.ShowAsync<PhotoLightboxDialog>(null, parameters, options);
    }

    private async Task DeleteFotoAsync(int evidenciaId)
    {
        var result = await ActividadService.DeleteEvidenciaAsync(evidenciaId);
        if (result.IsSuccess)
        {
            Snackbar.Add(L["Photo deleted successfully"], Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error, Severity.Error);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
