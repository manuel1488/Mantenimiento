@using App.Core.DTOs.Clientes
@using App.Core.Interfaces
@using App.Web.Components.Admin.Obras.Models
@using MudBlazor

@inject IStringLocalizer<ObraDialog> L
@inject IClienteService ClienteService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsNew ? L["New Obra"] : L["Edit Obra"])
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="@Model" @ref="@_form">
            <MudGrid>
                <MudItem xs="12">
                    <MudAutocomplete T="ClienteDto"
                                     Label="@L["Client"]"
                                     Required="true"
                                     RequiredError="@L["Client is required"]"
                                     SearchFunc="@SearchClientes"
                                     ToStringFunc="@(c => c == null ? string.Empty : (c.NombreComercial ?? c.Nombre))"
                                     Value="_selectedCliente"
                                     ValueChanged="OnClienteSelected"
                                     MaxItems="null"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     Immediate="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Adornment="Adornment.Start" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Direccion"
                                  Label="@L["Address"]"
                                  Lines="2"
                                  Required="true"
                                  RequiredError="@L["Address is required"]" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="Model.Urgente" Color="Color.Warning" Label="@L["Urgent"]" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="da-button-rounded">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit"
                   Class="da-button-rounded" Variant="Variant.Filled">
            @L["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ObraDialogModel Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private MudForm _form = null!;
    private List<ClienteDto> _clientes = new();
    private ClienteDto? _selectedCliente;

    protected override async Task OnInitializedAsync()
    {
        var result = await ClienteService.GetAllAsync();
        if (result.IsSuccess)
        {
            _clientes = result.Value!;
        }

        if (Model.ClienteId != 0)
        {
            _selectedCliente = _clientes.FirstOrDefault(c => c.Id == Model.ClienteId);
        }
    }

    private Task<IEnumerable<ClienteDto>> SearchClientes(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_clientes.AsEnumerable());

        return Task.FromResult(_clientes.Where(c =>
            c.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (c.NombreComercial?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)));
    }

    private void OnClienteSelected(ClienteDto? value)
    {
        _selectedCliente = value;
        Model.ClienteId = value?.Id ?? 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }
}
