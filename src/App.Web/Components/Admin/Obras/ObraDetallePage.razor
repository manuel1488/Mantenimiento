@page "/gestion/obras/{Id:int}"
@attribute [Authorize(Policy = ApplicationClaims.Shared.ViewObras)]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using App.Core.Constants
@using App.Core.DTOs.Clientes
@using App.Core.DTOs.Obras
@using App.Core.DTOs.Servicios
@using App.Core.Enums.Obras
@using App.Core.Interfaces
@using App.Web.Components.Admin.Obras.Models
@using App.Web.Components.Shared
@using App.Web.Components.Shared.Dialogs
@using App.Web.Components.Shared.Models
@using MudBlazor

@inject IStringLocalizer<ObraDetallePage> L
@inject IObraService ObraService
@inject IActividadService ActividadService
@inject IClienteService ClienteService
@inject IServicioService ServicioService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<ObraDetallePage> Logger
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(_obra is null ? L["Obra Details"] : _obra.Direccion)</PageTitle>

<AuthorizeView Policy="@ApplicationClaims.Shared.ViewObras">
    <Authorized Context="pageAuth">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @if (_loading)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_obra is null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Class="mb-2"
                               OnClick="@(() => NavigationManager.NavigateTo("/gestion/obras"))" />
                <MudAlert Severity="Severity.Warning">@L["Obra not found"]</MudAlert>
            }
            else
            {
                @* ── Header card ─────────────────────────────────────────── *@
                <MudPaper Class="da-card pa-4 pa-sm-6 mb-4" Elevation="2">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                                       OnClick="@(() => NavigationManager.NavigateTo("/gestion/obras"))" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Works"]</MudText>
                    </MudStack>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="4">
                        <div style="min-width: 0;">
                            <MudText Typo="Typo.h5" Style="font-weight: 600;">@_obra.ClienteNombre</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_obra.Direccion</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                <MudChip T="string" Size="Size.Small" Color="@ObrasPage.EstadoColor(_obra.Estado)" Variant="Variant.Filled">
                                    @EstadoLabel(_obra.Estado)
                                </MudChip>
                                @if (_obra.Urgente)
                                {
                                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.PriorityHigh"
                                             Color="Color.Error" Variant="Variant.Outlined">
                                        @L["Urgent"]
                                    </MudChip>
                                }
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Style="max-width: 320px;">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: nowrap;">@L["Overall Progress"]</MudText>
                                <MudProgressLinear Color="Color.Primary" Value="@AvanceGeneral" Rounded="true" Class="flex-grow-1" Style="min-width: 80px;" />
                                <MudText Typo="Typo.body2" Style="white-space: nowrap;">@AvanceGeneral%</MudText>
                            </MudStack>
                        </div>

                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="flex-shrink-0">
                            <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                <Authorized Context="authContext">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               Disabled="@(!CanIniciar)"
                                               OnClick="IniciarAsync" Class="da-button-rounded">
                                        @L["Start"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.CheckCircle"
                                               Disabled="@(!CanFinalizar)"
                                               OnClick="FinalizarAsync" Class="da-button-rounded">
                                        @L["Finish"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Class="da-button-rounded"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/gestion/obras/{Id}/editar"))">
                                        @L["Edit Obra"]
                                    </MudButton>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="@ApplicationClaims.Shared.DeleteObras">
                                <Authorized Context="authContext">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   Variant="Variant.Outlined" OnClick="OpenDeleteDialog"
                                                   title="@L["Delete Obra"]" />
                                </Authorized>
                            </AuthorizeView>
                        </MudStack>
                    </MudStack>

                    <MudDivider Class="my-3" />
                    <CamposDetalleGrid Campos="@CamposObra()" />
                </MudPaper>

                @* ── Fotos Generales ─────────────────────────────────────────── *@
                <MudPaper Class="da-card pa-3 pa-sm-4 mb-4" Elevation="2">
                    <ObraFotosGeneralesSection ObraId="Id" ReadOnly="@(!(_puedeGestionarFotos && _obra.Estado is not (ObraEstado.Finalizada or ObraEstado.Facturada)))" />
                </MudPaper>

                @* ── Agregar Actividad ────────────────────────────────────── *@
                <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                    <Authorized Context="manageAuth">
                        <MudPaper Class="da-card pa-4 mb-4" Elevation="2">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">@L["Add Actividad"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudAutocomplete T="ServicioDto"
                                                     Label="@L["Service"]"
                                                     SearchFunc="@SearchServicios"
                                                     ToStringFunc="@(s => s == null ? string.Empty : s.Nombre)"
                                                     Value="_selectedServicio"
                                                     ValueChanged="OnServicioSelected"
                                                     MaxItems="null"
                                                     CoerceText="false"
                                                     ResetValueOnEmptyText="true"
                                                     Clearable="true"
                                                     Immediate="true"
                                                     AdornmentIcon="@(_selectedServicio == null ? Icons.Material.Filled.Search : Icons.Material.Filled.CheckCircle)"
                                                     AdornmentColor="@(_selectedServicio == null ? Color.Default : Color.Success)"
                                                     Adornment="Adornment.Start" />
                                </MudItem>
                                <MudItem xs="12" md="5">
                                    <MudNumericField @bind-Value="_cantidad" Immediate="true"
                                                      Label="@CantidadLabel"
                                                      Format="F3" Min="0.001m" />
                                </MudItem>
                                <MudItem xs="12" md="1" Class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                                                   Disabled="@(_selectedServicio is null || _cantidad <= 0 || _addingActividad)"
                                                   OnClick="AgregarActividadAsync" title="@L["Add"]" />
                                </MudItem>
                            </MudGrid>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                @L["Evidence photos (before/after) can be added from the Actividades list once created."]
                            </MudText>
                        </MudPaper>
                    </Authorized>
                </AuthorizeView>

                @* ── Actividades grid ─────────────────────────────────────── *@
                <MudPaper Class="da-card pa-2 pa-sm-4 mb-4" Elevation="2">
                    <MudText Typo="Typo.subtitle1" Class="pa-2">@L["Actividades"]</MudText>

                    @* Desktop/tablet: regular grid. Hidden below sm — ServicioNombre is unpredictable-length
                       text that forces horizontal scroll and wrapped headers on phones. *@
                    <MudDataGrid T="ActividadDto" Items="@_actividades" Loading="_loadingActividades"
                                 Dense="true" Hover="true" RowsPerPage="10" Class="d-none d-sm-block">
                        <Columns>
                            <TemplateColumn Title="@L["Service"]">
                                <CellTemplate>
                                    @context.Item.ServicioNombre
                                    @if (!string.IsNullOrWhiteSpace(context.Item.Descripcion))
                                    {
                                        <div class="mud-text-secondary" style="font-size: 0.8rem;">@context.Item.Descripcion</div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Quantity"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>@context.Item.Cantidad.ToString("F2") @context.Item.UnidadMedidaCodigo</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Estimated Time (days)"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>@context.Item.TiempoEstimadoDias.ToString("F2")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Cost"]" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>@context.Item.Costo.ToString("C2")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Progress"]" HeaderStyle="width: 160px;">
                                <CellTemplate>
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras" Context="progressAuth">
                                        <Authorized>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="cursor: pointer;"
                                                      title="@($"{EstadoLabel(context.Item.Estado)} — {L["Click to update"]}")"
                                                      @onclick="@(() => OpenAvanceDialog(context.Item))">
                                                <MudProgressLinear Color="@EstadoColor(context.Item.Estado)" Value="@context.Item.PorcentajeAvance"
                                                                    Rounded="true" Size="Size.Small" Class="flex-grow-1" Style="min-width: 60px;" />
                                                <MudText Typo="Typo.body2" Style="white-space: nowrap;">@context.Item.PorcentajeAvance%</MudText>
                                            </MudStack>
                                        </Authorized>
                                        <NotAuthorized>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" title="@EstadoLabel(context.Item.Estado)">
                                                <MudProgressLinear Color="@EstadoColor(context.Item.Estado)" Value="@context.Item.PorcentajeAvance"
                                                                    Rounded="true" Size="Size.Small" Class="flex-grow-1" Style="min-width: 60px;" />
                                                <MudText Typo="Typo.body2" Style="white-space: nowrap;">@context.Item.PorcentajeAvance%</MudText>
                                            </MudStack>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@L["Actions"]" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Medium"
                                                   OnClick="@(() => OpenEvidenciasDialog(context.Item.Id))"
                                                   title="@L["Evidence Photos (view/upload)"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Medium"
                                                   OnClick="@(() => OpenHistorialAvanceDialog(context.Item.Id))"
                                                   title="@L["Progress History"]" />
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                        <Authorized Context="authContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Medium"
                                                           OnClick="@(() => OpenEditActividadDialog(context.Item))"
                                                           title="@L["Edit Actividad"]" />
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                        <Authorized Context="authContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Error"
                                                           OnClick="@(() => DeleteActividadAsync(context.Item))"
                                                           title="@L["Delete Actividad"]" />
                                        </Authorized>
                                    </AuthorizeView>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText>@L["No actividades yet"]</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudDataGridPager T="ActividadDto" />
                        </PagerContent>
                    </MudDataGrid>

                    @* Mobile: one stacked card per actividad instead of a cramped table. *@
                    <div class="d-sm-none">
                        @if (_loadingActividades)
                        {
                            <div class="d-flex justify-center pa-4">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            </div>
                        }
                        else if (_actividades.Count == 0)
                        {
                            <MudText Class="pa-2">@L["No actividades yet"]</MudText>
                        }
                        else
                        {
                            @foreach (var actividad in _actividades)
                            {
                                <MudPaper Class="pa-3 mb-2" Outlined="true">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                                        <MudText Typo="Typo.subtitle2">@actividad.ServicioNombre</MudText>
                                        <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras" Context="progressAuthMobile">
                                            <Authorized>
                                                <MudText Typo="Typo.body2" Style="cursor: pointer; text-decoration: underline;"
                                                         title="@($"{EstadoLabel(actividad.Estado)} — {L["Click to update"]}")"
                                                         @onclick="@(() => OpenAvanceDialog(actividad))">@actividad.PorcentajeAvance%</MudText>
                                            </Authorized>
                                            <NotAuthorized>
                                                <MudText Typo="Typo.body2" title="@EstadoLabel(actividad.Estado)">@actividad.PorcentajeAvance%</MudText>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </MudStack>
                                    <MudProgressLinear Color="@EstadoColor(actividad.Estado)" Value="@actividad.PorcentajeAvance"
                                                        Rounded="true" Size="Size.Small" Class="mb-2" />
                                    @if (!string.IsNullOrWhiteSpace(actividad.Descripcion))
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">@actividad.Descripcion</MudText>
                                    }
                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Quantity"]</MudText>
                                        <MudText Typo="Typo.body2">@actividad.Cantidad.ToString("F2") @actividad.UnidadMedidaCodigo</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Estimated Time (days)"]</MudText>
                                        <MudText Typo="Typo.body2">@actividad.TiempoEstimadoDias.ToString("F2")</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="font-weight: 600;">@L["Cost"]</MudText>
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@actividad.Costo.ToString("C2")</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                                        <MudIconButton Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Medium"
                                                       OnClick="@(() => OpenEvidenciasDialog(actividad.Id))"
                                                       title="@L["Evidence Photos (view/upload)"]" />
                                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Medium"
                                                       OnClick="@(() => OpenHistorialAvanceDialog(actividad.Id))"
                                                       title="@L["Progress History"]" />
                                        <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                            <Authorized Context="authContext">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Medium"
                                                               OnClick="@(() => OpenEditActividadDialog(actividad))"
                                                               title="@L["Edit Actividad"]" />
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Policy="@ApplicationClaims.Shared.ManageObras">
                                            <Authorized Context="authContext">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Error"
                                                               OnClick="@(() => DeleteActividadAsync(actividad))"
                                                               title="@L["Delete Actividad"]" />
                                            </Authorized>
                                        </AuthorizeView>
                                    </MudStack>
                                </MudPaper>
                            }
                        }
                    </div>
                </MudPaper>

            }
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning" Class="my-4">
            @L["You don't have permission to view works."]
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _loadingActividades;
    private bool _addingActividad;
    private bool _puedeGestionarFotos;
    private ObraDto? _obra;
    private List<ActividadDto> _actividades = new();

    private List<ServicioDto> _servicios = new();
    private ServicioDto? _selectedServicio;
    private decimal _cantidad;

    private string CantidadLabel => _selectedServicio is null
        ? L["Quantity"].ToString()
        : $"{L["Quantity"]} ({_selectedServicio.UnidadMedidaCodigo})";

    private bool CanFinalizar => _obra is not null &&
        (_obra.Estado == ObraEstado.Aprobada || _obra.Estado == ObraEstado.EnProceso);

    private bool CanIniciar => _obra is not null && _obra.Estado == ObraEstado.Aprobada;

    private int AvanceGeneral => _actividades.Count == 0
        ? 0
        : (int)Math.Round(_actividades.Average(a => a.PorcentajeAvance));

    protected override async Task OnInitializedAsync()
    {
        var servicioResult = await ServicioService.GetAllAsync();
        if (servicioResult.IsSuccess)
        {
            _servicios = servicioResult.Value!;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var authResult = await AuthorizationService.AuthorizeAsync(authState.User, ApplicationClaims.Shared.ManageObras);
        _puedeGestionarFotos = authResult.Succeeded;

        await LoadObraAsync();
        await LoadActividadesAsync();
    }

    private async Task LoadObraAsync()
    {
        _loading = true;
        try
        {
            var result = await ObraService.GetByIdAsync(Id);
            _obra = result.IsSuccess ? result.Value : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading obra {Id}", Id);
            Snackbar.Add(L["Error loading obra"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadActividadesAsync()
    {
        _loadingActividades = true;
        try
        {
            var result = await ActividadService.GetByObraIdAsync(Id);
            if (result.IsSuccess)
            {
                _actividades = result.Value!;
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading actividades for obra {Id}", Id);
            Snackbar.Add(L["Error loading actividades"], Severity.Error);
        }
        finally
        {
            _loadingActividades = false;
        }
    }

    private List<CampoDetalle> CamposObra() =>
    [
        new(Icons.Material.Filled.Business, L["Client"], _obra!.ClienteNombre),
        new(Icons.Material.Filled.Home, L["Address"], _obra.Direccion),
        new(Icons.Material.Filled.Event, L["Request Date"], _obra.FechaSolicitud.ToString("dd/MM/yyyy"))
    ];

    private string EstadoLabel(ObraEstado estado) => estado switch
    {
        ObraEstado.Solicitada => L["Requested"],
        ObraEstado.Cotizada => L["Quoted"],
        ObraEstado.Rechazada => L["Rejected"],
        ObraEstado.Aprobada => L["Approved"],
        ObraEstado.EnProceso => L["In Progress"],
        ObraEstado.Finalizada => L["Finished"],
        ObraEstado.Facturada => L["Invoiced"],
        _ => estado.ToString()
    };

    private static Color EstadoColor(ActividadEstado estado) => estado switch
    {
        ActividadEstado.Pendiente => Color.Warning,
        ActividadEstado.EnProceso => Color.Info,
        ActividadEstado.Finalizada => Color.Success,
        _ => Color.Default
    };

    private string EstadoLabel(ActividadEstado estado) => estado switch
    {
        ActividadEstado.Pendiente => L["Pending"],
        ActividadEstado.EnProceso => L["In Progress"],
        ActividadEstado.Finalizada => L["Finished"],
        _ => estado.ToString()
    };

    private Task<IEnumerable<ServicioDto>> SearchServicios(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_servicios.AsEnumerable());

        return Task.FromResult(_servicios.Where(s => s.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnServicioSelected(ServicioDto? value)
    {
        _selectedServicio = value;
    }

    private async Task AgregarActividadAsync()
    {
        if (_selectedServicio is null || _cantidad <= 0) return;

        _addingActividad = true;
        try
        {
            var createDto = new CreateActividadDto
            {
                ObraId = Id,
                ServicioId = _selectedServicio.Id,
                Cantidad = _cantidad
            };

            var result = await ActividadService.CreateAsync(createDto);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error, Severity.Error);
                return;
            }

            Snackbar.Add(L["Actividad added successfully"], Severity.Success);

            _selectedServicio = null;
            _cantidad = 0;

            await LoadActividadesAsync();
        }
        finally
        {
            _addingActividad = false;
        }
    }

    private async Task OpenEditActividadDialog(ActividadDto actividad)
    {
        var parameters = new DialogParameters<ActividadEditDialog>
        {
            { x => x.Model, new ActividadEditDialogModel
                {
                    Id = actividad.Id,
                    ServicioNombre = actividad.ServicioNombre,
                    Descripcion = actividad.Descripcion,
                    UnidadMedidaCodigo = actividad.UnidadMedidaCodigo,
                    Cantidad = actividad.Cantidad,
                    PorcentajeAvance = actividad.PorcentajeAvance
                }
            }
        };

        var dialog = await DialogService.ShowAsync<ActividadEditDialog>(L["Edit Actividad"], parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ActividadEditDialogModel model)
        {
            var updateDto = new UpdateActividadDto
            {
                Id = model.Id,
                Cantidad = model.Cantidad,
                PrecioUnitarioOverride = model.PrecioUnitarioOverride,
                RendimientoDiasPorUnidadOverride = model.RendimientoDiasPorUnidadOverride,
                Descripcion = model.Descripcion,
                PorcentajeAvance = model.PorcentajeAvance
            };

            var updateResult = await ActividadService.UpdateAsync(updateDto);
            if (updateResult.IsSuccess)
            {
                Snackbar.Add(L["Actividad updated successfully"], Severity.Success);
                await LoadActividadesAsync();
            }
            else
            {
                Snackbar.Add(updateResult.Error, Severity.Error);
            }
        }
    }

    private async Task OpenAvanceDialog(ActividadDto actividad)
    {
        var parameters = new DialogParameters<ActividadAvanceDialog>
        {
            { x => x.Model, new ActividadAvanceDialogModel
                {
                    Id = actividad.Id,
                    ServicioNombre = actividad.ServicioNombre,
                    PorcentajeAvance = actividad.PorcentajeAvance
                }
            }
        };

        var dialog = await DialogService.ShowAsync<ActividadAvanceDialog>(L["Update Progress"], parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ActividadAvanceDialogModel model)
        {
            var avanceResult = await ActividadService.ActualizarAvanceAsync(
                model.Id, model.PorcentajeAvance, model.Observaciones,
                model.FotoData, model.FotoContentType, model.FotoFileName);
            if (avanceResult.IsSuccess)
            {
                Snackbar.Add(L["Actividad updated successfully"], Severity.Success);
                await LoadActividadesAsync();
            }
            else
            {
                Snackbar.Add(avanceResult.Error, Severity.Error);
            }
        }
    }

    private async Task DeleteActividadAsync(ActividadDto actividad)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Title), L["Delete Actividad Confirmation"].ToString() },
            { nameof(ConfirmDialog.ContentText), L["Are you sure you want to delete this actividad:"].ToString() },
            { nameof(ConfirmDialog.HighlightedText), actividad.ServicioNombre },
            { nameof(ConfirmDialog.ConfirmText), L["Delete"].ToString() },
            { nameof(ConfirmDialog.CancelText), L["Cancel"].ToString() },
            { nameof(ConfirmDialog.Type), ConfirmDialog.DialogType.Delete },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.WarningText), L["This action cannot be undone."].ToString() }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Delete Actividad"], parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var deleteResult = await ActividadService.DeleteAsync(actividad.Id);
        if (deleteResult.IsSuccess)
        {
            Snackbar.Add(L["Actividad deleted successfully"], Severity.Success);
            await LoadActividadesAsync();
        }
        else
        {
            Snackbar.Add(deleteResult.Error, Severity.Error);
        }
    }

