@page "/admin/initial-setup"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using App.Core.Constants

@inject IStringLocalizer<InitialSetupPage> L

@attribute [Authorize(Policy = ApplicationClaims.Admin.ManageInitialSetup)]

<PageTitle>@L["Initial Setup"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudCard Elevation="0">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">@L["Initial Setup"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["Configure initial system settings and data"]
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="pt-0">
            <MudTabs Elevation="0"
                    Color="Color.Primary"
                    ApplyEffectsToContainer="true"
                    PanelClass="pa-6">
                <MudTabPanel Text="@L["Inventory Load"]" 
                            Icon="@Icons.Material.Filled.Inventory">
                    <InventoryLoadTab />
                </MudTabPanel>                
            </MudTabs>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
    }
}