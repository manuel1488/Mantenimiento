@using MudBlazor
@inject IStringLocalizer<ConfirmDialog> L 
@inject ILogger<ConfirmDialog> Logger

<MudDialog Options="@_dialogOptions">
    <DialogContent>
        <MudContainer Class="pa-4">
            <MudStack Spacing="4" AlignItems="AlignItems.Center">
                <!-- Icono de advertencia -->
                <MudIcon Icon="@_dialogIcon" 
                        Color="@Color" 
                        Size="Size.Large"
                        Style="width: 48px; height: 48px;" />

                <!-- Título -->
                <MudText Align="Align.Center" Typo="Typo.h6">
                    @TitleStr
                </MudText>

                <!-- Texto principal de confirmación -->
                @if (!string.IsNullOrEmpty(ContentTextStr))
                {
                    <MudText Align="Align.Center">
                        @ContentTextStr
                    </MudText>
                }

                <!-- Elemento destacado (ej: nombre de usuario) -->
                @if (!string.IsNullOrEmpty(HighlightedTextStr))
                {
                    <MudPaper Elevation="0"
                             Class="pa-3 rounded-lg"
                             Style="background-color: var(--mud-palette-background-grey); width: 100%;">
                        <MudText Align="Align.Center"
                                Typo="Typo.h6"
                                Color="@Color">
                            <strong>@HighlightedTextStr</strong>
                        </MudText>
                    </MudPaper>
                }

                <!-- Mensaje de advertencia para acciones destructivas -->
                @if (ShowWarning || !string.IsNullOrEmpty(WarningTextStr))
                {
                    <MudAlert Severity="Severity.Warning"
                             Variant="Variant.Filled"
                             Class="mt-2"
                             Style="width: 100%;">
                        @WarningTextStr
                    </MudAlert>
                }

                <!-- Contenido adicional si existe -->
                @if (AdditionalContent != null)
                {
                    <div class="mt-2" style="width: 100%;">
                        @AdditionalContent
                    </div>
                }
            </MudStack>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <!-- Botón Cancelar -->
        <MudButton OnClick="HandleCancel" 
                   Variant="Variant.Outlined"
                   Class="da-button-rounded">
            @(string.IsNullOrEmpty(CancelTextStr) ? L["Cancel"] : CancelTextStr)
        </MudButton>

        <!-- Botón de Confirmación -->
        <MudButton OnClick="HandleConfirm"
                  Color="@Color"
                  Variant="Variant.Filled"
                  StartIcon="@ConfirmIcon"
                  Class="da-button-rounded">
            @(string.IsNullOrEmpty(ConfirmTextStr) ? L["Confirm"] : ConfirmTextStr)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public object? Title { get; set; }
    [Parameter] public object? ContentText { get; set; }
    [Parameter] public object? HighlightedText { get; set; }
    [Parameter] public object? ConfirmText { get; set; }
    [Parameter] public object? CancelText { get; set; }
    [Parameter] public object? WarningText { get; set; }

    private string TitleStr => Title?.ToString() ?? string.Empty;
    private string ContentTextStr => ContentText?.ToString() ?? string.Empty;
    private string HighlightedTextStr => HighlightedText?.ToString() ?? string.Empty;
    private string ConfirmTextStr => ConfirmText?.ToString() ?? string.Empty;
    private string CancelTextStr => CancelText?.ToString() ?? string.Empty;
    private string WarningTextStr => WarningText?.ToString() ?? string.Empty;
    [Parameter] public bool ShowWarning { get; set; } = false;
    [Parameter] public Color Color { get; set; } = Color.Error;
    [Parameter] public DialogType Type { get; set; } = DialogType.Delete;
    [Parameter] public RenderFragment? AdditionalContent { get; set; }

    // Propiedades calculadas basadas en el tipo de diálogo
    private string _dialogIcon => Type switch
    {
        DialogType.Delete => Icons.Material.Filled.Warning,
        DialogType.Warning => Icons.Material.Filled.Warning,
        DialogType.Info => Icons.Material.Filled.Info,
        DialogType.Success => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.Help
    };

    private string ConfirmIcon => Type switch
    {
        DialogType.Delete => Icons.Material.Filled.Delete,
        DialogType.Warning => Icons.Material.Filled.Warning,
        DialogType.Success => Icons.Material.Filled.Check,
        _ => Icons.Material.Filled.Check
    };

    private DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        BackdropClick = true,
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true,
        Position = DialogPosition.Center,
        CloseButton = false
    };

    private async Task HandleConfirm()
    {
        try
        {
            await InvokeAsync(() => MudDialog.Close(DialogResult.Ok(true)));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling confirmation in dialog");
            await InvokeAsync(() => MudDialog.Cancel());
        }
    }

    private async Task HandleCancel()
    {
        try
        {
            await InvokeAsync(() => MudDialog.Cancel());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling cancel in dialog");
        }
    }

    public enum DialogType
    {
        Delete,
        Warning,
        Info,
        Success
    }
}