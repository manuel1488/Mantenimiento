@using App.Core.DTOs.Customer
@using App.Core.DTOs.Billing.Mexico
@using App.Core.Interfaces
@using App.Core.DTOs.Settings
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions

@inject ICustomerService CustomerService
@inject IMexicoFiscalCatalogService FiscalCatalogService
@inject ICompanySettingsService CompanySettingsService
@inject IStringLocalizer<CustomerDialog> L
@inject ISnackbar Snackbar
@inject ILookupService LookupService
@inject ILogger<CustomerDialog> Logger

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-width: 860px;" Class="pa-4">
            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">

                <!-- ═══════════════════ PESTAÑA COMERCIAL ═══════════════════ -->
                <MudTabPanel Text="@L["Commercial Data"]" Icon="@Icons.Material.Filled.Store">
                    <MudForm Model="@_commercial" @ref="@_commercialForm">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.Name"
                                            Label="@L["Name / Trade Name"]"
                                            Required="true"
                                            RequiredError="@L["Name is required"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.ContactName"
                                            Label="@L["Contact Name"]"
                                            Placeholder="@L["e.g. Juan Pérez García"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="_commercial.CountryCode"
                                        Label="@L["Country"]"
                                        Required="true"
                                        RequiredError="@L["Country is required"]">
                                    @foreach (var country in _countries)
                                    {
                                        <MudSelectItem Value="@country.Code">@country.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.Email"
                                            Label="@L["Email"]"
                                            InputType="InputType.Email"
                                            Validation="@((string email) => ValidateEmail(email))"
                                            Placeholder="@L["example@domain.com"]"
                                            Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_phoneInput"
                                            @bind-Value:after="OnPhoneChanged"
                                            MaxLength="14"
                                            InputType="InputType.Telephone"
                                            Label="@L["Phone"]"
                                            Placeholder="@GetPhonePlaceholder()"
                                            Validation="@((string phone) => ValidatePhone(phone))" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@L["Commercial Address"]</MudText>
                                <MudDivider Class="mb-3" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.Street"
                                            Label="@L["Street"]" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_commercial.ExteriorNumber"
                                            Label="@L["Exterior Number"]" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_commercial.InteriorNumber"
                                            Label="@L["Interior Number"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.Neighborhood"
                                            Label="@L["Neighborhood"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.City"
                                            Label="@L["City"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.State"
                                            Label="@L["State"]" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_commercial.PostalCode"
                                            Label="@L["Postal Code"]" />
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudTabPanel>

                <!-- ═══════════════════ PESTAÑA FISCAL ═══════════════════ -->
                <MudTabPanel Text="@L["Fiscal Data"]" Icon="@Icons.Material.Filled.Receipt">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="_hasFiscalProfile"
                                       @bind-Value:after="OnFiscalToggleChanged"
                                       Label="@L["This customer has fiscal data"]"
                                       Color="Color.Primary" />
                        </MudItem>

                        @if (_hasFiscalProfile)
                        {
                            <MudItem xs="12">
                                <MudForm Model="@_fiscal" @ref="@_fiscalForm">
                                    <MudGrid>
                                        <!-- Identificación fiscal -->
                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.TaxId"
                                                        Label="@L["Tax ID / RFC"]"
                                                        Required="true"
                                                        RequiredError="@L["Tax ID is required"]"
                                                        HelperText="@(IsPublicGeneralRfc ? L["RFC reserved for Público General — use Global Invoices"].Value : null)"
                                                        Error="@IsPublicGeneralRfc" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.LegalName"
                                                        Label="@L["Legal Name / Razón Social"]"
                                                        Required="true"
                                                        RequiredError="@L["Legal name is required"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.FiscalEmail"
                                                        Label="@L["Fiscal Email"]"
                                                        InputType="InputType.Email"
                                                        Validation="@((string email) => ValidateEmail(email))"
                                                        Placeholder="@L["example@domain.com"]"
                                                        HelperText="@L["For invoice delivery. Leave blank to use the commercial email."]"
                                                        Immediate="true" />
                                        </MudItem>

                                        <!-- Domicilio fiscal -->
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@L["Fiscal Address"]</MudText>
                                            <MudDivider Class="mb-3" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.Street"
                                                        Label="@L["Street"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="3">
                                            <MudTextField @bind-Value="_fiscal.ExteriorNumber"
                                                        Label="@L["Exterior Number"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="3">
                                            <MudTextField @bind-Value="_fiscal.InteriorNumber"
                                                        Label="@L["Interior Number"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.Neighborhood"
                                                        Label="@L["Neighborhood"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.City"
                                                        Label="@L["City"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.State"
                                                        Label="@L["State"]" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_fiscal.PostalCode"
                                                        Label="@L["Fiscal Postal Code"]"
                                                        HelperText="@L["Required for CFDI stamping (Mexico)"]" />
                                        </MudItem>

                                        <!-- Preferencias fiscales según país -->
                                        @if (_commercial.CountryCode == "MX")
                                        {
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@L["Mexico Billing Preferences"]</MudText>
                                                <MudDivider Class="mb-3" />
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudSelect @bind-Value="_fiscal.FiscalRegime"
                                                           @bind-Value:after="OnFiscalRegimeChanged"
                                                           Label="@L["Fiscal Regime"]"
                                                           Variant="Variant.Outlined"
                                                           Clearable="true"
                                                           AnchorOrigin="Origin.BottomCenter">
                                                    @foreach (var regime in _fiscalRegimes)
                                                    {
                                                        <MudSelectItem Value="@regime.Code">@regime.Code — @regime.Description</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudSelect @bind-Value="_fiscal.DefaultCfdiUse"
                                                           Label="@L["Default CFDI Use"]"
                                                           Variant="Variant.Outlined"
                                                           Clearable="true"
                                                           AnchorOrigin="Origin.BottomCenter">
                                                    @foreach (var use in FilteredCfdiUses)
                                                    {
                                                        <MudSelectItem Value="@use.Code">@use.Code — @use.Description</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" md="6" Class="d-flex align-center">
                                                <div>
                                                    <MudSwitch @bind-Value="_fiscal.AutoInvoice"
                                                               Label="@L["Auto-Invoice"]"
                                                               Color="Color.Primary" />
                                                    <MudText Typo="Typo.caption" Class="ml-14 mt-n2" Style="color: var(--mud-palette-text-secondary);">
                                                        @L["Automatically generate invoice after each sale"]
                                                    </MudText>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12" md="6" Class="d-flex align-center">
                                                <div>
                                                    <MudSwitch @bind-Value="_fiscal.SendInvoiceEmail"
                                                               Label="@L["Send Invoice Email"]"
                                                               Color="Color.Primary" />
                                                    <MudText Typo="Typo.caption" Class="ml-14 mt-n2" Style="color: var(--mud-palette-text-secondary);">
                                                        @L["Automatically send the invoice email after generation"]
                                                    </MudText>
                                                </div>
                                            </MudItem>
                                        }

                                        @if (_commercial.CountryCode == "CA")
                                        {
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@L["Canadian Tax Numbers"]</MudText>
                                                <MudDivider Class="mb-3" />
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="_fiscal.CaGstNumber"
                                                            Label="@L["GST Number"]" />
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="_fiscal.CaPstNumber"
                                                            Label="@L["PST Number"]" />
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="_fiscal.CaHstNumber"
                                                            Label="@L["HST Number"]" />
                                            </MudItem>

                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="_fiscal.CaQstNumber"
                                                            Label="@L["QST Number"]" />
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudForm>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
            Class="da-button-rounded"
            title="@L["Cancel editing"]">
            @L["Cancel"]
        </MudButton>
        <MudButton Color="Color.Error"
                  OnClick="Submit"
                  Variant="Variant.Filled"
                  Disabled="@_processing"
                  title="@L["Save customer data"]"
                  Class="da-button-rounded">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Saving"]</MudText>
            }
            else
            {
                @L["Save"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public long? CustomerId { get; set; }

    private List<CountryDto> _countries = [];
    private List<MexicoFiscalRegimeDto> _fiscalRegimes = [];
    private List<MexicoCfdiUseDto> _cfdiUses = [];

    private MudForm _commercialForm = null!;
    private MudForm? _fiscalForm;
    private bool _processing;
    private bool _hasFiscalProfile;

    // Separate models for each tab
    private CreateCustomerDto _commercial = new();
    private UpsertCustomerFiscalProfileDto _fiscal = new();

    private string _phoneInput = string.Empty;

    private bool IsPublicGeneralRfc =>
        string.Equals(_fiscal.TaxId?.Trim(), "XAXX010101000", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<MexicoCfdiUseDto> FilteredCfdiUses =>
        string.IsNullOrEmpty(_fiscal.FiscalRegime)
            ? _cfdiUses
            : _cfdiUses.Where(u =>
                string.IsNullOrEmpty(u.FiscalRegimeCodes) ||
                u.FiscalRegimeCodes.Split(',').Any(c => c.Trim() == _fiscal.FiscalRegime));

    protected override async Task OnInitializedAsync()
    {
        var countriesTask = LookupService.GetCountriesAsync();
        var regimesTask = FiscalCatalogService.GetFiscalRegimesAsync();
        var cfdiUsesTask = FiscalCatalogService.GetCfdiUsesAsync();
        await Task.WhenAll(countriesTask, regimesTask, cfdiUsesTask);

        _countries = (await countriesTask).ToList();
        _fiscalRegimes = (await regimesTask).ToList();
        _cfdiUses = (await cfdiUsesTask).ToList();

        if (CustomerId.HasValue)
            await LoadCustomer();
        else
        {
            var settings = await CompanySettingsService.GetSettingsAsync();
            var defaultCode = settings?.CountryCode;
            _commercial.CountryCode = _countries.Any(c => c.Code == defaultCode)
                ? defaultCode!
                : _countries.FirstOrDefault()?.Code ?? string.Empty;
        }
    }

    private async Task LoadCustomer()
    {
        try
        {
            var customer = await CustomerService.GetCustomerByIdAsync(CustomerId!.Value);
            if (customer == null) return;

            // Populate commercial form
            _commercial = new CreateCustomerDto
            {
                Name = customer.Name,
                ContactName = customer.ContactName,
                Email = customer.Email,
                Phone = customer.Phone,
                Street = customer.Street,
                ExteriorNumber = customer.ExteriorNumber,
                InteriorNumber = customer.InteriorNumber,
                Neighborhood = customer.Neighborhood,
                City = customer.City,
                State = customer.State,
                PostalCode = customer.PostalCode,
                CountryCode = customer.CountryCode
            };
            _phoneInput = FormatPhoneNumber(customer.Phone ?? string.Empty);

            // Populate fiscal form if profile exists
            _hasFiscalProfile = customer.FiscalProfile != null;
            if (customer.FiscalProfile != null)
            {
                var fp = customer.FiscalProfile;
                _fiscal = new UpsertCustomerFiscalProfileDto
                {
                    TaxId = fp.TaxId,
                    LegalName = fp.LegalName,
                    FiscalEmail = fp.FiscalEmail,
                    Street = fp.Street,
                    ExteriorNumber = fp.ExteriorNumber,
                    InteriorNumber = fp.InteriorNumber,
                    Neighborhood = fp.Neighborhood,
                    City = fp.City,
                    State = fp.State,
                    PostalCode = fp.PostalCode,
                    FiscalRegime = fp.FiscalRegime,
                    DefaultCfdiUse = fp.DefaultCfdiUse,
                    AutoInvoice = fp.AutoInvoice,
                    SendInvoiceEmail = fp.SendInvoiceEmail,
                    CaGstNumber = fp.CaGstNumber,
                    CaPstNumber = fp.CaPstNumber,
                    CaHstNumber = fp.CaHstNumber,
                    CaQstNumber = fp.CaQstNumber
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading customer {CustomerId}", CustomerId);
            Snackbar.Add(L["Error loading customer"], Severity.Error);
            MudDialog.Cancel();
        }
    }

    private void OnFiscalToggleChanged()
    {
        if (!_hasFiscalProfile)
            _fiscal = new UpsertCustomerFiscalProfileDto();
    }

    private void OnFiscalRegimeChanged()
    {
        if (!string.IsNullOrEmpty(_fiscal.DefaultCfdiUse) &&
            !FilteredCfdiUses.Any(u => u.Code == _fiscal.DefaultCfdiUse))
        {
            _fiscal.DefaultCfdiUse = null;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _commercialForm.Validate();
        if (!_commercialForm.IsValid) return;

        if (string.IsNullOrEmpty(_commercial.CountryCode))
        {
            Snackbar.Add(L["Country is required"], Severity.Warning);
            return;
        }

        if (_hasFiscalProfile && _fiscalForm != null)
        {
            await _fiscalForm.Validate();
            if (!_fiscalForm.IsValid) return;

            if (IsPublicGeneralRfc)
            {
                Snackbar.Add(L["RFC XAXX010101000 is reserved for Público General"], Severity.Warning);
                return;
            }
        }

        _processing = true;
        StateHasChanged();

        try
        {
            _commercial.FiscalProfile = _hasFiscalProfile ? _fiscal : null;

            if (CustomerId.HasValue)
            {
                var updateDto = new UpdateCustomerDto
                {
                    Name = _commercial.Name,
                    ContactName = _commercial.ContactName,
                    Email = _commercial.Email,
                    Phone = _commercial.Phone,
                    Street = _commercial.Street,
                    ExteriorNumber = _commercial.ExteriorNumber,
                    InteriorNumber = _commercial.InteriorNumber,
                    Neighborhood = _commercial.Neighborhood,
                    City = _commercial.City,
                    State = _commercial.State,
                    PostalCode = _commercial.PostalCode,
                    CountryCode = _commercial.CountryCode,
                    FiscalProfile = _hasFiscalProfile ? _fiscal : null
                };
                await CustomerService.UpdateCustomerAsync(CustomerId.Value, updateDto);
                Snackbar.Add(L["Customer updated successfully"], Severity.Success);
            }
            else
            {
                await CustomerService.CreateCustomerAsync(_commercial);
                Snackbar.Add(L["Customer created successfully"], Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving customer");
            Snackbar.Add(L["Error saving customer"], Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private string? ValidatePhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return null;

        var cleanPhone = phone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace("+", "");

        if (!Regex.IsMatch(cleanPhone, @"^\d+$"))
            return L["Phone number must contain only numbers, spaces, hyphens, parentheses, and plus signs"];

        if (cleanPhone.Length != 10)
            return L["Phone number must have exactly 10 digits"];

        return null;
    }

    private string? ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return null;

        var emailValidator = new EmailAddressAttribute();
        if (!emailValidator.IsValid(email))
            return L["Please enter a valid email address"];

        return null;
    }

    private void OnPhoneChanged()
    {
        var digitsOnly = new string(_phoneInput.Where(char.IsDigit).ToArray());
        _commercial.Phone = digitsOnly;
        _phoneInput = FormatPhoneNumber(digitsOnly);
    }

    private string FormatPhoneNumber(string phone)
    {
        if (string.IsNullOrEmpty(phone))
            return string.Empty;

        var digitsOnly = new string(phone.Where(char.IsDigit).ToArray());

        if (digitsOnly.Length <= 3)
            return $"({digitsOnly}";
        else if (digitsOnly.Length <= 6)
            return $"({digitsOnly[..3]})-{digitsOnly[3..]}";
        else if (digitsOnly.Length <= 10)
            return $"({digitsOnly[..3]})-{digitsOnly[3..6]}-{digitsOnly[6..]}";
        else
            return $"({digitsOnly[..3]})-{digitsOnly[3..6]}-{digitsOnly[6..10]}";
    }

    private string GetPhonePlaceholder() => "(461)-123-4567";
}
