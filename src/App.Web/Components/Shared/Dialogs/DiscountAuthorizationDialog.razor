@using App.Core.Interfaces
@inject IStringLocalizer<DiscountAuthorizationDialog> L
@inject ISnackbar Snackbar
@inject ILogger<DiscountAuthorizationDialog> _logger
@inject IDiscountAuthorizerService AuthorizerService

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
            <MudText Typo="Typo.h6" Class="mb-4">@L["Discount Authorization Required"]</MudText>
            
            <MudForm @ref="_form" Model="@_model">
                <MudTextField 
                    @bind-Value="_model.Username"
                    Label="@L["Authorizer Username"]"
                    Required="true"
                    RequiredError="@L["Username is required"]" />
                
                <MudTextField 
                    @bind-Value="_model.Password"
                    Label="@L["Password"]"
                    Required="true"
                    RequiredError="@L["Password is required"]"
                    InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                    Adornment="Adornment.End"
                    AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                    OnAdornmentClick="() => _showPassword = !_showPassword" />
                    
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-4">
                    @L["You are authorizing a discount that requires approval."]
                </MudText>
            </MudForm>
            
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton 
            Color="Color.Primary" 
            Variant="Variant.Filled" 
            OnClick="Submit" 
            Disabled="@_processing">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Verifying..."]</MudText>
            }
            else
            {
                @L["Authorize"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    private MudForm _form = null!;
    private bool _showPassword = false;
    private bool _processing = false;
    private string _errorMessage = string.Empty;
    
    private class AuthorizationModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
    
    private AuthorizationModel _model = new();
    
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    
    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }
        
        _processing = true;
        _errorMessage = string.Empty;
        StateHasChanged();
        
        try
        {
            var validationResult = await AuthorizerService.ValidateAuthorizerCredentialsAsync(
                _model.Username, _model.Password);
                
            if (validationResult.Success)
            {
                MudDialog.Close(DialogResult.Ok(new DiscountAuthorization 
                { 
                    AuthorizerId = validationResult.UserId!, 
                    AuthorizerName = validationResult.UserName!,
                    AuthorizedAt = DateTime.Now
                }));
            }
            else
            {
                // Aquí modificamos para distinguir entre tipos de error
                if (validationResult.InvalidCredentials)
                {
                    _errorMessage = L["Invalid username or password"];
                }
                else
                {
                    _errorMessage = L["Your account does not have permission to authorize discounts"];
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during authorization validation");
            _errorMessage = L["An error occurred during authorization validation"];
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    
    public class DiscountAuthorization
    {
        public string AuthorizerId { get; set; } = string.Empty;
        public string AuthorizerName { get; set; } = string.Empty;
        public DateTime AuthorizedAt { get; set; }
    }
}