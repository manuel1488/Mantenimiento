@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging

@inject ILogger<ErrorInterceptor> Logger
@inject NavigationManager NavigationManager

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="exception">
        @{
            Logger.LogError(exception, "Unhandled exception rendered to error boundary");
            
            // Redirigir a la página de error para mantener una experiencia coherente
            NavigationManager.NavigateTo("/Error", forceLoad: true);
            
            // Mostrar un mensaje mínimo mientras se redirige
            <div class="d-flex justify-center align-center" style="height: 100vh;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    private ErrorBoundary _errorBoundary = null!;
    
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}