@using MudBlazor

<MudTooltip Text="@Title" Placement="Placement.Top">
    <button class="mud-button-root mud-icon-button mud-ripple mud-ripple-icon"
            style="@($"color:{GetColor()}; padding:6px; background:none; border:none; cursor:pointer; border-radius:50%; line-height:0;")"
            type="button"
            disabled="@Disabled"
            @onclick="OnClick">
        <span class="mud-icon-button-label">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="mud-icon-root mud-svg-icon mud-icon-size-small"
                 viewBox="0 0 24 24"
                 width="20" height="20"
                 focusable="false"
                 aria-hidden="true">
                @* Document shape outline *@
                <path fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                @* Folded corner *@
                <path fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      d="M13 2v7h7" />
                @* XML label *@
                <text x="12" y="17.5"
                      font-size="5.5"
                      font-family="Roboto, Arial, sans-serif"
                      font-weight="900"
                      text-anchor="middle"
                      fill="currentColor"
                      stroke="none">XML</text>
            </svg>
        </span>
    </button>
</MudTooltip>

@code {
    [Parameter] public string Title { get; set; } = "XML";
    [Parameter] public Color Color { get; set; } = Color.Info;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string GetColor() => Color switch
    {
        Color.Primary   => "var(--mud-palette-primary)",
        Color.Secondary => "var(--mud-palette-secondary)",
        Color.Info      => "var(--mud-palette-info)",
        Color.Success   => "var(--mud-palette-success)",
        Color.Warning   => "var(--mud-palette-warning)",
        Color.Error     => "var(--mud-palette-error)",
        Color.Dark      => "var(--mud-palette-dark)",
        Color.Tertiary  => "var(--mud-palette-tertiary)",
        _               => "var(--mud-palette-action-default)"
    };
}
