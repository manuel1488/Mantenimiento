@page "/labels/bulk"
@using App.Core.Constants
@using App.Core.DTOs.Label
@using App.Core.DTOs.Product

@using App.Core.DTOs.Shop
@using App.Core.Interfaces
@using App.Core.Interfaces.Shop
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@inject IBulkLabelService BulkLabelService
@inject IProductService ProductService
@inject IUnitMeasureService UnitMeasureService
@inject IProductWholesalePriceService WholesalePriceService
@inject ISnackbar Snackbar
@inject IStringLocalizer<BulkLabelingPage> L
@inject ILogger<BulkLabelingPage> Logger
@inject IJSRuntime JS

@attribute [Authorize(Policy = ApplicationClaims.Labels.PrintLabels)]

<PageTitle>@L["Bulk Labeling"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["Bulk Labeling"]</MudText>

<MudGrid Justify="Justify.FlexStart">
    <MudItem xs="12" sm="10" md="7" lg="5">
        <MudPaper Elevation="2" Class="pa-5">

            <!-- Product search -->
            <MudAutocomplete T="ProductDto"
                             @ref="_autocomplete"
                             Label="@L["Product"]"
                             SearchFunc="@SearchProductsAsync"
                             ValueChanged="@OnProductSelected"
                             ToStringFunc="@(p => p == null ? string.Empty : $"{p.Code} - {p.Name}")"
                             Variant="Variant.Outlined"
                             Margin="Margin.Normal"
                             ResetValueOnEmptyText="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Adornment="Adornment.End"
                             Class="mb-2"
                             Required="true"
                             RequiredError="@L["Product is required"]" />

            <!-- Quantity — the only value the operator enters -->
            <MudNumericField T="decimal"
                             @ref="_quantityField"
                             Value="@_quantity"
                             ValueChanged="@OnQuantityChanged"
                             Label="@L["Quantity"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Normal"
                             Min="0.001m"
                             Step="0.100m"
                             Format="0.###"
                             Adornment="Adornment.End"
                             AdornmentText="@_unitCode"
                             Class="mb-4"
                             Required="true"
                             RequiredError="@L["Quantity must be greater than 0"]"
                             @onkeydown="@HandleQuantityKeyDown" />

            <!-- Price summary — read-only display, only shown when product is selected -->
            @if (_selectedProduct != null)
            {
                <MudDivider Class="mb-3" />

                @* Badge mayoreo *@
                @if (_discountPercentage > 0)
                {
                    <div class="mb-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">
                            @if (_applicableFixedPrice.HasValue)
                            {
                                @($"{L["Wholesale"]} ${_applicableFixedPrice.Value:N2}")
                            }
                            else
                            {
                                @($"{L["Wholesale"]} -{_discountPercentage:0.##}%")
                            }
                        </MudChip>
                    </div>
                }

                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Unit Price"]</MudText>
                    @if (_discountPercentage > 0)
                    {
                        <div style="text-align:right; line-height:1.2;">
                            <span style="font-size:11px; color:#999; text-decoration:line-through;">@_originalUnitPrice.ToString("C2")</span>
                            <br />
                            <MudText Typo="Typo.body1" Color="Color.Success"><strong>@_unitPrice.ToString("C2")</strong></MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1">@_unitPrice.ToString("C2")</MudText>
                    }
                </div>

                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.body1"><strong>@L["Total Price"]</strong></MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_totalPrice.ToString("C2")</MudText>
                </div>
            }

            <!-- Action buttons -->
            <div class="d-flex gap-3 align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="@PrintAsync"
                           Disabled="@(!CanSubmit || _printing)">
                    @if (_printing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                    }
                    @L["Print"]
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@ResetFormAsync">
                    @L["Reset"]
                </MudButton>
            </div>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    #region Fields
    private MudAutocomplete<ProductDto> _autocomplete = null!;
    private MudNumericField<decimal> _quantityField = null!;
    private ProductDto? _selectedProduct;
    private decimal _quantity = 0;
    private decimal _unitPrice = 0;
    private decimal _originalUnitPrice = 0;
    private decimal _totalPrice = 0;
    private string _unitCode = string.Empty;
    private string _unitMeasureCode = string.Empty;
    private bool _printing = false;
    private List<ProductWholesalePriceDto> _wholesalePrices = [];
    private decimal _discountPercentage = 0;
    private decimal? _applicableFixedPrice = null;
    #endregion

    #region Lifecycle
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _autocomplete.FocusAsync();
    }
    #endregion

    #region Computed
    private bool CanSubmit => _selectedProduct != null && _quantity > 0 && _unitPrice > 0;
    #endregion

    #region Product Search
    private async Task<IEnumerable<ProductDto>> SearchProductsAsync(string value, CancellationToken ct)
    {
        try
        {
            var (_, items) = await ProductService.GetProductsAsync(
                page: 1,
                pageSize: 20,
                searchString: value,
                isActive: true);
            return items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching products");
            return [];
        }
    }

    private async Task OnProductSelected(ProductDto? product)
    {
        _selectedProduct = product;
        if (product == null)
        {
            _unitCode = string.Empty;
            _unitMeasureCode = string.Empty;
            _unitPrice = 0;
            _originalUnitPrice = 0;
            _totalPrice = 0;
            _wholesalePrices = [];
            _discountPercentage = 0;
            _applicableFixedPrice = null;
            return;
        }

        _unitPrice = product.Price;
        _originalUnitPrice = product.Price;
        _wholesalePrices = [];
        _discountPercentage = 0;
        _applicableFixedPrice = null;

        var wpResult = await WholesalePriceService.GetWholesalePricesForProductAsync(product.Id);
        if (wpResult.IsSuccess)
            _wholesalePrices = wpResult.Value.ToList();

        try
        {
            var unit = await UnitMeasureService.GetUnitMeasureByIdAsync(product.UnitMeasureId);
            _unitMeasureCode = unit?.Code ?? product.UnitMeasureName;
            _unitCode = unit?.Code ?? string.Empty;
        }
        catch
        {
            _unitMeasureCode = product.UnitMeasureName;
            _unitCode = string.Empty;
        }

        RecalculateTotal();
        await _quantityField.FocusAsync();
    }
    #endregion

    #region Calculations
    private void OnQuantityChanged(decimal value)
    {
        _quantity = value;
        RecalculateTotal();
    }

    private void RecalculateTotal()
    {
        _discountPercentage = GetApplicableWholesaleDiscount();
        _applicableFixedPrice = GetApplicableWholesaleFixedPrice();

        _unitPrice = _discountPercentage > 0
            ? Math.Round(_originalUnitPrice * (1 - _discountPercentage / 100), 4)
            : _originalUnitPrice;

        _totalPrice = Math.Round(_quantity * _unitPrice, 2);
    }

    private decimal GetApplicableWholesaleDiscount()
    {
        if (_wholesalePrices.Count == 0) return 0;
        var applicable = _wholesalePrices
            .Where(w => w.IsActive && _quantity >= w.MinQuantity)
            .Where(w => w.FixedPrice is > 0 || w.DiscountPercentage > 0)
            .OrderByDescending(w => w.MinQuantity)
            .FirstOrDefault();
        if (applicable == null) return 0;
        if (applicable.FixedPrice is > 0 && _originalUnitPrice > 0)
            return (_originalUnitPrice - applicable.FixedPrice.Value) / _originalUnitPrice * 100;
        return applicable.DiscountPercentage;
    }

    private decimal? GetApplicableWholesaleFixedPrice()
    {
        if (_wholesalePrices.Count == 0) return null;
        return _wholesalePrices
            .Where(w => w.IsActive && w.FixedPrice is > 0 && _quantity >= w.MinQuantity)
            .OrderByDescending(w => w.MinQuantity)
            .FirstOrDefault()?.FixedPrice;
    }
    #endregion

    #region Actions
    private async Task HandleQuantityKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSubmit && !_printing)
            await PrintAsync();
    }

    private async Task PrintAsync()
    {
        if (!CanSubmit) return;

        _printing = true;
        StateHasChanged();

        try
        {
            var dto = new CreateBulkLabelJobDto
            {
                ProductId = _selectedProduct!.Id,
                Quantity = _quantity,
                UnitMeasureCode = _unitMeasureCode,
                UnitPrice = _unitPrice,
                TotalPrice = _totalPrice,
                LabelCount = 1
            };

            var result = await BulkLabelService.CreateAsync(dto);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error, Severity.Error);
                return;
            }

            await JS.InvokeVoidAsync("printTicket", $"/api/labels/bulk/{result.Value.Id}/pdf");
            await ResetFormAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing label");
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _printing = false;
        }
    }

    private async Task ResetFormAsync()
    {
        _selectedProduct = null;
        _quantity = 0;
        _unitPrice = 0;
        _originalUnitPrice = 0;
        _totalPrice = 0;
        _unitCode = string.Empty;
        _unitMeasureCode = string.Empty;
        _wholesalePrices = [];
        _discountPercentage = 0;
        _applicableFixedPrice = null;
        await _autocomplete.ResetAsync();
        await _autocomplete.FocusAsync();
    }
    #endregion
}
