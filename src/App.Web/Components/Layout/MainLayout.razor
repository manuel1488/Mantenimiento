@using App.Web.Services
@inherits LayoutComponentBase
@inject IBrowserViewportService BrowserViewportService
@inject ILogger<MainLayout> _logger
@inject CurrentThemeService ThemeService
@implements IAsyncDisposable

<MudThemeProvider Theme="ThemeService.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <AppBar OnDrawerToggle="DrawerToggle" />
            <MudDrawer @bind-Open="_drawerOpen" 
                      Elevation="1"
                      ClipMode="@_clipMode"
                      Overlay="@_isSmallScreen"
                      Variant="@_drawerVariant"
                      Breakpoint="@_breakpoint"
                      OverlayAutoClose="@_isSmallScreen">
                <NavMenu />
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen;
    private bool _isSmallScreen;
    private Guid _subscriptionId = Guid.NewGuid();

    // Drawer properties configurable based on screen size
    private DrawerClipMode _clipMode => _isSmallScreen ? DrawerClipMode.Never : DrawerClipMode.Always;
    private DrawerVariant _drawerVariant => _isSmallScreen ? DrawerVariant.Temporary : DrawerVariant.Responsive;
    private Breakpoint _breakpoint => Breakpoint.Md;

    protected override async Task OnInitializedAsync()
    {
        // Configure initial state based on screen size
        var breakpoint = await BrowserViewportService.GetCurrentBreakpointAsync();
        _isSmallScreen = breakpoint <= _breakpoint;
        _drawerOpen = !_isSmallScreen;

        await BrowserViewportService.SubscribeAsync(_subscriptionId, async @event =>
        {
            var wasSmallScreen = _isSmallScreen;
            _isSmallScreen = @event.Breakpoint <= _breakpoint;

            // If screen type changed
            if (wasSmallScreen != _isSmallScreen)
            {
                // Close drawer on small screen
                if (_isSmallScreen)
                {
                    _drawerOpen = false;
                }
                // Open drawer on large screen
                else
                {
                    _drawerOpen = true;
                }
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscriptionId != Guid.Empty)
        {
            try
            {
                await BrowserViewportService.UnsubscribeAsync(_subscriptionId);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error unsubscribing from viewport service");
            }
        }
    }
}