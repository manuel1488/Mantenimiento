@using App.Core.DTOs.Location
@using App.Core.Interfaces

@inject ILocationService LocationService
@inject IUserLocationService UserLocationService
@inject IStringLocalizer<BranchSelector> L
@inject ILogger<BranchSelector> Logger

@if (_locations.Any())
{
    <MudSelect T="int?" Value="_selectedLocationId"
               ValueChanged="OnLocationChanged"
               Variant="Variant.Outlined"
               Dense="true"
               Margin="Margin.Dense"
               Class="ml-4"
               Style="min-width: 180px; max-width: 250px; color: white;"
               Placeholder="@L["All Locations"]">
        @if (_isGlobalAccess)
        {
            <MudSelectItem T="int?" Value="@((int?)null)">@L["All Locations"]</MudSelectItem>
        }
        @foreach (var location in _locations)
        {
            <MudSelectItem T="int?" Value="@location.Id">@location.Name</MudSelectItem>
        }
    </MudSelect>
}

@code {
    [Inject] private App.Shared.Services.ICurrentUserService _currentUserService { get; set; } = null!;

    [Parameter] public EventCallback<int?> OnLocationSelected { get; set; }

    private IList<LocationDto> _locations = new List<LocationDto>();
    private int? _selectedLocationId;
    private bool _isGlobalAccess;

    protected override async Task OnInitializedAsync()
    {
        _isGlobalAccess = await _currentUserService.GetIsGlobalAccessAsync();
        await LoadLocations();
        _selectedLocationId = await _currentUserService.GetActiveLocationIdAsync();
    }

    private async Task LoadLocations()
    {
        try
        {
            if (_isGlobalAccess)
            {
                _locations = await LocationService.GetActiveLocationsAsync();
            }
            else
            {
                var userId = await _currentUserService.GetUserIdAsync();
                var result = await UserLocationService.GetUserLocationsAsync(userId);
                if (result.IsSuccess)
                {
                    _locations = result.Value;

                    // Auto-select first location if user has only one and none is selected
                    if (_locations.Count == 1 && await _currentUserService.GetActiveLocationIdAsync() == null)
                    {
                        await OnLocationChanged(_locations[0].Id);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading locations for selector");
        }
    }

    private async Task OnLocationChanged(int? locationId)
    {
        _selectedLocationId = locationId;
        await _currentUserService.SetActiveLocationAsync(locationId);
        await OnLocationSelected.InvokeAsync(locationId);
    }
}
