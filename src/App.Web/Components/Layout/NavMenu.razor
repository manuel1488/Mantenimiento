@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection
@using App.Core.Constants
@using MudBlazor
@inject IStringLocalizer<NavMenu> L

<MudDrawerHeader>
    <MudText Typo="Typo.h6">@L["App Name"]</MudText>
</MudDrawerHeader>

<MudNavMenu>
    <AuthorizeView Policy="@ApplicationClaims.Shared.ViewDashboard">
        <Authorized Context="dashAuth">
            <MudNavLink Icon="@Icons.Material.Filled.Dashboard"
                        Href="/dashboard" Match="NavLinkMatch.All">
                @L["Dashboard"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Shop (Tienda) -->
    <AuthorizeView Policy="@ApplicationClaims.Shop.ShopAccess">
        <Authorized Context="shopAuth">
            <MudNavGroup Title="@L["Shop"]"
                        Icon="@Icons.Material.Filled.Store"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewSales">
                    <Authorized Context="salesAuth">
                        <MudNavLink Href="/shop/sales">@L["Sales"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewHistorySales">
                    <Authorized Context="salesHistoryAuth">
                        <MudNavLink Href="/shop/sales-history">@L["View sales history"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewQuotations">
                    <Authorized Context="quotationsAuth">
                        <MudNavLink Href="/shop/quotations">@L["Quotations"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewRemissions">
                    <Authorized Context="remissionsAuth">
                        <MudNavLink Href="/shop/remissions">@L["Remissions"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewDailySalesSummary">
                    <Authorized Context="dailySummaryAuth">
                        <MudNavLink Href="/shop/daily-sales-summary">@L["Daily Sales Summary"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewProducts">
                    <Authorized Context="productsAuth">
                        <MudNavLink Href="/shop/products">@L["Products"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInventory">
                    <Authorized Context="inventoryAuth">
                        <MudNavLink Href="/shop/inventory">@L["Inventory"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewCashRegister">
                    <Authorized Context="cashRegisterAuth">
                        <MudNavLink Href="/shop/cash-register">@L["Cash Register"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Factura Electrónica (Billing) -->
    <AuthorizeView Policy="@ApplicationClaims.Billing.BillingAccess">
        <Authorized Context="billingAuth">
            <MudNavGroup Title="@L["Electronic Invoicing"]"
                        Icon="@Icons.Material.Filled.ReceiptLong"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewInvoice">
                    <Authorized>
                        <MudNavLink Href="/shop/invoices">@L["Invoices"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewGlobalInvoices">
                    <Authorized>
                        <MudNavLink Href="/admin/global-invoices">@L["Global Invoices"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewStampBalance">
                    <Authorized>
                        <MudNavLink Href="/shop/stamp-balance">@L["Stamp Balance"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Reportes -->
    <AuthorizeView Policy="@ApplicationClaims.Shared.ReportsAccess">
        <Authorized Context="reportsAuth">
            <MudNavGroup Title="@L["Reports"]"
                        Icon="@Icons.Material.Filled.Assessment"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Shop.ViewSalesReport">
                    <Authorized>
                        <MudNavLink Href="/shop/reports/sales">@L["Sales Reports"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewBillingReports">
                    <Authorized>
                        <MudNavLink Href="/admin/reports/sales-book">@L["Sales Book"]</MudNavLink>
                        <MudNavLink Href="/admin/reports/individual-invoices">@L["Individual Invoices"]</MudNavLink>
                        <MudNavLink Href="/admin/reports/global-invoices">@L["Global Invoices Report"]</MudNavLink>
                        <MudNavLink Href="/admin/reports/conciliation">@L["Conciliation"]</MudNavLink>
                        <MudNavLink Href="/admin/reports/vat">@L["VAT Report"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Etiquetado (Labeling) -->
    <AuthorizeView Policy="@ApplicationClaims.Labels.LabelsAccess">
        <Authorized Context="labelsAuth">
            <MudNavGroup Title="@L["Labeling"]"
                        Icon="@Icons.Material.Filled.Label"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Labels.PrintLabels">
                    <Authorized Context="printLabelsAuth">
                        <MudNavLink Href="/labels/bulk">@L["Bulk Products"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Management (Gestión) -->
    <AuthorizeView Policy="@ApplicationClaims.Shared.SharedAccess">
        <Authorized Context="customersAuth">
            <MudNavGroup Title="@L["Management"]"
                        Icon="@Icons.Material.Filled.People"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Shared.ViewCustomers">
                    <MudNavLink Href="/customers">@L["Customers"]</MudNavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@ApplicationClaims.Shared.ViewSuppliers">
                    <MudNavLink Href="/management/suppliers">@L["Suppliers"]</MudNavLink>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- Sección Administration (Administración) -->
    <AuthorizeView Policy="@ApplicationClaims.Admin.AdminAccess">
        <Authorized Context="adminAuth">
            <MudNavGroup Title="@L["Administration"]"
                        Icon="@Icons.Material.Filled.AdminPanelSettings"
                        Expanded="true">
                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewUsers">
                    <Authorized Context="usersAuth">
                        <MudNavLink Href="/admin/users">@L["Users & Roles"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewSettings">
                    <Authorized Context="settingsAuth">
                        <MudNavLink Href="/admin/settings">@L["Settings"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ManageInitialSetup">
                    <Authorized Context="setupAuth">
                        <MudNavLink Href="/admin/initial-setup">@L["Initial Setup"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewCashiers">
                    <Authorized>
                        <MudNavLink Href="/admin/cashier-profiles" Icon="@Icons.Material.Filled.Badge">@L["Cashiers"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewCashStations">
                    <Authorized>
                        <MudNavLink Href="/admin/cash-stations" Icon="@Icons.Material.Filled.PointOfSale">@L["Cash Stations"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Policy="@ApplicationClaims.Admin.ViewAudit">
                    <Authorized>
                        <MudNavLink Href="/admin/audit-log" Icon="@Icons.Material.Filled.History">@L["Audit Log"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>

            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

<MudText Typo="Typo.caption" Class="pa-4 mud-text-secondary" Style="display:block;">
    v@_appVersion
</MudText>

@code {
    private readonly string _appVersion = Assembly.GetExecutingAssembly()
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? "0.0.0";
}
