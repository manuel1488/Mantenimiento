@using App.Core.Options
@using App.Web.Services
@using Microsoft.Extensions.Options
@inherits LayoutComponentBase
@inject IOptions<ApplicationOptions> applicationOptions
@inject CurrentThemeService ThemeService

<MudThemeProvider Theme="ThemeService.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="2">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                              Color="Color.Inherit" 
                              Edge="Edge.Start" 
                              Disabled="true" />
                <MudText Typo="Typo.h6" Class="ml-4">@applicationOptions.Value.Name</MudText>
                <MudSpacer />
            </MudAppBar>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <MudLayout>
            <MudAppBar Elevation="2" Color="Color.Primary">
                <MudText Typo="Typo.h6" Class="ml-2">@applicationOptions.Value.Name</MudText>
            </MudAppBar>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </NotAuthorized>
</AuthorizeView>

