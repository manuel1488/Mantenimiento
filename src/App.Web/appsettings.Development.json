{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "App",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "Server=localhost;port=3308;Database=App;User=root;Password=unixxxx;",
    "MaxRetryCount": 3,
    "CommandTimeout": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Application": {
    "Name": "App",
    "Version": "1.0.0",
    "DefaultLanguage": "es-MX",
    "SupportedLanguages": [
      "es-MX",
      "en-US"
    ],
    "BaseUrl": "https://localhost:7154"
  },
  "Images": {
    "StoragePath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "JpegQuality": 75,
    "Thumbnail": {
      "MaxWidth": 300,
      "MaxHeight": 300,
      "Prefix": "thumb_"
    }
  },
  "FiscalCatalogs": {
    "DataPath": "Data/FiscalCatalogs"
  },
  "FileStorage": {
    "TempPath": "./Temp"
  },
  "Export": {
    "MaxExportRecords": 10000,
    "MaxPdfRecords": 1000,
    "DefaultChunkSize": 1000,
    "TempPath": "wwwroot/temp"
  },
  "EPPlus": {
    "LicenseContext": "NonCommercial"
  },
  "ProductCodeGenerator": {
    "Prefix": "P",
    "MinLength": 4,
    "DefaultStrategy": "Sequential",
    "PadWithZeros": true,
    "NumberPadding": 4,
    "SequentialStartNumber": 1,
    "RandomUseNumbers": true,
    "RandomUseLetters": true,
    "RandomPartLength": 6,
    "DateFormat": "yyyyMMdd",
    "DateIncludeTime": false,
    "TimeFormat": "HHmm",
    "CategoryPrefixes": {
      "Paint": "PNT",
      "Tools": "TLS",
      "Parts": "PRT",
      "General": "GEN"
    }
  },
  "Camera": {
    "Width": {
      "Min": 1024,
      "Ideal": 1280,
      "Max": 1920
    },
    "Height": {
      "Min": 720,
      "Ideal": 776,
      "Max": 1080
    },
    "MimeType": "image/jpeg",
    "Quality": 1,
    "FacingMode": "environment"
  }
}