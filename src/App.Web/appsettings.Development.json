{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "AppBase",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "ConnectionString": "Server=localhost;port=3308;Database=App;User=root;Password=unixxxx;",
    "MaxRetryCount": 3,
    "CommandTimeout": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Application": {
    "Version": "1.0.0",
    "DefaultLanguage": "en-US",
    "SupportedLanguages": [
      "en-US",
      "es-MX"
    ],
    "BaseUrl": "https://localhost:7154"
  },
  "Images": {
    "StoragePath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "JpegQuality": 75,
    "Thumbnail": {
      "MaxWidth": 300,
      "MaxHeight": 300,
      "Prefix": "thumb_"
    }
  },
  "FileStorage": {
    "TempPath": "./Temp"
  }
}
