@model App.Core.DTOs.Label.BulkLabelViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Etiqueta</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @@page {
            margin: 0;
            size: @(Model.LabelWidthMm)mm @(Model.LabelHeightMm)mm;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fff;
            width: @(Model.LabelWidthMm)mm;
            height: @(Model.LabelHeightMm)mm;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .label {
            width: 100%;
            padding: 1.5mm 2mm;
            text-align: center;
        }

        .barcode-img {
            width: 100%;
            max-width: @(Model.LabelWidthMm - 4)mm;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        .barcode-text {
            font-size: 8px;
            font-family: 'Courier New', monospace;
            color: #000;
            margin-top: 1mm;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <div class="label">
        @if (!string.IsNullOrEmpty(Model.BarcodeBase64))
        {
            <img class="barcode-img" src="data:image/png;base64,@Model.BarcodeBase64" alt="barcode" />
        }
        <div class="barcode-text">@Model.BarcodeHumanReadable</div>
    </div>
</body>
</html>
