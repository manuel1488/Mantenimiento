@using App.Core.DTOs.Shop
@using App.Services.Shop
@using Microsoft.Extensions.Localization
@using App.Shared.Services
@inject IStringLocalizer<RemissionService> L
@inject IDateTime _dateTime
@model RemissionPdfDto

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@L["Remission"] @Model.RemissionNumber</title>
    <style>
        :root {
            --primary-color: #1A6868;
            --primary-light: #E0F2F1;
            --secondary-color: #546E7A;
        }

        body {
            font-family: 'Roboto', Arial, sans-serif;
            margin: 0;
            padding: 24px;
            color: #263238;
            font-size: 13px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: 16px;
        }

        .logo {
            max-width: 160px;
            max-height: 60px;
        }

        .company-info { text-align: right; }

        .company-name {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-color);
        }

        .document-title {
            font-size: 22px;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 16px;
        }

        .meta-grid {
            display: flex;
            gap: 32px;
            margin-bottom: 20px;
        }

        .meta-block { flex: 1; }

        .meta-label {
            font-size: 10px;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 500;
        }

        .meta-value {
            font-size: 14px;
            font-weight: 500;
            margin-top: 2px;
            color: #263238;
        }

        .info-row {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .customer-section {
            flex: 1;
            background: #F5F5F5;
            border-radius: 8px;
            padding: 12px 16px;
        }

        .section-title {
            font-size: 10px;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .customer-name { font-size: 15px; font-weight: 600; color: #263238; }
        .customer-legal { font-size: 12px; color: var(--secondary-color); margin-top: 1px; }

        .customer-detail {
            font-size: 11px;
            color: #546E7A;
            margin-top: 3px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
        }

        thead tr { background: var(--primary-color); color: white; }

        thead th {
            padding: 9px 12px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        thead th.text-right { text-align: right; }

        tbody tr:nth-child(even) { background: #F8FAFB; }

        tbody td {
            padding: 8px 12px;
            border-bottom: 1px solid #ECEFF1;
            font-size: 12px;
        }

        tbody td.text-right { text-align: right; }

        .totals-section {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .totals-table { width: 280px; }

        .totals-table td {
            padding: 5px 12px;
            border: none;
        }

        .totals-table .label {
            color: var(--secondary-color);
            font-size: 12px;
        }

        .totals-table .value { text-align: right; font-size: 13px; }

        .totals-table .total-row {
            border-top: 2px solid var(--primary-color);
        }

        .totals-table .total-row td {
            font-size: 15px;
            font-weight: bold;
            color: var(--primary-color);
            padding-top: 8px;
        }

        .notes-section {
            background: #F5F5F5;
            border-left: 4px solid var(--primary-color);
            border-radius: 4px;
            padding: 12px 16px;
            margin-bottom: 20px;
        }

        .notes-title {
            font-size: 10px;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .notes-text {
            font-size: 12px;
            line-height: 1.5;
            white-space: pre-wrap;
            color: #37474F;
        }

        .disclaimer {
            background: #FFF3E0;
            border: 1px solid #FF9800;
            border-radius: 4px;
            padding: 8px 16px;
            text-align: center;
            font-size: 12px;
            font-weight: 600;
            color: #E65100;
            margin-bottom: 20px;
        }

        .footer {
            text-align: center;
            font-size: 11px;
            color: var(--secondary-color);
            border-top: 1px solid #CFD8DC;
            padding-top: 12px;
            margin-top: 8px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div>
            @if (!string.IsNullOrEmpty(Model.LogoBase64))
            {
                <img src="@Model.LogoBase64" class="logo" alt="Logo" />
            }
        </div>
        <div class="company-info">
            <div class="company-name">@Model.CompanyName</div>
        </div>
    </div>

    <div class="disclaimer">@L["This document is not an invoice"]</div>

    <div class="document-title">@L["Remission"] — @Model.RemissionNumber</div>

    <div class="meta-grid">
        <div class="meta-block">
            <div class="meta-label">@L["Date"]</div>
            <div class="meta-value">@Model.RemissionDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Location"]</div>
            <div class="meta-value">@Model.LocationName</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Remission #"]</div>
            <div class="meta-value">@Model.RemissionNumber</div>
        </div>
    </div>

    <div class="info-row">
        <div class="customer-section">
            <div class="section-title">@L["Customer"]</div>
            <div class="customer-name">@Model.CustomerName</div>
            @if (!string.IsNullOrEmpty(Model.CustomerLegalName) && Model.CustomerLegalName != Model.CustomerName)
            {
                <div class="customer-legal">@Model.CustomerLegalName</div>
            }
            @if (!string.IsNullOrEmpty(Model.CustomerPhone))
            {
                <div class="customer-detail">&#9742; @Model.CustomerPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.CustomerAddress))
            {
                <div class="customer-detail">@Model.CustomerAddress</div>
            }
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>@L["Code"]</th>
                <th>@L["Product"]</th>
                <th class="text-right">@L["Qty"]</th>
                <th class="text-right">@L["Unit Price"]</th>
                @if (Model.Details.Any(d => d.DiscountAmount > 0))
                {
                    <th class="text-right">@L["Discount"]</th>
                }
                <th class="text-right">@L["Tax"]</th>
                <th class="text-right">@L["Total"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Details.Count; i++)
            {
                var item = Model.Details[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@item.ProductCode</td>
                    <td>@item.ProductName</td>
                    <td class="text-right">@item.Quantity.ToString("G29")</td>
                    <td class="text-right">@Model.CurrencySymbol@item.UnitPrice.ToString("N2")</td>
                    @if (Model.Details.Any(d => d.DiscountAmount > 0))
                    {
                        <td class="text-right">
                            @if (item.DiscountAmount > 0)
                            {
                                @($"-{Model.CurrencySymbol}{item.DiscountAmount:N2}")
                            }
                        </td>
                    }
                    <td class="text-right">@Model.CurrencySymbol@item.TaxAmount.ToString("N2")</td>
                    <td class="text-right">@Model.CurrencySymbol@item.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals-section">
        <table class="totals-table">
            <tr>
                <td class="label">@L["Subtotal"]</td>
                <td class="value">@Model.CurrencySymbol@Model.Subtotal.ToString("N2")</td>
            </tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr>
                    <td class="label">@L["Discount"]</td>
                    <td class="value">- @Model.CurrencySymbol@Model.DiscountAmount.ToString("N2")</td>
                </tr>
            }
            <tr>
                <td class="label">@L["Tax"]</td>
                <td class="value">@Model.CurrencySymbol@Model.TaxAmount.ToString("N2")</td>
            </tr>
            <tr class="total-row">
                <td class="label">@L["Total"]</td>
                <td class="value">@Model.CurrencySymbol@Model.Total.ToString("N2")</td>
            </tr>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="notes-section">
            <div class="notes-title">@L["Notes"]</div>
            <div class="notes-text">@Model.Notes</div>
        </div>
    }

    <div class="footer">
        @Model.CompanyName — @L["Remission"] @Model.RemissionNumber — @Model.RemissionDate.ToString("dd/MM/yyyy")
    </div>
</body>
</html>
