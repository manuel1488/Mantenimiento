@using App.Core.DTOs.Billing
@using App.Core.Enums.Billing
@model GlobalInvoicePdfDto

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Factura Global @Model.FolioDisplay</title>
    <style>
        :root {
            --primary: #C62828;
            --primary-light: #FFEBEE;
            --secondary: #546E7A;
            --surface: #F5F5F5;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 24px;
            color: #263238;
            font-size: 12px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 14px;
        }

        .logo { max-width: 150px; max-height: 55px; }

        .company-block { text-align: right; }
        .company-name { font-size: 18px; font-weight: bold; color: var(--primary); }
        .company-sub { font-size: 11px; color: var(--secondary); margin-top: 2px; }

        .cfdi-badge {
            display: inline-block;
            background: var(--primary);
            color: white;
            font-size: 10px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 3px;
            margin-top: 4px;
        }

        .cancelled-banner {
            background: var(--primary-light);
            border: 2px solid var(--primary);
            border-radius: 4px;
            text-align: center;
            padding: 6px;
            font-size: 15px;
            font-weight: bold;
            color: var(--primary);
            letter-spacing: 2px;
            margin-bottom: 14px;
        }

        .preview-banner {
            background: #FFF8E1;
            border: 2px dashed #F9A825;
            border-radius: 4px;
            text-align: center;
            padding: 8px;
            font-size: 13px;
            font-weight: bold;
            color: #F57F17;
            letter-spacing: 2px;
            margin-bottom: 14px;
        }

        .doc-title {
            font-size: 18px;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 12px;
        }

        .uuid-box {
            text-align: center;
            background: var(--surface);
            border: 1px dashed #90A4AE;
            border-radius: 4px;
            padding: 6px;
            margin-bottom: 14px;
        }

        .uuid-label { font-size: 9px; color: var(--secondary); text-transform: uppercase; }
        .uuid-value { font-size: 12px; font-weight: bold; font-family: monospace; }

        .meta-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .meta-block { min-width: 110px; }
        .meta-label { font-size: 9px; color: var(--secondary); text-transform: uppercase; }
        .meta-value { font-size: 12px; font-weight: 500; margin-top: 2px; }

        .two-col {
            display: flex;
            gap: 12px;
            margin-bottom: 14px;
        }

        .info-box {
            flex: 1;
            background: var(--surface);
            border-radius: 4px;
            padding: 9px 12px;
        }

        .info-box-title {
            font-size: 9px;
            color: var(--secondary);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .info-line { font-size: 11px; margin-bottom: 2px; }

        .global-section {
            background: var(--primary-light);
            border: 1px solid #EF9A9A;
            border-radius: 4px;
            padding: 9px 14px;
            margin-bottom: 14px;
        }

        .global-title {
            font-size: 9px;
            color: var(--primary);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .global-items { display: flex; gap: 20px; flex-wrap: wrap; }
        .global-item-label { font-size: 9px; color: var(--secondary); text-transform: uppercase; }
        .global-item-value { font-size: 12px; font-weight: 500; }

        .totals-wrap { display: flex; justify-content: flex-end; margin-bottom: 14px; }

        .totals-table { width: 280px; border-collapse: collapse; }

        .totals-table td {
            padding: 4px 8px;
            font-size: 12px;
        }

        .totals-table .lbl { color: var(--secondary); }
        .totals-table .val { text-align: right; }

        .totals-table tr.grand-total {
            border-top: 2px solid var(--primary);
        }

        .totals-table tr.grand-total td {
            font-size: 14px;
            font-weight: bold;
            color: var(--primary);
            padding-top: 6px;
        }

        .seals {
            background: #FAFAFA;
            border: 1px solid #ECEFF1;
            border-radius: 4px;
            padding: 9px 12px;
            margin-bottom: 14px;
            word-break: break-all;
        }

        .seal-label { font-size: 9px; color: var(--secondary); text-transform: uppercase; margin-bottom: 1px; }
        .seal-value { font-size: 8px; font-family: monospace; color: #37474F; margin-bottom: 7px; }

        .footer {
            text-align: center;
            font-size: 10px;
            color: var(--secondary);
            border-top: 1px solid #CFD8DC;
            padding-top: 8px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div>
            @if (!string.IsNullOrEmpty(Model.LogoBase64))
            {
                <img src="@Model.LogoBase64" class="logo" alt="Logo" />
            }
        </div>
        <div class="company-block">
            <div class="company-name">@Model.CompanyName</div>
            <div class="company-sub">RFC: @Model.IssuerRfc &nbsp;|&nbsp; @Model.IssuerLegalName</div>
            <div class="company-sub">Régimen Fiscal: @Model.IssuerFiscalRegime &nbsp;|&nbsp; CP: @Model.IssuerPostalCode</div>
            <div><span class="cfdi-badge">CFDI 4.0 — Factura Global</span></div>
        </div>
    </div>

    @if (Model.IsPreview)
    {
        <div class="preview-banner">⚠ VISTA PREVIA — DOCUMENTO NO VÁLIDO FISCALMENTE</div>
    }

    @if (Model.Status == GlobalInvoiceStatus.Cancelled)
    {
        <div class="cancelled-banner">CANCELADA</div>
    }

    <div class="doc-title">Factura Global — @Model.FolioDisplay</div>

    <!-- UUID -->
    @if (!string.IsNullOrEmpty(Model.Uuid))
    {
        <div class="uuid-box">
            <div class="uuid-label">Folio Fiscal (UUID)</div>
            <div class="uuid-value">@Model.Uuid</div>
        </div>
    }

    <!-- CFDI metadata -->
    <div class="meta-grid">
        <div class="meta-block">
            <div class="meta-label">Folio</div>
            <div class="meta-value">@Model.FolioDisplay</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">Fecha de Timbre</div>
            <div class="meta-value">@(Model.StampDateLocal ?? "—")</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">Forma de Pago</div>
            <div class="meta-value">@Model.PaymentForm — @Model.PaymentFormDescription</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">Método de Pago</div>
            <div class="meta-value">PUE — Pago en una exhibición</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">Ventas Incluidas</div>
            <div class="meta-value">@Model.SaleCount</div>
        </div>
    </div>

    <!-- Emisor / Receptor -->
    <div class="two-col">
        <div class="info-box">
            <div class="info-box-title">Emisor</div>
            <div class="info-line"><strong>@Model.IssuerLegalName</strong></div>
            <div class="info-line">RFC: @Model.IssuerRfc</div>
            <div class="info-line">Régimen Fiscal: @Model.IssuerFiscalRegime</div>
            <div class="info-line">Código Postal: @Model.IssuerPostalCode</div>
        </div>
        <div class="info-box">
            <div class="info-box-title">Receptor</div>
            <div class="info-line"><strong>PUBLICO EN GENERAL</strong></div>
            <div class="info-line">RFC: XAXX010101000</div>
            <div class="info-line">Régimen Fiscal: 616 — Sin obligaciones fiscales</div>
            <div class="info-line">Uso CFDI: S01 — Sin efectos fiscales</div>
        </div>
    </div>

    <!-- InformacionGlobal -->
    <div class="global-section">
        <div class="global-title">Información Global (InformacionGlobal)</div>
        <div class="global-items">
            <div>
                <div class="global-item-label">Rango de Fechas</div>
                <div class="global-item-value">@Model.StartDateLocal — @Model.EndDateLocal</div>
            </div>
            <div>
                <div class="global-item-label">Mes / Año</div>
                <div class="global-item-value">@Model.PeriodMonth / @Model.PeriodYear</div>
            </div>
        </div>
    </div>

    <!-- Totals -->
    <div class="totals-wrap">
        <table class="totals-table">
            <tr>
                <td class="lbl">Subtotal</td>
                <td class="val">@Model.CurrencySymbol@Model.Subtotal.ToString("N2")</td>
            </tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr>
                    <td class="lbl">Descuento</td>
                    <td class="val">- @Model.CurrencySymbol@Model.DiscountAmount.ToString("N2")</td>
                </tr>
            }
            <tr>
                <td class="lbl">IVA</td>
                <td class="val">@Model.CurrencySymbol@Model.TaxAmount.ToString("N2")</td>
            </tr>
            <tr class="grand-total">
                <td class="lbl">Total</td>
                <td class="val">@Model.CurrencySymbol@Model.Total.ToString("N2")</td>
            </tr>
        </table>
    </div>

    <!-- Digital seals -->
    @if (!string.IsNullOrEmpty(Model.SelloCfdi) || !string.IsNullOrEmpty(Model.SelloSat))
    {
        <div class="seals">
            @if (!string.IsNullOrEmpty(Model.NoCertificadoCfdi))
            {
                <div class="seal-label">No. de Certificado del CFDI</div>
                <div class="seal-value">@Model.NoCertificadoCfdi</div>
            }
            @if (!string.IsNullOrEmpty(Model.SelloCfdi))
            {
                <div class="seal-label">Sello Digital del CFDI</div>
                <div class="seal-value">@Model.SelloCfdi</div>
            }
            @if (!string.IsNullOrEmpty(Model.SelloSat))
            {
                <div class="seal-label">Sello Digital del SAT</div>
                <div class="seal-value">@Model.SelloSat</div>
            }
        </div>
    }

    <div class="footer">
        @Model.CompanyName &nbsp;|&nbsp; Factura Global @Model.FolioDisplay
        @if (!string.IsNullOrEmpty(Model.StampDateLocal))
        {
            @: &nbsp;|&nbsp; Timbrada: @Model.StampDateLocal
        }
        &nbsp;|&nbsp; Este documento es una representación impresa de un CFDI
    </div>

</body>
</html>
