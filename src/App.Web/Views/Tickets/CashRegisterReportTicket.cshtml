@model App.Core.DTOs.Ticket.TicketDto<App.Core.DTOs.Shop.CashRegisterReportDto>
@using App.Core.Enums.Shop
@using App.Shared.Services
@inject IDateTime DateTimeService

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Caja</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.2;
            color: #000;
            background: #fff;
            width: @(Model.TicketWidth)mm;
            margin: 0 auto;
            padding: 3mm 2mm 3mm 2mm;
        }

        .ticket-container {
            width: 100%;
            text-align: center;
        }

        .company-logo {
            max-width: 60mm;
            max-height: 20mm;
            margin: 0 auto 2mm auto;
            display: block;
        }

        .company-name {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 1mm;
            text-transform: uppercase;
        }

        .company-info {
            font-size: 10px;
            margin-bottom: 1mm;
            line-height: 1.3;
        }

        .divider {
            border-top: 1px dashed #000;
            margin: 2mm 0;
            width: 100%;
        }

        .title {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 1mm;
            letter-spacing: 1px;
        }

        .info {
            text-align: left;
            font-size: 11px;
            margin-bottom: 2mm;
        }

        .info div {
            margin-bottom: 0.5mm;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        td {
            padding: 0.5mm 0;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .separator td {
            border-top: 1px solid #000;
        }

        .signature {
            margin-top: 6mm;
            font-size: 10px;
        }

        @@media print {
            body {
                margin: 0;
                padding: 2mm 1mm;
            }

            .ticket-container {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="ticket-container">

        @if (Model.ShowCompanyLogo && !string.IsNullOrEmpty(Model.CompanyLogoBase64))
        {
            <img src="data:image/png;base64,@Model.CompanyLogoBase64" alt="Logo" class="company-logo" />
        }

        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <div class="company-name">@Model.CompanyName</div>
        }

        <div class="company-info">
            @if (!string.IsNullOrEmpty(Model.CompanyAddress))
            {
                <div>@Model.CompanyAddress</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyPhone))
            {
                <div>Tel: @Model.CompanyPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyTaxId))
            {
                <div>RFC: @Model.CompanyTaxId</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.CustomHeader))
        {
            <div style="font-size:11px; font-style:italic; margin-bottom:2mm;">@Model.CustomHeader</div>
        }

        <div class="divider"></div>

        <div class="title">Reporte de Caja</div>
        <div style="font-size:10px; margin-bottom:1mm;"># @Model.Data.CashRegisterId.ToString("D6")</div>

        <div class="divider"></div>

        <div class="info">
            <div><strong>Ubicación:</strong> @Model.Data.LocationName</div>
            <div><strong>Cajero:</strong> @Model.Data.CashierName</div>
            @{
                var openedStr = Model.TimeZone != null
                    ? DateTimeService.FormatToTimezone(Model.Data.OpenedAt, Model.TimeZone)
                    : Model.Data.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy h:mm tt");
            }
            <div><strong>Abierta el:</strong> @openedStr</div>
            @if (Model.Data.ClosedAt.HasValue)
            {
                var closedStr = Model.TimeZone != null
                    ? DateTimeService.FormatToTimezone(Model.Data.ClosedAt.Value, Model.TimeZone)
                    : Model.Data.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy h:mm tt");
                <div><strong>Cerrada el:</strong> @closedStr</div>
            }
        </div>

        <div class="divider"></div>

        <table>
            <tr>
                <td>Fondo Inicial</td>
                <td class="right">@Model.Data.InitialFund.ToString("C")</td>
            </tr>
            <tr>
                <td>Ventas en Efectivo</td>
                <td class="right">@Model.Data.TotalCashSales.ToString("C")</td>
            </tr>
            <tr>
                <td>Depósitos</td>
                <td class="right">@Model.Data.TotalDeposits.ToString("C")</td>
            </tr>
            <tr>
                <td>Retiros</td>
                <td class="right">(@Model.Data.TotalWithdrawals.ToString("C"))</td>
            </tr>
            <tr class="separator">
                <td class="bold">Efectivo Esperado</td>
                <td class="right bold">@Model.Data.ExpectedCash.ToString("C")</td>
            </tr>
            @{
                var diffSign = Model.Data.Difference >= 0 ? "+" : "";
            }
            @if (Model.Data.CountedCash != 0)
            {
                <tr>
                    <td class="bold">Efectivo Contado</td>
                    <td class="right bold">@Model.Data.CountedCash.ToString("C")</td>
                </tr>
                <tr>
                    <td class="bold">Diferencia</td>
                    <td class="right bold">@diffSign@Model.Data.Difference.ToString("C")</td>
                </tr>
            }
        </table>

        @if (Model.Data.PaymentSummary.Count > 0)
        {
            <div class="divider"></div>
            <div style="font-size:11px; font-weight:bold; margin-bottom:1mm;">Formas de Pago</div>
            <table>
                @foreach (var ps in Model.Data.PaymentSummary)
                {
                    <tr>
                        <td style="font-size:10px;">@ps.PaymentMethodName</td>
                        <td class="right" style="font-size:10px;">@ps.TotalAmount.ToString("C")</td>
                    </tr>
                }
            </table>
        }

        @if (Model.Data.Movements.Count > 0)
        {
            <div class="divider"></div>
            <div style="font-size:11px; font-weight:bold; margin-bottom:1mm;">Movimientos</div>
            @foreach (var m in Model.Data.Movements)
            {
                <table style="margin-bottom:1mm;">
                    <tr>
                        <td style="font-size:10px;">@(m.Type == CashRegisterMovementType.Withdrawal ? "Retiro" : "Depósito")</td>
                        <td class="right bold" style="font-size:10px;">
                            @(m.Type == CashRegisterMovementType.Withdrawal ? "-" : "+")@m.Amount.ToString("C")
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(m.Reason))
                    {
                        <tr>
                            <td colspan="2" style="font-size:9px; color:gray;">@m.Reason — @m.CreatedAt.ToLocalTime().ToString("t")</td>
                        </tr>
                    }
                </table>
            }
        }

        @if (!string.IsNullOrWhiteSpace(Model.Data.ClosingNotes))
        {
            <div class="divider"></div>
            <div style="text-align:left; font-size:10px;"><strong>Notas:</strong> @Model.Data.ClosingNotes</div>
        }

        <div class="divider"></div>

        <div class="signature">
            Firma del Cajero<br />
            ___________________________<br />
            <span style="font-size:9px;">@Model.Data.CashierName</span>
        </div>

    </div>
</body>
</html>
