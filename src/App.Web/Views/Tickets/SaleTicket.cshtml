@model App.Core.DTOs.Ticket.TicketDto<App.Core.DTOs.Shop.SaleDto>
@using App.Shared.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App.Web.Views.Tickets.SaleTicket> L
@inject IDateTime DateTimeService

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sale Ticket"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.2;
            color: #000;
            background: #fff;
            width: @(Model.TicketWidth)mm;
            margin: 0 auto;
            padding: 3mm 2mm 3mm 2mm;
        }

        .ticket-container {
            width: 100%;
            text-align: center;
        }

        .company-logo {
            max-width: 60mm;
            max-height: 20mm;
            margin: 0 auto 2mm auto;
            display: block;
        }

        .company-name {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 1mm;
            text-transform: uppercase;
        }

        .company-info {
            font-size: 10px;
            margin-bottom: 1mm;
            line-height: 1.3;
        }

        .custom-header {
            font-size: 11px;
            margin-bottom: 2mm;
            font-style: italic;
        }

        .divider {
            border-top: 1px dashed #000;
            margin: 2mm 0;
            width: 100%;
        }

        .sale-header {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 1mm;
        }

        .sale-info {
            text-align: left;
            margin-bottom: 2mm;
            font-size: 11px;
        }

        .sale-info div {
            margin-bottom: 0.5mm;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2mm;
            font-size: 10px;
        }

        .items-table th {
            border-bottom: 1px solid #000;
            padding: 0.5mm 0;
            text-align: left;
            font-weight: bold;
        }

        .items-table td {
            padding: 0.5mm 0;
            border-bottom: 1px dotted #ccc;
        }

        .item-name {
            width: 50%;
        }

        .item-qty {
            width: 15%;
            text-align: center;
        }

        .item-price {
            width: 20%;
            text-align: right;
        }

        .item-total {
            width: 15%;
            text-align: right;
        }

        .totals-section {
            text-align: right;
            margin-top: 2mm;
            font-size: 11px;
        }

        .totals-section div {
            margin-bottom: 0.5mm;
            display: flex;
            justify-content: space-between;
        }

        .total-line {
            font-weight: bold;
            font-size: 12px;
            border-top: 1px solid #000;
            padding-top: 0.5mm;
        }

        .payment-info {
            text-align: left;
            margin: 2mm 0;
            font-size: 11px;
        }

        .qr-code {
            text-align: center;
            margin: 2mm 0;
        }

        .qr-code img {
            max-width: 25mm;
            max-height: 25mm;
        }

        .custom-footer {
            font-size: 10px;
            margin-top: 2mm;
            font-style: italic;
        }

        .thank-you {
            font-size: 12px;
            font-weight: bold;
            margin-top: 2mm;
            text-transform: uppercase;
        }

        .sale-id {
            font-size: 10px;
            margin-top: 1mm;
            color: #666;
        }

        @@media print {
            body {
                margin: 0;
                padding: 2mm 1mm;
            }
            
            .ticket-container {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="ticket-container">
        
        @* Company Logo *@
        @if (Model.ShowCompanyLogo && !string.IsNullOrEmpty(Model.CompanyLogoBase64))
        {
            <img src="data:image/png;base64,@Model.CompanyLogoBase64" alt="@L["Company Logo"]" class="company-logo" />
        }

        @* Company Name *@
        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <div class="company-name">@Model.CompanyName</div>
        }

        @* Company Information *@
        <div class="company-info">
            @if (!string.IsNullOrEmpty(Model.CompanyAddress))
            {
                <div>@Model.CompanyAddress</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyPhone))
            {
                <div>@L["Phone"]: @Model.CompanyPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyTaxId))
            {
                <div>@L["Tax ID"]: @Model.CompanyTaxId</div>
            }
        </div>

        @* Custom Header *@
        @if (!string.IsNullOrEmpty(Model.CustomHeader))
        {
            <div class="custom-header">@Model.CustomHeader</div>
        }

        <div class="divider"></div>

        @* Sale Header *@
        <div class="sale-header">@L["SALE RECEIPT"]</div>

        @* Sale Information *@
        <div class="sale-info">
            <div><strong>@L["Sale"]:</strong> #@Model.Data.Id</div>
            <div><strong>@L["Date"]:</strong> @(Model.TimeZone != null ? DateTimeService.FormatToTimezone(Model.Data.SaleDate, Model.TimeZone) : Model.Data.SaleDate.ToString("dd/MM/yyyy h:mm tt"))</div>
            <div><strong>@L["Customer"]:</strong> @Model.Data.CustomerName</div>

        </div>

        <div class="divider"></div>

        @* Items Table *@
        <table class="items-table">
            <thead>
                <tr>
                    <th class="item-name">@L["Product"]</th>
                    <th class="item-qty">@L["Qty"]</th>
                    <th class="item-price">@L["Price"]</th>
                    <th class="item-total">@L["Total"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.Data.Details)
                {
                    <tr>
                        <td class="item-name">@detail.ProductName</td>
                        <td class="item-qty">@detail.Quantity.ToString("0.###")</td>
                        <td class="item-price">@detail.UnitPrice.ToString("C")</td>
                        <td class="item-total">@detail.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="divider"></div>

        @* Totals Section *@
        <div class="totals-section">
            <div>
                <span>@L["Subtotal"]:</span>
                <span>@Model.Data.Subtotal.ToString("C")</span>
            </div>
            
            @if (Model.Data.DiscountAmount > 0)
            {
                <div>
                    <span>@L["Discount"] (@Model.Data.DiscountPercentage.ToString("0.##")%):</span>
                    <span>-@Model.Data.DiscountAmount.ToString("C")</span>
                </div>
            }
            
            @if (Model.Data.TaxAmount > 0)
            {
                <div>
                    <span>@L["Tax"]:</span>
                    <span>@Model.Data.TaxAmount.ToString("C")</span>
                </div>
            }

            @if (Model.Data.RoundingAmount != 0)
            {
                <div>
                    <span>@L["Rounding"]:</span>
                    <span>@(Model.Data.RoundingAmount > 0 ? "+" : "")@Model.Data.RoundingAmount.ToString("C")</span>
                </div>
            }

            <div class="total-line">
                <span>@L["TOTAL"]:</span>
                <span>@Model.Data.Total.ToString("C")</span>
            </div>
        </div>

        @* Payment Information *@
        <div class="payment-info">
            <div><strong>@L["Payment Method"]:</strong> @(string.Join(", ", Model.Data.Payments.Select(p => p.PaymentMethodName)))</div>
            <div><strong>@L["Status"]:</strong> @L[Model.Data.Status.ToString()]</div>
        </div>

        @* QR Code *@
        @if (Model.ShowQRCode && !string.IsNullOrEmpty(Model.QRCodeData))
        {
            <div class="qr-code">
                <img src="data:image/png;base64,@Model.QRCodeData" alt="@L["QR Code"]" />
                <div style="font-size: 9px; margin-top: 0.5mm;">@L["Scan for details"]</div>
            </div>
        }

        <div class="divider"></div>

        @* Custom Footer *@
        @if (!string.IsNullOrEmpty(Model.CustomFooter))
        {
            <div class="custom-footer">@Model.CustomFooter</div>
        }

        @* Sale ID for reference *@
        <div class="sale-id">@L["Ref"]: @Model.Data.Id.ToString("D6")</div>

    </div>
</body>
</html>