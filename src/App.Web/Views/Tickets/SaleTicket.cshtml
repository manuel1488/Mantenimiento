@model App.Core.DTOs.Ticket.TicketDto<App.Core.DTOs.Shop.SaleDto>
@using App.Shared.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App.Web.Views.Tickets.SaleTicket> L
@inject IDateTime DateTimeService

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Sale Ticket"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.5;
            color: #000;
            background: #fff;
            width: @(Model.TicketWidth)mm;
            margin: 0 auto;
            padding: 4mm 3mm 5mm 3mm;
        }

        .ticket-container {
            width: 100%;
            text-align: center;
        }

        .company-logo {
            max-width: 60mm;
            max-height: 20mm;
            margin: 0 auto 3mm auto;
            display: block;
        }

        .company-name {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 1.5mm;
            text-transform: uppercase;
        }

        .company-info {
            font-size: 10px;
            margin-bottom: 1.5mm;
            line-height: 1.5;
        }

        .custom-header {
            font-size: 11px;
            margin-bottom: 2mm;
            font-style: italic;
        }

        .divider {
            border-top: 1px dashed #000;
            margin: 3mm 0;
            width: 100%;
        }

        .sale-header {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 1.5mm;
        }

        .sale-info {
            text-align: left;
            margin-bottom: 2mm;
            font-size: 11px;
        }

        .sale-info div {
            margin-bottom: 1mm;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2mm;
            font-size: 10px;
        }

        .items-table th {
            border-bottom: 1px solid #000;
            padding: 1mm 1mm 1mm 0;
            text-align: left;
            font-weight: bold;
        }

        .items-table th.align-right {
            text-align: right;
        }

        .items-table td {
            padding: 1.5mm 1mm 0.5mm 0;
            vertical-align: top;
        }

        .item-row td {
            border-bottom: 1px dotted #000;
            padding-bottom: 1mm;
        }

        .item-name-col {
            width: 46%;
        }

        .item-qty-col {
            width: 13%;
            text-align: center;
        }

        .item-price-col {
            width: 21%;
            text-align: right;
        }

        .item-total-col {
            width: 20%;
            text-align: right;
        }

        /* Tax badge: T16 / T0 */
        .tax-badge {
            display: inline-block;
            font-size: 7px;
            font-weight: bold;
            vertical-align: middle;
            margin-left: 2px;
        }

        /* Per-item discount sub-row */
        .discount-row td {
            font-size: 9px;
            padding: 0 1mm 1.5mm 0;
            border-bottom: 1px dotted #000;
        }

        .discount-label {
            padding-left: 6px;
        }

        .totals-section {
            text-align: right;
            margin-top: 2mm;
            font-size: 11px;
        }

        .totals-section .totals-row {
            margin-bottom: 1mm;
            display: flex;
            justify-content: space-between;
        }

        .total-line {
            font-weight: bold;
            font-size: 13px;
            border-top: 1px solid #000;
            padding-top: 1mm;
            margin-top: 1mm;
        }

        .tax-note {
            font-size: 10px;
        }

        .payment-info {
            text-align: left;
            margin: 2mm 0;
            font-size: 11px;
        }

        .payment-info div {
            margin-bottom: 0.8mm;
        }

        .qr-code {
            text-align: center;
            margin: 2mm 0;
        }

        .qr-code img {
            max-width: 25mm;
            max-height: 25mm;
        }

        .custom-footer {
            font-size: 10px;
            margin-top: 2mm;
            font-style: italic;
        }

        .sale-id {
            font-size: 10px;
            margin-top: 1.5mm;
            color: #666;
        }

        @@media print {
            body {
                margin: 0;
                padding: 3mm 2mm;
            }

            .ticket-container {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="ticket-container">

        @* Company Logo *@
        @if (Model.ShowCompanyLogo && !string.IsNullOrEmpty(Model.CompanyLogoBase64))
        {
            <img src="data:image/png;base64,@Model.CompanyLogoBase64" alt="@L["Company Logo"]" class="company-logo" />
        }

        @* Company Name *@
        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <div class="company-name">@Model.CompanyName</div>
        }

        @* Company Information *@
        <div class="company-info">
            @if (!string.IsNullOrEmpty(Model.CompanyAddress))
            {
                <div>@Model.CompanyAddress</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyPhone))
            {
                <div>@L["Phone"]: @Model.CompanyPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyTaxId))
            {
                <div>@L["Tax ID"]: @Model.CompanyTaxId</div>
            }
        </div>

        @* Custom Header *@
        @if (!string.IsNullOrEmpty(Model.CustomHeader))
        {
            <div class="custom-header">@Model.CustomHeader</div>
        }

        <div class="divider"></div>

        @* Sale Header *@
        <div class="sale-header">@L["SALE RECEIPT"]</div>

        @* Sale Information *@
        <div class="sale-info">
            <div><strong>@L["Sale"]:</strong> #@Model.Data.Id</div>
            <div><strong>@L["Date"]:</strong> @(Model.TimeZone != null ? DateTimeService.FormatToTimezone(Model.Data.SaleDate, Model.TimeZone) : Model.Data.SaleDate.ToString("dd/MM/yyyy h:mm tt"))</div>
            <div><strong>@L["Customer"]:</strong> @Model.Data.CustomerName</div>
        </div>

        <div class="divider"></div>

        @* Items Table *@
        @{
            var showIva = Model.ShowPricesWithTax;
            // ticketSubtotal: gross pre-discount total (with IVA when showIva)
            // d.Subtotal = net pre-discount; d.Total already includes IVA
            decimal ticketSubtotal = showIva
                ? Model.Data.Details.Sum(d => d.TaxRate > 0 ? d.Subtotal * (1 + d.TaxRate) : d.Subtotal)
                : Model.Data.Subtotal;
            // ticketDiscount: total discount on displayed prices
            decimal ticketDiscount = showIva && Model.Data.DiscountAmount > 0
                ? ticketSubtotal - (Model.Data.Total - Model.Data.RoundingAmount)
                : Model.Data.DiscountAmount;
        }
        <table class="items-table">
            <thead>
                <tr>
                    <th class="item-name-col">@L["Product"]</th>
                    <th class="item-qty-col" style="text-align:center;">@L["Qty"]</th>
                    <th class="item-price-col align-right">@L["Price"]</th>
                    <th class="item-total-col align-right">@L["Total"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.Data.Details)
                {
                    var taxPct = (int)Math.Round(detail.TaxRate * 100);
                    var taxLabel = taxPct > 0 ? $"T{taxPct}" : "T0";

                    // Display unit price: gross (with IVA) when showIva
                    decimal displayUnitPrice = showIva && detail.TaxRate > 0
                        ? detail.UnitPrice * (1 + detail.TaxRate)
                        : detail.UnitPrice;

                    // Per-item discount amount for display
                    decimal displayDiscAmount = showIva && detail.TaxRate > 0
                        ? detail.DiscountAmount * (1 + detail.TaxRate)
                        : detail.DiscountAmount;
                    <tr class="item-row">
                        <td class="item-name-col">
                            @detail.ProductName
                            <span class="tax-badge">[@taxLabel]</span>
                        </td>
                        <td class="item-qty-col">@detail.Quantity.ToString("0.###")</td>
                        <td class="item-price-col">@displayUnitPrice.ToString("C")</td>
                        <td class="item-total-col">@detail.Total.ToString("C")</td>
                    </tr>
                    @if (detail.DiscountPercentage > 0)
                    {
                        <tr class="discount-row">
                            <td colspan="3" class="item-name-col">
                                <span class="discount-label">  @L["Disc."] -@detail.DiscountPercentage.ToString("0.##")%</span>
                            </td>
                            <td class="item-total-col">-@displayDiscAmount.ToString("C")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="divider"></div>

        @* Totals Section *@
        <div class="totals-section">
            <div class="totals-row">
                <span>@L["Subtotal"]:</span>
                <span>@ticketSubtotal.ToString("C")</span>
            </div>

            @if (ticketDiscount > 0)
            {
                <div class="totals-row">
                    <span>@L["Discount"]:</span>
                    <span>-@ticketDiscount.ToString("C")</span>
                </div>
            }

            @if (Model.Data.TaxAmount > 0)
            {
                @if (showIva)
                {
                    <div class="totals-row tax-note">
                        <span>@L["Tax"] (@((Model.TaxRate * 100).ToString("0"))% @L["incl."]):</span>
                        <span>@Model.Data.TaxAmount.ToString("C")</span>
                    </div>
                }
                else
                {
                    <div class="totals-row">
                        <span>@L["Tax"]:</span>
                        <span>@Model.Data.TaxAmount.ToString("C")</span>
                    </div>
                }
            }

            @if (Model.Data.RoundingAmount != 0)
            {
                <div class="totals-row">
                    <span>@L["Rounding"]:</span>
                    <span>@(Model.Data.RoundingAmount > 0 ? "+" : "")@Model.Data.RoundingAmount.ToString("C")</span>
                </div>
            }

            <div class="totals-row total-line">
                <span>@L["TOTAL"]:</span>
                <span>@Model.Data.Total.ToString("C")</span>
            </div>
        </div>

        @* Payment Information *@
        <div class="payment-info">
            @foreach (var payment in Model.Data.Payments)
            {
                <div class="total-row">
                    <span>@payment.PaymentMethodName</span>
                    <span>@payment.Amount.ToString("C")</span>
                </div>
                @if (payment.CashTendered.HasValue)
                {
                    <div class="total-row" style="font-size:9px;color:#666;">
                        <span>@L["Cash tendered"]</span>
                        <span>@payment.CashTendered.Value.ToString("C")</span>
                    </div>
                    <div class="total-row" style="font-size:9px;color:#666;">
                        <span>@L["Change"]</span>
                        <span>@((payment.CashChange ?? 0).ToString("C"))</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(payment.CardLastFour))
                {
                    <div style="font-size:9px;color:#666;">****@payment.CardLastFour @(payment.AuthorizationCode != null ? $"Auth: {payment.AuthorizationCode}" : "")</div>
                }
            }
        </div>

        @* QR Code *@
        @if (Model.ShowQRCode && !string.IsNullOrEmpty(Model.QRCodeData))
        {
            <div class="qr-code">
                <img src="data:image/png;base64,@Model.QRCodeData" alt="@L["QR Code"]" />
                <div style="font-size: 9px; margin-top: 0.5mm;">@L["Scan for details"]</div>
            </div>
        }

        <div class="divider"></div>

        @* Custom Footer *@
        @if (!string.IsNullOrEmpty(Model.CustomFooter))
        {
            <div class="custom-footer">@Model.CustomFooter</div>
        }

        @* Sale ID for reference *@
        <div class="sale-id">@L["Ref"]: @Model.Data.Id.ToString("D6")</div>

    </div>
</body>
</html>
