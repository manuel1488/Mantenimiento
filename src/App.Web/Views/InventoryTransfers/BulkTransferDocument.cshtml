@using App.Core.DTOs.Inventory
@using App.Services.Inventory
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<InventoryService> L
@model BulkTransferPdfDto

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@L["Bulk Transfer"] @Model.BatchNumber</title>
    <style>
        :root {
            --primary-color: #1A6868;
            --secondary-color: #546E7A;
        }

        body {
            font-family: 'Roboto', Arial, sans-serif;
            margin: 0;
            padding: 24px;
            color: #263238;
            font-size: 13px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: 16px;
        }

        .logo {
            max-width: 160px;
            max-height: 60px;
        }

        .company-info { text-align: right; }

        .company-name {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-color);
        }

        .document-title {
            font-size: 22px;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 16px;
        }

        .meta-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            margin-bottom: 20px;
        }

        .meta-block { flex: 1; min-width: 140px; }

        .meta-label {
            font-size: 10px;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 500;
        }

        .meta-value {
            font-size: 14px;
            font-weight: 500;
            margin-top: 2px;
            color: #263238;
            word-break: break-all;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
        }

        thead tr { background: var(--primary-color); color: white; }

        thead th {
            padding: 9px 12px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        thead th.text-right { text-align: right; }

        tbody tr:nth-child(even) { background: #F8FAFB; }

        tbody td {
            padding: 8px 12px;
            border-bottom: 1px solid #ECEFF1;
            font-size: 12px;
        }

        tbody td.text-right { text-align: right; }

        .footer {
            text-align: center;
            font-size: 11px;
            color: var(--secondary-color);
            border-top: 1px solid #CFD8DC;
            padding-top: 12px;
            margin-top: 8px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div>
            @if (!string.IsNullOrEmpty(Model.LogoBase64))
            {
                <img src="@Model.LogoBase64" class="logo" alt="Logo" />
            }
        </div>
        <div class="company-info">
            <div class="company-name">@Model.CompanyName</div>
        </div>
    </div>

    <div class="document-title">@L["Bulk Transfer"]</div>

    <div class="meta-grid">
        <div class="meta-block">
            <div class="meta-label">@L["Batch"]</div>
            <div class="meta-value">@Model.BatchNumber</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Date"]</div>
            <div class="meta-value">@Model.MovementDate.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Source Location"]</div>
            <div class="meta-value">@Model.LocationName</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Destination Location"]</div>
            <div class="meta-value">@Model.DestinationLocationName</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Transfer Type"]</div>
            <div class="meta-value">@Model.TransferTypeDisplay</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Reference"]</div>
            <div class="meta-value">@(string.IsNullOrEmpty(Model.Reference) ? "-" : Model.Reference)</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Created By"]</div>
            <div class="meta-value">@Model.CreatedBy</div>
        </div>
        <div class="meta-block">
            <div class="meta-label">@L["Reason"]</div>
            <div class="meta-value">@Model.Reason</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>@L["Code"]</th>
                <th>@L["Product"]</th>
                <th class="text-right">@L["Quantity"]</th>
                <th class="text-right">@L["Previous Balance"]</th>
                <th class="text-right">@L["New Balance"]</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                var line = Model.Lines[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@line.ProductCode</td>
                    <td>@line.ProductName</td>
                    <td class="text-right">@line.Quantity.ToString("N2")</td>
                    <td class="text-right">@line.PreviousBalance.ToString("N2")</td>
                    <td class="text-right">@line.NewBalance.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer">
        @Model.CompanyName — @L["Bulk Transfer"] @Model.BatchNumber — @Model.MovementDate.ToString("dd/MM/yyyy HH:mm")
    </div>
</body>
</html>
