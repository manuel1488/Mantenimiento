# =============================================================================
# App - MySQL root secret template. Only needed for a SELF-HOSTED MySQL container
# (development, or the "shared-db"/"tenant" white-label profiles — see
# docs/02-Development/white-label-deployment-guide.md). The plain "production"
# profile uses an externally-provisioned DB and does NOT need this file.
# Copy to .env.{environment}.secrets and fill in. Never commit the filled-in file
# (already covered by .env.*.secrets in .gitignore).
# =============================================================================

MYSQL_ROOT_PASSWORD=YOUR_SECURE_PASSWORD_HERE
